@using Microsoft.AspNetCore.Mvc.Rendering
@model RouteViewModel
@{
    ViewData["Title"] = "Edit Route";

    var typeClass = Model.RouteTypeName switch
    {
        "New" => "state-ok",
        "Removal" => "state-crit",
        "Update" => "state-warn",
        "Transfer" => "state-info",
        _ => "state-idle"
    };
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Routes"]</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L[(string)ViewData["Title"]!]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-eye"></i> @L["View Details"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <span><i class="fas fa-circle-info me-1"></i> @L["Route Information"]</span>
                    <span class="d-flex gap-2 flex-wrap">
                        <span class="state state-flat @typeClass">@L[Model.RouteTypeName ?? ""]</span>
                        @if (Model.IsCompleted)
                        {
                            <span class="state state-ok">@L["Completed"]</span>
                        }
                        else
                        {
                            <span class="state state-warn">@L["Pending"]</span>
                        }
                    </span>
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">@L["Route type"]</span>
                            <span class="d-value">@L[Model.RouteTypeName ?? ""]</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Product"]</span>
                            <span class="d-value"><span class="mono">@Model.InventoryCode</span> - @Model.Model</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Vendor"]</span>
                            @if (string.IsNullOrWhiteSpace(Model.Vendor))
                            {
                                <span class="d-value d-empty">@L["Not set"]</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Vendor</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["From"]</span>
                            @if (string.IsNullOrWhiteSpace(Model.FromDepartmentName))
                            {
                                <span class="d-value d-empty">@L["Not set"]</span>
                            }
                            else
                            {
                                @* Only append the worker when there is one - otherwise this rendered
                                   "IT Storage ()" with empty brackets. *@
                                <span class="d-value">
                                    @Model.FromDepartmentName@(string.IsNullOrWhiteSpace(Model.FromWorker) ? "" : $" ({Model.FromWorker})")
                                </span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Created"]</span>
                            <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Status"]</span>
                            <span class="d-value">
                                @if (Model.IsCompleted)
                                {
                                    <span class="state state-ok">@L["Completed"]</span>
                                }
                                else
                                {
                                    <span class="state state-warn">@L["Pending"]</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-pen-to-square me-1"></i>
                    @L["Edit Route Information"]
                </div>

                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editRouteForm">
                    <div>
                    <div class="form-section">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <h2 class="section-title">@L["Destination"]</h2>
                        <div class="form-grid">
                            <div>
                                <label class="form-label" for="ToDepartmentId">@L["To Department"]</label>
                                @{
                                    var departmentOptions = ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>();
                                }
                                @if (departmentOptions.Any())
                                {
                                    <select name="ToDepartmentId" id="ToDepartmentId" class="form-select">
                                        @foreach (var dept in departmentOptions)
                                        {
                                            <option value="@dept.Value" selected="@(dept.Value == Model.ToDepartmentId.ToString())">@dept.Text</option>
                                        }
                                    </select>
                                    <div class="form-text">@L["Moving the route to another department updates its destination."]</div>
                                }
                                else
                                {
                                    @* Department list unavailable - keep the current value rather than posting an empty one. *@
                                    <input type="text" class="form-control" value="@Model.ToDepartmentName" readonly disabled />
                                    <input type="hidden" name="ToDepartmentId" value="@Model.ToDepartmentId" />
                                    <div class="form-text">@L["Department list could not be loaded; try reloading the page."]</div>
                                }
                            </div>
                            <div>
                                <label class="form-label">@L["To Worker"]</label>
                                @* The visible box had no name attribute, so edits never reached the
                                   server - a hidden field posted the ORIGINAL value instead. Bind the
                                   visible input itself and drop the shadow field. *@
                                <input type="text" name="ToWorker" class="form-control" value="@Model.ToWorker"
                                       placeholder="@L["Not assigned"]" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h2 class="section-title">@L["Images"]</h2>
                        <partial name="_ImageManager" model='new ImageManagerModel { Existing = Model.ImageUrls, Hint = "When the transfer is completed these become the product images, and the cover (★) becomes its main image." }' />
                    </div>

                    <div class="form-section">
                        <h2 class="section-title">@L["Notes"]</h2>
                        <div class="form-grid">
                            <div class="full">
                                <label class="form-label">@L["Notes"]</label>
                                <textarea name="Notes" class="form-control" rows="3" placeholder="@L["Add any notes..."]">@Model.Notes</textarea>
                            </div>
                        </div>
                    </div>
                    </div>

                    <div class="page-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> @L["Back to List"]
                        </a>
                        <div class="actions-right">
                            @if (!Model.IsCompleted)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmDelete(@Model.Id)">
                                    <i class="fas fa-trash"></i> @L["Delete Route"]
                                </button>
                            }
                            <button type="submit" class="btn btn-primary btn-sm" id="submitBtn">
                                <i class="fas fa-save"></i> @L["Save Changes"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 side-panel">
                <div class="card-header">
                    <i class="fas fa-lightbulb me-1"></i>
                    @L["Edit Guidelines"]
                </div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item">
                        <i class="fas fa-check me-2"></i>
                        @L["Changing department will update product location"]
                    </div>
                    <div class="list-group-item">
                        <i class="fas fa-check me-2"></i>
                        @L["Worker assignment tracks responsibility"]
                    </div>
                    <div class="list-group-item">
                        <i class="fas fa-check me-2"></i>
                        @L["Add or remove images; the first image is the cover"]
                    </div>
                    <div class="list-group-item">
                        <i class="fas fa-triangle-exclamation me-2"></i>
                        @L["Completed routes cannot be edited"]
                    </div>
                </div>
                @if (!Model.IsCompleted)
                {
                    <div class="card-body">
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>@L["Note:"]</strong> @L["Deleting this route will revert the product to its previous location."]
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete this route?"]</p>
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i> @L["The product will be reverted to its previous location and worker assignment."]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteRoute()">
                    <i class="fas fa-trash"></i> @L["Delete Route"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        // Create a namespace for this page to avoid global conflicts
        (function() {
            'use strict';

            // Track if form is currently being submitted
            let isSubmitting = false;
            let routeId = @Model.Id;  // Store the route ID for use in delete function

            // Initialize the form handler when document is ready
            $(document).ready(function() {
                initializeEditForm();
                initializeDeleteHandlers();
            });

            // Function to initialize the edit form with proper safeguards
            function initializeEditForm() {
                const $form = $('#editRouteForm');

                // Ensure the form exists before proceeding
                if (!$form.length) {
                    console.error('Edit form not found');
                    return;
                }

                // Get the submit button and remember its original appearance
                const $submitBtn = $('#submitBtn');
                const originalButtonHtml = $submitBtn.html();

                // This is crucial to prevent duplicate handlers
                $form.off('submit');
                $form.off('submit.ajaxHandler');
                $submitBtn.off('click');

                // Initialize the AjaxHandler with proper configuration
                AjaxHandler.handleForm('#editRouteForm', {
                    successMessage: t('Route updated successfully!'),
                    successRedirect: '/Routes',
                    redirectDelay: 2000,

                    onBeforeSubmit: function(form) {
                        // Check if already submitting
                        if (isSubmitting) {
                            return false;
                        }

                        // Set the submission flag
                        isSubmitting = true;

                        // Log for debugging

                        return true; // Allow submission to proceed
                    },

                    onSuccess: function(response) {
                        // Check if this is an approval request
                        if (response.isApprovalRequest ||
                            response.status === 'PendingApproval' ||
                            response.approvalRequestId) {
                            showToast(
                                response.message || t('Update submitted for approval'),
                                'info'
                            );

                            // Redirect after showing the message
                            setTimeout(() => {
                                window.location.href = '/Routes';
                            }, 2000);

                            return false; // Prevent default redirect
                        }

                        // For direct updates (admin users)
                        showToast(t('Route updated successfully!'), 'success');
                        setTimeout(() => {
                            window.location.href = '/Routes';
                        }, 1500);

                        return false; // We're handling the redirect ourselves
                    },

                    onError: function(errorMessage, response) {
                        console.error('Route update error:', errorMessage, response);

                        // Reset submission flag on error
                        isSubmitting = false;

                        // Also restore the button to its original state
                        $submitBtn.prop('disabled', false)
                            .html(originalButtonHtml);

                        // Show error message
                        showToast(errorMessage || t('Failed to update route'), 'error');
                    }
                });
            }

            // Function to handle delete operations
            function initializeDeleteHandlers() {
                // Confirm delete function
                window.confirmDelete = function(id) {
                    // Store the route ID for use in deleteRoute
                    window.currentDeleteRouteId = id;
                    $('#deleteModal').modal('show');
                };

                // Delete route function
                window.deleteRoute = function() {
                    // Prevent multiple delete attempts
                    if (isSubmitting) {
                        return;
                    }

                    isSubmitting = true;
                    $('#deleteModal').modal('hide');

                    const deleteRouteId = window.currentDeleteRouteId || routeId;

                    $.ajax({
                        url: '/Routes/Delete',
                        type: 'POST',
                        data: {
                            id: deleteRouteId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            showToast(
                                t('Route deleted successfully. Product has been reverted to previous state.'),
                                'success'
                            );
                            setTimeout(() => {
                                window.location.href = '/Routes';
                            }, 2000);
                        },
                        error: function(xhr) {
                            isSubmitting = false;

                            let errorMsg = t('Failed to delete route');
                            try {
                                if (xhr.responseJSON && xhr.responseJSON.error) {
                                    errorMsg = xhr.responseJSON.error;
                                } else if (xhr.responseText) {
                                    const response = JSON.parse(xhr.responseText);
                                    errorMsg = response.message || response.error || errorMsg;
                                }
                            } catch (e) {
                                console.error('Error parsing error response:', e);
                            }

                            showToast(errorMsg, 'error');
                        }
                    });
                };

                // Ensure delete modal doesn't interfere with form submission
                $('#deleteModal').on('hidden.bs.modal', function() {
                    // Clear any stored route ID
                    window.currentDeleteRouteId = null;
                });
            }
        })(); // End of page-specific namespace


        // Someone else saving or deleting this route while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['route'],
            ids: { route: @Model.Id },
            label: 'route'
        });
    </script>
}
