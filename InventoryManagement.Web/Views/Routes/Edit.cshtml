@using Microsoft.AspNetCore.Mvc.Rendering
@model RouteViewModel
@{
    ViewData["Title"] = "Edit Route";
    ViewData["Subtitle"] = Model.InventoryCode.ToString();
    var direct = User.HasPermission("route.update.direct");
    var canDelete = User.HasPermission("route.delete") || User.HasPermission("route.delete.direct");
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Routes"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="ip-num">#@Model.Id</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L[(string)ViewData["Title"]!]</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                <span class="ip-mono text-body">@Model.InventoryCode</span>
                <span>@Or(Model.Model, "-")</span>
                @if (Model.IsCompleted)
                {
                    <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                }
                <span class="ip-tag-plain">@L[Model.RouteTypeLabel]</span>
            </div>
        </div>
    </div>

    @if (Model.IsCompleted)
    {
        <div class="ip-banner ip-banner-warning mb-3">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@L["Completed routes cannot be edited"]</span>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="ip-form" id="editRouteForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Route"]</h2>
            <dl class="ip-dl">
                <div>
                    <dt>@L["Product"]</dt>
                    <dd>
                        <span class="ip-mono">@Model.InventoryCode</span> · @Or(Model.Model, "-")
                        <div class="ip-faint">@Or(Model.Vendor, "-") · @Or(Model.CategoryName, "-")</div>
                    </dd>
                </div>
                <div>
                    <dt>@L["From"]</dt>
                    <dd>
                        @Or(Model.FromDepartmentName, "-")
                        @if (!string.IsNullOrWhiteSpace(Model.FromWorker))
                        {
                            <div class="ip-faint">@Model.FromWorker</div>
                        }
                    </dd>
                </div>
                <div><dt>@L["Type"]</dt><dd>@L[Model.RouteTypeLabel]</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div>
            </dl>
        </section>

        @* Same fields, names and order as the transfer form that created the route *@
        <section class="ip-form-section">
            <h2>@L["Where to"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label class="ip-label" for="ToDepartmentId"><span>@L["To Department"]</span> <span class="req">*</span></label>
                    @{
                        var departmentOptions = ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>();
                    }
                    @if (departmentOptions.Any())
                    {
                        <select name="ToDepartmentId" id="ToDepartmentId" class="ip-select">
                            @foreach (var dept in departmentOptions)
                            {
                                <option value="@dept.Value" selected="@(dept.Value == Model.ToDepartmentId.ToString())">@dept.Text</option>
                            }
                        </select>
                        <span class="ip-hint">@L["Moving the route to another department updates its destination."]</span>
                    }
                    else
                    {
                        @* Without the department list, post the current value instead of an empty one *@
                        <input type="text" id="ToDepartmentId" class="ip-input" value="@Model.ToDepartmentName" readonly disabled />
                        <input type="hidden" name="ToDepartmentId" value="@Model.ToDepartmentId" />
                        <span class="ip-error"><i class="fa-solid fa-circle-exclamation"></i>@L["The department list could not be loaded. Please reload the page."]</span>
                    }
                </div>
                <div class="ip-field">
                    <label class="ip-label" for="ToWorker">@L["New worker"]</label>
                    <input type="text" name="ToWorker" id="ToWorker" class="ip-input" value="@Model.ToWorker"
                           maxlength="100" placeholder="@L["Enter worker name (optional)"]" />
                </div>
            </div>

            <div class="ip-field mt-4">
                <label class="ip-label" for="Notes">@L["Notes"]</label>
                <textarea name="Notes" id="Notes" class="ip-textarea" rows="3" maxlength="500"
                          placeholder="@L["Reason for the transfer, condition of the device"]">@Model.Notes</textarea>
            </div>

            <div class="mt-4">
                <partial name="_ImageManager" model='new ImageManagerModel { Existing = Model.ImageUrls, Label = "Handover photos (optional)", Hint = "When the transfer is completed they become the product images; the starred one becomes the cover." }' />
            </div>
        </section>

        @* Phones hide the footer note, so the approval notice is repeated above the fixed bar *@
        @if (!direct)
        {
            <p class="ip-hint d-md-none mt-3 mb-0"><i class="fa-solid fa-circle-info me-1"></i>@L["Your changes are applied after they are approved."]</p>
        }

        <div class="ip-form-foot">
            <span class="note">
                @if (!direct)
                {
                    <i class="fa-solid fa-circle-info me-1"></i>@L["Your changes are applied after they are approved."]
                }
            </span>
            @if (canDelete && !Model.IsCompleted)
            {
                <button type="button" class="ip-btn ip-btn-danger-ghost" data-summary="@Model.Summary" onclick="confirmDelete(this.dataset.summary)">
                    <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
                </button>
            }
            <a asp-action="Details" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary" id="submitBtn">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        (function() {
            'use strict';

            // Shared by save and delete so only one request runs at a time
            let isSubmitting = false;
            const routeId = @Model.Id;

            $(document).ready(function() {
                initializeEditForm();
                initializeDeleteHandlers();
            });

            function initializeEditForm() {
                const $form = $('#editRouteForm');

                if (!$form.length) {
                    console.error('Edit form not found');
                    return;
                }

                const $submitBtn = $('#submitBtn');
                const originalButtonHtml = $submitBtn.html();

                AjaxHandler.handleForm('#editRouteForm', {
                    successMessage: t('Route updated successfully!'),
                    successRedirect: '/Routes',
                    redirectDelay: 2000,

                    onBeforeSubmit: function(form) {
                        if (isSubmitting) {
                            return false;
                        }

                        isSubmitting = true;


                        return true;
                    },

                    // AjaxHandler deals with approval-required responses before onSuccess runs
                    onSuccess: function(response) {
                        showToast(t('Route updated successfully!'), 'success');
                        setTimeout(() => {
                            window.location.href = '/Routes';
                        }, 1500);

                        return false; // Skips AjaxHandler's own redirect
                    },

                    onError: function(errorMessage, response) {
                        console.error('Route update error:', errorMessage, response);

                        isSubmitting = false;

                        $submitBtn.prop('disabled', false)
                            .html(originalButtonHtml);

                        showToast(errorMessage || t('Failed to update route'), 'error');
                    }
                });
            }

            function initializeDeleteHandlers() {
                // The same question as on the route's page and in the list
                window.confirmDelete = function(routeSummary) {
                    confirmAction({
                        title: t('Delete route'),
                        detail: routeSummary,
                        message: t('Delete this route? This cannot be undone.'),
                        okText: t('Delete'),
                        danger: true
                    }, deleteRoute);
                };

                function deleteRoute() {
                    if (isSubmitting) {
                        return;
                    }

                    isSubmitting = true;

                    $.ajax({
                        url: '/Routes/Delete',
                        type: 'POST',
                        data: {
                            id: routeId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            // Without route.delete.direct the deletion waits for approval
                            showToast(response && response.isApprovalRequest
                                ? (response.message || t('Delete request submitted for approval'))
                                : (response && response.message) || t('Route deleted successfully'),
                                response && response.isApprovalRequest ? 'info' : 'success');
                            setTimeout(() => {
                                window.location.href = '/Routes';
                            }, 2000);
                        },
                        error: function(xhr) {
                            isSubmitting = false;

                            let errorMsg = t('Failed to delete route');
                            try {
                                if (xhr.responseJSON && xhr.responseJSON.error) {
                                    errorMsg = xhr.responseJSON.error;
                                } else if (xhr.responseText) {
                                    const response = JSON.parse(xhr.responseText);
                                    errorMsg = response.message || response.error || errorMsg;
                                }
                            } catch (e) {
                                console.error('Error parsing error response:', e);
                            }

                            showToast(errorMsg, 'error');
                        }
                    });
                }
            }
        })();


        // If someone else changes this route while it is open, warn but leave the form alone
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['route'],
            ids: { route: @Model.Id },
            label: 'route'
        });
    </script>
}
