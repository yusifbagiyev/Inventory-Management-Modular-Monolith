@model List<RouteViewModel>
@{
    var canProducts = User.HasPermission("product.view");
    ViewData["Title"] = "Transfer Timeline";
    var productId = ViewBag.ProductId;
    var ordered = Model.OrderByDescending(r => r.CreatedAt).ToList();
    var product = ordered.FirstOrDefault();
    ViewData["Subtitle"] = product?.InventoryCode.ToString();
    var pendingCount = Model.Count(r => !r.IsCompleted);
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    string Place(string? department, string? worker)
        => string.IsNullOrWhiteSpace(worker) ? Or(department, "-") : $"{Or(department, "-")} ({worker})";
}

@section Styles {
    <style>
        .timeline { list-style: none; margin: 0; padding: var(--ip-space-6) 0 0; }
        .timeline-item { position: relative; display: flex; gap: var(--ip-space-4); padding-bottom: var(--ip-space-6); }
        .timeline-item:not(:last-child)::before { content: ""; position: absolute; left: 13px; top: 32px; bottom: 4px; width: 2px; background: var(--ip-border); }
        .timeline-marker { width: 28px; height: 28px; flex: none; border-radius: 50%; background: var(--ip-sunken); color: var(--ip-text-3); display: grid; place-items: center; font-size: 12px; }
        .timeline-content { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; padding-top: 3px; }
        .timeline-move { display: flex; align-items: flex-start; gap: var(--ip-space-3); flex-wrap: wrap; }
        .timeline-move > i { color: var(--ip-text-3); margin-top: 4px; }
        .timeline-thumbs { display: flex; gap: var(--ip-space-2); flex-wrap: wrap; }
        .timeline-thumbs .ip-thumb { border: 0; padding: 0; cursor: zoom-in; }
    </style>
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                @if (canProducts)
                {
                    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@L["Products"]</a></li>
                }
                @if (product != null && canProducts)
                {
                    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Details" asp-route-id="@productId" class="ip-mono">@product.InventoryCode</a></li>
                }
                <li class="breadcrumb-item active">@L["Timeline"]</li>
            </ol>
            <h1>@L[(string)ViewData["Title"]!]</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (product != null)
                {
                    <span class="ip-mono text-body">@product.InventoryCode</span>
                    <span>@Or(product.Model, "-") · @Or(product.Vendor, "-")</span>
                    <span aria-hidden="true">·</span>
                }
                <span class="ip-num">@L["{0} routes, {1} pending", Model.Count, pendingCount]</span>
            </div>
        </div>
    </div>

    <div class="ip-page-actions mb-4">
        @if (canProducts)
        {
            <a asp-controller="Products" asp-action="Details" asp-route-id="@productId" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-box"></i><span>@L["View Product"]</span>
            </a>
        }
        @if (ordered.Any() && User.HasPermission("route.export"))
        {
            <button type="button" class="ip-btn ip-btn-secondary" onclick="exportTimelineToPDF()">
                <span>@L["Export PDF"]</span><i class="fa-regular fa-file-pdf"></i>
            </button>
        }
    </div>

    <hr class="ip-rule" />

    @if (product != null)
    {
        <ol class="timeline" data-product="@($"{product.InventoryCode} · {product.Model} ({product.Vendor})")">
            @foreach (var route in ordered)
            {
                <li class="timeline-item"
                    data-when="@route.CreatedAt.ToString("dd.MM.yyyy HH:mm")"
                    data-type="@L[route.RouteTypeLabel]"
                    data-status="@(route.IsCompleted ? "completed" : "pending")"
                    data-status-text="@(route.IsCompleted ? L["Completed"] : L["Pending"])"
                    data-from="@(route.FromDepartmentName == null ? "" : Place(route.FromDepartmentName, route.FromWorker))"
                    data-to="@Place(route.ToDepartmentName, route.ToWorker)"
                    data-notes="@route.Notes"
                    data-completed="@(route.IsCompleted ? route.CompletedAt?.ToString("dd.MM.yyyy HH:mm") : "")">
                    <div class="timeline-marker" aria-hidden="true">
                        <i class="fa-solid @(route.IsCompleted ? "fa-check" : "fa-clock")"></i>
                    </div>
                    <div class="timeline-content">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <a asp-action="Details" asp-route-id="@route.Id" class="ip-num fw-semibold text-body">
                                @route.CreatedAt.ToString("dd.MM.yyyy") <span class="ip-muted fw-normal">@route.CreatedAt.ToString("HH:mm")</span>
                            </a>
                            <span class="ip-tag-plain">@L[route.RouteTypeLabel]</span>
                            @if (route.IsCompleted)
                            {
                                <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                            }
                            else
                            {
                                <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                            }
                        </div>

                        <div class="timeline-move">
                            @if (route.FromDepartmentName != null)
                            {
                                <div class="cell-text">
                                    <span>@route.FromDepartmentName</span>
                                    @if (!string.IsNullOrEmpty(route.FromWorker))
                                    {
                                        <span class="ip-faint">@route.FromWorker</span>
                                    }
                                </div>
                                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            }
                            <div class="cell-text">
                                <span class="fw-semibold">@route.ToDepartmentName</span>
                                @if (!string.IsNullOrEmpty(route.ToWorker))
                                {
                                    <span class="ip-faint">@route.ToWorker</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(route.Notes))
                        {
                            <p class="ip-muted mb-0">@route.Notes</p>
                        }

                        @if (route.ImageUrls.Count > 0)
                        {
                            <div class="timeline-thumbs">
                                @for (var i = 0; i < route.ImageUrls.Count; i++)
                                {
                                    <button type="button" class="ip-thumb" data-src="@route.ImageUrls[i]" data-title="@L["Transfer image"]"
                                            aria-label="@L["Image {0}", i + 1]" onclick="showImageModal(this.dataset.src, this.dataset.title)">
                                        <img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(route.ImageUrls[i])" alt="" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }

                        @if (route.IsCompleted && route.CompletedAt.HasValue)
                        {
                            <span class="ip-faint ip-num">@L["Completed"]: @route.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <div class="ip-empty">
            <span class="icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
            <div class="title">@L["No transfers yet"]</div>
            <div class="text">@L["No transfer history available for this product."]</div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>

        // Other users' changes refresh the page in place. A deletion shows a notice.
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { product: @(productId ?? 0) },
            regions: ['#detailsRegion'],
            label: 'product'
        });
    </script>
}
