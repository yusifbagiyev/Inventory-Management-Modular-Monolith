@model List<RouteViewModel>
@{
    ViewData["Title"] = "Transfer Timeline";
    var productId = ViewBag.ProductId;
    var ordered = Model.OrderByDescending(r => r.CreatedAt).ToList();
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@L["Products"]</a></li>
                <li class="breadcrumb-item active">@L["Timeline"]</li>
            </ol>
            <h1>@L[(string)ViewData["Title"]!]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportTimelineToPDF()">
                <i class="fas fa-file-pdf"></i> @L["Export PDF"]
            </button>
            <a asp-controller="Products" asp-action="Details" asp-route-id="@productId" class="btn btn-primary btn-sm">
                <i class="fas fa-box"></i> @L["View Product"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-clock-rotate-left me-1"></i>
                    @L["Product Transfer History"]
                </div>
                <div class="card-body">
                    @if (ordered.Any())
                    {
                        var product = ordered[0];
                        <div class="timeline" data-product="@($"{product.InventoryCode} · {product.Model} ({product.Vendor})")">
                            @for (var i = 0; i < ordered.Count; i++)
                            {
                                var route = ordered[i];
                                var isLast = i == ordered.Count - 1;
                                var typeClass = route.RouteTypeName switch
                                {
                                    "New" => "state-ok",
                                    "Removal" => "state-crit",
                                    "Update" => "state-warn",
                                    "Transfer" => "state-info",
                                    _ => "state-idle"
                                };

                                <div class="timeline-item d-flex gap-3 py-3 @(isLast ? "" : "border-bottom")">
                                    <div class="timeline-marker">
                                        @if (route.IsCompleted)
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-clock text-warning"></i>
                                        }
                                    </div>
                                    <div class="timeline-content flex-grow-1">
                                        <h6 class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                            <span class="d-flex align-items-center flex-wrap gap-2">
                                                <span class="state state-flat @typeClass">@L[route.RouteTypeName ?? ""]</span>
                                                @if (route.IsCompleted)
                                                {
                                                    <span class="state state-ok">@L["Completed"]</span>
                                                }
                                                else
                                                {
                                                    <span class="state state-warn">@L["Pending"]</span>
                                                }
                                            </span>
                                            <span class="cell-sub mono">@route.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </h6>

                                        <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
                                            @if (route.FromDepartmentName != null)
                                            {
                                                <div class="cell-text">
                                                    <span class="cell-sub">@L["From"]</span>
                                                    <span class="cell-title">@route.FromDepartmentName</span>
                                                    @if (!string.IsNullOrEmpty(route.FromWorker))
                                                    {
                                                        <span class="cell-sub">@route.FromWorker</span>
                                                    }
                                                </div>
                                                <i class="fas fa-arrow-right text-muted"></i>
                                            }
                                            <div class="cell-text">
                                                <span class="cell-sub">@L["To"]</span>
                                                <span class="cell-title">@route.ToDepartmentName</span>
                                                @if (!string.IsNullOrEmpty(route.ToWorker))
                                                {
                                                    <span class="cell-sub">@route.ToWorker</span>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(route.Notes))
                                        {
                                            <p class="text-muted mb-2">
                                                <i class="fas fa-note-sticky me-1"></i> @route.Notes
                                            </p>
                                        }

                                        @if (!string.IsNullOrEmpty(route.FullImageUrl))
                                        {
                                            <img src="@route.FullImageUrl"
                                                 class="img-thumbnail timeline-image-zoom mb-2"
                                                 style="max-width: 150px; cursor: pointer;"
                                                 alt="@L["Transfer image"]"
                                                 data-src="@route.FullImageUrl" data-title="@L["Transfer image"]"
                                                 onclick="showImageModal(this.dataset.src, this.dataset.title)" />
                                        }

                                        @if (route.IsCompleted)
                                        {
                                            <div class="cell-sub mono">
                                                @L["Completed"]: @route.CompletedAt?.ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-clock-rotate-left"></i>
                            <h5>@L["No transfers yet"]</h5>
                            <p class="mb-0">@L["No transfer history available for this product."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-line me-1"></i>
                    @L["Statistics"]
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">@L["Total Transfers"]</span>
                            <span class="d-value mono">@Model.Count</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Completed"]</span>
                            <span class="d-value mono">@Model.Count(r => r.IsCompleted)</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Pending"]</span>
                            <span class="d-value mono">@Model.Count(r => !r.IsCompleted)</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["First Transfer"]</span>
                            @if (Model.Any())
                            {
                                <span class="d-value mono">@Model.Min(r => r.CreatedAt).ToString("dd.MM.yyyy")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">@L["Not available"]</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Last Transfer"]</span>
                            @if (Model.Any())
                            {
                                <span class="d-value mono">@Model.Max(r => r.CreatedAt).ToString("dd.MM.yyyy")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">@L["Not available"]</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>

        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { product: @(productId ?? 0) },
            regions: ['#detailsRegion'],
            label: 'product'
        });
    </script>
}
