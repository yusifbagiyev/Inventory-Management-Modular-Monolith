@model List<RouteViewModel>
@{
    ViewData["Title"] = "Transfer Timeline";
    var productId = ViewBag.ProductId;
    var ordered = Model.OrderByDescending(r => r.CreatedAt).ToList();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Transfer Timeline</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
                <li class="breadcrumb-item active">Timeline</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportTimelineToPDF()">
                <i class="fas fa-file-pdf"></i> Export PDF
            </button>
            <a asp-controller="Products" asp-action="Details" asp-route-id="@productId" class="btn btn-primary btn-sm">
                <i class="fas fa-box"></i> View Product
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-clock-history me-1"></i>
                    Product Transfer History
                </div>
                <div class="card-body">
                    @if (ordered.Any())
                    {
                        <div class="timeline">
                            @for (var i = 0; i < ordered.Count; i++)
                            {
                                var route = ordered[i];
                                var isLast = i == ordered.Count - 1;
                                var typeClass = route.RouteTypeName switch
                                {
                                    "New" => "state-ok",
                                    "Removal" => "state-crit",
                                    "Update" => "state-warn",
                                    "Transfer" => "state-info",
                                    _ => "state-idle"
                                };

                                <div class="timeline-item d-flex gap-3 py-3 @(isLast ? "" : "border-bottom")">
                                    <div class="timeline-marker">
                                        @if (route.IsCompleted)
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-clock text-warning"></i>
                                        }
                                    </div>
                                    <div class="timeline-content flex-grow-1">
                                        <h6 class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                            <span class="d-flex align-items-center flex-wrap gap-2">
                                                <span class="state state-flat @typeClass">@route.RouteTypeName</span>
                                                @if (route.IsCompleted)
                                                {
                                                    <span class="state state-ok">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="state state-warn">Pending</span>
                                                }
                                            </span>
                                            <span class="cell-sub mono">@route.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        </h6>

                                        <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
                                            @if (route.FromDepartmentName != null)
                                            {
                                                <div class="cell-text">
                                                    <span class="cell-sub">From</span>
                                                    <span class="cell-title">@route.FromDepartmentName</span>
                                                    @if (!string.IsNullOrEmpty(route.FromWorker))
                                                    {
                                                        <span class="cell-sub">@route.FromWorker</span>
                                                    }
                                                </div>
                                                <i class="bi bi-arrow-right text-muted"></i>
                                            }
                                            <div class="cell-text">
                                                <span class="cell-sub">To</span>
                                                <span class="cell-title">@route.ToDepartmentName</span>
                                                @if (!string.IsNullOrEmpty(route.ToWorker))
                                                {
                                                    <span class="cell-sub">@route.ToWorker</span>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(route.Notes))
                                        {
                                            <p class="text-muted mb-2">
                                                <i class="bi bi-sticky me-1"></i> @route.Notes
                                            </p>
                                        }

                                        @if (!string.IsNullOrEmpty(route.FullImageUrl))
                                        {
                                            <img src="@route.FullImageUrl"
                                                 class="img-thumbnail timeline-image-zoom mb-2"
                                                 style="max-width: 150px; cursor: pointer;"
                                                 alt="Transfer Image"
                                                 data-src="@route.FullImageUrl" onclick="showImageModal(this.dataset.src, 'Transfer Image')" />
                                        }

                                        @if (route.IsCompleted)
                                        {
                                            <div class="cell-sub mono">
                                                Completed: @route.CompletedAt?.ToString("MMM dd, yyyy HH:mm")
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-clock-history"></i>
                            <h5>No transfers yet</h5>
                            <p class="mb-0">No transfer history available for this product.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-bar-chart-line me-1"></i>
                    Statistics
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">Total Transfers</span>
                            <span class="d-value mono">@Model.Count</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Completed</span>
                            <span class="d-value mono">@Model.Count(r => r.IsCompleted)</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Pending</span>
                            <span class="d-value mono">@Model.Count(r => !r.IsCompleted)</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">First Transfer</span>
                            @if (Model.Any())
                            {
                                <span class="d-value mono">@Model.Min(r => r.CreatedAt).ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">Not available</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Last Transfer</span>
                            @if (Model.Any())
                            {
                                <span class="d-value mono">@Model.Max(r => r.CreatedAt).ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">Not available</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
}
