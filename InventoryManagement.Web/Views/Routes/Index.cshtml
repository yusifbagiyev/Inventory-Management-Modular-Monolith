@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<RouteViewModel>
@{
    ViewData["Title"] = "Routes";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curDepartmentId = ViewBag.CurrentDepartmentId as int?;
    var curDepartmentName = ViewBag.CurrentDepartmentName as string;
    var curCategoryName = ViewBag.CurrentCategoryName as string;

}
<div class="container-fluid px-4">
    @{
        var curCompleted = ViewBag.CurrentFilter as bool?;
        var curStart = ViewBag.StartDate as DateTime?;
        var curEnd = ViewBag.EndDate as DateTime?;
        var curRouteType = ViewBag.CurrentRouteType as string;
        var hasFilters = !string.IsNullOrEmpty(currentSearch) || curStart.HasValue || curEnd.HasValue
            || curDepartmentId.HasValue || !string.IsNullOrEmpty(curDepartmentName) || !string.IsNullOrEmpty(curCategoryName) || !string.IsNullOrEmpty(curRouteType);
        var pendingCount = (int)(ViewBag.PendingCount ?? 0);
        var completedCount = (int)(ViewBag.CompletedCount ?? 0);
        var canComplete = User.HasPermission("route.complete");
        var canUpdate = User.HasPermission("route.update") || User.HasPermission("route.update.direct");
        var canDelete = User.HasPermission("route.delete") || User.HasPermission("route.delete.direct");

        // Tab link: the current filters with another completion state, back to page 1.
        string TabUrl(bool? completed)
        {
            var query = Context.Request.Query
                .Where(q => !string.Equals(q.Key, "isCompleted", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(q.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
                .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)));
            if (completed.HasValue)
                query = query.Append(new KeyValuePair<string, string?>("isCompleted", completed.Value ? "true" : "false"));
            return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query).ToString();
        }
    }

    <div class="ip-page-head">
        <div>
            <h1>@L["Routes"]</h1>
            <div class="ip-sub ip-num" id="routesSummary">
                @if (curStart.HasValue || curEnd.HasValue)
                {
                    <span>@(curStart?.ToString("dd.MM.yyyy")) – @(curEnd?.ToString("dd.MM.yyyy")) · </span>
                }
                @L["{0} routes, {1} pending", pendingCount + completedCount, pendingCount]
            </div>
        </div>
        <div class="ip-page-actions">
            @if (User.HasPermission("route.export"))
            {
                <button type="button" class="ip-btn ip-btn-secondary" onclick="exportRoutesToPDF()">
                    <span>@L["Export PDF"]</span><i class="fa-solid fa-file-pdf"></i>
                </button>
            }
            @if (User.HasPermission("route.create") || User.HasPermission("route.create.direct"))
            {
                <a asp-action="Transfer" class="ip-btn ip-btn-primary">
                    <span>@L["New Transfer"]</span><i class="fa-solid fa-arrow-right-arrow-left"></i>
                </a>
            }
        </div>
    </div>

    <nav class="ip-tabs ink" aria-label="@L["Status"]" id="routesTabs" data-list-tabs>
        <a href="@TabUrl(null)" class="ip-tab @(curCompleted == null ? "active" : "")">@L["All"] <span class="count">@(pendingCount + completedCount)</span></a>
        <a href="@TabUrl(false)" class="ip-tab @(curCompleted == false ? "active" : "")">@L["Pending"] <span class="count warning">@pendingCount</span></a>
        <a href="@TabUrl(true)" class="ip-tab @(curCompleted == true ? "active" : "")">@L["Completed"] <span class="count">@completedCount</span></a>
    </nav>
    <select id="statusFilter" class="d-none" aria-hidden="true" tabindex="-1">
        <option value=""></option>
        <option value="false" selected="@(curCompleted == false)"></option>
        <option value="true" selected="@(curCompleted == true)"></option>
    </select>

    <div class="ip-filterbar ip-filterbar-soft">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" name="search" value="@currentSearch" autocomplete="off"
                   placeholder="@L["Search code, model, vendor, department..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Department"]</span>
            <select id="departmentFilter" onchange="onDepartmentChange()">
                <option value="">@L["All"]</option>
                @foreach (var d in filterDepartments)
                {
                    <option value="@d.Value" selected="@(d.Value == curDepartmentName)">@d.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Category"]</span>
            <select id="categoryFilter" onchange="onCategoryChange()">
                <option value="">@L["All"]</option>
                @foreach (var c in filterCategories)
                {
                    <option value="@c.Value" selected="@(c.Value == curCategoryName)">@c.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Type"]</span>
            <select id="typeFilter" onchange="applyRouteFilters()">
                <option value="">@L["All"]</option>
                @foreach (var (type, label) in new[] { ("New", "New"), ("Existing", "Existing"), ("Update", "Update"), ("CodeChange", "Code change"), ("Transfer", "Transfer"), ("Removal", "Removal") })
                {
                    <option value="@type" selected="@(type == curRouteType)">@L[label]</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <i class="fa-regular fa-calendar"></i>
            <input type="text" id="dateRange" class="date-range-input" placeholder="@L["Any date"]" size="12" aria-label="@L["Created between"]" />
        </label>
        @if (hasFilters)
        {
            <button type="button" class="ip-btn ip-btn-ghost" onclick="resetFilters()">
                <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
            </button>
        }
    </div>

    <div id="routesRegion" data-list-region>
        <div class="ip-table-wrap">
            @if (Model.Items.Any())
            {
                <table class="ip-table" id="routesTable">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["From"]</th>
                            <th></th>
                            <th>@L["To"]</th>
                            <th>@L["Type"]</th>
                            <th class="d-none">@L["Notes"]</th>
                            <th>@L["Status"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody id="routesTableBody">
                        @foreach (var route in Model.Items)
                        {
                            <tr data-href="@Url.Action("Details", new { id = route.Id })">
                                <td class="ip-num text-nowrap">
                                    @route.CreatedAt.ToString("dd.MM.yyyy")
                                    <div class="sub">@route.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="cell-item">
                                        <span class="ip-thumb">
                                            @if (!string.IsNullOrEmpty(route.ImageUrl))
                                            {
                                                <img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(route.FullImageUrl)" alt="" loading="lazy" />
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-box" aria-hidden="true"></i>
                                            }
                                        </span>
                                        <div class="cell-text">
                                            <a class="cell-title text-reset" href="@Url.Action("Details", new { id = route.Id })">@route.Model</a>
                                            <span class="cell-sub ip-mono">@route.InventoryCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title fw-normal">@(string.IsNullOrEmpty(route.FromDepartmentName) ? "—" : route.FromDepartmentName)</span>
                                        @if (!string.IsNullOrEmpty(route.FromWorker))
                                        {
                                            <span class="cell-sub">@route.FromWorker</span>
                                        }
                                    </div>
                                </td>
                                <td class="ip-muted" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title">@(string.IsNullOrEmpty(route.ToDepartmentName) ? "—" : route.ToDepartmentName)</span>
                                        @if (!string.IsNullOrEmpty(route.ToWorker))
                                        {
                                            <span class="cell-sub">@route.ToWorker</span>
                                        }
                                    </div>
                                </td>
                                <td class="ip-muted">@L[route.RouteTypeLabel]</td>
                                <td class="d-none">@route.Notes</td>
                                <td>
                                    @if (route.IsCompleted)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                                    }
                                </td>
                                <td data-no-row-link>
                                    <div class="actions align-items-center">
                                        @if (canComplete && !route.IsCompleted)
                                        {
                                            <button type="button" class="ip-btn ip-btn-secondary ip-btn-sm me-1" onclick="completeRoute(@route.Id)">@L["Complete"]</button>
                                        }
                                        @if (canUpdate && !route.IsCompleted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@route.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }
                                        @if (canDelete && !route.IsCompleted)
                                        {
                                            <button type="button" class="ip-btn-icon ip-btn-icon-danger" onclick="deleteRoute(@route.Id)" title="@L["Delete"]" aria-label="@L["Delete"]">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="ip-empty">
                    <span class="icon"><i class="fa-solid fa-route"></i></span>
                    <div class="title">@L["Nothing found"]</div>
                    <div class="text">@(hasFilters || curCompleted.HasValue ? L["No routes match these filters."] : L["No transfers yet."])</div>
                    @if (hasFilters)
                    {
                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                            <span>@L["Reset filters"]</span><i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            }
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>

    <form id="csrfForm" style="display: none;">
        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/list-filters.js" asp-append-version="true"></script>
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        const routeFilters = ListFilters.init({
            basePath: '/Routes',
            pageSize: @Model.PageSize,
            pairs: @Html.Raw(ViewBag.FilterPairsJson ?? "[]"),   // [["departmentName", "categoryName"], ...]
            // Routes store the category by name, so the category options carry names.
            categoryKey: 'name',
            // ...and the department by the name written on the route, too.
            departmentKey: 'name',
            fields: {
                isCompleted: '#statusFilter',
                departmentName: '#departmentFilter',
                categoryName: '#categoryFilter',
                routeType: '#typeFilter'
            }
        });

        // Names used by the markup's onclick/onchange handlers.
        function applyRouteFilters() { routeFilters.apply(); }
        function onDepartmentChange() { routeFilters.onDepartmentChange(); }
        function onCategoryChange() { routeFilters.onCategoryChange(); }
        function removeRouteFilter(key) { routeFilters.remove(key); }
        function resetFilters() { routeFilters.reset(); }

        function completeRoute(id) {
            confirmAction({
                title: t('Complete route'),
                message: t('Mark this route as completed?'),
                okText: t('Complete')
            }, function () {
                $.ajax({
                    url: '/Routes/Complete/' + id,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value
                    },
                    success: function() {
                        showToast(t('Route completed'), 'success');
                        ListNav.reload();
                    },
                    error: function(xhr) {
                        const errorMsg = ErrorHandler.parseErrorMessage(xhr, t('Failed to complete route'));
                        showToast(errorMsg, 'error');
                    }
                });
            });
        }
        function deleteRoute(id) {
            confirmAction({
                title: t('Delete route'),
                message: t('Delete this route? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;

                form.appendChild(tokenInput);
                document.body.appendChild(form);
                form.submit();
            });
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product', 'department', 'category'],
            regions: ['#routesSummary', '#routesTabs', '#routesRegion']
        });
    </script>
}