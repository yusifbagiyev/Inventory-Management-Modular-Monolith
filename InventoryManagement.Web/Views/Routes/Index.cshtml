@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<RouteViewModel>
@inject SharedServices.Contracts.IWhatsAppRouteNotifier WhatsAppNotifier
@{
    ViewData["Title"] = "Routes";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curDepartmentName = ViewBag.CurrentDepartmentName as string;

    // Headers can send several values where the bar sends one, so the query is read as lists
    string[] QueryValues(string key) => Context.Request.Query[key].Where(v => !string.IsNullOrEmpty(v)).Select(v => v!).ToArray();
    var curCategories = QueryValues("categoryName");
    var curRouteTypes = QueryValues("routeType");
    var routeTypes = new[] { ("New", "New"), ("Existing", "Existing"), ("Update", "Update"), ("CodeChange", "Code change"), ("Transfer", "Transfer"), ("Removal", "Removal") };

    // Department and category choices are the names stored on routes, plus any chosen one the lists no longer hold
    string NameOptions(IEnumerable<string?> names, string[] chosen) => Json.Serialize(names
        .Concat(chosen).Where(n => !string.IsNullOrEmpty(n)).Distinct()
        .Select(n => new { value = n, label = n })).ToString() ?? "[]";
    var fromOptions = NameOptions(filterDepartments.Select(d => d.Value), QueryValues("fromDepartment"));
    var toOptions = NameOptions(filterDepartments.Select(d => d.Value), QueryValues("toDepartment"));
    var categoryOptions = NameOptions(filterCategories.Select(c => c.Value), curCategories);
    var typeOptions = Json.Serialize(routeTypes.Select(t => new { value = t.Item1, label = L[t.Item2].Value })).ToString();
    var statusOptions = Json.Serialize(new[] { new { value = "false", label = L["Pending"].Value }, new { value = "true", label = L["Completed"].Value } }).ToString();
    var curWhatsApp = QueryValues("whatsApp");
    var whatsAppStatuses = new[] { ("Sent", "Sent"), ("Queued", "Queued"), ("Failed", "Failed"), ("Deleted", "Deleted"), ("None", "None") };
    var whatsAppOptions = Json.Serialize(whatsAppStatuses.Select(s => new { value = s.Item1, label = L[s.Item2].Value })).ToString();
}
<div class="container-fluid px-4">
    @{
        var curCompleted = ViewBag.CurrentFilter as bool?;
        var curStart = ViewBag.StartDate as DateTime?;
        var curEnd = ViewBag.EndDate as DateTime?;
        // The completion tabs and the sort are not filters, so they neither show the found count nor need clearing
        var hasFilters = new[] { "search", "startDate", "endDate", "departmentId", "departmentName", "categoryName", "routeType", "product", "fromDepartment", "toDepartment", "whatsApp" }
            .Any(k => QueryValues(k).Length > 0);
        var hasSort = QueryValues("sort").Length > 0;
        var pendingCount = (int)(ViewBag.PendingCount ?? 0);
        var completedCount = (int)(ViewBag.CompletedCount ?? 0);
        var canComplete = User.HasPermission("route.complete");
        var canUpdate = User.HasPermission("route.update") || User.HasPermission("route.update.direct");
        var canDelete = User.HasPermission("route.delete") || User.HasPermission("route.delete.direct");

        // Keeps the other filters, swaps the completion state and goes back to page 1
        string TabUrl(bool? completed)
        {
            var query = Context.Request.Query
                .Where(q => !string.Equals(q.Key, "isCompleted", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(q.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
                .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)));
            if (completed.HasValue)
                query = query.Append(new KeyValuePair<string, string?>("isCompleted", completed.Value ? "true" : "false"));
            return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query).ToString();
        }
    }

    <div class="ip-page-head ip-list-head">
        <div>
            <h1>@L["Routes"]</h1>
            <div class="ip-sub ip-num" id="routesSummary">
                @if (hasFilters)
                {
                    <strong class="ip-found">@L["{0} found", Model.TotalCount]</strong><span> · </span>
                }
                @if (curStart.HasValue || curEnd.HasValue)
                {
                    <span>@(curStart?.ToString("dd.MM.yyyy")) – @(curEnd?.ToString("dd.MM.yyyy")) · </span>
                }
                @L["{0} routes, {1} pending", pendingCount + completedCount, pendingCount]
            </div>
        </div>
        <div class="ip-page-actions">
            @if (User.HasPermission("route.export"))
            {
                <button type="button" class="ip-btn ip-btn-secondary" onclick="exportRoutesToPDF()" title="@L["Export PDF"]" aria-label="@L["Export PDF"]">
                    <span>@L["Export PDF"]</span><i class="fa-solid fa-file-pdf"></i>
                </button>
            }
            @if (User.HasPermission("route.create") || User.HasPermission("route.create.direct"))
            {
                <a asp-action="Transfer" class="ip-btn ip-btn-primary">
                    <span>@L["New Transfer"]</span><i class="fa-solid fa-arrow-right-arrow-left"></i>
                </a>
            }
        </div>
    </div>

    <nav class="ip-tabs ink" aria-label="@L["Status"]" id="routesTabs" data-list-tabs>
        <a href="@TabUrl(null)" class="ip-tab @(curCompleted == null ? "active" : "")">@L["All"] <span class="count">@(pendingCount + completedCount)</span></a>
        <a href="@TabUrl(false)" class="ip-tab @(curCompleted == false ? "active" : "")">@L["Pending"] <span class="count warning">@pendingCount</span></a>
        <a href="@TabUrl(true)" class="ip-tab @(curCompleted == true ? "active" : "")">@L["Completed"] <span class="count">@completedCount</span></a>
    </nav>
    @* Hidden so ListFilters keeps the tab's completion state like any other filter *@
    <select id="statusFilter" class="d-none" aria-hidden="true" tabindex="-1">
        <option value=""></option>
        <option value="false" selected="@(curCompleted == false)"></option>
        <option value="true" selected="@(curCompleted == true)"></option>
    </select>

    <div class="ip-filterbar ip-filterbar-soft">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" name="search" value="@currentSearch" autocomplete="off"
                   placeholder="@L["Search code, model, vendor, department..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Department"]</span>
            <select id="departmentFilter" onchange="onDepartmentChange()">
                <option value="">@L["All"]</option>
                @foreach (var d in filterDepartments)
                {
                    <option value="@d.Value" selected="@(d.Value == curDepartmentName)">@d.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Category"]</span>
            <select id="categoryFilter" onchange="onCategoryChange()">
                <option value="">@L["All"]</option>
                @foreach (var c in filterCategories)
                {
                    <option value="@c.Value" selected="@(curCategories.Length == 1 && c.Value == curCategories[0])">@c.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Type"]</span>
            <select id="typeFilter" onchange="applyRouteFilters()">
                <option value="">@L["All"]</option>
                @foreach (var (type, label) in routeTypes)
                {
                    <option value="@type" selected="@(curRouteTypes.Length == 1 && type == curRouteTypes[0])">@L[label]</option>
                }
            </select>
        </label>
        @* The WhatsApp column only fits wide lists, so its filter also lives here *@
        <label class="ip-filter">
            <span>@L["WhatsApp"]</span>
            <select id="whatsAppFilter" onchange="applyRouteFilters()">
                <option value="">@L["All"]</option>
                @foreach (var (status, label) in whatsAppStatuses)
                {
                    <option value="@status" selected="@(curWhatsApp.Length == 1 && status == curWhatsApp[0])">@L[label]</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <i class="fa-regular fa-calendar"></i>
            <input type="text" id="dateRange" class="date-range-input" placeholder="@L["Any date"]" size="12" aria-label="@L["Created between"]" />
        </label>
        @if (hasFilters || hasSort)
        {
            <button type="button" class="ip-btn ip-btn-ghost" onclick="resetFilters()">
                <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
            </button>
        }
    </div>

    <div id="routesRegion" data-list-region>
        <div class="ip-table-wrap">
            <table class="ip-table" id="routesTable">
                <thead>
                    <tr>
                        <th data-sort="date" data-sort-first="desc" data-filter="date" data-param-from="startDate" data-param-to="endDate">@L["Date"]</th>
                        <th data-sort="product" data-filter="text" data-param="product">@L["Product"]</th>
                        <th data-sort="from" data-filter="list" data-param="fromDepartment" data-options="@fromOptions">@L["From"]</th>
                        <th></th>
                        <th data-sort="to" data-filter="list" data-param="toDepartment" data-options="@toOptions">@L["To"]</th>
                        <th class="route-category" data-sort="category" data-filter="list" data-param="categoryName" data-options="@categoryOptions">@L["Category"]</th>
                        <th data-sort="type" data-filter="list" data-param="routeType" data-options="@typeOptions">@L["Type"]</th>
                        <th class="d-none">@L["Notes"]</th>
                        <th data-sort="status" data-filter="list" data-param="isCompleted" data-multi="false" data-options="@statusOptions">@L["Status"]</th>
                        <th class="route-whatsapp" data-sort="whatsapp" data-filter="list" data-param="whatsApp" data-options="@whatsAppOptions">@L["WhatsApp"]</th>
                        <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody id="routesTableBody">
                    @foreach (var route in Model.Items)
                    {
                        <tr data-href="@Url.Action("Details", new { id = route.Id })">
                            <td class="date ip-num text-nowrap">
                                @route.CreatedAt.ToString("dd.MM.yyyy")
                                <div class="sub">@route.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td class="title">
                                <div class="cell-item">
                                    <span class="ip-thumb">
                                        @if (!string.IsNullOrEmpty(route.ImageUrl))
                                        {
                                            <img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(route.FullImageUrl)" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-box" aria-hidden="true"></i>
                                        }
                                    </span>
                                    <div class="cell-text">
                                        <a class="cell-title text-reset" href="@Url.Action("Details", new { id = route.Id })" title="@route.Model">@route.Model</a>
                                        <span class="cell-sub ip-mono">@route.InventoryCode</span>
                                    </div>
                                </div>
                            </td>
                            <td class="meta route-from @(string.IsNullOrEmpty(route.FromDepartmentName) ? "is-empty" : "")">
                                <div class="cell-text">
                                    <span class="cell-title fw-normal" title="@route.FromDepartmentName">@(string.IsNullOrEmpty(route.FromDepartmentName) ? "—" : route.FromDepartmentName)</span>
                                    @if (!string.IsNullOrEmpty(route.FromWorker))
                                    {
                                        <span class="cell-sub" title="@route.FromWorker">@route.FromWorker</span>
                                    }
                                </div>
                            </td>
                            <td class="hide-sm ip-muted" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></td>
                            <td class="meta route-to">
                                <div class="cell-text">
                                    <span class="cell-title" title="@route.ToDepartmentName">@(string.IsNullOrEmpty(route.ToDepartmentName) ? "—" : route.ToDepartmentName)</span>
                                    @if (!string.IsNullOrEmpty(route.ToWorker))
                                    {
                                        <span class="cell-sub" title="@route.ToWorker">@route.ToWorker</span>
                                    }
                                </div>
                            </td>
                            <td class="hide-sm route-category ip-muted">@route.CategoryName</td>
                            <td class="meta ip-muted">@L[route.RouteTypeLabel]</td>
                            <td class="d-none">@route.Notes</td>
                            <td class="state">
                                @if (route.IsCompleted)
                                {
                                    <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                                }
                                else
                                {
                                    <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                                }
                                @* Shown here only while the WhatsApp column does not fit, as on phone cards *@
                                @if (!string.IsNullOrEmpty(route.WhatsAppStatus))
                                {
                                    <div class="mt-1 route-wa-inline" data-no-row-link><partial name="_WhatsAppStatus" model="route" /></div>
                                }
                            </td>
                            <td class="hide-sm route-whatsapp">
                                @if (route.WhatsAppStatus == "Failed")
                                {
                                    <div class="d-flex align-items-center gap-1" data-no-row-link>
                                        <span class="ip-wa ip-wa-failed" title="@route.WhatsAppError"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["Failed"]</span></span>
                                        @if (canComplete)
                                        {
                                            <button type="button" class="ip-btn-icon pdf-omit" data-wa-resend="@route.Id" title="@L["Send again"]" aria-label="@L["Send again"]">
                                                <i class="fa-solid fa-rotate-right"></i>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (route.WhatsAppStatus == "Queued")
                                {
                                    <span class="ip-wa ip-wa-queued"><i class="fa-regular fa-clock" aria-hidden="true"></i><span>@L["Queued"]</span></span>
                                }
                                else if (route.WhatsAppStatus == "Sent")
                                {
                                    <div class="d-flex align-items-center gap-1" data-no-row-link>
                                        <span class="ip-wa"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["Sent"]</span></span>
                                        @if (canComplete && route.CanDeleteWhatsApp(WhatsAppNotifier.DeleteWindow))
                                        {
                                            <button type="button" class="ip-btn-icon pdf-omit" data-wa-delete="@route.Id" title="@L["Delete message"]" aria-label="@L["Delete message"]">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (route.WhatsAppStatus == "Deleted")
                                {
                                    <span class="ip-wa ip-wa-queued"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["Deleted"]</span></span>
                                }
                                else
                                {
                                    <span class="ip-faint pdf-omit">—</span>
                                }
                            </td>
                            <td class="actions" data-no-row-link>
                                <div class="actions align-items-center">
                                    @if (canComplete && !route.IsCompleted)
                                    {
                                        <button type="button" class="ip-btn ip-btn-secondary ip-btn-sm me-1" data-summary="@route.Summary" onclick="completeRoute(@route.Id, this.dataset.summary)"
                                                aria-label="@L["Complete"] @route.InventoryCode">@L["Complete"]</button>
                                    }
                                    @if (canUpdate && !route.IsCompleted)
                                    {
                                        <a asp-action="Edit" asp-route-id="@route.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"] @route.InventoryCode">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    @if (canDelete && !route.IsCompleted)
                                    {
                                        <button type="button" class="ip-btn-icon ip-btn-icon-danger" data-summary="@route.Summary" onclick="deleteRoute(@route.Id, this.dataset.summary)"
                                                title="@L["Delete"]" aria-label="@L["Delete"] @route.InventoryCode">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @* The headers stay when nothing matches, so their filters can be changed *@
                    @if (!Model.Items.Any())
                    {
                        <tr class="ip-empty-row">
                            <td class="empty" colspan="11">
                                <div class="ip-empty pdf-omit">
                                    <span class="icon"><i class="fa-solid fa-route"></i></span>
                                    <div class="title">@L["Nothing found"]</div>
                                    <div class="text">@(hasFilters || curCompleted.HasValue ? L["No routes match these filters."] : L["No transfers yet."])</div>
                                    @if (hasFilters || curCompleted.HasValue)
                                    {
                                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                                            <span>@L["Clear filters"]</span><i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>

    <form id="csrfForm" style="display: none;">
        @Html.AntiForgeryToken()
    </form>
</div>

@section Styles {
    <style>
        /* The list's own width decides which optional columns fit, so a collapsed menu or a wide screen shows more */
        #routesRegion .ip-table-wrap { container: routes / inline-size; }
        @@container routes (max-width: 1279.98px) { #routesTable .route-category { display: none; } }
        @@container routes (max-width: 1139.98px) { #routesTable .route-whatsapp { display: none; } }
        @@container routes (min-width: 1140px) { #routesTable .route-wa-inline { display: none; } }
        @@media (max-width: 767.98px) {
            /* On cards the date sits beside the title, so the WhatsApp line and its Send again button get the whole width */
            #routesTable td.date { top: var(--ip-space-3); bottom: auto; }
            #routesTable td.title { padding-right: 104px; }
            #routesTable .route-wa-inline { flex-basis: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: var(--ip-space-2); margin-top: 0 !important; }
            /* A route with no source shows only its destination, with the arrow in front */
            #routesTable td.route-from.is-empty { display: none; }
            #routesTable tr:has(> td.route-from.is-empty) > td.route-to::before { content: "\2192\00a0"; }
        }
    </style>
}

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/list-filters.js" asp-append-version="true"></script>
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        const routeFilters = ListFilters.init({
            basePath: '/Routes',
            pageSize: @Model.PageSize,
            pairs: @Html.Raw(ViewBag.FilterPairsJson ?? "[]"),   // Pairs of department and category names
            // Routes keep department and category names from the time of the transfer, so filter by name
            categoryKey: 'name',
            departmentKey: 'name',
            fields: {
                isCompleted: '#statusFilter',
                departmentName: '#departmentFilter',
                categoryName: '#categoryFilter',
                routeType: '#typeFilter',
                whatsApp: '#whatsAppFilter'
            },
            sheet: true
        });

        // Names used by the markup's onclick and onchange handlers
        function applyRouteFilters() { routeFilters.apply(); }
        function onDepartmentChange() { routeFilters.onDepartmentChange(); }
        function onCategoryChange() { routeFilters.onCategoryChange(); }
        function resetFilters() { routeFilters.reset(); }

        // The dialog covers the rows, so it names the route it acts on
        function completeRoute(id, summary) {
            confirmAction({
                title: t('Complete route'),
                detail: summary,
                message: t('The product moves to the destination above and the route can no longer be changed. Complete it?'),
                okText: t('Complete')
            }, function () {
                $.ajax({
                    url: '/Routes/Complete/' + id,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value
                    },
                    success: function() {
                        showToast(t('Route completed'), 'success');
                        ListNav.reload();
                    },
                    error: function(xhr) {
                        const errorMsg = ErrorHandler.parseErrorMessage(xhr, t('Failed to complete route'));
                        showToast(errorMsg, 'error');
                    }
                });
            });
        }
        function deleteRoute(id, summary) {
            confirmAction({
                title: t('Delete route'),
                detail: summary,
                message: t('Delete this route? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;

                form.appendChild(tokenInput);
                document.body.appendChild(form);
                form.submit();
            });
        }

        // Other users' changes refresh the count and the table in place
        LiveUpdates.watch({
            entities: ['route', 'product', 'department', 'category'],
            regions: ['#routesSummary', '#routesTabs', '#routesRegion']
        });
    </script>
}