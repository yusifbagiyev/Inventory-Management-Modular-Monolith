@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<RouteViewModel>
@{
    ViewData["Title"] = "Routes";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curDepartmentId = ViewBag.CurrentDepartmentId as int?;
    var curCategoryName = ViewBag.CurrentCategoryName as string;

    string DepartmentName(int? id) => filterDepartments.FirstOrDefault(d => d.Value == id.ToString())?.Text ?? id?.ToString() ?? "";
}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Routes</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Routes</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportRoutesToPDF()">
                <i class="fas fa-file-pdf"></i> Export PDF
            </button>
            @if (User.HasPermission("route.create") || User.HasPermission("route.create.direct"))
            {
                <a asp-action="Transfer" class="btn btn-primary btn-sm">
                    <i class="fas fa-exchange-alt"></i> New Transfer
                </a>
            }
        </div>
    </div>

    @{
        var curCompleted = ViewBag.CurrentFilter as bool?;
        var curStart = ViewBag.StartDate as DateTime?;
        var curEnd = ViewBag.EndDate as DateTime?;
        var curRouteType = ViewBag.CurrentRouteType as string;
        var hasFilters = !string.IsNullOrEmpty(currentSearch) || curCompleted.HasValue || curStart.HasValue || curEnd.HasValue
            || curDepartmentId.HasValue || !string.IsNullOrEmpty(curCategoryName) || !string.IsNullOrEmpty(curRouteType);
    }

    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" name="search" value="@currentSearch"
                           placeholder="Search code, model, vendor, department..." />
                </div>
            </div>
            <button class="btn btn-primary btn-sm" onclick="applyRouteFilters()">
                <i class="fas fa-filter"></i> Apply
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                <i class="fas fa-redo"></i> Reset
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="departmentFilter">Department</label>
                <select id="departmentFilter" class="form-select form-select-sm" onchange="onDepartmentChange()">
                    <option value="">All departments</option>
                    @foreach (var d in filterDepartments)
                    {
                        <option value="@d.Value" selected="@(d.Value == curDepartmentId?.ToString())">@d.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="categoryFilter">Category</label>
                <select id="categoryFilter" class="form-select form-select-sm" onchange="onCategoryChange()">
                    <option value="">All categories</option>
                    @foreach (var c in filterCategories)
                    {
                        <option value="@c.Value" selected="@(c.Value == curCategoryName)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="statusFilter">Status</label>
                @* the previous markup wrote the Razor variables as bare attributes, so the
                   current selection never rendered - bound properly here *@
                <select id="statusFilter" class="form-select form-select-sm" onchange="applyRouteFilters()">
                    <option value="">All</option>
                    <option value="false" selected="@(curCompleted == false)">Pending</option>
                    <option value="true" selected="@(curCompleted == true)">Completed</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="typeFilter">Route type</label>
                @* Server-side now: a fixed enum list (New/Existing/Update/Transfer/Removal) so past
                   types on other pages are selectable, the count reflects it, and it survives other
                   filter changes. Was client-side, narrowing only the current page's rows. *@
                <select id="typeFilter" class="form-select form-select-sm" onchange="applyRouteFilters()">
                    <option value="">All types</option>
                    @foreach (var t in new[] { "New", "Existing", "Update", "Transfer", "Removal" })
                    {
                        <option value="@t" selected="@(t == curRouteType)">@t</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="dateRange">Created between</label>
                <input type="text" id="dateRange" class="form-control form-control-sm" placeholder="Any date" />
            </div>
            <div class="filter-field">
                <label for="pageSizeFilter">Rows per page</label>
                <select id="pageSizeFilter" class="form-select form-select-sm" onchange="applyRouteFilters()">
                    @foreach (var size in new[] { 15, 30, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="filter-quick">
            <span class="qlabel">Quick</span>
            <a asp-action="Index" class="qchip @(curCompleted == null ? "active" : "")">All</a>
            <a asp-action="Index" asp-route-isCompleted="false" class="qchip @(curCompleted == false ? "active" : "")">Pending</a>
            <a asp-action="Index" asp-route-isCompleted="true" class="qchip @(curCompleted == true ? "active" : "")">Completed</a>
        </div>

        @if (hasFilters)
        {
            <div class="filter-applied">
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    @* One chip per search word - each word is matched independently, and its ×
                       removes just that word. data-word is Razor-encoded so a quote in the term
                       cannot break out. *@
                    foreach (var word in currentSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="achip">Search: <b>@word</b><button type="button" class="achip-x achip-word" data-word="@word">&times;</button></span>
                    }
                }
                @if (curDepartmentId.HasValue)
                {
                    <span class="achip">Department: <b>@DepartmentName(curDepartmentId)</b><button type="button" class="achip-x" onclick="removeRouteFilter('departmentId')">&times;</button></span>
                }
                @if (!string.IsNullOrEmpty(curCategoryName))
                {
                    <span class="achip">Category: <b>@curCategoryName</b><button type="button" class="achip-x" onclick="removeRouteFilter('categoryName')">&times;</button></span>
                }
                @if (!string.IsNullOrEmpty(curRouteType))
                {
                    <span class="achip">Type: <b>@curRouteType</b><button type="button" class="achip-x" onclick="removeRouteFilter('routeType')">&times;</button></span>
                }
                @if (curCompleted.HasValue)
                {
                    <span class="achip">Status: <b>@(curCompleted.Value ? "Completed" : "Pending")</b><button type="button" class="achip-x" onclick="removeRouteFilter('isCompleted')">&times;</button></span>
                }
                @if (curStart.HasValue || curEnd.HasValue)
                {
                    <span class="achip">Created: <b>@(curStart?.ToString("dd.MM.yyyy")) - @(curEnd?.ToString("dd.MM.yyyy"))</b><button type="button" class="achip-x" onclick="removeRouteFilter('dates')">&times;</button></span>
                }
                <button type="button" class="filter-clear" onclick="resetFilters()">Clear all</button>
            </div>
        }
    </div>

    <div class="result-bar" id="routesSummary">
        <span><b>@Model.TotalCount</b> route@(Model.TotalCount == 1 ? "" : "s")@(hasFilters ? " matched" : "")</span>
        <span class="text-muted">Page @Model.PageNumber</span>
    </div>

    <div class="card mb-4" id="routesRegion">
        <div class="card-body p-0">
                @if (Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="routesTable">
                            <thead>
                                <tr>
                                    <th style="width: 78px;">Code</th>
                                    <th>Product</th>
                                    <th style="width: 96px;">Type</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Description</th>
                                    <th style="width: 118px;">Status</th>
                                    <th style="width: 92px;">Created</th>
                                    <th class="actions-column" style="width: 104px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="routesTableBody">
                                @foreach (var route in Model.Items)
                                {
                                    <tr data-search="@($"{route.InventoryCode} {route.Model} {route.Vendor} {route.FromDepartmentName} {route.ToDepartmentName}".ToLower())">
                                        <td class="mono">
                                            @if (route.RouteTypeName != "Removal")
                                            {
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@route.ProductId"
                                                   class="text-decoration-none mono">@route.InventoryCode</a>
                                            }
                                            else
                                            {
                                                @route.InventoryCode
                                            }
                                        </td>
                                        <td>
                                            <div class="cell-item">
                                                @if (!string.IsNullOrEmpty(route.ImageUrl))
                                                {
                                                    <img src="@route.FullImageUrl" class="cell-thumb" style="cursor: pointer;"
                                                         data-src="@route.FullImageUrl" onclick="showImageModal(this.dataset.src, 'Route @route.Id')"
                                                         alt="Route image">
                                                }
                                                else
                                                {
                                                    <div class="cell-thumb cell-thumb-empty"><i class="fas fa-image"></i></div>
                                                }
                                                <div class="cell-text">
                                                    <span class="cell-title" title="@route.Notes">@route.Model</span>
                                                    <span class="cell-sub">@route.Vendor@(string.IsNullOrEmpty(route.CategoryName) ? "" : " · " + route.CategoryName)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var typeClass = route.RouteTypeName switch
                                                {
                                                    "New" => "state-ok",
                                                    "Removal" => "state-crit",
                                                    "Update" => "state-warn",
                                                    "Transfer" => "state-info",
                                                    _ => "state-idle"
                                                };
                                            }
                                            <span class="state state-flat @typeClass">@route.RouteTypeName</span>
                                        </td>
                                        <td>
                                            <div class="cell-text">
                                                <span class="cell-title">@(string.IsNullOrEmpty(route.FromDepartmentName) ? "-" : route.FromDepartmentName)</span>
                                                @if (!string.IsNullOrEmpty(route.FromWorker))
                                                {
                                                    <span class="cell-sub">@route.FromWorker</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="cell-text">
                                                <span class="cell-title">@(string.IsNullOrEmpty(route.ToDepartmentName) ? "-" : route.ToDepartmentName)</span>
                                                @if (!string.IsNullOrEmpty(route.ToWorker))
                                                {
                                                    <span class="cell-sub">@route.ToWorker</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="desc-cell">
                                            @if (!string.IsNullOrEmpty(route.Notes))
                                            {
                                                <span class="desc-text" title="@route.Notes">@route.Notes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted pdf-omit">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (route.IsCompleted)
                                            {
                                                <div class="cell-text">
                                                    <span class="state state-ok">Completed</span>
                                                    @if (route.CompletedAt.HasValue)
                                                    {
                                                        <span class="cell-sub mono">@route.CompletedAt.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="state state-warn">Pending</span>
                                            }
                                        </td>
                                        <td class="mono text-muted">@route.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td class="actions-column">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@route.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if ((User.HasPermission("route.update") || User.HasPermission("route.update.direct")) && !route.IsCompleted)
                                                {
                                                    <a asp-action="Edit" asp-route-id="@route.Id"
                                                       class="btn btn-sm btn-outline-secondary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }

                                                @if ((User.HasPermission("route.complete") && !route.IsCompleted))
                                                {
                                                    <button type="button" class="btn btn-sm btn-success"
                                                            onclick="completeRoute(@route.Id)" title="Complete">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                }

                                                @if (User.HasPermission("route.delete") && !route.IsCompleted)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="deleteRoute(@route.Id)" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-route fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No routes found</p>
                        <a asp-action="Transfer" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Create First Route
                        </a>
                    </div>
                }
            </div>
            <div class="card-footer">
                <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
            </div>

        </div>

    <!-- Hidden form for CSRF token -->
    <form id="csrfForm" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/list-filters.js" asp-append-version="true"></script>
    <script>
        const routeFilters = ListFilters.init({
            basePath: '/Routes',
            pageSize: @Model.PageSize,
            pairs: @Html.Raw(ViewBag.FilterPairsJson ?? "[]"),   // [[departmentId, "categoryName"], ...]
            // Routes store the category by name, so the category options carry names.
            categoryKey: 'name',
            fields: {
                isCompleted: '#statusFilter',
                departmentId: '#departmentFilter',
                categoryName: '#categoryFilter',
                routeType: '#typeFilter'
            }
        });

        // Names used by the markup's onclick/onchange handlers.
        function applyRouteFilters() { routeFilters.apply(); }
        function onDepartmentChange() { routeFilters.onDepartmentChange(); }
        function onCategoryChange() { routeFilters.onCategoryChange(); }
        function removeRouteFilter(key) { routeFilters.remove(key); }
        function resetFilters() { routeFilters.reset(); }

        function completeRoute(id) {
            confirmAction({
                title: 'Complete route',
                message: 'Mark this route as completed?',
                okText: 'Complete'
            }, function () {
                $.ajax({
                    url: '/Routes/Complete/' + id,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value
                    },
                    success: function(response) {
                        // Reload after a short delay
                        setTimeout(function() {
                            window.location.reload();
                        }, 1500);
                    },
                    error: function(xhr) {
                        const errorMsg = ErrorHandler.parseErrorMessage(xhr, 'Failed to complete route');
                        showToast(errorMsg, 'error');
                    }
                });
            });
        }
        function deleteRoute(id) {
            confirmAction({
                title: 'Delete route',
                message: 'Delete this route? This cannot be undone.',
                okText: 'Delete',
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;

                form.appendChild(tokenInput);
                document.body.appendChild(form);
                form.submit();
            });
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product', 'department', 'category'],
            regions: ['#routesSummary', '#routesRegion']
        });
    </script>
    <style>
        .gmail-pagination {
            font-size: 0.875rem;
        }

        .pagination-controls .btn {
            padding: 0.25rem 0.5rem;
            margin: 0 0.125rem;
        }
        #routesTable{
            font-weight:normal;
        }
    
        #routesTable tbody tr {
            font-weight: normal; /* Ensure body rows are normal weight */
        }
    
        /* Additional styles matching products view */
        #routesTable tbody td {
            vertical-align: middle;
            font-weight: 400;
        }
    </style>
}