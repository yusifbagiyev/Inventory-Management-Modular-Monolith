@model TransferViewModel
@{
    ViewData["Title"] = "Transfer";
    var direct = User.HasPermission("route.create.direct");
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Transfer"]</h1>
        </div>
    </div>

    <form asp-action="Transfer" method="post" enctype="multipart/form-data" id="transferForm" class="ip-form" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        <input type="hidden" asp-for="ProductId" id="ProductId" />

        @* Step 1 (design: 06 Transfer): the code, then the found product or an inline error. *@
        <section class="ip-form-section">
            <h2>@L["Product"]</h2>
            <label class="ip-label mb-2" for="inventoryCodeInput">@L["Inventory Code"]</label>
            <div class="d-flex gap-2 flex-wrap align-items-start">
                <input type="number" id="inventoryCodeInput" class="ip-input ip-input-lg mono ip-code-input"
                       min="1" max="9999" autocomplete="off" autofocus inputmode="numeric"
                       placeholder="1042" aria-describedby="searchFeedback" />
                <button type="button" id="searchBtn" class="ip-btn ip-btn-secondary ip-btn-lg">
                    <i class="fa-solid fa-magnifying-glass"></i><span>@L["Search"]</span>
                </button>
            </div>
            <div id="searchFeedback" class="mt-2" role="status" aria-live="polite"></div>

            <div id="productInfoContainer" class="ip-found ip-found-row mt-3" style="display:none;">
                <span class="ip-found-thumb" id="productThumb"><i class="fa-solid fa-box"></i></span>
                <div class="flex-grow-1" style="min-width: 0">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold" id="productModel"></span>
                        <span class="ip-mono ip-muted" id="productCode"></span>
                        <span id="workingStatus"></span>
                    </div>
                    <div class="ip-faint" id="productMeta"></div>
                </div>
                <div class="ip-found-where">
                    <div class="ip-faint">@L["Currently"]</div>
                    <div class="fw-semibold" id="currentDepartment"></div>
                    <div class="ip-faint" id="currentWorker"></div>
                </div>
            </div>
            <div id="warningContainer"></div>
        </section>

        @* Step 2: only once a product without a pending transfer is found. *@
        <div id="transferFields" style="display:none;">
            <section class="ip-form-section">
                <h2>@L["Where to"]</h2>
                <div class="ip-form-grid">
                    <div class="ip-field">
                        <label asp-for="ToDepartmentId" class="ip-label"><span>@L["To Department"]</span> <span class="req">*</span></label>
                        <select asp-for="ToDepartmentId" asp-items="Model.Departments" class="ip-select">
                            <option value="">@L["-- Select Department --"]</option>
                        </select>
                        <span class="ip-error d-none" id="departmentError"></span>
                        <span asp-validation-for="ToDepartmentId" class="ip-error"></span>
                    </div>
                    <div class="ip-field">
                        <label asp-for="ToWorker" class="ip-label">@L["New worker"]</label>
                        <input asp-for="ToWorker" class="ip-input" placeholder="@L["Enter worker name (optional)"]" />
                        <span asp-validation-for="ToWorker" class="ip-error"></span>
                    </div>
                </div>

                <div class="ip-field mt-4">
                    <label asp-for="Notes" class="ip-label">@L["Notes"]</label>
                    <textarea asp-for="Notes" class="ip-textarea" rows="3" placeholder="@L["Reason for the transfer, condition of the device"]"></textarea>
                    <span asp-validation-for="Notes" class="ip-error"></span>
                </div>

                <div class="mt-4">
                    <partial name="_ImageManager" model='new ImageManagerModel { Label = "Handover photos (optional)", Hint = "When the transfer is completed they become the product images; the starred one becomes the cover." }' />
                </div>
            </section>

            <div class="ip-form-foot">
                <span class="note ip-transfer-summary" id="transferSummary"></span>
                <a asp-action="Index" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
                <button type="submit" class="ip-btn ip-btn-primary" id="submitBtn">
                    <span>@L["Start transfer"]</span>
                </button>
            </div>
            @if (!direct)
            {
                <p class="ip-hint mt-2"><i class="fa-solid fa-circle-info me-1"></i>@L["Your changes are applied after they are approved."]</p>
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            let currentProductData = null;
            let searchTimeout = null;
            let lastSearchedCode = '';
            let isSubmitting = false;

            const $submitBtn = $('#submitBtn');
            const originalButtonHtml = $submitBtn.html();

            AjaxHandler.handleForm('#transferForm', {
                validateBeforeSubmit: true,
                successMessage: t('Product transferred successfully!'),
                successRedirect: '/Routes',
                redirectDelay: 1500,
                onBeforeSubmit: function() {
                    if (isSubmitting) return false;

                    if (!currentProductData || !$('#ProductId').val()) {
                        showError(t('Please search for and select a valid product first'));
                        $('#inventoryCodeInput').focus();
                        return false;
                    }
                    if (!$('#ToDepartmentId').val()) {
                        showDepartmentError(t('Please select a destination department'));
                        $('#ToDepartmentId').focus();
                        return false;
                    }
                    if (sameAsNow()) {
                        showDepartmentError(t('The product is already in this department. To change only the worker, edit the product.'));
                        $('#ToDepartmentId').focus();
                        return false;
                    }
                    isSubmitting = true;
                    return true;
                },
                onSuccess: function(response) {
                    if (response.isApprovalRequest || response.approvalRequestId) {
                        showToast(response.message || t('Transfer request submitted for approval'), 'info');
                        setTimeout(() => window.location.href = '/Routes', 2000);
                        return false;
                    }
                    return true;
                },
                onError: function(errorMessage) {
                    isSubmitting = false;
                    $submitBtn.prop('disabled', false).html(originalButtonHtml);
                    console.error('Transfer error:', errorMessage);
                }
            });

            $('#inventoryCodeInput').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    searchProduct();
                }
            });

            // Search a moment after typing stops.
            $('#inventoryCodeInput').on('input', function() {
                const inventoryCode = $(this).val().trim();
                clearTimeout(searchTimeout);
                if (!inventoryCode) { resetForm(); return; }

                const codeNum = parseInt(inventoryCode);
                if (isNaN(codeNum) || codeNum < 1 || codeNum > 9999) {
                    showError(t('Inventory code must be between 1 and 9999'));
                    return;
                }
                searchTimeout = setTimeout(searchProduct, 600);
            });

            $('#searchBtn').on('click', searchProduct);
            $('#ToDepartmentId, #ToWorker').on('change input', function() {
                hideDepartmentError();
                if (sameAsNow()) showDepartmentError(t('The product is already in this department. To change only the worker, edit the product.'));
                updateSummary();
            });

            // A transfer moves the product to another department (design: 06 Transfer); a new
            // worker within the same department is a product edit.
            function sameAsNow() {
                return !!currentProductData
                    && $('#ToDepartmentId').val() === String(currentProductData.departmentId ?? '');
            }

            async function searchProduct() {
                const inventoryCode = $('#inventoryCodeInput').val().trim();
                if (!inventoryCode) { showError(t('Please enter an inventory code')); return; }
                if (inventoryCode === lastSearchedCode && currentProductData) return;

                showSearching();
                hideError();
                hideWarning();

                try {
                    const response = await $.ajax({
                        url: AppConfig.buildApiUrl(`products/search/inventory-code/${inventoryCode}`),
                        type: 'GET'
                    });
                    if (!response || !response.id) throw new Error('Product not found');

                    lastSearchedCode = inventoryCode;
                    currentProductData = response;
                    displayProductInfo(response);
                    await checkPendingRoutes(response.id);
                } catch (error) {
                    currentProductData = null;
                    lastSearchedCode = '';
                    if (error.status === 404) {
                        showError(t('No product found with inventory code: {0}', inventoryCode));
                    } else if (error.status === 401) {
                        showError(t('Your session has expired. Please refresh the page or login again.'));
                    } else {
                        showError(error.responseJSON?.error || error.responseJSON?.message || t('Error searching for product'));
                    }
                    hideProductInfo();
                    hideTransferFields();
                } finally {
                    hideSearching();
                }
            }

            function displayProductInfo(product) {
                $('#productModel').text(product.model || t('N/A'));
                $('#productCode').text('#' + product.inventoryCode);
                $('#productMeta').text([product.vendor, product.categoryName].filter(Boolean).join(' · '));
                $('#currentDepartment').text(product.departmentName || t('N/A'));
                $('#currentWorker').text(product.worker || t('No worker assigned'));
                $('#workingStatus').html(product.isWorking
                    ? `<span class="ip-badge ip-badge-success">${escapeHtml(t('Working'))}</span>`
                    : `<span class="ip-badge ip-badge-danger">${escapeHtml(t('Not working'))}</span>`);
                const thumb = document.getElementById('productThumb');
                thumb.innerHTML = product.imageUrl
                    ? `<img src="${escapeHtml(thumbUrl(product.imageUrl, 480))}" alt="" />`
                    : '<i class="fa-solid fa-box"></i>';
                $('#ProductId').val(product.id);
                $('#productInfoContainer').show();
                updateSummary();
            }

            async function checkPendingRoutes(productId) {
                try {
                    const routes = await $.ajax({
                        url: AppConfig.buildApiUrl(`inventoryroutes/product/${productId}`),
                        type: 'GET'
                    });
                    const pending = (routes || []).filter(r => !r.isCompleted);
                    if (pending.length > 0) {
                        showWarning(t('This product has a pending transfer to {0} created on {1}. The pending transfer must be completed first.',
                            pending[0].toDepartmentName || '', formatDate(pending[0].createdAt)));
                        hideTransferFields();
                    } else {
                        showTransferFields();
                    }
                } catch (error) {
                    console.error('Failed to check pending routes:', error);
                    showTransferFields();
                }
            }

            // "Finance -> IT · worker" in the footer.
            function updateSummary() {
                if (!currentProductData) { $('#transferSummary').empty(); return; }
                const to = $('#ToDepartmentId').val() ? $('#ToDepartmentId option:selected').text() : '…';
                const worker = ($('#ToWorker').val() || '').trim();
                $('#transferSummary').html(
                    `<span class="fw-semibold text-body">${escapeHtml(currentProductData.departmentName || '-')}</span>` +
                    ` <i class="fa-solid fa-arrow-right mx-1"></i> ` +
                    `<span class="fw-semibold text-body">${escapeHtml(to)}</span>` +
                    (worker ? ` · ${escapeHtml(worker)}` : ''));
            }

            function showTransferFields() { $('#transferFields').show(); $submitBtn.prop('disabled', false); }
            function hideTransferFields() { $('#transferFields').hide(); $submitBtn.prop('disabled', true); }

            function hideProductInfo() {
                $('#productInfoContainer').hide();
                $('#ProductId').val('');
                currentProductData = null;
            }

            function showSearching() {
                $('#searchBtn').prop('disabled', true)
                    .html(`<span class="spinner-border spinner-border-sm"></span><span>${escapeHtml(t('Searching...'))}</span>`);
            }
            function hideSearching() {
                $('#searchBtn').prop('disabled', false)
                    .html(`<i class="fa-solid fa-magnifying-glass"></i><span>${escapeHtml(t('Search'))}</span>`);
            }

            function showError(message) {
                $('#searchFeedback').html(`<span class="ip-error">${escapeHtml(message)}</span>`);
                $('#inventoryCodeInput').addClass('is-invalid');
                hideWarning();
            }
            function hideError() {
                $('#searchFeedback').empty();
                $('#inventoryCodeInput').removeClass('is-invalid');
            }

            function showDepartmentError(message) {
                $('#departmentError').text(message).removeClass('d-none');
                $('#ToDepartmentId').addClass('is-invalid');
            }
            function hideDepartmentError() {
                $('#departmentError').text('').addClass('d-none');
                $('#ToDepartmentId').removeClass('is-invalid');
            }

            function showWarning(message) {
                $('#warningContainer').html(
                    `<div class="ip-banner ip-banner-danger mt-3"><i class="fa-solid fa-ban"></i><span>${escapeHtml(message)}</span></div>`);
            }
            function hideWarning() { $('#warningContainer').empty(); }

            function resetForm() {
                hideProductInfo();
                hideTransferFields();
                hideError();
                hideWarning();
                hideDepartmentError();
                lastSearchedCode = '';
                isSubmitting = false;
                $('#ToDepartmentId').val('');
                $('#ToWorker').val('');
                $('#Notes').val('');
                ImageManager.reset(document);
                updateSummary();
            }

            // Opened from a product (?code=1042): search straight away.
            const preset = new URLSearchParams(window.location.search).get('code');
            if (preset && /^\d{1,4}$/.test(preset)) {
                $('#inventoryCodeInput').val(preset);
                searchProduct();
            }
        });
    </script>
}
