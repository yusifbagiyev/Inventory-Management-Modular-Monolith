@model RouteViewModel
@* A transfer's WhatsApp message: nothing when sent (or none), a warning when it failed (with the
   reason in the tooltip and, for whoever completes transfers, a resend button), a clock while queued. *@
@if (Model.WhatsAppStatus == "Failed")
{
    <span class="ip-wa ip-wa-failed" title="@Model.WhatsAppError">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["WhatsApp not sent"]</span>
    </span>
    @if (User.HasPermission("route.complete"))
    {
        <button type="button" class="ip-btn ip-btn-ghost ip-btn-sm ip-wa-resend" data-wa-resend="@Model.Id">
            <i class="fa-solid fa-rotate-right"></i><span>@L["Send again"]</span>
        </button>
    }
}
else if (Model.WhatsAppStatus == "Queued")
{
    <span class="ip-wa ip-wa-queued"><i class="fa-regular fa-clock" aria-hidden="true"></i><span>@L["WhatsApp queued"]</span></span>
}
