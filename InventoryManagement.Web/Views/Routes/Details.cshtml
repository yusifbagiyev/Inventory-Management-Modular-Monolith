@model RouteViewModel
@{
    ViewData["Title"] = "Route Details";

    var typeClass = Model.RouteTypeName switch
    {
        "New" => "state-ok",
        "Removal" => "state-crit",
        "Update" => "state-warn",
        "Transfer" => "state-info",
        _ => "state-idle"
    };
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Routes"]</a></li>
                <li class="breadcrumb-item active">@L["Details"]</li>
            </ol>
            <h1>@L[(string)ViewData["Title"]!]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> @L["Back to List"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <span><i class="fas fa-signs-post me-1"></i> @L["Route Information"]</span>
                    <span class="d-flex gap-2 flex-wrap">
                        <span class="state state-flat @typeClass">@L[Model.RouteTypeName ?? ""]</span>
                        @if (Model.IsCompleted)
                        {
                            <span class="state state-ok">@L["Completed"]</span>
                        }
                        else
                        {
                            <span class="state state-warn">@L["Pending"]</span>
                        }
                    </span>
                </div>

                <div class="card-body">
                    <h2 class="section-title">@L["Transfer"]</h2>
                    <div class="d-flex align-items-center flex-wrap gap-3 mb-4">
                        @if (Model.FromDepartmentName != null)
                        {
                            <div class="cell-text">
                                <span class="cell-sub">@L["From"]</span>
                                <span class="cell-title">@Model.FromDepartmentName</span>
                                <span class="cell-sub">@L["Worker"]: @(Model.FromWorker ?? L["N/A"].Value)</span>
                            </div>
                            <i class="fas fa-arrow-right text-muted"></i>
                        }
                        <div class="cell-text">
                            <span class="cell-sub">@L["To"]</span>
                            <span class="cell-title">@Model.ToDepartmentName</span>
                            <span class="cell-sub">@L["Worker"]: @(Model.ToWorker ?? L["N/A"].Value)</span>
                        </div>
                    </div>

                    <h2 class="section-title">@L["Product"]</h2>
                    <div class="detail-grid mb-4">
                        <div class="detail-row">
                            <span class="d-label">@L["Code"]</span>
                            <span class="d-value mono">@Model.InventoryCode</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Model"]</span>
                            @if (string.IsNullOrWhiteSpace(Model.Model))
                            {
                                <span class="d-value d-empty">@L["Not set"]</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Model</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Vendor"]</span>
                            @if (string.IsNullOrWhiteSpace(Model.Vendor))
                            {
                                <span class="d-value d-empty">@L["Not set"]</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Vendor</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Category"]</span>
                            @if (string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span class="d-value d-empty">@L["Not set"]</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.CategoryName</span>
                            }
                        </div>
                    </div>

                    <h2 class="section-title">@L["Route"]</h2>
                    <div class="detail-grid mb-4">
                        <div class="detail-row">
                            <span class="d-label">@L["Route type"]</span>
                            <span class="d-value">@L[Model.RouteTypeName ?? ""]</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Created"]</span>
                            <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Completed"]</span>
                            @if (Model.IsCompleted && Model.CompletedAt.HasValue)
                            {
                                <span class="d-value mono">@Model.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">@L["Not completed"]</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <h2 class="section-title">@L["Notes"]</h2>
                        <p class="mb-4">@Model.Notes</p>
                    }

                    @if (Model.ImageUrls.Count > 0)
                    {
                        <h2 class="section-title">@L["Images"]</h2>
                        <partial name="_ImageGallery" model='new ImageGalleryModel { Images = Model.ImageUrls, Title = L["Transfer image"].Value }' />
                    }
                </div>

                <div class="page-actions">
                    <div class="actions-right">
                        @if (!Model.IsCompleted)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteRoute(@Model.Id)">
                                <i class="fas fa-trash"></i> @L["Delete"]
                            </button>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-box"></i> @L["View Product"]
                            </a>
                            <button type="button" class="btn btn-primary btn-sm" onclick="completeRoute(@Model.Id)">
                                <i class="fas fa-check"></i> @L["Mark as Complete"]
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-box"></i> @L["View Product"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 side-panel">
                <div class="card-header">
                    <i class="fas fa-bolt me-1"></i>
                    @L["Quick Actions"]
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Timeline" asp-route-productId="@Model.ProductId" class="list-group-item list-group-item-action">
                        <i class="fas fa-clock-rotate-left me-2"></i> @L["View Full Timeline"]
                    </a>
                    <a asp-action="Transfer" class="list-group-item list-group-item-action">
                        <i class="fas fa-arrow-right-arrow-left me-2"></i> @L["New Transfer"]
                    </a>
                    <button type="button" class="list-group-item list-group-item-action text-start" onclick="printRoute()">
                        <i class="fas fa-print me-2"></i> @L["Print Details"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function completeRoute(id) {
            confirmAction({
                title: t('Complete route'),
                message: t('Mark this route as completed?'),
                okText: t('Complete')
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Complete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function deleteRoute(id) {
            confirmAction({
                title: t('Delete route'),
                message: t('Delete this route? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function printRoute() {
            window.print();
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { route: @Model.Id, product: @Model.ProductId },
            regions: ['#detailsRegion'],
            label: 'route'
        });
    </script>
}
