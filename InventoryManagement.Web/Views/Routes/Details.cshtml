@model RouteViewModel
@{
    ViewData["Title"] = "Route Details";
    var canComplete = User.HasPermission("route.complete");
    var canUpdate = User.HasPermission("route.update") || User.HasPermission("route.update.direct");
    var canDelete = User.HasPermission("route.delete") || User.HasPermission("route.delete.direct");
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Routes"]</a></li>
                <li class="breadcrumb-item active ip-num">#@Model.Id</li>
            </ol>
            <h1>@L["Route {0}", $"#{Model.Id}"]</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (Model.IsCompleted)
                {
                    <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                }
                <span class="ip-tag-plain">@L[Model.RouteTypeName ?? ""]</span>
                <span class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="ip-page-actions mb-4">
        @if (canDelete && !Model.IsCompleted)
        {
            <button type="button" class="ip-btn ip-btn-danger-ghost" onclick="deleteRoute(@Model.Id)">
                <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
            </button>
        }
        <button type="button" class="ip-btn-icon lg" onclick="printRoute()" title="@L["Print Details"]" aria-label="@L["Print Details"]">
            <i class="fa-solid fa-print"></i>
        </button>
        <a asp-action="Timeline" asp-route-productId="@Model.ProductId" class="ip-btn ip-btn-secondary">
            <i class="fa-solid fa-clock-rotate-left"></i><span>@L["Full history"]</span>
        </a>
        @if (canUpdate && !Model.IsCompleted)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-pen"></i><span>@L["Edit"]</span>
            </a>
        }
        @if (canComplete && !Model.IsCompleted)
        {
            <button type="button" class="ip-btn ip-btn-primary" onclick="completeRoute(@Model.Id)">
                <span>@L["Complete"]</span><i class="fa-solid fa-check"></i>
            </button>
        }
    </div>

    <hr class="ip-rule" />

    <div class="row g-5 pt-4">
        <div class="@(Model.ImageUrls.Count > 0 ? "col-lg-6" : "col-lg-8")">
            <dl class="ip-dl">
                <div>
                    <dt>@L["Product"]</dt>
                    <dd>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">@Or(Model.Model, L["N/A"].Value)</a>
                        <div class="ip-faint">@Or(Model.Vendor, "-") · @Or(Model.CategoryName, "-")</div>
                    </dd>
                </div>
                <div><dt>@L["Inventory Code"]</dt><dd class="ip-mono">@Model.InventoryCode</dd></div>
                <div>
                    <dt>@L["From"]</dt>
                    <dd>
                        @Or(Model.FromDepartmentName, "-")
                        @if (!string.IsNullOrWhiteSpace(Model.FromWorker))
                        {
                            <div class="ip-faint">@Model.FromWorker</div>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@L["To"]</dt>
                    <dd>
                        <span class="fw-semibold">@Or(Model.ToDepartmentName, "-")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.ToWorker))
                        {
                            <div class="ip-faint">@Model.ToWorker</div>
                        }
                    </dd>
                </div>
                <div><dt>@L["Type"]</dt><dd>@L[Model.RouteTypeName ?? ""]</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div>
                <div>
                    <dt>@L["Completed"]</dt>
                    @if (Model.IsCompleted && Model.CompletedAt.HasValue)
                    {
                        <dd class="ip-num">@Model.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["Not completed"]</dd>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div><dt>@L["Notes"]</dt><dd>@Model.Notes</dd></div>
                }
            </dl>
        </div>
        @if (Model.ImageUrls.Count > 0)
        {
            <div class="col-lg-6">
                <partial name="_ImageGallery" model='new ImageGalleryModel { Images = Model.ImageUrls, Title = L["Transfer image"].Value }' />
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function completeRoute(id) {
            confirmAction({
                title: t('Complete route'),
                message: t('Mark this route as completed?'),
                okText: t('Complete')
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Complete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function deleteRoute(id) {
            confirmAction({
                title: t('Delete route'),
                message: t('Delete this route? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function printRoute() {
            window.print();
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { route: @Model.Id, product: @Model.ProductId },
            regions: ['#detailsRegion'],
            label: 'route'
        });
    </script>
}
