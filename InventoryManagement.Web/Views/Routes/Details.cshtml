@model RouteViewModel
@{
    ViewData["Title"] = "Route Details";

    var typeClass = Model.RouteTypeName switch
    {
        "New" => "state-ok",
        "Removal" => "state-crit",
        "Update" => "state-warn",
        "Transfer" => "state-info",
        _ => "state-idle"
    };
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Route Details</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Routes</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <span><i class="bi bi-signpost-split me-1"></i> Route Information</span>
                    <span class="d-flex gap-2 flex-wrap">
                        <span class="state state-flat @typeClass">@Model.RouteTypeName</span>
                        @if (Model.IsCompleted)
                        {
                            <span class="state state-ok">Completed</span>
                        }
                        else
                        {
                            <span class="state state-warn">Pending</span>
                        }
                    </span>
                </div>

                <div class="card-body">
                    <h2 class="section-title">Transfer</h2>
                    <div class="d-flex align-items-center flex-wrap gap-3 mb-4">
                        @if (Model.FromDepartmentName != null)
                        {
                            <div class="cell-text">
                                <span class="cell-sub">From</span>
                                <span class="cell-title">@Model.FromDepartmentName</span>
                                <span class="cell-sub">Worker: @(Model.FromWorker ?? "N/A")</span>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                        }
                        <div class="cell-text">
                            <span class="cell-sub">To</span>
                            <span class="cell-title">@Model.ToDepartmentName</span>
                            <span class="cell-sub">Worker: @(Model.ToWorker ?? "N/A")</span>
                        </div>
                    </div>

                    <h2 class="section-title">Product</h2>
                    <div class="detail-grid mb-4">
                        <div class="detail-row">
                            <span class="d-label">Code</span>
                            <span class="d-value mono">@Model.InventoryCode</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Model</span>
                            @if (string.IsNullOrWhiteSpace(Model.Model))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Model</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Vendor</span>
                            @if (string.IsNullOrWhiteSpace(Model.Vendor))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Vendor</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Category</span>
                            @if (string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.CategoryName</span>
                            }
                        </div>
                    </div>

                    <h2 class="section-title">Route</h2>
                    <div class="detail-grid mb-4">
                        <div class="detail-row">
                            <span class="d-label">Route type</span>
                            <span class="d-value">@Model.RouteTypeName</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Created</span>
                            <span class="d-value mono">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm")</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Completed</span>
                            @if (Model.IsCompleted && Model.CompletedAt.HasValue)
                            {
                                <span class="d-value mono">@Model.CompletedAt.Value.ToString("MM/dd/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span class="d-value d-empty">Not completed</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <h2 class="section-title">Notes</h2>
                        <p class="mb-4">@Model.Notes</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <h2 class="section-title">Transfer image</h2>
                        <div class="image-preview">
                            <img src="@Model.FullImageUrl"
                                 style="cursor: pointer;"
                                 alt="Transfer Image"
                                 data-src="@Model.FullImageUrl" onclick="showImageModal(this.dataset.src, 'Transfer Image')" />
                        </div>
                    }
                </div>

                <div class="page-actions">
                    <div class="actions-right">
                        @if (!Model.IsCompleted)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteRoute(@Model.Id)">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-box"></i> View Product
                            </a>
                            <button type="button" class="btn btn-primary btn-sm" onclick="completeRoute(@Model.Id)">
                                <i class="fas fa-check"></i> Mark as Complete
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-box"></i> View Product
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 side-panel">
                <div class="card-header">
                    <i class="bi bi-lightning-charge me-1"></i>
                    Quick Actions
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Timeline" asp-route-productId="@Model.ProductId" class="list-group-item list-group-item-action">
                        <i class="bi bi-clock-history me-2"></i> View Full Timeline
                    </a>
                    <a asp-action="Transfer" class="list-group-item list-group-item-action">
                        <i class="bi bi-arrow-left-right me-2"></i> New Transfer
                    </a>
                    <button type="button" class="list-group-item list-group-item-action text-start" onclick="printRoute()">
                        <i class="bi bi-printer me-2"></i> Print Details
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function completeRoute(id) {
            confirmAction({
                title: 'Complete route',
                message: 'Mark this route as completed?',
                okText: 'Complete'
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Complete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function deleteRoute(id) {
            confirmAction({
                title: 'Delete route',
                message: 'Delete this route? This cannot be undone.',
                okText: 'Delete',
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function printRoute() {
            window.print();
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { route: @Model.Id, product: @Model.ProductId },
            regions: ['#detailsRegion'],
            label: 'route'
        });
    </script>
}
