@model RouteViewModel
@inject SharedServices.Contracts.IWhatsAppRouteNotifier WhatsAppNotifier
@{
    ViewData["Title"] = "Route Details";
    ViewData["Subtitle"] = Model.InventoryCode.ToString();
    var canComplete = User.HasPermission("route.complete");
    var canUpdate = User.HasPermission("route.update") || User.HasPermission("route.update.direct");
    var canDelete = User.HasPermission("route.delete") || User.HasPermission("route.delete.direct");
    var hasFootActions = !Model.IsCompleted && (canDelete || canUpdate || canComplete);
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Routes"]</a></li>
                <li class="breadcrumb-item active ip-num">#@Model.Id</li>
            </ol>
            <h1>@L["Route {0}", $"#{Model.Id}"]</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (Model.IsCompleted)
                {
                    <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                }
                <span class="ip-tag-plain">@L[Model.RouteTypeLabel]</span>
                <span class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    @* Phones get the record actions in the fixed bar at the end of the page, and history and print under the details *@
    <div class="ip-page-actions mb-4 d-none d-md-flex">
        @if (canDelete && !Model.IsCompleted)
        {
            <button type="button" class="ip-btn ip-btn-danger-ghost" onclick="deleteRoute(@Model.Id)">
                <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
            </button>
        }
        <button type="button" class="ip-btn-icon lg" onclick="printRoute()" title="@L["Print Details"]" aria-label="@L["Print Details"]">
            <i class="fa-solid fa-print"></i>
        </button>
        <a asp-action="Timeline" asp-route-productId="@Model.ProductId" class="ip-btn ip-btn-secondary">
            <i class="fa-solid fa-clock-rotate-left"></i><span>@L["Full history"]</span>
        </a>
        @if (canUpdate && !Model.IsCompleted)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-pen"></i><span>@L["Edit"]</span>
            </a>
        }
        @if (canComplete && !Model.IsCompleted)
        {
            <button type="button" class="ip-btn ip-btn-primary" onclick="completeRoute(@Model.Id)">
                <span>@L["Complete"]</span><i class="fa-solid fa-check"></i>
            </button>
        }
    </div>

    <hr class="ip-rule" />

    <div class="row g-5 pt-4">
        <div class="@(Model.ImageUrls.Count > 0 ? "col-lg-6" : "col-lg-8")">
            <dl class="ip-dl">
                <div>
                    <dt>@L["Product"]</dt>
                    <dd>
                        @if (User.HasPermission("product.view"))
                        {
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">@Or(Model.Model, L["N/A"].Value)</a>
                        }
                        else
                        {
                            @Or(Model.Model, L["N/A"].Value)
                        }
                        <div class="ip-faint">@Or(Model.Vendor, "-") · @Or(Model.CategoryName, "-")</div>
                    </dd>
                </div>
                <div><dt>@L["Inventory Code"]</dt><dd class="ip-mono">@Model.InventoryCode</dd></div>
                <div>
                    <dt>@L["From"]</dt>
                    <dd>
                        @Or(Model.FromDepartmentName, "-")
                        @if (!string.IsNullOrWhiteSpace(Model.FromWorker))
                        {
                            <div class="ip-faint">@Model.FromWorker</div>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@L["To"]</dt>
                    <dd>
                        <span class="fw-semibold">@Or(Model.ToDepartmentName, "-")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.ToWorker))
                        {
                            <div class="ip-faint">@Model.ToWorker</div>
                        }
                    </dd>
                </div>
                <div><dt>@L["Type"]</dt><dd>@L[Model.RouteTypeLabel]</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div>
                <div>
                    <dt>@L["Completed"]</dt>
                    @if (Model.IsCompleted && Model.CompletedAt.HasValue)
                    {
                        <dd class="ip-num">@Model.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["Not completed"]</dd>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div><dt>@L["Notes"]</dt><dd>@Model.Notes</dd></div>
                }
                @if (!string.IsNullOrEmpty(Model.WhatsAppStatus))
                {
                    <div>
                        <dt>WhatsApp</dt>
                        <dd class="d-flex flex-wrap align-items-center gap-2">
                            @if (Model.WhatsAppStatus == "Sent")
                            {
                                <span class="ip-wa"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["Sent {0}", Model.WhatsAppAt?.ToString("dd.MM.yyyy HH:mm") ?? ""]</span></span>
                                @if (canComplete && Model.CanDeleteWhatsApp(WhatsAppNotifier.DeleteWindow))
                                {
                                    <button type="button" class="ip-btn ip-btn-ghost ip-btn-sm ip-wa-resend" data-wa-delete="@Model.Id">
                                        <i class="fa-regular fa-trash-can"></i><span>@L["Delete message"]</span>
                                    </button>
                                }
                            }
                            else if (Model.WhatsAppStatus == "Deleted")
                            {
                                <span class="ip-wa ip-wa-queued"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>@L["Deleted from the group {0}", Model.WhatsAppAt?.ToString("dd.MM.yyyy HH:mm") ?? ""]</span></span>
                            }
                            else
                            {
                                <partial name="_WhatsAppStatus" model="Model" />
                                @if (Model.WhatsAppStatus == "Failed" && !string.IsNullOrWhiteSpace(Model.WhatsAppError))
                                {
                                    <div class="ip-hint w-100">@Model.WhatsAppError</div>
                                }
                            }
                        </dd>
                    </div>
                }
            </dl>
            <div class="ip-page-actions mt-4 d-md-none">
                <a asp-action="Timeline" asp-route-productId="@Model.ProductId" class="ip-btn ip-btn-secondary">
                    <i class="fa-solid fa-clock-rotate-left"></i><span>@L["Full history"]</span>
                </a>
                <button type="button" class="ip-btn ip-btn-secondary" onclick="printRoute()">
                    <i class="fa-solid fa-print"></i><span>@L["Print Details"]</span>
                </button>
            </div>
        </div>
        @if (Model.ImageUrls.Count > 0)
        {
            <div class="col-lg-6">
                <partial name="_ImageGallery" model='new ImageGalleryModel { Images = Model.ImageUrls, Title = L["Transfer image"].Value }' />
            </div>
        }
    </div>

    @if (hasFootActions)
    {
        <div class="ip-form-foot d-md-none">
            @if (canDelete)
            {
                <button type="button" class="ip-btn ip-btn-danger-ghost" onclick="deleteRoute(@Model.Id)" title="@L["Delete"]" aria-label="@L["Delete"]">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            }
            @if (canUpdate)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary flex-fill"><i class="fa-solid fa-pen"></i><span>@L["Edit"]</span></a>
            }
            @if (canComplete)
            {
                <button type="button" class="ip-btn ip-btn-primary flex-fill" onclick="completeRoute(@Model.Id)">
                    <span>@L["Complete"]</span><i class="fa-solid fa-check"></i>
                </button>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function completeRoute(id) {
            confirmAction({
                title: t('Complete route'),
                message: t('Mark this route as completed?'),
                okText: t('Complete')
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Complete/' + id;

                // The token value is cut out of the hidden input that AntiForgeryToken renders
                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function deleteRoute(id) {
            confirmAction({
                title: t('Delete route'),
                message: t('Delete this route? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Routes/Delete/' + id;

                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            });
        }

        function printRoute() {
            window.print();
        }

        // The sheet is printed with the light colours, also when the browser's own print command is used
        window.addEventListener('beforeprint', function () {
            const root = document.documentElement;
            root.dataset.themeBeforePrint = root.getAttribute('data-bs-theme') || '';
            root.setAttribute('data-bs-theme', 'light');
        });
        window.addEventListener('afterprint', function () {
            const root = document.documentElement;
            if (!('themeBeforePrint' in root.dataset)) return;
            if (root.dataset.themeBeforePrint) root.setAttribute('data-bs-theme', root.dataset.themeBeforePrint);
            else root.removeAttribute('data-bs-theme');
            delete root.dataset.themeBeforePrint;
        });


        // Other users' changes refresh the page in place, and a deletion shows a notice
        LiveUpdates.watch({
            entities: ['route', 'product'],
            ids: { route: @Model.Id, product: @Model.ProductId },
            regions: ['#detailsRegion'],
            label: 'route'
        });
    </script>
}
