@model ProductViewModel
@{
    ViewData["Title"] = "Product Details";
    ViewData["Subtitle"] = Model.InventoryCode.ToString();   // Shown under the title in the phone app bar
    var transfers = ViewBag.Transfers as List<RouteViewModel> ?? new List<RouteViewModel>();
    var canUpdate = User.HasPermission("product.update") || User.HasPermission("product.update.direct");
    var canDelete = User.HasPermission("product.delete") || User.HasPermission("product.delete.direct");
    var canTransfer = User.HasPermission("route.create") || User.HasPermission("route.create.direct");
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

<div class="container-fluid px-4" id="detailsRegion" data-product-name="@($"{Or(Model.Model, L["N/A"].Value)} ({Model.InventoryCode})")">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Products"]</a></li>
                <li class="breadcrumb-item active ip-mono">@Model.InventoryCode</li>
            </ol>
            <h1>@Or(Model.Model, L["N/A"].Value)</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                <span>@Or(Model.Vendor, "-") · @Or(Model.CategoryName, "-")</span>
                <span class="ip-mono text-body">#@Model.InventoryCode</span>
                @if (Model.IsWorking)
                {
                    <span class="ip-badge ip-badge-success">@L["Working"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-danger">@L["Not working"]</span>
                }
                @if (!Model.IsActive)
                {
                    <span class="ip-tag-plain">@L["Inactive"]</span>
                }
                @if (Model.IsNewItem)
                {
                    <span class="ip-tag-plain">@L["New"]</span>
                }
            </div>
        </div>
    </div>

    @* Phones get these actions in the fixed bar at the end of the page *@
    <div class="ip-page-actions mb-4 d-none d-md-flex">
        @if (canDelete)
        {
            <button type="button" class="ip-btn ip-btn-danger-ghost" data-delete-product>
                <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
            </button>
        }
        @if (canUpdate)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-pen"></i><span>@L["Edit"]</span>
            </a>
        }
        @if (canTransfer && Model.IsActive)
        {
            <a href="@Url.Action("Transfer", "Routes", new { code = Model.InventoryCode })" class="ip-btn ip-btn-primary">
                <span>@L["Transfer"]</span>
            </a>
        }
    </div>

    @if (Model.HasPendingApproval)
    {
        <div class="ip-banner ip-banner-warning mb-4">
            <i class="fa-regular fa-clock"></i>
            <span class="flex-grow-1">@L["This product has a request awaiting approval. The details below stay as they are until it is approved."]</span>
            @* Only approvers can open someone else's request, so others go to their own list *@
            @if (User.HasPermission("approval.view") || User.HasPermission("approval.decide"))
            {
                <a href="/Approvals?open=@Model.PendingRequestId">@L["Request #{0}", Model.PendingRequestId!]</a>
            }
            else
            {
                <a href="/MyRequests">@L["My Requests"]</a>
            }
        </div>
    }

    <hr class="ip-rule" />

    <div class="row g-5 pt-4">
        <div class="col-lg-6">
            <partial name="_ImageGallery" model='new ImageGalleryModel { Images = Model.ImageUrls, Title = Model.Model ?? "", EmptyText = "No image available" }' />
        </div>
        <div class="col-lg-6">
            <dl class="ip-dl">
                <div><dt>@L["Inventory Code"]</dt><dd class="ip-mono">@Model.InventoryCode</dd></div>
                <div><dt>@L["Model"]</dt><dd>@Or(Model.Model, "-")</dd></div>
                <div><dt>@L["Vendor"]</dt><dd>@Or(Model.Vendor, "-")</dd></div>
                <div><dt>@L["Category"]</dt><dd>@Or(Model.CategoryName, "-")</dd></div>
                <div><dt>@L["Color"]</dt><dd class="@(string.IsNullOrWhiteSpace(Model.Color) ? "ip-muted" : "")">@Or(Model.Color, "-")</dd></div>
                <div><dt>@L["Department"]</dt><dd>@Or(Model.DepartmentName, "-")</dd></div>
                <div><dt>@L["Assigned Worker"]</dt><dd class="@(string.IsNullOrWhiteSpace(Model.Worker) ? "ip-muted" : "")">@Or(Model.Worker, L["Not Assigned"].Value)</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@(Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd></div>
                <div><dt>@L["Updated"]</dt><dd class="ip-num">@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div><dt>@L["Description"]</dt><dd>@Model.Description</dd></div>
                }
            </dl>
        </div>
    </div>

    @if (Model.Specifications.Count > 0)
    {
        <section class="ip-section mt-5">
            <h2 class="mb-2">@L["Specifications"]</h2>
            <dl class="ip-dl ip-dl-wide">
                @foreach (var spec in Model.Specifications)
                {
                    <div><dt>@spec.Name</dt><dd>@(string.IsNullOrWhiteSpace(spec.Value) ? "-" : spec.Value)</dd></div>
                }
            </dl>
        </section>
    }

    @if (User.HasPermission("audit.view"))
    {
        <div class="d-flex justify-content-end mt-4">
            <a href="/Audit?entityType=Product&entityId=@Model.Id" class="ip-btn ip-btn-ghost ip-btn-sm">
                <span>@L["Audit log"]</span><i class="fa-solid fa-clipboard-list"></i>
            </a>
        </div>
    }

    @* Transfers are route data, so they need route.view *@
    @if (User.HasPermission("route.view"))
    {
    <section class="ip-section mt-5">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-2">
            <h2>@L["Transfers"]</h2>
            <div class="d-flex gap-2">
                <a asp-controller="Routes" asp-action="Timeline" asp-route-productId="@Model.Id" class="ip-btn ip-btn-ghost ip-btn-sm">
                    <span>@L["Full history"]</span><i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
        @if (transfers.Count == 0)
        {
            <p class="ip-muted py-3 mb-0">@L["This product has not been transferred yet."]</p>
        }
        else
        {
            <div class="ip-table-wrap">
                <table class="ip-table" id="productTransfersTable" data-column-filters="client">
                    <thead>
                        <tr>
                            <th data-sort="date" data-sort-first="desc" data-filter="date">@L["Date"]</th>
                            <th data-sort="from" data-filter="list">@L["From"]</th>
                            <th></th>
                            <th data-sort="to" data-filter="list">@L["To"]</th>
                            <th data-sort="status" data-filter="list">@L["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in transfers)
                        {
                            <tr data-href="@Url.Action("Details", "Routes", new { id = route.Id })">
                                <td class="date ip-num text-nowrap" data-order="@route.CreatedAt.ToString("yyyy-MM-dd HH:mm")">@route.CreatedAt.ToString("dd.MM.yyyy")<div class="sub">@route.CreatedAt.ToString("HH:mm")</div></td>
                                <td class="meta route-from" data-filter-value="@(route.FromDepartmentName ?? "-")" data-filter-label="@(route.FromDepartmentName ?? "-")"><span class="cell-text">@(route.FromDepartmentName ?? "-")</span><div class="sub">@route.FromWorker</div></td>
                                <td class="hide-sm ip-muted" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></td>
                                <td class="meta route-to" data-filter-value="@route.ToDepartmentName" data-filter-label="@route.ToDepartmentName"><span class="cell-text">@route.ToDepartmentName</span><div class="sub">@route.ToWorker</div></td>
                                <td class="state" data-filter-value="@(route.IsCompleted ? "completed" : "pending")">
                                    @if (route.IsCompleted)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Completed"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }
    @if (canDelete || canUpdate || (canTransfer && Model.IsActive))
    {
        <div class="ip-form-foot d-md-none">
            @if (canDelete)
            {
                <button type="button" class="ip-btn ip-btn-danger-ghost" data-delete-product title="@L["Delete"]" aria-label="@L["Delete"]">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            }
            @if (canUpdate)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary"><i class="fa-solid fa-pen"></i><span>@L["Edit"]</span></a>
            }
            @if (canTransfer && Model.IsActive)
            {
                <a href="@Url.Action("Transfer", "Routes", new { code = Model.InventoryCode })" class="ip-btn ip-btn-primary"><span>@L["Transfer"]</span></a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        const productId = @Model.Id;
        const productName = document.getElementById('detailsRegion').dataset.productName;
        const deleteDirect = @Json.Serialize(User.HasPermission("product.delete.direct"));

        // Delegated, because live updates swap the region holding the buttons
        document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-delete-product]')) return;
            confirmAction({
                title: t('Delete product'),
                message: deleteDirect
                    ? t('Delete {0}? It will be kept on the Deleted products page.', productName)
                    : t('Delete {0}? The request is sent for approval, and once approved the product is kept on the Deleted products page.', productName),
                okText: t('Delete'),
                danger: true
            }, deleteProduct);
        });

        function deleteProduct() {
            const $deleteBtn = $('[data-delete-product]');
            const originalHtml = $deleteBtn.map((i, el) => el.innerHTML).get();
            $deleteBtn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: '/Products/Delete/' + productId,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function(response) {
                    if (response && response.approvalRequestId) {
                        showToast(t('Delete request submitted for approval'), 'info');
                        setTimeout(() => window.location.href = '/Products', 2000);
                    } else {
                        showToast(t('Product deleted successfully'), 'success');
                        setTimeout(() => window.location.href = '/Products', 1500);
                    }
                },
                error: function(xhr) {
                    $deleteBtn.prop('disabled', false).each((i, el) => { el.innerHTML = originalHtml[i]; });

                    let errorMsg = t('Failed to delete product');
                    if (xhr.status === 403) {
                        errorMsg = t('You do not have permission to delete products');
                    } else if (xhr.status === 404) {
                        errorMsg = t('Product not found');
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }

                    showToast(errorMsg, 'error');
                }
            });
        }

        let transfersTable = null;
        let transfersSnapshot = '';

        // Only read from untouched rows, because header sorting reorders the rows of a table in use
        function transfersText(table) {
            return table ? Array.from(table.tBodies[0].rows, row => row.dataset.href + ' ' + row.textContent.replace(/\s+/g, ' ')).join('\n') : '';
        }

        function rememberTransfers() {
            transfersTable = document.getElementById('productTransfersTable');
            transfersSnapshot = transfersText(transfersTable);
        }

        rememberTransfers();

        // Other users' changes refresh the page in place, and a deletion shows a notice
        LiveUpdates.watch({
            entities: ['product', 'route'],
            ids: { product: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'product',
            // An open header filter belongs to the table it was opened on
            isEditing: () => !!document.querySelector('.ip-colfilter'),
            afterRefresh() {
                // Any transfer anywhere refreshes this page, so unchanged transfers keep their header sort and filters
                const fresh = document.getElementById('productTransfersTable');
                if (fresh && transfersTable && transfersText(fresh) === transfersSnapshot) fresh.replaceWith(transfersTable);
                else rememberTransfers();
            }
        });
    </script>
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
}
