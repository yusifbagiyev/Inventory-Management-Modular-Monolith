@model ProductViewModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@L["Product Details"]</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@L["Products"]</a></li>
                <li class="breadcrumb-item active">@L["Details"]</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-edit"></i> @L["Edit"]
                </a>
            }
            @if(User.HasPermission("route.create")|| User.HasPermission("route.create.direct"))
            {
                <a asp-controller="Routes" asp-action="Transfer" class="btn btn-primary btn-sm">
                    <i class="fas fa-exchange-alt"></i> @L["Transfer"]
                </a>
            }
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-circle-info me-1"></i>
                    @L["Product Information"]
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <partial name="_ImageGallery" model='new ImageGalleryModel { Images = Model.ImageUrls, Title = Model.Model ?? "", EmptyText = "No image available" }' />
                        </div>

                        <div class="col-md-7">
                            <div class="detail-grid">
                                <div class="detail-row">
                                    <span class="d-label">@L["Inventory Code"]</span>
                                    <span class="d-value mono">@Model.InventoryCode</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Model"]</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Model) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Model) ? L["N/A"].Value : Model.Model)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Vendor"]</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Vendor) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Vendor) ? L["N/A"].Value : Model.Vendor)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Category"]</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.CategoryName) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.CategoryName) ? L["N/A"].Value : Model.CategoryName)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Department"]</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.DepartmentName) ? L["N/A"].Value : Model.DepartmentName)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Assigned Worker"]</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Worker) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Worker) ? L["Not Assigned"].Value : Model.Worker)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">@L["Status"]</span>
                                    <span class="d-value">
                                        <span class="state-stack">
                                            @if (Model.IsWorking)
                                            {
                                                <span class="state state-ok">@L["Working"]</span>
                                            }
                                            else
                                            {
                                                <span class="state state-crit">@L["Not Working"]</span>
                                            }
                                            @if (Model.IsActive)
                                            {
                                                <span class="state state-info">@L["Active"]</span>
                                            }
                                            else
                                            {
                                                <span class="state state-idle">@L["Inactive"]</span>
                                            }
                                            @if (Model.IsNewItem)
                                            {
                                                <span class="state state-new">@L["New Item"]</span>
                                            }
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-4">
                            <div class="section-title">@L["Description"]</div>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 side-panel">
                <div class="card-header">
                    <i class="fas fa-bolt me-1"></i>
                    @L["Quick Actions"]
                </div>
                <div class="list-group list-group-flush">
                    <a asp-controller="Routes" asp-action="Timeline" asp-route-productId="@Model.Id" class="list-group-item list-group-item-action">
                        <i class="fas fa-route me-2"></i> @L["View Transfer History"]
                    </a>
                    @if (User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                            <i class="fas fa-edit me-2"></i> @L["Edit Product"]
                        </a>
                    }
                    @if(User.HasPermission("product.delete") || User.HasPermission("product.delete.direct"))
                    {
                        <button type="button" class="list-group-item list-group-item-action text-start" onclick="confirmDelete(@Model.Id)">
                            <i class="fas fa-trash me-2"></i> @L["Delete Product"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @L["Are you sure you want to delete this product?"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">@L["Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(productId) {
            if (!productId) {
                showToast(t('Invalid product ID'), 'error');
                return;
            }

            confirmAction({
                title: t('Delete product'),
                message: t('Delete this product? This cannot be undone.'),
                okText: t('Delete'),
                danger: true
            }, function () {
                deleteProduct(productId);
            });
        }

        function deleteProduct(productId) {
            // Show loading state
            const $deleteBtn = $('button[onclick*="confirmDelete"]');
            const originalHtml = $deleteBtn.html();
            $deleteBtn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm"></span> ' + t('Deleting...'));

            $.ajax({
                url: '/Products/Delete/' + productId,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function(response) {
                    // Check if it's an approval request
                    if (response && response.approvalRequestId) {
                        showToast(t('Delete request submitted for approval'), 'info');
                        setTimeout(() => window.location.href = '/Products', 2000);
                    } else {
                        showToast(t('Product deleted successfully'), 'success');
                        setTimeout(() => window.location.href = '/Products', 1500);
                    }
                },
                error: function(xhr) {
                    // Reset button
                    $deleteBtn.prop('disabled', false).html(originalHtml);

                    let errorMsg = t('Failed to delete product');
                    if (xhr.status === 403) {
                        errorMsg = t('You do not have permission to delete products');
                    } else if (xhr.status === 404) {
                        errorMsg = t('Product not found');
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }

                    showToast(errorMsg, 'error');
                }
            });
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['product', 'route'],
            ids: { product: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'product'
        });
    </script>
}
