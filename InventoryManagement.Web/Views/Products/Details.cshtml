@model ProductViewModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Product Details</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-edit"></i> Edit
                </a>
            }
            @if(User.HasPermission("route.create")|| User.HasPermission("route.create.direct"))
            {
                <a asp-controller="Routes" asp-action="Transfer" class="btn btn-primary btn-sm">
                    <i class="fas fa-exchange-alt"></i> Transfer
                </a>
            }
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-1"></i>
                    Product Information
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-5">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="image-preview">
                                    <img src="@Model.FullImageUrl"
                                         alt="Product Image"
                                         onclick="showImageModal('@Model.FullImageUrl', 'Product Image')"
                                         style="cursor: pointer;" />
                                </div>
                            }
                            else
                            {
                                <div class="image-preview">
                                    <i class="bi bi-image"></i>
                                    <span>No image available</span>
                                </div>
                            }
                        </div>

                        <div class="col-md-7">
                            <div class="detail-grid">
                                <div class="detail-row">
                                    <span class="d-label">Inventory Code</span>
                                    <span class="d-value mono">@Model.InventoryCode</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Model</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Model) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Model) ? "N/A" : Model.Model)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Vendor</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Vendor) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Vendor) ? "N/A" : Model.Vendor)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Category</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.CategoryName) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.CategoryName) ? "N/A" : Model.CategoryName)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Department</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.DepartmentName) ? "N/A" : Model.DepartmentName)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Assigned Worker</span>
                                    <span class="d-value @(string.IsNullOrWhiteSpace(Model.Worker) ? "d-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Worker) ? "Not Assigned" : Model.Worker)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="d-label">Status</span>
                                    <span class="d-value">
                                        <span class="state-stack">
                                            @if (Model.IsWorking)
                                            {
                                                <span class="state state-ok">Working</span>
                                            }
                                            else
                                            {
                                                <span class="state state-crit">Not Working</span>
                                            }
                                            @if (Model.IsActive)
                                            {
                                                <span class="state state-info">Active</span>
                                            }
                                            else
                                            {
                                                <span class="state state-idle">Inactive</span>
                                            }
                                            @if (Model.IsNewItem)
                                            {
                                                <span class="state state-new">New Item</span>
                                            }
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-4">
                            <div class="section-title">Description</div>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 side-panel">
                <div class="card-header">
                    <i class="bi bi-lightning-charge me-1"></i>
                    Quick Actions
                </div>
                <div class="list-group list-group-flush">
                    <a asp-controller="Routes" asp-action="Timeline" asp-route-productId="@Model.Id" class="list-group-item list-group-item-action">
                        <i class="fas fa-route me-2"></i> View Transfer History
                    </a>
                    @if (User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                            <i class="fas fa-edit me-2"></i> Edit Product
                        </a>
                    }
                    @if(User.HasPermission("product.delete") || User.HasPermission("product.delete.direct"))
                    {
                        <button type="button" class="list-group-item list-group-item-action text-start" onclick="confirmDelete(@Model.Id)">
                            <i class="fas fa-trash me-2"></i> Delete Product
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this product?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app-config.js"></script>
    <script>
        function confirmDelete(productId) {
            if (!productId) {
                showToast('Invalid product ID', 'error');
                return;
            }

            // Show confirmation modal
            if (!confirm('Are you sure you want to delete this product?')) {
                return;
            }

            deleteProduct(productId);
        }

        function deleteProduct(productId) {
            // Show loading state
            const $deleteBtn = $('button[onclick*="confirmDelete"]');
            const originalHtml = $deleteBtn.html();
            $deleteBtn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm"></span> Deleting...');

            $.ajax({
                url: '/Products/Delete/' + productId,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function(response) {
                    // Check if it's an approval request
                    if (response && response.approvalRequestId) {
                        showToast('Delete request submitted for approval', 'info');
                        setTimeout(() => window.location.href = '/Products', 2000);
                    } else {
                        showToast('Product deleted successfully', 'success');
                        setTimeout(() => window.location.href = '/Products', 1500);
                    }
                },
                error: function(xhr) {
                    // Reset button
                    $deleteBtn.prop('disabled', false).html(originalHtml);

                    let errorMsg = 'Failed to delete product';
                    if (xhr.status === 403) {
                        errorMsg = 'You do not have permission to delete products';
                    } else if (xhr.status === 404) {
                        errorMsg = 'Product not found';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }

                    showToast(errorMsg, 'error');
                }
            });
        }
        function showImageModal(imageUrl, title) {
                // Use the global image modal from _Layout
                $('#globalModalImage').attr('src', imageUrl);
                $('#globalImageModal .modal-title').text(title || 'Image Preview');
                $('#globalImageModal').modal('show');
            }
    </script>
}
