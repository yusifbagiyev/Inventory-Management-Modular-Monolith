@model ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    var direct = User.HasPermission("product.update.direct");
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Products"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="ip-mono">@Model.InventoryCode</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L["Edit Product"]</h1>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="ip-form" id="productForm">
        <input type="hidden" asp-for="Id" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <partial name="_ProductFormFields" model="Model" view-data='new ViewDataDictionary(ViewData) { ["IsEdit"] = true }' />

        <div class="ip-form-foot">
            <span class="note">
                @if (!direct)
                {
                    <i class="fa-solid fa-circle-info me-1"></i>@L["Operator changes are applied after an administrator approves them."]
                }
            </span>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script src="~/js/product-form.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // One save per click: later clicks are ignored until the request has an answer.
            let isSubmitting = false;
            const $submitBtn = $('#productForm button[type="submit"]');
            const originalButtonHtml = $submitBtn.html();

            AjaxHandler.handleForm('#productForm', {
                successMessage: t('Product updated successfully!'),
                successRedirect: '@Url.Action("Details", new { id = Model.Id })',
                redirectDelay: 1500,

                onBeforeSubmit: function() {
                    if (isSubmitting) return false;
                    isSubmitting = true;
                    return true;
                },

                onSuccess: function(response) {
                    // Without product.update.direct the change waits for approval.
                    if (response.isApprovalRequest || response.approvalRequestId) {
                        showToast(response.message || t('Product update submitted for approval'), 'info', 3000);
                        setTimeout(() => { window.location.href = '@Url.Action("Details", new { id = Model.Id })'; }, 2000);
                        return false;
                    }
                    return true;
                },

                onError: function() {
                    isSubmitting = false;
                    $submitBtn.prop('disabled', false).html(originalButtonHtml);
                }
            });
        });

        // Someone else saving or deleting this product while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['product'],
            ids: { product: @Model.Id },
            label: 'product'
        });
    </script>
}
