@model ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@L["Edit Product"]</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@L["Products"]</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-eye"></i> @L["View Details"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-pen-to-square me-1"></i>
                        @L["Edit Product Information"]
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="form-section">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0" role="alert"></div>
                        </div>
                    }

                    <div class="form-section">
                        <div class="section-title">@L["Identity"]</div>
                        <div class="form-grid">
                            <div>
                                <label asp-for="InventoryCode" class="form-label"></label>
                                <input asp-for="InventoryCode" class="form-control" readonly />
                                <div class="form-text">@L["The inventory code cannot be changed after creation."]</div>
                            </div>
                            <div>
                                <label asp-for="Vendor" class="form-label"></label>
                                <input asp-for="Vendor" class="form-control" />
                                <span asp-validation-for="Vendor" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="Model" class="form-label"></label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">@L["Classification"]</div>
                        <div class="form-grid">
                            <div>
                                <label asp-for="CategoryId" class="form-label"></label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                    <option value="">@L["-- Select Category --"]</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="DepartmentId" class="form-label"></label>
                                <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                                    <option value="">@L["-- Select Department --"]</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="Worker" class="form-label"></label>
                                <input asp-for="Worker" class="form-control" />
                                <span asp-validation-for="Worker" class="text-danger"></span>
                                <div class="form-text">@L["Person responsible for this item."]</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">@L["Status"]</div>
                        <div class="form-grid">
                            <div class="form-check">
                                <input asp-for="IsWorking" class="form-check-input" type="checkbox" />
                                <label asp-for="IsWorking" class="form-check-label"></label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsNewItem" class="form-check-input" type="checkbox" />
                                <label asp-for="IsNewItem" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">@L["Images"]</div>
                        <div class="form-grid">
                            <div class="full">
                                <partial name="_ImageManager" model="new ImageManagerModel { Existing = Model.ImageUrls }" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">@L["Notes"]</div>
                        <div class="form-grid">
                            <div class="full">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="page-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> @L["Back to List"]
                        </a>
                        <div class="actions-right">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-save"></i> @L["Save Changes"]
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Our submission protection flag
            let isSubmitting = false;

            // Get references to elements we'll need
            const $form = $('form');
            const $submitBtn = $('#submitBtn, button[type="submit"]').first();
            const originalButtonHtml = $submitBtn.html();

            // Initialize the AjaxHandler for this form
            AjaxHandler.handleForm('form', {
                successMessage: t('Product updated successfully!'),
                successRedirect: '@Url.Action("Index")',
                redirectDelay: 1500,

                onBeforeSubmit: function(form) {
                    // FIRST LINE OF DEFENSE: Check if we're already submitting
                    // This check happens immediately, before anything else
                    // Think of it as a bouncer at a club - if someone's already going in,
                    // they stop others from entering until the first person is through
                    if (isSubmitting) {
                        return false; // Stop the submission attempt
                    }

                    // LOCK THE DOOR: Set the flag to prevent any other submissions
                    isSubmitting = true;

                    // Let the submission proceed
                    // The AjaxHandler will handle validation, button state, etc.
                    return true;
                },

                onSuccess: function(response) {
                    // Check if this became an approval request
                    // This happens when a user updates but doesn't have direct permission
                    if (response.isApprovalRequest || response.approvalRequestId) {
                        showToast(
                            response.message || t('Product update submitted for approval'),
                            'info',
                            3000
                        );

                        // Redirect after showing the approval message
                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index")';
                        }, 2000);

                        return false; // We're handling the redirect
                    }

                    // Normal success - direct update
                    return true; // Let AjaxHandler handle the success flow
                },

                onError: function(errorMessage, response) {
                    console.error('Product update error:', errorMessage);

                    // UNLOCK THE DOOR: Reset the flag so the user can try again
                    // This is crucial - without this, the user would be permanently locked out
                    isSubmitting = false;

                    // Restore the button to its original state
                    $submitBtn.prop('disabled', false).html(originalButtonHtml);

                    // Error message will be shown by AjaxHandler
                }
            });
        });


        // Someone else saving or deleting this product while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['product'],
            ids: { product: @Model.Id },
            label: 'product'
        });
    </script>
}
