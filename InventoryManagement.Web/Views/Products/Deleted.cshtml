@using Microsoft.AspNetCore.Mvc.Rendering
@model List<ProductViewModel>
@{
    ViewData["Title"] = "Deleted products";
    var total = ViewBag.TotalCount as int? ?? 0;
    var pageNumber = ViewBag.PageNumber as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 30;
    var search = Context.Request.Query["search"].ToString();
    // Any query value besides paging and sort is a filter, from the search box or a column header
    var hasFilters = Context.Request.Query.Any(q => q.Key is not ("pageNumber" or "pageSize" or "sort" or "dir")
        && q.Value.Any(v => !string.IsNullOrEmpty(v)));
    var hasSort = !string.IsNullOrEmpty(Context.Request.Query["sort"]);

    // Header options, built in the attribute so Razor encodes them
    var categories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var departments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var deleters = ViewBag.Deleters as IReadOnlyList<string> ?? Array.Empty<string>();
    var categoryOptions = Json.Serialize(categories.Select(c => new { value = c.Value, label = c.Text })).ToString();
    var departmentOptions = Json.Serialize(departments.Select(d => new { value = d.Value, label = d.Text })).ToString();
    var deleterOptions = Json.Serialize(deleters.Select(name => new { value = name, label = name })).ToString();
}
@* Soft-deleted products, where search and the column headers update the list in place through ListNav *@
<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                @if (User.HasPermission("product.view"))
                {
                    <li class="breadcrumb-item"><a asp-action="Index">@L["Products"]</a></li>
                }
                <li class="breadcrumb-item active">@L["Deleted products"]</li>
            </ol>
            <h1>@L["Deleted products"]</h1>
            <div class="ip-sub ip-num">@L.Plural(total, "{0} deleted product", "{0} deleted products")</div>
        </div>
    </div>

    <div class="ip-filterbar">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" name="search" value="@search" autocomplete="off"
                   placeholder="@L["Search code, model, vendor, worker..."]" aria-label="@L["Search"]" />
        </label>
        <button type="button" class="ip-btn ip-btn-ghost @(hasFilters || hasSort ? "" : "d-none")" id="resetFiltersBtn" onclick="resetFilters()">
            <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div id="deletedRegion" data-list-region>
        <div class="ip-table-wrap">
            <table class="ip-table" id="deletedProductsTable">
                <thead>
                    <tr>
                        <th><span class="visually-hidden">@L["Image"]</span></th>
                        <th data-sort="code" data-filter="text" data-param="code">@L["Code"]</th>
                        <th data-sort="product" data-filter="text" data-param="product">@L["Product"]</th>
                        <th class="hide-xl" data-sort="category" data-filter="list" data-param="categoryId" data-options="@categoryOptions">@L["Category"]</th>
                        <th data-sort="department" data-filter="list" data-param="departmentId" data-options="@departmentOptions">@L["Department"]</th>
                        <th class="hide-xl" data-sort="worker" data-filter="text" data-param="worker">@L["Worker"]</th>
                        <th data-sort="deleted" data-sort-first="desc" data-filter="date" data-param-from="deletedFrom" data-param-to="deletedTo">@L["Deleted"]</th>
                        <th data-sort="deletedBy" data-filter="list" data-param="deletedBy" data-options="@deleterOptions">@L["Deleted by"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr data-href="@Url.Action("Deleted", new { id = product.Id })">
                            <td class="thumb">
                                <span class="ip-thumb" @(string.IsNullOrEmpty(product.ImageUrl) ? "" : "data-image-preview")
                                      data-image="@product.FullImageUrl" data-title="@product.Model">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(product.FullImageUrl)" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-box" aria-hidden="true"></i>
                                    }
                                </span>
                            </td>
                            <td class="code ip-mono">@product.InventoryCode</td>
                            <td class="title">
                                <div class="cell-text">
                                    <span><a class="cell-title text-reset" href="@Url.Action("Deleted", new { id = product.Id })" title="@product.Model">@product.Model</a></span>
                                    @* Phones and narrower screens hide the category and worker columns, so the cells repeat them here *@
                                    <span class="cell-sub" title="@product.Vendor · @product.CategoryName">@product.Vendor<span class="show-xl"> · @product.CategoryName</span></span>
                                </div>
                            </td>
                            <td class="hide-sm hide-xl" title="@product.CategoryName">@product.CategoryName</td>
                            <td class="meta">
                                <div class="cell-text">
                                    <span class="cell-title fw-normal" title="@product.DepartmentName">@product.DepartmentName</span>
                                    <span class="cell-sub show-xl" title="@product.Worker">@(string.IsNullOrWhiteSpace(product.Worker) ? L["Unassigned"].Value : product.Worker)</span>
                                </div>
                            </td>
                            <td class="hide-sm hide-xl" title="@product.Worker">
                                @if (string.IsNullOrWhiteSpace(product.Worker))
                                {
                                    <span class="ip-faint">@L["Unassigned"]</span>
                                }
                                else
                                {
                                    @product.Worker
                                }
                            </td>
                            <td class="date ip-num text-nowrap" data-order="@product.DeletedAt?.ToString("yyyy-MM-dd HH:mm")">
                                @product.DeletedAt?.ToString("dd.MM.yyyy")
                                <div class="sub">@product.DeletedAt?.ToString("HH:mm")</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(product.DeletedBy) ? "-" : product.DeletedBy)</td>
                        </tr>
                    }
                    @* The headers stay when nothing matches, so their filters can be changed *@
                    @if (!Model.Any())
                    {
                        <tr class="ip-empty-row">
                            <td class="empty" colspan="8">
                                <div class="ip-empty">
                                    <span class="icon"><i class="fa-solid fa-trash-can"></i></span>
                                    <div class="title">@(hasFilters ? L["Nothing found"] : L["No deleted products"])</div>
                                    <div class="text">@(hasFilters ? L["No products match these filters"] : L["Products deleted from now on are kept here."])</div>
                                    @if (hasFilters)
                                    {
                                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                                            <span>@L["Reset filters"]</span><i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(pageNumber, pageSize, total)" />
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script>
        // Shows Reset while a header filter or sort is set, and the search box is left to search-as-you-type
        TableColumns.bindBar({ reset: '#resetFiltersBtn' });

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            ListNav.go(window.location.pathname);
        }
    </script>
}
