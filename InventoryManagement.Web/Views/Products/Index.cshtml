@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<ProductViewModel>
@{
    ViewData["Title"] = "Products";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curCategoryId = ViewBag.CurrentCategoryId as int?;
    var curDepartmentId = ViewBag.CurrentDepartmentId as int?;
    var curStatus = ViewBag.CurrentStatus as bool?;
    var curAvailability = ViewBag.CurrentAvailability as bool?;
    var curHasImage = ViewBag.CurrentHasImage as bool?;
    var curAssigned = ViewBag.CurrentAssigned as bool?;
    var curStart = ViewBag.StartDate as DateTime?;
    var curEnd = ViewBag.EndDate as DateTime?;

}

<div class="container-fluid px-4">
    @{
        var counts = ViewBag.Counts as ProductService.Application.Features.Products.Queries.ProductCountsDto;
        var hasFilters = !string.IsNullOrEmpty(currentSearch) || curCategoryId.HasValue || curDepartmentId.HasValue
            || curStatus.HasValue || curAvailability.HasValue || curStart.HasValue || curEnd.HasValue
            || curHasImage.HasValue || curAssigned.HasValue;
        var canUpdate = User.HasPermission("product.update") || User.HasPermission("product.update.direct");
        var canTransfer = User.HasPermission("route.create") || User.HasPermission("route.create.direct");
        var canChangeCode = User.HasPermission("product.code.update");
    }
    <div class="ip-page-head">
        <div>
            <h1>@L["Products"]</h1>
            @if (counts != null)
            {
                <div class="ip-sub ip-num" id="productsCounts">
                    @L["{0} products", counts.Total] · @L["{0} active", counts.Active] · @L["{0} not working", counts.NotWorking]
                </div>
            }
        </div>
        <div class="ip-page-actions">
            @if (User.HasPermission("product.deleted.view"))
            {
                <a href="/Products/Deleted" class="ip-btn ip-btn-ghost">
                    <i class="fa-solid fa-trash-can"></i><span>@L["Deleted products"]</span>
                </a>
            }
            @if (User.HasPermission("product.export"))
            {
                <button type="button" class="ip-btn ip-btn-secondary" onclick="exportProductsToPDF()">
                    <span>@L["Export PDF"]</span><i class="fa-solid fa-file-pdf"></i>
                </button>
            }
            @if (User.HasPermission("product.create") || User.HasPermission("product.create.direct"))
            {
                <a asp-action="Create" class="ip-btn ip-btn-primary">
                    <span>@L["New Product"]</span><i class="fa-solid fa-plus"></i>
                </a>
            }
        </div>
    </div>

    @* Filter bar (design: 03 Products): search and the main filters, labels inside the controls. *@
    <div class="ip-filterbar">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" value="@currentSearch" name="search" autocomplete="off"
                   placeholder="@L["Search code, model, vendor, worker..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Category"]</span>
            <select id="categoryFilter" onchange="onCategoryChange()">
                <option value="">@L["All"]</option>
                @foreach (var c in filterCategories)
                {
                    <option value="@c.Value" selected="@(c.Value == curCategoryId?.ToString())">@c.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Department"]</span>
            <select id="departmentFilter" onchange="onDepartmentChange()">
                <option value="">@L["All"]</option>
                @foreach (var d in filterDepartments)
                {
                    <option value="@d.Value" selected="@(d.Value == curDepartmentId?.ToString())">@d.Text</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["State"]</span>
            <select id="statusFilter" onchange="applyProductFilters()">
                <option value="">@L["All"]</option>
                <option value="true" selected="@(curStatus == true)">@L["Working"]</option>
                <option value="false" selected="@(curStatus == false)">@L["Not working"]</option>
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Availability"]</span>
            <select id="availabilityFilter" onchange="applyProductFilters()">
                <option value="">@L["All"]</option>
                <option value="true" selected="@(curAvailability == true)">@L["Active"]</option>
                <option value="false" selected="@(curAvailability == false)">@L["Inactive"]</option>
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Created"]</span>
            <input type="text" id="dateRange" class="date-range-input" placeholder="@L["Any date"]" size="12" />
        </label>
        <button type="button" class="ip-btn ip-btn-ghost @(curAssigned == false ? "is-on" : "")" aria-pressed="@(curAssigned == false ? "true" : "false")" onclick="quickFilter('unassigned')">@L["Unassigned"]</button>
        <button type="button" class="ip-btn ip-btn-ghost @(curHasImage == false ? "is-on" : "")" aria-pressed="@(curHasImage == false ? "true" : "false")" onclick="quickFilter('noImage')">@L["No image"]</button>
        @if (hasFilters)
        {
            <button type="button" class="ip-btn ip-btn-ghost" onclick="resetProductFilters()">
                <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
            </button>
        }
    </div>

    <div id="productsRegion" data-list-region>
        <div class="ip-table-wrap">
            @if (Model.Items.Any())
            {
                <table class="ip-table" id="productsTable">
                    <thead>
                        <tr>
                            <th class="pdf-omit" style="width: 60px"><span class="visually-hidden">@L["Image"]</span></th>
                            <th>@L["Code"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["Department and worker"]</th>
                            <th class="d-none">@L["Description"]</th>
                            <th>@L["Updated"]</th>
                            <th>@L["State"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr data-href="@Url.Action("Details", new { id = product.Id })">
                                <td>
                                    <span class="ip-thumb">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.FullImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-box" aria-hidden="true"></i>
                                        }
                                    </span>
                                </td>
                                <td data-no-row-link>
                                    @if (canChangeCode)
                                    {
                                        <span class="ip-mono inventory-code-display" data-id="@product.Id" title="@L["Double-click to change the code"]">@product.InventoryCode</span>
                                        <div class="inventory-code-edit d-none" data-id="@product.Id">
                                            <div class="d-flex align-items-center gap-1">
                                                <input type="number" class="ip-input ip-input-sm mono inventory-code-input"
                                                       value="@product.InventoryCode" min="1" max="9999" data-id="@product.Id" aria-label="@L["Inventory Code"]">
                                                <button type="button" class="ip-btn-icon save-inventory-code" data-id="@product.Id" title="@L["Save"]" aria-label="@L["Save"]">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                                <button type="button" class="ip-btn-icon cancel-inventory-code" data-id="@product.Id" title="@L["Cancel"]" aria-label="@L["Cancel"]">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="ip-mono">@product.InventoryCode</span>
                                    }
                                </td>
                                <td>
                                    <div class="cell-text">
                                        <span><a class="cell-title text-reset" href="@Url.Action("Details", new { id = product.Id })">@product.Model</a>@if (product.IsNewItem)
                                            {
                                                <span class="ip-tag-plain ms-2">@L["New"]</span>
                                            }</span>
                                        <span class="cell-sub">@product.Vendor · @product.CategoryName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title fw-normal">@product.DepartmentName</span>
                                        @if (!string.IsNullOrEmpty(product.Worker))
                                        {
                                            <span class="cell-sub">@product.Worker</span>
                                        }
                                        else
                                        {
                                            <span class="cell-sub pdf-omit">@L["Unassigned"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="d-none">@product.Description</td>
                                <td class="ip-num text-nowrap">@((product.UpdatedAt ?? product.CreatedAt)?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td>
                                    <div class="state-stack flex-column align-items-start">
                                        @if (product.IsWorking)
                                        {
                                            <span class="ip-badge ip-badge-success">@L["Working"]</span>
                                        }
                                        else
                                        {
                                            <span class="ip-badge ip-badge-danger">@L["Not working"]</span>
                                        }
                                        @if (product.HasPendingApproval)
                                        {
                                            <span class="ip-status-text warning">@L["Awaiting approval"]</span>
                                        }
                                        @if (!product.IsActive)
                                        {
                                            <span class="ip-tag-plain">@L["Inactive"]</span>
                                        }
                                    </div>
                                </td>
                                <td data-no-row-link>
                                    <div class="actions">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        @if (canUpdate)
                                        {
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }
                                        @if (canTransfer && product.IsActive)
                                        {
                                            <a href="@Url.Action("Transfer", "Routes", new { code = product.InventoryCode })" class="ip-btn-icon" title="@L["Transfer"]" aria-label="@L["Transfer"]">
                                                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="ip-empty">
                    <span class="icon"><i class="fa-solid fa-box-open"></i></span>
                    <div class="title">@L["Nothing found"]</div>
                    <div class="text">@(hasFilters ? L["No products match these filters"] : L["There are no products yet."])</div>
                    @if (hasFilters)
                    {
                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetProductFilters()">
                            <span>@L["Reset filters"]</span><i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            }
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/list-filters.js" asp-append-version="true"></script>
    <script>
        const productFilters = ListFilters.init({
            basePath: '/Products',
            pageSize: @Model.PageSize,
            pairs: @Html.Raw(ViewBag.FilterPairsJson ?? "[]"),   // [[departmentId, categoryId], ...]
            categoryKey: 'id',
            fields: {
                status: '#statusFilter',
                availability: '#availabilityFilter',
                categoryId: '#categoryFilter',
                departmentId: '#departmentFilter'
            },
            // Server-side quick flags with no control of their own.
            urlFlags: ['hasImage', 'assigned']
        });

        // Names used by the markup's onclick/onchange handlers.
        function applyProductFilters() { productFilters.apply(); }
        function onDepartmentChange() { productFilters.onDepartmentChange(); }
        function onCategoryChange() { productFilters.onCategoryChange(); }
        function removeFilter(key) { productFilters.remove(key); }
        function resetProductFilters() { productFilters.reset(); }

        // One-click presets with no control of their own: URL-only flags.
        function quickFilter(kind) {
            if (kind === 'unassigned') {
                productFilters.toggleFlag('assigned');
            } else if (kind === 'noImage') {
                productFilters.toggleFlag('hasImage');
            }
        }

        // Double-click to edit inventory code
        $(document).on('dblclick', '.inventory-code-display', function() {
            const id = $(this).data('id');
            $(this).addClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-input[data-id="${id}"]`).focus().select();
        });

        // Save inventory code
        $(document).on('click', '.save-inventory-code', function() {
            const id = $(this).data('id');
            const newCode = $(`.inventory-code-input[data-id="${id}"]`).val();

            if (newCode < 1 || newCode > 9999) {
                showToast(t('Inventory code must be between 1 and 9999'), 'error');
                return;
            }

            const $btn = $(this);
            const originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: '/Products/UpdateInventoryCode',
                type: 'POST',
                data: JSON.stringify({
                    id: id,
                    inventoryCode: parseInt(newCode)
                }),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function() {
                    $(`.inventory-code-display[data-id="${id}"]`).text(newCode).removeClass('d-none');
                    $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
                    showToast(t('Inventory code updated successfully'), 'success');
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.error || t('Failed to update inventory code');
                    showToast(errorMsg, 'error');
                },
                complete: function() {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // Cancel inventory code edit
        $(document).on('click', '.cancel-inventory-code', function() {
            const id = $(this).data('id');
            $(`.inventory-code-display[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
        });

        // Keyboard shortcuts for inventory code editing
        $(document).on('keydown', '.inventory-code-input', function(e) {
            const id = $(this).data('id');
            if (e.which === 13) { // Enter key
                e.preventDefault();
                $(`.save-inventory-code[data-id="${id}"]`).click();
            } else if (e.which === 27) { // Escape key
                $(`.cancel-inventory-code[data-id="${id}"]`).click();
            }
        });

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['product', 'category', 'department'],
            regions: ['#productsCounts', '#productsRegion'],
            // An inventory code being edited in a row must not be swapped away.
            isEditing: () => $('.inventory-code-input:visible').length > 0
        });
    </script>
}