@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<ProductViewModel>
@{
    ViewData["Title"] = "Products";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curCategoryId = ViewBag.CurrentCategoryId as int?;
    var curDepartmentId = ViewBag.CurrentDepartmentId as int?;
    var curStatus = ViewBag.CurrentStatus as bool?;
    var curAvailability = ViewBag.CurrentAvailability as bool?;
    var curHasImage = ViewBag.CurrentHasImage as bool?;
    var curAssigned = ViewBag.CurrentAssigned as bool?;
    var curStart = ViewBag.StartDate as DateTime?;
    var curEnd = ViewBag.EndDate as DateTime?;

    string CategoryName(int? id) => filterCategories.FirstOrDefault(c => c.Value == id.ToString())?.Text ?? id?.ToString() ?? "";
    string DepartmentName(int? id) => filterDepartments.FirstOrDefault(d => d.Value == id.ToString())?.Text ?? id?.ToString() ?? "";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Products</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Products</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportProductsToPDF()">
                <i class="fas fa-file-pdf"></i> Export PDF
            </button>
            @if (User.HasPermission("product.create") || User.HasPermission("product.create.direct"))
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> New Product
                </a>
            }
        </div>
    </div>

    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" value="@currentSearch" name="search"
                           placeholder="Search code, model, vendor, worker..." />
                </div>
            </div>
            <button class="btn btn-primary btn-sm" onclick="applyProductFilters()">
                <i class="fas fa-filter"></i> Apply
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetProductFilters()">
                <i class="fas fa-redo"></i> Reset
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="categoryFilter">Category</label>
                <select id="categoryFilter" class="form-select form-select-sm" onchange="onCategoryChange()">
                    <option value="">All categories</option>
                    @foreach (var c in filterCategories)
                    {
                        <option value="@c.Value" selected="@(c.Value == curCategoryId?.ToString())">@c.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="departmentFilter">Department</label>
                <select id="departmentFilter" class="form-select form-select-sm" onchange="onDepartmentChange()">
                    <option value="">All departments</option>
                    @foreach (var d in filterDepartments)
                    {
                        <option value="@d.Value" selected="@(d.Value == curDepartmentId?.ToString())">@d.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="statusFilter">Working state</label>
                <select id="statusFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    <option value="">All</option>
                    <option value="true" selected="@(curStatus == true)">Working</option>
                    <option value="false" selected="@(curStatus == false)">Not working</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="availabilityFilter">Availability</label>
                <select id="availabilityFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    <option value="">All</option>
                    <option value="true" selected="@(curAvailability == true)">Active</option>
                    <option value="false" selected="@(curAvailability == false)">Inactive</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="dateRange">Created between</label>
                <input type="text" id="dateRange" class="form-control form-control-sm" placeholder="Any date" />
            </div>
            <div class="filter-field">
                <label for="pageSizeFilter">Rows per page</label>
                <select id="pageSizeFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    @foreach (var size in new[] { 15, 30, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="filter-quick">
            <span class="qlabel">Quick</span>
            <span class="qchip @(curStatus == false ? "active" : "")" onclick="quickFilter('notWorking')">Not working</span>
            <span class="qchip @(curAvailability == false ? "active" : "")" onclick="quickFilter('inactive')">Inactive</span>
            <span class="qchip @(curAssigned == false ? "active" : "")" onclick="quickFilter('unassigned')">Unassigned</span>
            <span class="qchip @(curHasImage == false ? "active" : "")" onclick="quickFilter('noImage')">No image</span>
        </div>

        @{
            var hasFilters = !string.IsNullOrEmpty(currentSearch) || curCategoryId.HasValue || curDepartmentId.HasValue
                || curStatus.HasValue || curAvailability.HasValue || curStart.HasValue || curEnd.HasValue
                || curHasImage.HasValue || curAssigned.HasValue;
        }
        @if (hasFilters)
        {
            <div class="filter-applied">
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    @* One chip per search word; each × removes just that word (data-word is Razor-encoded). *@
                    foreach (var word in currentSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="achip">Search: <b>@word</b><button type="button" class="achip-x achip-word" data-word="@word">&times;</button></span>
                    }
                }
                @if (curCategoryId.HasValue)
                {
                    <span class="achip">Category: <b>@CategoryName(curCategoryId)</b><button type="button" class="achip-x" onclick="removeFilter('categoryId')">&times;</button></span>
                }
                @if (curDepartmentId.HasValue)
                {
                    <span class="achip">Department: <b>@DepartmentName(curDepartmentId)</b><button type="button" class="achip-x" onclick="removeFilter('departmentId')">&times;</button></span>
                }
                @if (curStatus.HasValue)
                {
                    <span class="achip">Working: <b>@(curStatus.Value ? "Yes" : "No")</b><button type="button" class="achip-x" onclick="removeFilter('status')">&times;</button></span>
                }
                @if (curAvailability.HasValue)
                {
                    <span class="achip">Active: <b>@(curAvailability.Value ? "Yes" : "No")</b><button type="button" class="achip-x" onclick="removeFilter('availability')">&times;</button></span>
                }
                @if (curStart.HasValue || curEnd.HasValue)
                {
                    <span class="achip">Created: <b>@(curStart?.ToString("dd.MM.yyyy")) - @(curEnd?.ToString("dd.MM.yyyy"))</b><button type="button" class="achip-x" onclick="removeFilter('dates')">&times;</button></span>
                }
                @if (curAssigned == false)
                {
                    <span class="achip"><b>Unassigned</b><button type="button" class="achip-x" onclick="removeFilter('assigned')">&times;</button></span>
                }
                @if (curHasImage == false)
                {
                    <span class="achip"><b>No image</b><button type="button" class="achip-x" onclick="removeFilter('hasImage')">&times;</button></span>
                }
                <button type="button" class="filter-clear" onclick="resetProductFilters()">Clear all</button>
            </div>
        }
    </div>

    <div class="result-bar">
        <span><b>@Model.TotalCount</b> product@(Model.TotalCount == 1 ? "" : "s")@(hasFilters ? " matched" : "")</span>
        <span class="text-muted">Page @Model.PageNumber</span>
    </div>

    <div class="card mb-4">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="productsTable">
                        <thead>
                            <tr>
                                <th style="width: 96px;">Code</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Department</th>
                                <th>Assigned</th>
                                <th>State</th>
                                <th style="width: 96px;">Created</th>
                                <th style="width: 104px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Items)
                            {
                                <tr class="@(product.HasPendingApproval ? "row-crit" : (!product.IsWorking ? "row-warn" : ""))">
                                    <td>
                                        <span class="badge bg-primary fs-6 inventory-code-display" data-id="@product.Id">
                                            @product.InventoryCode
                                        </span>
                                        <div class="inventory-code-edit d-none" data-id="@product.Id">
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control form-control-sm inventory-code-input"
                                                       value="@product.InventoryCode" min="1" max="9999" data-id="@product.Id">
                                                <button class="btn btn-success btn-sm save-inventory-code" data-id="@product.Id">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button class="btn btn-secondary btn-sm cancel-inventory-code" data-id="@product.Id">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cell-item">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.FullImageUrl" class="cell-thumb"
                                                     style="cursor: pointer;"
                                                     onclick="showImageModal('@product.FullImageUrl','@product.Model')"
                                                     alt="@product.Model">
                                            }
                                            else
                                            {
                                                <div class="cell-thumb cell-thumb-empty"><i class="fas fa-image"></i></div>
                                            }
                                            <div class="cell-text">
                                                <span class="cell-title" title="@product.Description">@product.Model</span>
                                                <span class="cell-sub">@product.Vendor</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@product.CategoryName</td>
                                    <td class="desc-cell">
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <span class="desc-text" title="@product.Description">@product.Description</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted pdf-omit">-</span>
                                        }
                                    </td>
                                    <td>@product.DepartmentName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Worker))
                                        {
                                            @product.Worker
                                        }
                                        else
                                        {
                                            <span class="text-muted pdf-omit">Unassigned</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="state-stack">
                                            @if (product.HasPendingApproval)
                                            {
                                                <span class="state state-crit">Pending</span>
                                            }
                                            @if (!product.IsWorking)
                                            {
                                                <span class="state state-warn">Not working</span>
                                            }
                                            else if (!product.HasPendingApproval)
                                            {
                                                <span class="state state-ok">Working</span>
                                            }
                                            @if (!product.IsActive)
                                            {
                                                <span class="state state-flat state-idle">Inactive</span>
                                            }
                                            @if (product.IsNewItem)
                                            {
                                                <span class="state state-flat state-new">New</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="num text-muted">@(product.CreatedAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if(User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            @if(User.HasPermission("product.delete") || User.HasPermission("product.delete.direct"))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteProduct(@product.Id)" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h5>No products match these filters</h5>
                    <p class="text-muted mb-3">Clear the filters to see the full inventory, or add a new product.</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm me-1" onclick="resetProductFilters()">Clear filters</button>
                    @if (User.HasPermission("product.create") || User.HasPermission("product.create.direct"))
                    {
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> New product
                        </a>
                    }
                </div>
            }
        </div>
        <div class="card-footer">
            <partial name="_ProductPagination" model="Model" />
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this product?</p>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> This action may require approval from an administrator.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Delete Product
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        let currentDeleteProductId = null;
        // Initialize date range picker when document is ready
        $(document).ready(function() {
            // Initialize date range picker with proper configuration
            $('#dateRange').daterangepicker({
                autoUpdateInput: false,
                locale: {
                    cancelLabel: 'Clear',
                    format: 'MM/DD/YYYY'
                },
                opens: 'left'
            });

            // Handle date range selection - apply immediately, like the other filters do.
            $('#dateRange').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
                applyProductFilters();
            });

            // "Clear" drops the date filter and reloads (only if one was set).
            $('#dateRange').on('cancel.daterangepicker', function(ev, picker) {
                const hadValue = $(this).val() !== '';
                $(this).val('');
                if (hadValue) {
                    removeFilter('dates');
                }
            });

            // Restore filter values from query parameters
            restoreFilterValues();

            // Reflect the current department/category selection in the cascading dropdowns.
            cascadeCategoryOptions();
            cascadeDepartmentOptions();
        });

        // Restore filter values from URL parameters
        function restoreFilterValues() {
            const params = new URLSearchParams(window.location.search);

            // Restore search
            const search = params.get('search');
            if (search) {
                $('#searchInput').val(search);
            }

            // Restore date range
            const startDate = params.get('startDate');
            const endDate = params.get('endDate');
            if (startDate && endDate) {
                const formattedStart = moment(startDate).format('MM/DD/YYYY');
                const formattedEnd = moment(endDate).format('MM/DD/YYYY');
                $('#dateRange').val(formattedStart + ' - ' + formattedEnd);
            }

            // Restore status filter
            const status = params.get('status');
            if (status !== null) {
                $('#statusFilter').val(status);
            }

            // Restore availability filter
            const availability = params.get('availability');
            if (availability !== null) {
                $('#availabilityFilter').val(availability);
            }
        }

        // Cascading filters: which categories occur in which department. Built from the
        // [[deptId, catId], ...] facet list the server emits, into two lookup maps.
        const FILTER_PAIRS = @Html.Raw(ViewBag.FilterPairsJson ?? "[]");
        const deptToCats = new Map();   // departmentId -> Set(categoryId)
        const catToDepts = new Map();   // categoryId   -> Set(departmentId)
        FILTER_PAIRS.forEach(function (pair) {
            const dep = pair[0], cat = pair[1];
            if (!deptToCats.has(dep)) deptToCats.set(dep, new Set());
            if (!catToDepts.has(cat)) catToDepts.set(cat, new Set());
            deptToCats.get(dep).add(cat);
            catToDepts.get(cat).add(dep);
        });

        // Show only the category options that exist in the selected department (all when none).
        function cascadeCategoryOptions() {
            const dep = parseInt($('#departmentFilter').val(), 10);
            const allowed = Number.isNaN(dep) ? null : (deptToCats.get(dep) || new Set());
            document.querySelectorAll('#categoryFilter option').forEach(function (opt) {
                if (opt.value === '') { opt.hidden = false; return; }
                opt.hidden = allowed ? !allowed.has(parseInt(opt.value, 10)) : false;
            });
        }

        // Show only the department options that contain the selected category (all when none).
        function cascadeDepartmentOptions() {
            const cat = parseInt($('#categoryFilter').val(), 10);
            const allowed = Number.isNaN(cat) ? null : (catToDepts.get(cat) || new Set());
            document.querySelectorAll('#departmentFilter option').forEach(function (opt) {
                if (opt.value === '') { opt.hidden = false; return; }
                opt.hidden = allowed ? !allowed.has(parseInt(opt.value, 10)) : false;
            });
        }

        function onDepartmentChange() {
            const dep = parseInt($('#departmentFilter').val(), 10);
            const cat = parseInt($('#categoryFilter').val(), 10);
            // If the chosen category doesn't exist in the new department, drop it - avoids an
            // empty result the user didn't ask for.
            if (!Number.isNaN(dep) && !Number.isNaN(cat) && !(deptToCats.get(dep) || new Set()).has(cat)) {
                $('#categoryFilter').val('');
            }
            cascadeCategoryOptions();
            applyProductFilters();
        }

        function onCategoryChange() {
            const cat = parseInt($('#categoryFilter').val(), 10);
            const dep = parseInt($('#departmentFilter').val(), 10);
            if (!Number.isNaN(cat) && !Number.isNaN(dep) && !(catToDepts.get(cat) || new Set()).has(dep)) {
                $('#departmentFilter').val('');
            }
            cascadeDepartmentOptions();
            applyProductFilters();
        }

        // Collect every active filter control into query params. `hasImage`/`assigned` have no
        // dropdown, so they are carried over from the current URL (a quick chip toggles them).
        function collectFilterParams() {
            const params = new URLSearchParams();

            const searchTerm = $('#searchInput').val().trim();
            if (searchTerm) {
                params.append('search', searchTerm);
            }

            const dateRange = $('#dateRange').val();
            if (dateRange) {
                const dates = dateRange.split(' - ');
                if (dates.length === 2) {
                    params.append('startDate', moment(dates[0], 'MM/DD/YYYY').format('YYYY-MM-DD'));
                    params.append('endDate', moment(dates[1], 'MM/DD/YYYY').format('YYYY-MM-DD'));
                }
            }

            const status = $('#statusFilter').val();
            if (status !== '') {
                params.append('status', status);
            }

            const availability = $('#availabilityFilter').val();
            if (availability !== '') {
                params.append('availability', availability);
            }

            const categoryId = $('#categoryFilter').val();
            if (categoryId) {
                params.append('categoryId', categoryId);
            }

            const departmentId = $('#departmentFilter').val();
            if (departmentId) {
                params.append('departmentId', departmentId);
            }

            // Preserve the two URL-only quick flags across any other filter change.
            const cur = new URLSearchParams(window.location.search);
            ['hasImage', 'assigned'].forEach(function (k) {
                if (cur.get(k) === 'false') params.set(k, 'false');
            });

            const pageSize = $('#pageSizeFilter').val() || '@Model.PageSize';
            params.append('pageSize', pageSize);
            params.append('pageNumber', '1');
            return params;
        }

        // Apply all filters and reload the page with query parameters.
        function applyProductFilters() {
            window.location.href = '/Products?' + collectFilterParams().toString();
        }

        // One-click presets. "Not working"/"Inactive" drive their dropdowns; "Unassigned"/"No image"
        // are server-side flags with no control, so they toggle directly in the URL.
        function quickFilter(kind) {
            if (kind === 'notWorking') {
                $('#statusFilter').val($('#statusFilter').val() === 'false' ? '' : 'false');
                applyProductFilters();
            } else if (kind === 'inactive') {
                $('#availabilityFilter').val($('#availabilityFilter').val() === 'false' ? '' : 'false');
                applyProductFilters();
            } else if (kind === 'unassigned') {
                toggleQuickFlag('assigned');
            } else if (kind === 'noImage') {
                toggleQuickFlag('hasImage');
            }
        }

        // Flip a URL-only quick flag on/off while preserving every other active filter.
        function toggleQuickFlag(key) {
            const params = collectFilterParams();
            if (params.get(key) === 'false') { params.delete(key); }
            else { params.set(key, 'false'); }
            params.set('pageNumber', '1');
            window.location.href = '/Products?' + params.toString();
        }

        // Drop a single applied filter and reload.
        function removeFilter(key) {
            const params = new URLSearchParams(window.location.search);
            if (key === 'dates') {
                params.delete('startDate');
                params.delete('endDate');
            } else {
                params.delete(key);
            }
            params.set('pageNumber', '1');
            window.location.href = '/Products?' + params.toString();
        }

        // Drop a single word from a multi-word search (its own chip's ×).
        function removeSearchWord(word) {
            const params = new URLSearchParams(window.location.search);
            const remaining = (params.get('search') || '')
                .split(/\s+/)
                .filter(w => w && w.toLowerCase() !== word.toLowerCase());
            if (remaining.length) { params.set('search', remaining.join(' ')); }
            else { params.delete('search'); }
            params.set('pageNumber', '1');
            window.location.href = '/Products?' + params.toString();
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.achip-word').forEach(function (b) {
                b.addEventListener('click', function () { removeSearchWord(b.dataset.word); });
            });
        });

        // Make search work on Enter key
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                applyProductFilters();
            }
        });

        // Reset all filters and reload the page
        function resetProductFilters() {
            $('#searchInput').val('');
            $('#dateRange').val('');
            $('#statusFilter').val('');
            $('#availabilityFilter').val('');
            $('#categoryFilter').val('');
            $('#departmentFilter').val('');
            window.location.href = '/Products?pageSize=@Model.PageSize&pageNumber=1';
        }

        // Change page with current filters maintained
        function changePage(page) {
            const params = new URLSearchParams(window.location.search);
            params.set('pageNumber', page);

            // Ensure we always have pageSize
            if (!params.has('pageSize')) {
                params.set('pageSize', '@Model.PageSize');
            }

            window.location.href = '/Products?' + params.toString();
        }

        // Delete product confirmation
        function deleteProduct(id) {
            currentDeleteProductId = id;
            $('#deleteModal').modal('show');
        }

                // Handle the delete confirmation
        $('#confirmDeleteBtn').on('click', function() {
            const $btn = $(this);
            const originalHtml = $btn.html();

            // Show loading state
            $btn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2"></span>Deleting...');

            // Perform AJAX delete request
            $.ajax({
                url: `/Products/Delete/${currentDeleteProductId}`,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    // First, check if this went to approval
                    if (response.isApprovalRequest) {
                        // Product deletion requires approval
                        $('#deleteModal').modal('hide');

                        // Show detailed approval notification
                        showToast(
                            response.message || 'Product deletion has been submitted for approval. An administrator will review your request.',
                            'info',
                            8000
                        );

                        // Add a visual indicator to the product row
                        const $productRow = $(`tr:has(button[onclick="deleteProduct(${currentDeleteProductId})"])`);
                        if ($productRow.length) {
                            // Add pending badge to the status column
                            const $statusCell = $productRow.find('td:nth-child(5)'); // Adjust based on your table structure
                            $statusCell.append('<span class="badge bg-warning ms-1"><i class="fas fa-clock"></i> Deletion Pending</span>');

                            // Disable the action buttons
                            $productRow.find('.btn-group button').prop('disabled', true).addClass('opacity-50');
                        }

                        // Optionally show a more prominent notification
                        if (response.approvalRequestId) {
                            showApprovalRequestInfo(response.approvalRequestId);
                        }

                    } 
                    else if (response.isSuccess !== false) {
                        // Product was deleted successfully (direct deletion)
                        $('#deleteModal').modal('hide');

                        showToast('Product deleted successfully', 'success');

                        // Remove the product row with animation
                        const $productRow = $(`tr:has(button[onclick="deleteProduct(${currentDeleteProductId})"])`);
                        $productRow.fadeOut(500, function() {
                            $(this).remove();

                            // Check if table is now empty
                            if ($('#productsTable tbody tr').length === 0) {
                                location.reload(); // Reload to show empty state
                            }
                        });

                        // Update the product count if displayed
                        updateProductCount(-1);

                    } 
                    else {
                        // Deletion failed
                        showToast(
                            response.message || 'Failed to delete product. Please try again.',
                            'error'
                        );

                        // Keep modal open for retry
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function(xhr) {
                    // Handle different error scenarios
                    let errorMessage = 'An error occurred while deleting the product';

                    if (xhr.status === 401) {
                        errorMessage = 'Your session has expired. Please login again.';
                        setTimeout(() => window.location.href = '/Account/Login', 2000);
                    } else if (xhr.status === 403) {
                        errorMessage = 'You do not have permission to delete this product.';
                    } else if (xhr.status === 409) {
                        errorMessage = 'This product cannot be deleted because it has associated routes or transfers.';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }

                    showToast(errorMessage, 'error', 7000);

                    // Re-enable the button for retry
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

                // Helper function to show approval request details
        function showApprovalRequestInfo(requestId) {
            const infoHtml = `
                <div class="alert alert-info alert-dismissible fade show position-fixed"
                     style="top: 100px; right: 20px; z-index: 9999; max-width: 400px;">
                    <h6 class="alert-heading">
                        <i class="fas fa-info-circle me-2"></i>Approval Request Created
                    </h6>
                    <p class="mb-2">Your deletion request has been submitted with ID: <strong>#${requestId}</strong></p>
                    <small class="text-muted">You can track the status in the My Requests section.</small>
                    <hr class="my-2">
                    <div class="d-flex gap-2">
                        <a href="/Approvals/MyRequests" class="btn btn-sm btn-info">
                            <i class="fas fa-list me-1"></i>View My Requests
                        </a>
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="alert">
                            Close
                        </button>
                    </div>
                </div>
            `;

            $('body').append(infoHtml);

            // Auto-hide after 10 seconds
            setTimeout(() => {
                $('.alert-info[style*="position: fixed"]').fadeOut(500, function() {
                    $(this).remove();
                });
            }, 10000);
        }

        function updateProductCount(change) {
            const $countElement = $('.showing-text');
            if ($countElement.length) {
                const currentText = $countElement.text();
                const match = currentText.match(/of (\d+) products/);
                if (match) {
                    const currentTotal = parseInt(match[1]);
                    const newTotal = Math.max(0, currentTotal + change);
                    $countElement.text(currentText.replace(/of \d+ products/, `of ${newTotal} products`));
                }
            }
        }

        $('#deleteModal').on('keydown', function(e) {
            if (e.key === 'Escape') {
                $(this).modal('hide');
            }
        });

        // Reset when modal is hidden
        $('#deleteModal').on('hidden.bs.modal', function() {
            currentDeleteProductId = null;
            $('#confirmDeleteBtn').prop('disabled', false)
                .html('<i class="fas fa-trash me-2"></i>Delete Product');
        });

        // Double-click to edit inventory code
        $(document).on('dblclick', '.inventory-code-display', function() {
            const id = $(this).data('id');
            $(this).addClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-input[data-id="${id}"]`).focus().select();
        });

        // Save inventory code
        $(document).on('click', '.save-inventory-code', function() {
            const id = $(this).data('id');
            const newCode = $(`.inventory-code-input[data-id="${id}"]`).val();

            if (newCode < 1 || newCode > 9999) {
                showToast('Inventory code must be between 1 and 9999', 'error');
                return;
            }

            const $btn = $(this);
            const originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: '/Products/UpdateInventoryCode',
                type: 'POST',
                data: JSON.stringify({
                    id: id,
                    inventoryCode: parseInt(newCode)
                }),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function() {
                    $(`.inventory-code-display[data-id="${id}"]`).text(newCode).removeClass('d-none');
                    $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
                    showToast('Inventory code updated successfully', 'success');
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.error || 'Failed to update inventory code';
                    showToast(errorMsg, 'error');
                },
                complete: function() {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // Cancel inventory code edit
        $(document).on('click', '.cancel-inventory-code', function() {
            const id = $(this).data('id');
            $(`.inventory-code-display[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
        });

        // Keyboard shortcuts for inventory code editing
        $(document).on('keydown', '.inventory-code-input', function(e) {
            const id = $(this).data('id');
            if (e.which === 13) { // Enter key
                e.preventDefault();
                $(`.save-inventory-code[data-id="${id}"]`).click();
            } else if (e.which === 27) { // Escape key
                $(`.cancel-inventory-code[data-id="${id}"]`).click();
            }
        });

        // Show image modal
        function showImageModal(imageUrl, title) {
            $('#globalModalImage').attr('src', imageUrl);
            $('#globalImageModal .modal-title').text(title || 'Image Preview');
            $('#globalImageModal').modal('show');
        }
    </script>
    <script>
        // Real-time search functionality
        let searchTimeout;
        const searchInput = document.getElementById('searchInput');
        const searchForm = document.getElementById('searchForm');

        if (searchInput && searchForm) {
            searchInput.addEventListener('input', function(e) {
                clearTimeout(searchTimeout);

                // Show loading indicator
                const submitBtn = searchForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Searching...';
                }

                searchTimeout = setTimeout(() => {
                    searchForm.submit();
                }, 500); // Wait 500ms after user stops typing
            });
        }

        // Update the showing text dynamically
        function updateShowingText() {
            const totalCount = @(ViewBag.TotalCount ?? 0);
            const showingStart = @(ViewBag.ShowingStart ?? 0);
            const showingEnd = @(ViewBag.ShowingEnd ?? 0);

            const showingText = document.querySelector('.showing-text');
            if (showingText) {
                if (totalCount === 0) {
                    showingText.textContent = 'No products found';
                } else {
                    showingText.textContent = `Showing ${showingStart}-${showingEnd} of ${totalCount} products`;
                }
            }
        }

        // Call on page load
        document.addEventListener('DOMContentLoaded', updateShowingText);
    </script>
}