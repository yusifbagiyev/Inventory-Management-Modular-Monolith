@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResultDto<ProductViewModel>
@{
    ViewData["Title"] = "Products";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var filterCategories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
    var filterDepartments = ViewBag.FilterDepartments as List<SelectListItem> ?? new List<SelectListItem>();
    var curCategoryId = ViewBag.CurrentCategoryId as int?;
    var curDepartmentId = ViewBag.CurrentDepartmentId as int?;
    var curStatus = ViewBag.CurrentStatus as bool?;
    var curAvailability = ViewBag.CurrentAvailability as bool?;
    var curHasImage = ViewBag.CurrentHasImage as bool?;
    var curAssigned = ViewBag.CurrentAssigned as bool?;
    var curStart = ViewBag.StartDate as DateTime?;
    var curEnd = ViewBag.EndDate as DateTime?;

    string CategoryName(int? id) => filterCategories.FirstOrDefault(c => c.Value == id.ToString())?.Text ?? id?.ToString() ?? "";
    string DepartmentName(int? id) => filterDepartments.FirstOrDefault(d => d.Value == id.ToString())?.Text ?? id?.ToString() ?? "";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Products"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportProductsToPDF()">
                <i class="fas fa-file-pdf"></i> @L["Export PDF"]
            </button>
            @if (User.HasPermission("product.create") || User.HasPermission("product.create.direct"))
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> @L["New Product"]
                </a>
            }
        </div>
    </div>

    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" value="@currentSearch" name="search"
                           placeholder="@L["Search code, model, vendor, worker..."]" />
                </div>
            </div>
            <button class="btn btn-primary btn-sm" onclick="applyProductFilters()">
                <i class="fas fa-filter"></i> @L["Apply"]
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetProductFilters()">
                <i class="fas fa-redo"></i> @L["Reset"]
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="categoryFilter">@L["Category"]</label>
                <select id="categoryFilter" class="form-select form-select-sm" onchange="onCategoryChange()">
                    <option value="">@L["All categories"]</option>
                    @foreach (var c in filterCategories)
                    {
                        <option value="@c.Value" selected="@(c.Value == curCategoryId?.ToString())">@c.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="departmentFilter">@L["Department"]</label>
                <select id="departmentFilter" class="form-select form-select-sm" onchange="onDepartmentChange()">
                    <option value="">@L["All departments"]</option>
                    @foreach (var d in filterDepartments)
                    {
                        <option value="@d.Value" selected="@(d.Value == curDepartmentId?.ToString())">@d.Text</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="statusFilter">@L["Working state"]</label>
                <select id="statusFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    <option value="">@L["All"]</option>
                    <option value="true" selected="@(curStatus == true)">@L["Working"]</option>
                    <option value="false" selected="@(curStatus == false)">@L["Not working"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="availabilityFilter">@L["Availability"]</label>
                <select id="availabilityFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    <option value="">@L["All"]</option>
                    <option value="true" selected="@(curAvailability == true)">@L["Active"]</option>
                    <option value="false" selected="@(curAvailability == false)">@L["Inactive"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="dateRange">@L["Created between"]</label>
                <input type="text" id="dateRange" class="form-control form-control-sm" placeholder="@L["Any date"]" />
            </div>
            <div class="filter-field">
                <label for="pageSizeFilter">@L["Rows per page"]</label>
                <select id="pageSizeFilter" class="form-select form-select-sm" onchange="applyProductFilters()">
                    @foreach (var size in new[] { 15, 30, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="filter-quick">
            <span class="qlabel">@L["Quick"]</span>
            <span class="qchip @(curStatus == false ? "active" : "")" onclick="quickFilter('notWorking')">@L["Not working"]</span>
            <span class="qchip @(curAvailability == false ? "active" : "")" onclick="quickFilter('inactive')">@L["Inactive"]</span>
            <span class="qchip @(curAssigned == false ? "active" : "")" onclick="quickFilter('unassigned')">@L["Unassigned"]</span>
            <span class="qchip @(curHasImage == false ? "active" : "")" onclick="quickFilter('noImage')">@L["No image"]</span>
        </div>

        @{
            var hasFilters = !string.IsNullOrEmpty(currentSearch) || curCategoryId.HasValue || curDepartmentId.HasValue
                || curStatus.HasValue || curAvailability.HasValue || curStart.HasValue || curEnd.HasValue
                || curHasImage.HasValue || curAssigned.HasValue;
        }
        @if (hasFilters)
        {
            <div class="filter-applied">
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    @* One chip per search word; each × removes just that word (data-word is Razor-encoded). *@
                    foreach (var word in currentSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="achip">@L["Search:"] <b>@word</b><button type="button" class="achip-x achip-word" data-word="@word">&times;</button></span>
                    }
                }
                @if (curCategoryId.HasValue)
                {
                    <span class="achip">@L["Category"]: <b>@CategoryName(curCategoryId)</b><button type="button" class="achip-x" onclick="removeFilter('categoryId')">&times;</button></span>
                }
                @if (curDepartmentId.HasValue)
                {
                    <span class="achip">@L["Department"]: <b>@DepartmentName(curDepartmentId)</b><button type="button" class="achip-x" onclick="removeFilter('departmentId')">&times;</button></span>
                }
                @if (curStatus.HasValue)
                {
                    <span class="achip">@L["Working"]: <b>@(curStatus.Value ? L["Yes"] : L["No"])</b><button type="button" class="achip-x" onclick="removeFilter('status')">&times;</button></span>
                }
                @if (curAvailability.HasValue)
                {
                    <span class="achip">@L["Active"]: <b>@(curAvailability.Value ? L["Yes"] : L["No"])</b><button type="button" class="achip-x" onclick="removeFilter('availability')">&times;</button></span>
                }
                @if (curStart.HasValue || curEnd.HasValue)
                {
                    <span class="achip">@L["Created"]: <b>@(curStart?.ToString("dd.MM.yyyy")) - @(curEnd?.ToString("dd.MM.yyyy"))</b><button type="button" class="achip-x" onclick="removeFilter('dates')">&times;</button></span>
                }
                @if (curAssigned == false)
                {
                    <span class="achip"><b>@L["Unassigned"]</b><button type="button" class="achip-x" onclick="removeFilter('assigned')">&times;</button></span>
                }
                @if (curHasImage == false)
                {
                    <span class="achip"><b>@L["No image"]</b><button type="button" class="achip-x" onclick="removeFilter('hasImage')">&times;</button></span>
                }
                <button type="button" class="filter-clear" onclick="resetProductFilters()">@L["Clear all"]</button>
            </div>
        }
    </div>

    <div class="result-bar" id="productsSummary">
        <span><b>@Model.TotalCount</b> @(hasFilters ? (Model.TotalCount == 1 ? L["product matched"] : L["products matched"]) : (Model.TotalCount == 1 ? L["product"] : L["products"]))</span>
        <span class="text-muted">@L["Page {0}", Model.PageNumber]</span>
    </div>

    <div class="card mb-4" id="productsRegion">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="productsTable">
                        <thead>
                            <tr>
                                <th style="width: 96px;">@L["Code"]</th>
                                <th>@L["Product"]</th>
                                <th>@L["Category"]</th>
                                <th>@L["Description"]</th>
                                <th>@L["Department"]</th>
                                <th>@L["Assigned"]</th>
                                <th>@L["State"]</th>
                                <th style="width: 96px;">@L["Created"]</th>
                                <th style="width: 104px;">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Items)
                            {
                                <tr class="@(product.HasPendingApproval ? "row-crit" : (!product.IsWorking ? "row-warn" : ""))">
                                    <td>
                                        <span class="badge bg-primary fs-6 inventory-code-display" data-id="@product.Id">
                                            @product.InventoryCode
                                        </span>
                                        <div class="inventory-code-edit d-none" data-id="@product.Id">
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control form-control-sm inventory-code-input"
                                                       value="@product.InventoryCode" min="1" max="9999" data-id="@product.Id">
                                                <button class="btn btn-success btn-sm save-inventory-code" data-id="@product.Id">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button class="btn btn-secondary btn-sm cancel-inventory-code" data-id="@product.Id">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cell-item">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <span class="thumb-wrap">
                                                    <img src="@product.FullImageUrl" class="cell-thumb"
                                                         style="cursor: pointer;"
                                                         data-src="@product.FullImageUrl" data-title="@product.Model" onclick="showImageModal(this.dataset.src, this.dataset.title)"
                                                         alt="@product.Model">
                                                    @if (product.ImageUrls.Count > 1)
                                                    {
                                                        <span class="thumb-more" title="@L["{0} images", product.ImageUrls.Count]">+@(product.ImageUrls.Count - 1)</span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="cell-thumb cell-thumb-empty"><i class="fas fa-image"></i></div>
                                            }
                                            <div class="cell-text">
                                                <span class="cell-title" title="@product.Description">@product.Model</span>
                                                <span class="cell-sub">@product.Vendor</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@product.CategoryName</td>
                                    <td class="desc-cell">
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <span class="desc-text" title="@product.Description">@product.Description</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted pdf-omit">-</span>
                                        }
                                    </td>
                                    <td>@product.DepartmentName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Worker))
                                        {
                                            @product.Worker
                                        }
                                        else
                                        {
                                            <span class="text-muted pdf-omit">@L["Unassigned"]</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="state-stack">
                                            @if (product.HasPendingApproval)
                                            {
                                                <span class="state state-crit">@L["Pending"]</span>
                                            }
                                            @if (!product.IsWorking)
                                            {
                                                <span class="state state-warn">@L["Not working"]</span>
                                            }
                                            else if (!product.HasPendingApproval)
                                            {
                                                <span class="state state-ok">@L["Working"]</span>
                                            }
                                            @if (!product.IsActive)
                                            {
                                                <span class="state state-flat state-idle">@L["Inactive"]</span>
                                            }
                                            @if (product.IsNewItem)
                                            {
                                                <span class="state state-flat state-new">@L["New"]</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="num text-muted">@(product.CreatedAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary" title="@L["View"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if(User.HasPermission("product.update") || User.HasPermission("product.update.direct"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary" title="@L["Edit"]">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            @if(User.HasPermission("product.delete") || User.HasPermission("product.delete.direct"))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteProduct(@product.Id)" title="@L["Delete"]">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h5>@L["No products match these filters"]</h5>
                    <p class="text-muted mb-3">@L["Clear the filters to see the full inventory, or add a new product."]</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm me-1" onclick="resetProductFilters()">@L["Clear filters"]</button>
                    @if (User.HasPermission("product.create") || User.HasPermission("product.create.direct"))
                    {
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> @L["New Product"]
                        </a>
                    }
                </div>
            }
        </div>
        <div class="card-footer">
            <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Confirm Delete"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>@L["Are you sure you want to delete this product?"]</p>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>@L["Note:"]</strong> @L["This action may require approval from an administrator."]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>@L["Delete Product"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/list-filters.js" asp-append-version="true"></script>
    <script>
        let currentDeleteProductId = null;
        const productFilters = ListFilters.init({
            basePath: '/Products',
            pageSize: @Model.PageSize,
            pairs: @Html.Raw(ViewBag.FilterPairsJson ?? "[]"),   // [[departmentId, categoryId], ...]
            categoryKey: 'id',
            fields: {
                status: '#statusFilter',
                availability: '#availabilityFilter',
                categoryId: '#categoryFilter',
                departmentId: '#departmentFilter'
            },
            // Server-side quick flags with no control of their own.
            urlFlags: ['hasImage', 'assigned']
        });

        // Names used by the markup's onclick/onchange handlers.
        function applyProductFilters() { productFilters.apply(); }
        function onDepartmentChange() { productFilters.onDepartmentChange(); }
        function onCategoryChange() { productFilters.onCategoryChange(); }
        function removeFilter(key) { productFilters.remove(key); }
        function resetProductFilters() { productFilters.reset(); }

        // One-click presets: "Not working"/"Inactive" drive their dropdowns, "Unassigned"/"No image"
        // are URL-only flags.
        function quickFilter(kind) {
            if (kind === 'notWorking') {
                $('#statusFilter').val($('#statusFilter').val() === 'false' ? '' : 'false');
                applyProductFilters();
            } else if (kind === 'inactive') {
                $('#availabilityFilter').val($('#availabilityFilter').val() === 'false' ? '' : 'false');
                applyProductFilters();
            } else if (kind === 'unassigned') {
                productFilters.toggleFlag('assigned');
            } else if (kind === 'noImage') {
                productFilters.toggleFlag('hasImage');
            }
        }

        // Delete product confirmation
        function deleteProduct(id) {
            currentDeleteProductId = id;
            $('#deleteModal').modal('show');
        }

                // Handle the delete confirmation
        $('#confirmDeleteBtn').on('click', function() {
            const $btn = $(this);
            const originalHtml = $btn.html();

            // Show loading state
            $btn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2"></span>' + t('Deleting...'));

            // Perform AJAX delete request
            $.ajax({
                url: `/Products/Delete/${currentDeleteProductId}`,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    // First, check if this went to approval
                    if (response.isApprovalRequest) {
                        // Product deletion requires approval
                        $('#deleteModal').modal('hide');

                        // Show detailed approval notification
                        showToast(
                            response.message || t('Product deletion has been submitted for approval. An administrator will review your request.'),
                            'info',
                            8000
                        );

                        // Add a visual indicator to the product row
                        const $productRow = $(`tr:has(button[onclick="deleteProduct(${currentDeleteProductId})"])`);
                        if ($productRow.length) {
                            // Add pending badge to the status column
                            const $statusCell = $productRow.find('td:nth-child(5)'); // Adjust based on your table structure
                            $statusCell.append('<span class="badge bg-warning ms-1"><i class="fas fa-clock"></i> ' + t('Deletion Pending') + '</span>');

                            // Disable the action buttons
                            $productRow.find('.btn-group button').prop('disabled', true).addClass('opacity-50');
                        }

                        // Optionally show a more prominent notification
                        if (response.approvalRequestId) {
                            showApprovalRequestInfo(response.approvalRequestId);
                        }

                    } 
                    else if (response.isSuccess !== false) {
                        // Product was deleted successfully (direct deletion)
                        $('#deleteModal').modal('hide');

                        showToast(t('Product deleted successfully'), 'success');

                        // Remove the product row with animation
                        const $productRow = $(`tr:has(button[onclick="deleteProduct(${currentDeleteProductId})"])`);
                        $productRow.fadeOut(500, function() {
                            $(this).remove();

                            // Check if table is now empty
                            if ($('#productsTable tbody tr').length === 0) {
                                location.reload(); // Reload to show empty state
                            }
                        });
                    }
                    else {
                        // Deletion failed
                        showToast(
                            response.message || t('Failed to delete product. Please try again.'),
                            'error'
                        );

                        // Keep modal open for retry
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function(xhr) {
                    // Handle different error scenarios
                    let errorMessage = t('An error occurred while deleting the product');

                    if (xhr.status === 401) {
                        errorMessage = t('Your session has expired. Please log in again.');
                        setTimeout(() => window.location.href = '/Account/Login', 2000);
                    } else if (xhr.status === 403) {
                        errorMessage = t('You do not have permission to delete this product.');
                    } else if (xhr.status === 409) {
                        errorMessage = t('This product cannot be deleted because it has associated routes or transfers.');
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }

                    showToast(errorMessage, 'error', 7000);

                    // Re-enable the button for retry
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

                // Helper function to show approval request details
        function showApprovalRequestInfo(requestId) {
            const infoHtml = `
                <div class="alert alert-info alert-dismissible fade show position-fixed"
                     style="top: 100px; right: 20px; z-index: 9999; max-width: 400px;">
                    <h6 class="alert-heading">
                        <i class="fas fa-info-circle me-2"></i>${t('Approval Request Created')}
                    </h6>
                    <p class="mb-2">${t('Your deletion request has been submitted with ID:')} <strong>#${requestId}</strong></p>
                    <small class="text-muted">${t('You can track the status in the My Requests section.')}</small>
                    <hr class="my-2">
                    <div class="d-flex gap-2">
                        <a href="/Approvals/MyRequests" class="btn btn-sm btn-secondary">
                            <i class="fas fa-list me-1"></i>${t('View My Requests')}
                        </a>
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="alert">
                            ${t('Close')}
                        </button>
                    </div>
                </div>
            `;

            $('body').append(infoHtml);

            // Auto-hide after 10 seconds
            setTimeout(() => {
                $('.alert-info[style*="position: fixed"]').fadeOut(500, function() {
                    $(this).remove();
                });
            }, 10000);
        }


        $('#deleteModal').on('keydown', function(e) {
            if (e.key === 'Escape') {
                $(this).modal('hide');
            }
        });

        // Reset when modal is hidden
        $('#deleteModal').on('hidden.bs.modal', function() {
            currentDeleteProductId = null;
            $('#confirmDeleteBtn').prop('disabled', false)
                .html('<i class="fas fa-trash me-2"></i>' + t('Delete Product'));
        });

        // Double-click to edit inventory code
        $(document).on('dblclick', '.inventory-code-display', function() {
            const id = $(this).data('id');
            $(this).addClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-input[data-id="${id}"]`).focus().select();
        });

        // Save inventory code
        $(document).on('click', '.save-inventory-code', function() {
            const id = $(this).data('id');
            const newCode = $(`.inventory-code-input[data-id="${id}"]`).val();

            if (newCode < 1 || newCode > 9999) {
                showToast(t('Inventory code must be between 1 and 9999'), 'error');
                return;
            }

            const $btn = $(this);
            const originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: '/Products/UpdateInventoryCode',
                type: 'POST',
                data: JSON.stringify({
                    id: id,
                    inventoryCode: parseInt(newCode)
                }),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function() {
                    $(`.inventory-code-display[data-id="${id}"]`).text(newCode).removeClass('d-none');
                    $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
                    showToast(t('Inventory code updated successfully'), 'success');
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.error || t('Failed to update inventory code');
                    showToast(errorMsg, 'error');
                },
                complete: function() {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // Cancel inventory code edit
        $(document).on('click', '.cancel-inventory-code', function() {
            const id = $(this).data('id');
            $(`.inventory-code-display[data-id="${id}"]`).removeClass('d-none');
            $(`.inventory-code-edit[data-id="${id}"]`).addClass('d-none');
        });

        // Keyboard shortcuts for inventory code editing
        $(document).on('keydown', '.inventory-code-input', function(e) {
            const id = $(this).data('id');
            if (e.which === 13) { // Enter key
                e.preventDefault();
                $(`.save-inventory-code[data-id="${id}"]`).click();
            } else if (e.which === 27) { // Escape key
                $(`.cancel-inventory-code[data-id="${id}"]`).click();
            }
        });

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['product', 'category', 'department'],
            regions: ['#productsSummary', '#productsRegion'],
            // An inventory code being edited in a row must not be swapped away.
            isEditing: () => $('.inventory-code-input:visible').length > 0
        });
    </script>
}