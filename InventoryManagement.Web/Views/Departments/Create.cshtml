@model DepartmentViewModel
@{
    ViewData["Title"] = "Create Department";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Departments"]</a></li>
                <li class="breadcrumb-item active">@L["Create"]</li>
            </ol>
            <h1>@L["Create Department"]</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" class="ip-form" id="departmentForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Basic information"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label asp-for="Name" class="ip-label"><span>@L["Department Name"]</span> <span class="req">*</span></label>
                    <input asp-for="Name" class="ip-input" placeholder="@L["Enter department name"]" autofocus />
                    <span asp-validation-for="Name" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="DepartmentHead" class="ip-label"></label>
                    <input asp-for="DepartmentHead" class="ip-input" placeholder="@L["Enter department head name"]" />
                    <span class="ip-hint">@L["This person will appear in exported documents"]</span>
                    <span asp-validation-for="DepartmentHead" class="ip-error"></span>
                </div>
                <div class="ip-field span-2">
                    <label asp-for="Description" class="ip-label"></label>
                    <textarea asp-for="Description" class="ip-textarea" rows="3" placeholder="@L["Enter department description"]"></textarea>
                    <span asp-validation-for="Description" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Status"]</h2>
            <div class="ip-switch-list">
                <label class="ip-switch-row">
                    <span class="fw-medium">@L["Active"]</span>
                    <input asp-for="IsActive" type="checkbox" role="switch" class="ip-switch" />
                </label>
            </div>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a asp-action="Index" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            AjaxHandler.handleForm('#departmentForm', {
                successMessage: t('Department created successfully!'),
                successRedirect: '@Url.Action("Index")',
                redirectDelay: 1500
            });
        });
    </script>
}
