@model DepartmentViewModel
@{
    ViewData["Title"] = "Create Department";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Create Department</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Departments</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-xl-7 col-lg-9">
            <div class="card mb-4">
                <div class="card-header">New Department Information</div>

                <form asp-action="Create" method="post">
                    <div class="form-section">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-grid">
                            <div>
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter department name" autofocus />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div>
                                <label asp-for="DepartmentHead" class="form-label"></label>
                                <input asp-for="DepartmentHead" class="form-control" placeholder="Enter department head name" />
                                <span asp-validation-for="DepartmentHead" class="text-danger"></span>
                                <div class="form-text">This person will appear in exported documents</div>
                            </div>

                            <div class="full">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter department description"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="full">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="page-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <div class="actions-right">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-save"></i> Create Department
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            AjaxHandler.handleForm('form', {
                successMessage: 'Department created successfully!',
                successRedirect: '@Url.Action("Index")',
                redirectDelay: 1500
            });
        });
    </script>
}
