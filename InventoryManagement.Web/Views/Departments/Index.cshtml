@model PagedResultDto<DepartmentViewModel>
@{
    ViewData["Title"] = "Departments";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var hasSearch = !string.IsNullOrEmpty(currentSearch);
    object activeCount = Model.ActiveItems ?? ViewBag.ActiveDepartments ?? 0;
    object inactiveCount = Model.InActiveItems ?? ViewBag.InActiveDepartments ?? 0;
    object withProductsCount = Model.ItemsInWithProducts ?? ViewBag.DepartmentsInWithProducts ?? 0;
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Departments"]</h1>
            <div class="ip-sub ip-num" id="departmentsSummary">
                @L["{0} departments", Model.TotalCount] · @L["{0} active", activeCount] · @L["{0} inactive", inactiveCount] · @L["{0} with products", withProductsCount]
            </div>
        </div>
        <div class="ip-page-actions">
            <button type="button" class="ip-btn ip-btn-secondary" onclick="exportDepartmentsToPDF()">
                <span>@L["Export PDF"]</span><i class="fa-regular fa-file-pdf"></i>
            </button>
            @if (User.HasPermission("department.create"))
            {
                <a asp-action="Create" class="ip-btn ip-btn-primary">
                    <span>@L["New Department"]</span><i class="fa-solid fa-plus"></i>
                </a>
            }
        </div>
    </div>

    @* Status and sort narrow the rows already on screen, so they take effect the
       moment they change. Free-text search (Enter) goes back to the server. *@
    <div class="ip-filterbar">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" value="@currentSearch" autocomplete="off"
                   placeholder="@L["Search departments..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Status"]</span>
            <select id="statusFilter">
                <option value="">@L["All"]</option>
                <option value="active">@L["Active"]</option>
                <option value="inactive">@L["Inactive"]</option>
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Sort"]</span>
            <select id="sortBy">
                <option value="name">@L["Sort by Name"]</option>
                <option value="products">@L["Sort by Products"]</option>
                <option value="workers">@L["Sort by Workers"]</option>
                <option value="created">@L["Sort by Date"]</option>
            </select>
        </label>
        <button type="button" class="ip-btn ip-btn-ghost @(hasSearch ? "" : "d-none")" id="resetFiltersBtn" onclick="resetFilters()">
            <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div id="departmentsRegion" data-list-region>
        <div class="ip-table-wrap">
            @if (Model.Items.Any())
            {
                <table class="ip-table" id="departmentsTable">
                    <thead>
                        <tr>
                            <th>@L["Department"]</th>
                            <th>@L["Department Head"]</th>
                            <th>@L["Description"]</th>
                            <th>@L["Products"]</th>
                            <th>@L["Workers"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Created"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var department in Model.Items)
                        {
                            <tr data-href="@Url.Action("Details", new { id = department.Id })"
                                data-name="@department.Name"
                                data-status="@(department.IsActive ? "active" : "inactive")"
                                data-products="@department.ProductCount"
                                data-workers="@department.WorkerCount"
                                data-created="@department.CreatedAt.Ticks">
                                <td class="title">
                                    <div class="cell-text">
                                        <a class="cell-title text-reset" href="@Url.Action("Details", new { id = department.Id })">@department.Name</a>
                                    </div>
                                </td>
                                <td class="meta">
                                    @if (!string.IsNullOrEmpty(department.DepartmentHead))
                                    {
                                        @department.DepartmentHead
                                    }
                                    else
                                    {
                                        <span class="ip-faint pdf-omit">@L["Not assigned"]</span>
                                    }
                                </td>
                                <td class="hide-sm">
                                    @* max-width is what makes the ellipsis work in an auto-layout table *@
                                    <div class="cell-sub text-truncate" style="max-width: 300px;" title="@department.Description">
                                        @if (!string.IsNullOrEmpty(department.Description))
                                        {
                                            @department.Description
                                        }
                                        else
                                        {
                                            <span class="pdf-omit">@L["No description provided"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="ip-num">@department.ProductCount</td>
                                <td class="ip-num">@department.WorkerCount</td>
                                <td class="state">
                                    @if (department.IsActive)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                                    }
                                </td>
                                <td class="date ip-num text-nowrap">@department.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="actions" data-no-row-link>
                                    <div class="actions">
                                        <a asp-action="Details" asp-route-id="@department.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        @if (User.HasPermission("department.update"))
                                        {
                                        <a asp-action="Edit" asp-route-id="@department.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        }
                                        @if (User.HasPermission("department.delete"))
                                        {
                                        <button type="button" class="ip-btn-icon ip-btn-icon-danger" title="@L["Delete"]" aria-label="@L["Delete"]"
                                                data-id="@department.Id" data-name="@department.Name" onclick="deleteDepartment(this.dataset.id, this.dataset.name)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="ip-empty">
                    <span class="icon"><i class="fa-solid fa-building"></i></span>
                    <div class="title">@L["No departments found"]</div>
                    @if (hasSearch)
                    {
                        <div class="text">@L["Clear the search to see every department, or add a new one."]</div>
                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                            <span>@L["Clear search"]</span><i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                    else
                    {
                        <div class="text">@L["Departments you create will be listed here."]</div>
                    }
                </div>
            }
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade ip-modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalTitle">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete"] <strong id="departmentName"></strong>?</p>
                <div class="ip-banner ip-banner-warning">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>@L["This will permanently delete the department and affect associated products."]</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ip-btn ip-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ip-btn ip-btn-danger">
                        <span>@L["Delete"]</span><i class="fa-solid fa-trash-can"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Snapshot of every rendered row, so narrowing by status can be undone
        // without a round-trip to the server.
        let allDepartmentRows = [];
        const serverSearchActive = @(hasSearch ? "true" : "false");

        $(document).ready(function() {
            allDepartmentRows = Array.from(document.querySelectorAll('#departmentsTable tbody tr[data-status]'));

            $('#statusFilter, #sortBy').on('change', function() {
                filterDepartments();
            });

            restoreFilterValues();
        });

        function filterDepartments() {
            const statusFilter = $('#statusFilter').val();
            const sortBy = $('#sortBy').val();

            $('#resetFiltersBtn').toggleClass('d-none', !serverSearchActive && !statusFilter);

            const tbody = document.querySelector('#departmentsTable tbody');
            if (!tbody) {
                return;
            }

            // Each row carries its values in data-* attributes (status, counts, created ticks).
            let visibleRows = allDepartmentRows.filter(row => {
                const isActive = row.dataset.status === 'active';
                return !statusFilter ||
                    (statusFilter === 'active' && isActive) ||
                    (statusFilter === 'inactive' && !isActive);
            });

            visibleRows.sort((a, b) => {
                switch(sortBy) {
                    case 'name':
                        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                    case 'products':
                        return (Number(b.dataset.products) || 0) - (Number(a.dataset.products) || 0);
                    case 'workers':
                        return (Number(b.dataset.workers) || 0) - (Number(a.dataset.workers) || 0);
                    case 'created':
                        return (Number(b.dataset.created) || 0) - (Number(a.dataset.created) || 0);
                    default:
                        return 0;
                }
            });

            tbody.innerHTML = '';
            visibleRows.forEach(row => tbody.appendChild(row));

            if (visibleRows.length === 0) {
                tbody.innerHTML = `
                    <tr id="noResults">
                        <td colspan="8">
                            <div class="ip-empty">
                                <span class="icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <div class="title">${t('No departments match these filters')}</div>
                                <div class="text">${t('Pick a different status or clear the filters.')}</div>
                            </div>
                        </td>
                    </tr>
                `;
            }
        }

        function restoreFilterValues() {
            const params = new URLSearchParams(window.location.search);
            const search = params.get('search');
            if (search) {
                $('#searchInput').val(search);
            }
        }

        function applyFilters() {
            const searchTerm = $('#searchInput').val().trim();
            const params = new URLSearchParams();

            if (searchTerm) {
                params.append('search', searchTerm);
            }

            params.append('pageSize', '@Model.PageSize');
            params.append('pageNumber', '1');

            ListNav.go(window.location.pathname + '?' + params.toString());
        }

        function resetFilters() {
            $('#searchInput').val('');
            ListNav.go(window.location.pathname);
        }

        // Search on Enter
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                applyFilters();
            }
        });

        function deleteDepartment(id, name) {
            $('#departmentName').text(name);
            $('#deleteForm').attr('action', '/Departments/Delete/' + id);
            $('#deleteModal').modal('show');
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['department', 'product'],
            regions: ['#departmentsSummary', '#departmentsRegion'],
            afterRefresh() {
                allDepartmentRows = Array.from(document.querySelectorAll('#departmentsTable tbody tr[data-status]'));
                filterDepartments();
            }
        });
    </script>
}
