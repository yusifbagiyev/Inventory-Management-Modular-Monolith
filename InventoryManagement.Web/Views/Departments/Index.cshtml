@model PagedResultDto<DepartmentViewModel>
@{
    ViewData["Title"] = "Departments";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Departments"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportDepartmentsToPDF()">
                <i class="fas fa-file-pdf"></i> @L["Export PDF"]
            </button>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> @L["New Department"]
                </a>
            }
        </div>
    </div>

    @* Status and sort narrow the rows already on screen, so they take effect the
       moment they change. Free-text search goes back to the server. *@
    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" value="@currentSearch"
                           placeholder="@L["Search departments..."]">
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="applyFilters()">
                <i class="fas fa-filter"></i> @L["Apply"]
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                <i class="fas fa-redo"></i> @L["Reset"]
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="statusFilter">@L["Status"]</label>
                <select id="statusFilter" class="form-select form-select-sm">
                    <option value="">@L["All Status"]</option>
                    <option value="active">@L["Active"]</option>
                    <option value="inactive">@L["Inactive"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="sortBy">@L["Sort by"]</label>
                <select id="sortBy" class="form-select form-select-sm">
                    <option value="name">@L["Sort by Name"]</option>
                    <option value="products">@L["Sort by Products"]</option>
                    <option value="workers">@L["Sort by Workers"]</option>
                    <option value="created">@L["Sort by Date"]</option>
                </select>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(currentSearch))
        {
            <div class="filter-applied">
                <span class="achip">
                    @L["Search:"] <b>@currentSearch</b>
                    <button type="button" class="achip-x" onclick="resetFilters()">&times;</button>
                </span>
                <button type="button" class="filter-clear" onclick="resetFilters()">@L["Clear all"]</button>
            </div>
        }
    </div>

    <div class="result-bar" id="departmentsSummary">
        <span>
            <b>@Model.TotalCount</b> @L[Model.TotalCount == 1 ? "department" : "departments"]@(string.IsNullOrEmpty(currentSearch) ? "" : " " + L["matched"].Value)
        </span>
        <span class="text-muted">
            @L["Active"] <b>@(Model.ActiveItems ?? ViewBag.ActiveDepartments)</b>
            &middot; @L["Inactive"] <b>@(Model.InActiveItems ?? ViewBag.InActiveDepartments)</b>
            &middot; @L["Products"] <b>@(Model.ItemsInWithProducts ?? ViewBag.DepartmentsInWithProducts)</b>
        </span>
    </div>

    <div class="card mb-4" id="departmentsRegion">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="departmentsTable">
                        <thead>
                            <tr>
                                <th>@L["Department"]</th>
                                <th>@L["Department Head"]</th>
                                <th>@L["Description"]</th>
                                <th class="text-center" style="width: 92px;">@L["Products"]</th>
                                <th class="text-center" style="width: 92px;">@L["Workers"]</th>
                                <th style="width: 112px;">@L["Status"]</th>
                                <th style="width: 118px;">@L["Created"]</th>
                                <th class="text-center" style="width: 104px;">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var department in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="cell-text">
                                            <span class="cell-title fw-semibold">@department.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(department.DepartmentHead))
                                        {
                                            @department.DepartmentHead
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic pdf-omit">@L["Not assigned"]</span>
                                        }
                                    </td>
                                    <td>
                                        @* max-width is what makes the ellipsis work in an auto-layout table - kept from the original markup *@
                                        <div class="cell-sub text-truncate" style="max-width: 300px;" title="@department.Description">
                                            @if (!string.IsNullOrEmpty(department.Description))
                                            {
                                                @department.Description
                                            }
                                            else
                                            {
                                                <span class="d-empty pdf-omit">@L["No description provided"]</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@department.ProductCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@department.WorkerCount</span>
                                    </td>
                                    <td>
                                        @if (department.IsActive)
                                        {
                                            <span class="state state-ok">@L["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="state state-idle">@L["Inactive"]</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="num text-muted">@department.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@department.Id"
                                               class="btn btn-sm btn-outline-secondary" title="@L["View"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@department.Id"
                                               class="btn btn-sm btn-outline-secondary" title="@L["Edit"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="@L["Delete"]"
                                                    data-name="@department.Name" onclick="deleteDepartment(@department.Id, this.dataset.name)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-building"></i>
                    <h5>@L["No departments found"]</h5>
                    <p class="text-muted mb-3">@L["Clear the search to see every department, or add a new one."]</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm me-1" onclick="resetFilters()">@L["Clear filters"]</button>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-plus"></i> @L["New Department"]
                        </a>
                    }
                </div>
            }
        </div>
        <div class="card-footer">
            <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete"] <strong id="departmentName"></strong>?</p>
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @L["This will permanently delete the department and affect associated products."]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>@L["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Snapshot of every rendered row, so narrowing by status can be undone
        // without a round-trip to the server.
        let allDepartmentRows = [];

        $(document).ready(function() {
            allDepartmentRows = Array.from(document.querySelectorAll('#departmentsTable tbody tr'));

            $('#statusFilter, #sortBy').on('change', function() {
                filterDepartments();
            });

            restoreFilterValues();
        });

        function filterDepartments() {
            const statusFilter = $('#statusFilter').val();
            const sortBy = $('#sortBy').val();

            const tbody = document.querySelector('#departmentsTable tbody');
            if (!tbody) {
                return;
            }

            let visibleRows = allDepartmentRows.filter(row => {
                const isActive = row.querySelector('.state-ok') !== null;
                return !statusFilter ||
                    (statusFilter === 'active' && isActive) ||
                    (statusFilter === 'inactive' && !isActive);
            });

            visibleRows.sort((a, b) => {
                switch(sortBy) {
                    case 'name':
                        const nameA = a.querySelector('.fw-semibold')?.textContent || '';
                        const nameB = b.querySelector('.fw-semibold')?.textContent || '';
                        return nameA.localeCompare(nameB);
                    case 'products':
                        const productsA = parseInt(a.querySelector('.badge.bg-primary')?.textContent) || 0;
                        const productsB = parseInt(b.querySelector('.badge.bg-primary')?.textContent) || 0;
                        return productsB - productsA;
                    case 'workers':
                        const workersA = parseInt(a.querySelector('.badge.bg-info')?.textContent) || 0;
                        const workersB = parseInt(b.querySelector('.badge.bg-info')?.textContent) || 0;
                        return workersB - workersA;
                    case 'created':
                        const dateA = a.querySelector('td:nth-child(7) .text-muted')?.textContent || '';
                        const dateB = b.querySelector('td:nth-child(7) .text-muted')?.textContent || '';
                        return new Date(dateB) - new Date(dateA);
                    default:
                        return 0;
                }
            });

            tbody.innerHTML = '';
            visibleRows.forEach(row => tbody.appendChild(row));

            if (visibleRows.length === 0) {
                tbody.innerHTML = `
                    <tr id="noResults">
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fas fa-search"></i>
                                <h5>${t('No departments match these filters')}</h5>
                                <p class="text-muted mb-0">${t('Pick a different status or clear the filters.')}</p>
                            </div>
                        </td>
                    </tr>
                `;
            }
        }

        function restoreFilterValues() {
            const params = new URLSearchParams(window.location.search);
            const search = params.get('search');
            if (search) {
                $('#searchInput').val(search);
            }
        }

        function applyFilters() {
            const searchTerm = $('#searchInput').val().trim();
            const params = new URLSearchParams();

            if (searchTerm) {
                params.append('search', searchTerm);
            }

            params.append('pageSize', '@Model.PageSize');
            params.append('pageNumber', '1');

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        function resetFilters() {
            $('#searchInput').val('');
            window.location.href = window.location.pathname;
        }

        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                applyFilters();
            }
        });

        function deleteDepartment(id, name) {
            $('#departmentName').text(name);
            $('#deleteForm').attr('action', '/Departments/Delete/' + id);
            $('#deleteModal').modal('show');
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['department', 'product'],
            regions: ['#departmentsSummary', '#departmentsRegion'],
            afterRefresh() {
                allDepartmentRows = Array.from(document.querySelectorAll('#departmentsTable tbody tr'));
                filterDepartments();
            }
        });
    </script>
}
