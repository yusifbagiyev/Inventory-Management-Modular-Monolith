@model PagedResultDto<DepartmentViewModel>
@{
    ViewData["Title"] = "Departments";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    object activeCount = ViewBag.ActiveDepartments ?? 0;
    object inactiveCount = ViewBag.InActiveDepartments ?? 0;
    object withProductsCount = ViewBag.DepartmentsInWithProducts ?? 0;
    // Any query value besides paging is a filter or sort the reset button undoes
    var hasFilters = Context.Request.Query.Keys.Any(k => k is not ("pageNumber" or "pageSize"));
    // The counts are totals, so a narrowed list says how many it shows before them
    var isFiltered = Context.Request.Query.Keys.Any(k => k is not ("pageNumber" or "pageSize" or "sort" or "dir"));
    var totalCount = Convert.ToInt32(activeCount) + Convert.ToInt32(inactiveCount);
    var canUpdate = User.HasPermission("department.update");
    var activeParam = Context.Request.Query["active"].ToString();
    var currentSort = $"{Context.Request.Query["sort"]}:{Context.Request.Query["dir"]}";
    var statusOptions = Json.Serialize(new[] { new { value = "true", label = L["Active"].Value }, new { value = "false", label = L["Inactive"].Value } }).ToString();
}

<div class="container-fluid px-4">
    <div class="ip-page-head ip-list-head">
        <div>
            <h1>@L["Departments"]</h1>
            <div class="ip-sub ip-num" id="departmentsSummary">
                @if (isFiltered) {<text>@L["{0} found", Model.TotalCount] · </text>}@L.Plural(totalCount, "{0} department", "{0} departments") · @L["{0} active", activeCount] · @L["{0} inactive", inactiveCount] · @L["{0} with products", withProductsCount]
            </div>
        </div>
        <div class="ip-page-actions">
            <button type="button" class="ip-btn ip-btn-secondary" onclick="exportDepartmentsToPDF()" title="@L["Export PDF"]" aria-label="@L["Export PDF"]">
                <span>@L["Export PDF"]</span><i class="fa-regular fa-file-pdf"></i>
            </button>
            @if (User.HasPermission("department.create"))
            {
                <a asp-action="Create" class="ip-btn ip-btn-primary">
                    <span>@L["New Department"]</span><i class="fa-solid fa-plus"></i>
                </a>
            }
        </div>
    </div>

    @* The same filters and sort as the column headers, for phones where the headers are hidden *@
    <div class="ip-filterbar">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" value="@currentSearch" autocomplete="off"
                   placeholder="@L["Search departments..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Status"]</span>
            <select id="statusFilter">
                <option value="">@L["All"]</option>
                <option value="true" selected="@(activeParam == "true")">@L["Active"]</option>
                <option value="false" selected="@(activeParam == "false")">@L["Inactive"]</option>
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Sort"]</span>
            <select id="sortBy">
                <option value="name:asc">@L["Sort by Name"]</option>
                <option value="products:desc" selected="@(currentSort == "products:desc")">@L["Sort by Products"]</option>
                <option value="workers:desc" selected="@(currentSort == "workers:desc")">@L["Sort by Workers"]</option>
                <option value="created:desc" selected="@(currentSort == "created:desc")">@L["Sort by Date"]</option>
            </select>
        </label>
        <button type="button" class="ip-btn ip-btn-ghost @(hasFilters ? "" : "d-none")" id="resetFiltersBtn" onclick="resetFilters()">
            <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div id="departmentsRegion" data-list-region>
        <div class="ip-table-wrap">
                <table class="ip-table catalog-list" id="departmentsTable">
                    <thead>
                        <tr>
                            <th data-sort="name" data-filter="text" data-param="name">@L["Department"]</th>
                            <th data-sort="head" data-filter="text" data-param="head">@L["Department Head"]</th>
                            <th data-sort="products" data-sort-first="desc" data-filter="range" data-param-min="productsMin" data-param-max="productsMax">@L["Products"]</th>
                            <th class="hide-md" data-sort="workers" data-sort-first="desc" data-filter="range" data-param-min="workersMin" data-param-max="workersMax">@L["Workers"]</th>
                            <th data-sort="status" data-filter="list" data-param="active" data-options="@statusOptions">@L["Status"]</th>
                            <th class="hide-lg" data-sort="created" data-sort-first="desc" data-filter="date" data-param-from="createdFrom" data-param-to="createdTo">@L["Created"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var department in Model.Items)
                        {
                            <tr data-href="@Url.Action("Details", new { id = department.Id })">
                                <td class="title">
                                    <div class="cell-text">
                                        <a class="cell-title text-reset" href="@Url.Action("Details", new { id = department.Id })" title="@department.Name">@department.Name</a>
                                        @if (!string.IsNullOrEmpty(department.Description))
                                        {
                                            <span class="cell-sub" title="@department.Description">@department.Description</span>
                                        }
                                    </div>
                                </td>
                                <td class="meta">
                                    @if (!string.IsNullOrEmpty(department.DepartmentHead))
                                    {
                                        <span class="cell-title fw-normal" title="@department.DepartmentHead">@department.DepartmentHead</span>
                                    }
                                    else
                                    {
                                        <span class="cell-title fw-normal"><span class="ip-faint pdf-omit">@L["Not assigned"]</span></span>
                                    }
                                    @* Phone cards have no number columns, so the counts follow the head *@
                                    <span class="cell-sub d-md-none pdf-omit">@L.Plural(department.ProductCount, "{0} product", "{0} products") · @L.Plural(department.WorkerCount, "{0} worker", "{0} workers")</span>
                                </td>
                                <td class="ip-num hide-sm">@department.ProductCount</td>
                                <td class="ip-num hide-sm hide-md">@department.WorkerCount</td>
                                <td class="state">
                                    @if (department.IsActive)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                                    }
                                </td>
                                <td class="date ip-num text-nowrap hide-lg">@department.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="actions" data-no-row-link>
                                    <div class="actions">
                                        <a asp-action="Details" asp-route-id="@department.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        @if (canUpdate)
                                        {
                                        <a asp-action="Edit" asp-route-id="@department.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        }
                                        @if (User.HasPermission("department.delete"))
                                        {
                                        <button type="button" class="ip-btn-icon ip-btn-icon-danger" title="@L["Delete"]" aria-label="@L["Delete"]"
                                                data-catalog-delete="department" data-name="@department.Name" data-products="@department.ProductCount"
                                                data-url="@Url.Action("Delete", new { id = department.Id })" data-edit-url="@(canUpdate ? Url.Action("Edit", new { id = department.Id }) : null)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @* The headers stay when nothing matches, so their filters can be changed *@
                        @if (!Model.Items.Any())
                        {
                            <tr class="ip-empty-row">
                                <td class="empty" colspan="7">
                                    <div class="ip-empty">
                                        <span class="icon"><i class="fa-solid fa-building"></i></span>
                                        <div class="title">@L[hasFilters ? "No departments match these filters" : "No departments found"]</div>
                                        @if (hasFilters)
                                        {
                                            <div class="text">@L["Change or clear the filters to see more."]</div>
                                            <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                                                <span>@L["Reset filters"]</span><i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="text">@L["Departments you create will be listed here."]</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>
</div>

<form id="catalogDeleteForm" method="post" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/catalog-delete.js" asp-append-version="true"></script>
    <script>
        // The filter bar writes the same query values as the column headers
        TableColumns.bindBar({ fields: { '#statusFilter': 'active' }, sort: '#sortBy', search: '#searchInput', reset: '#resetFiltersBtn' });

        function resetFilters() {
            ListNav.go(window.location.pathname);
        }

        // Other users' changes refresh the count and the table in place
        LiveUpdates.watch({
            entities: ['department', 'product'],
            regions: ['#departmentsSummary', '#departmentsRegion']
        });
    </script>
}
