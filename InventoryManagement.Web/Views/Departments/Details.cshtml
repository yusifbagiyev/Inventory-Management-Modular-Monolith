@model DepartmentViewModel
@{
    ViewData["Title"] = "Department Details";
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@Model.Name</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/Departments">Departments</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
            <a asp-action="ExportToWord" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-file-word"></i> Export to Word
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-edit"></i> Edit Department
            </a>
        </div>
    </div>

    <div class="card mt-3 mb-4">
        <div class="card-header">Department</div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-row">
                    <span class="d-label">Department head</span>
                    @if (!string.IsNullOrEmpty(Model.DepartmentHead))
                    {
                        <span class="d-value">@Model.DepartmentHead</span>
                    }
                    else
                    {
                        <span class="d-value d-empty">Not assigned</span>
                    }
                </div>
                <div class="detail-row">
                    <span class="d-label">Status</span>
                    <span class="d-value">
                        @if (Model.IsActive)
                        {
                            <span class="state state-ok">Active</span>
                        }
                        else
                        {
                            <span class="state state-idle">Inactive</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Products</span>
                    <span class="d-value mono">@Model.ProductCount</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Workers</span>
                    <span class="d-value mono">@Model.WorkerCount</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Created</span>
                    <span class="d-value mono">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Description</span>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <span class="d-value">@Model.Description</span>
                    }
                    else
                    {
                        <span class="d-value d-empty">No description provided</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                Department Inventory
                <div class="text-muted fw-normal">Complete list of products in this department</div>
            </div>
            @if (products.Any())
            {
                <span class="badge bg-primary">@products.Count Total Items</span>
            }
        </div>
        <div class="card-body p-0">
            @if (products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="departmentProductsTable">
                        <thead>
                            <tr>
                                <th style="width: 10%">Code</th>
                                <th style="width: 18%">Category</th>
                                <th style="width: 20%">Model</th>
                                <th style="width: 15%">Vendor</th>
                                <th style="width: 15%">Assigned To</th>
                                <th style="width: 12%" class="text-center">Status</th>
                                <th style="width: 10%" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in products.OrderBy(p => p.CategoryName).ThenBy(p => p.InventoryCode))
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary mono">@product.InventoryCode</span>
                                    </td>
                                    <td>@(product.CategoryName ?? "Uncategorized")</td>
                                    <td>@(product.Model ?? "N/A")</td>
                                    <td class="text-muted">@(product.Vendor ?? "N/A")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Worker))
                                        {
                                            @product.Worker
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not assigned</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (product.IsWorking)
                                        {
                                            <span class="state state-ok">Working</span>
                                        }
                                        else
                                        {
                                            <span class="state state-crit">Not Working</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-secondary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h5>No Products Yet</h5>
                    <p class="text-muted mb-0">This department doesn't have any products assigned.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with modern styling
            $('#departmentProductsTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc'], [0, 'asc']], // Sort by category, then code
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search products...",
                    lengthMenu: "Show _MENU_ items",
                    info: "Showing _START_ to _END_ of _TOTAL_ products",
                    infoEmpty: "No products to show",
                    infoFiltered: "(filtered from _MAX_ total)"
                },
                dom: '<"row mb-3"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row mt-3"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });
        });
    </script>
}
