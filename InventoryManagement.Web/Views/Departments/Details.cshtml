@model DepartmentViewModel
@{
    var canProducts = User.HasPermission("product.view");
    ViewData["Title"] = "Department Details";
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Departments"]</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
            <h1>@Model.Name</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (Model.IsActive)
                {
                    <span class="ip-badge ip-badge-success">@L["Active"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                }
                <span class="ip-num">@L["{0} products", Model.ProductCount] · @L["{0} workers", Model.WorkerCount]</span>
            </div>
        </div>
    </div>

    <div class="ip-page-actions mb-4">
        @if (User.HasPermission("department.export"))
        {
            <a asp-action="ExportToWord" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">
                <i class="fa-regular fa-file-word"></i><span>@L["Export to Word"]</span>
            </a>
        }
        @if (User.HasPermission("department.update"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-primary">
                <span>@L["Edit"]</span><i class="fa-solid fa-pen"></i>
            </a>
        }
    </div>

    <hr class="ip-rule" />

    <div class="row pt-2 mb-5">
        <div class="col-lg-8 col-xl-7">
            <dl class="ip-dl">
                <div>
                    <dt>@L["Department head"]</dt>
                    @if (!string.IsNullOrEmpty(Model.DepartmentHead))
                    {
                        <dd>@Model.DepartmentHead</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["Not assigned"]</dd>
                    }
                </div>
                <div><dt>@L["Products"]</dt><dd class="ip-num">@Model.ProductCount</dd></div>
                <div><dt>@L["Workers"]</dt><dd class="ip-num">@Model.WorkerCount</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd></div>
                <div>
                    <dt>@L["Description"]</dt>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dd>@Model.Description</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["No description provided"]</dd>
                    }
                </div>
            </dl>
        </div>
    </div>

    <section class="ip-section">
        <div class="d-flex align-items-baseline gap-3 flex-wrap mb-2">
            <h2>@L["Department Inventory"]</h2>
            @if (products.Any())
            {
                <span class="ip-faint ip-num">@L["{0} Total Items", products.Count]</span>
            }
        </div>
        @if (products.Any())
        {
            <div class="ip-table-wrap">
                <table class="ip-table" id="departmentProductsTable">
                    <thead>
                        <tr>
                            <th>@L["Code"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["Category"]</th>
                            <th>@L["Assigned To"]</th>
                            <th>@L["State"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products.OrderBy(p => p.CategoryName).ThenBy(p => p.InventoryCode))
                        {
                            <tr data-href="@(canProducts ? Url.Action("Details", "Products", new { id = product.Id }) : null)">
                                <td class="ip-mono" data-order="@product.InventoryCode">@product.InventoryCode</td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title">@(product.Model ?? L["N/A"].Value)</span>
                                        <span class="cell-sub">@(product.Vendor ?? L["N/A"].Value)</span>
                                    </div>
                                </td>
                                <td>@(product.CategoryName ?? L["Uncategorized"].Value)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Worker))
                                    {
                                        @product.Worker
                                    }
                                    else
                                    {
                                        <span class="ip-faint">@L["Not assigned"]</span>
                                    }
                                </td>
                                <td>
                                    @if (product.IsWorking)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Working"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-danger">@L["Not working"]</span>
                                    }
                                </td>
                                <td data-no-row-link>
                                    <div class="actions">
                                        @if (canProducts)
                                        {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-solid fa-box-open"></i></span>
                <div class="title">@L["No Products Yet"]</div>
                <div class="text">@L["This department doesn't have any products assigned."]</div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        $(document).ready(initProductsTable);

        // Runs on load and again after live-updates.js swaps in a fresh table.
        function initProductsTable() {
            $('#departmentProductsTable').DataTable({
                pageLength: 25,
                order: [[2, 'asc'], [0, 'asc']], // Sort by category, then code
                columnDefs: [{ targets: -1, orderable: false, searchable: false }],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: t('Search products...'),
                    lengthMenu: t('Show _MENU_ items'),
                    info: t('Showing _START_ to _END_ of _TOTAL_ products'),
                    infoEmpty: t('No products to show'),
                    infoFiltered: t('(filtered from _MAX_ total)')
                }
                // No `dom`/`layout`: DataTables' default (length + search above, info + paging below)
                // is what the old `dom` string spelled out, and DataTables 3 dropped `dom`.
            });
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['department', 'product'],
            ids: { department: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'department',
            beforeRefresh() {
                if ($.fn.DataTable.isDataTable('#departmentProductsTable')) $('#departmentProductsTable').DataTable().destroy();
            },
            afterRefresh: initProductsTable
        });
    </script>
}
