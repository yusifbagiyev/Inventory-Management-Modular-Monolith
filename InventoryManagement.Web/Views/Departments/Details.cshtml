@model DepartmentViewModel
@{
    ViewData["Title"] = "Department Details";
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@Model.Name</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item"><a href="/Departments">@L["Departments"]</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> @L["Back to List"]
            </a>
            <a asp-action="ExportToWord" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-file-word"></i> @L["Export to Word"]
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-edit"></i> @L["Edit Department"]
            </a>
        </div>
    </div>

    <div class="card mt-3 mb-4">
        <div class="card-header">@L["Department"]</div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-row">
                    <span class="d-label">@L["Department head"]</span>
                    @if (!string.IsNullOrEmpty(Model.DepartmentHead))
                    {
                        <span class="d-value">@Model.DepartmentHead</span>
                    }
                    else
                    {
                        <span class="d-value d-empty">@L["Not assigned"]</span>
                    }
                </div>
                <div class="detail-row">
                    <span class="d-label">@L["Status"]</span>
                    <span class="d-value">
                        @if (Model.IsActive)
                        {
                            <span class="state state-ok">@L["Active"]</span>
                        }
                        else
                        {
                            <span class="state state-idle">@L["Inactive"]</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="d-label">@L["Products"]</span>
                    <span class="d-value mono">@Model.ProductCount</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">@L["Workers"]</span>
                    <span class="d-value mono">@Model.WorkerCount</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">@L["Created"]</span>
                    <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">@L["Description"]</span>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <span class="d-value">@Model.Description</span>
                    }
                    else
                    {
                        <span class="d-value d-empty">@L["No description provided"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                @L["Department Inventory"]
                <div class="text-muted fw-normal">@L["Complete list of products in this department"]</div>
            </div>
            @if (products.Any())
            {
                <span class="badge bg-primary">@L["{0} Total Items", products.Count]</span>
            }
        </div>
        <div class="card-body p-0">
            @if (products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="departmentProductsTable">
                        <thead>
                            <tr>
                                <th style="width: 10%">@L["Code"]</th>
                                <th style="width: 18%">@L["Category"]</th>
                                <th style="width: 20%">@L["Model"]</th>
                                <th style="width: 15%">@L["Vendor"]</th>
                                <th style="width: 15%">@L["Assigned To"]</th>
                                <th style="width: 12%" class="text-center">@L["Status"]</th>
                                <th style="width: 10%" class="text-center">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in products.OrderBy(p => p.CategoryName).ThenBy(p => p.InventoryCode))
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary mono">@product.InventoryCode</span>
                                    </td>
                                    <td>@(product.CategoryName ?? L["Uncategorized"].Value)</td>
                                    <td>@(product.Model ?? L["N/A"].Value)</td>
                                    <td class="text-muted">@(product.Vendor ?? L["N/A"].Value)</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Worker))
                                        {
                                            @product.Worker
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">@L["Not assigned"]</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (product.IsWorking)
                                        {
                                            <span class="state state-ok">@L["Working"]</span>
                                        }
                                        else
                                        {
                                            <span class="state state-crit">@L["Not Working"]</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-secondary" title="@L["View Details"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h5>@L["No Products Yet"]</h5>
                    <p class="text-muted mb-0">@L["This department doesn't have any products assigned."]</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(initProductsTable);

        // Runs on load and again after live-updates.js swaps in a fresh table.
        function initProductsTable() {
            // Initialize DataTable with modern styling
            $('#departmentProductsTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc'], [0, 'asc']], // Sort by category, then code
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: t('Search products...'),
                    lengthMenu: t('Show _MENU_ items'),
                    info: t('Showing _START_ to _END_ of _TOTAL_ products'),
                    infoEmpty: t('No products to show'),
                    infoFiltered: t('(filtered from _MAX_ total)')
                }
                // No `dom`/`layout`: DataTables' default (length + search above, info + paging below)
                // is what the old `dom` string spelled out, and DataTables 3 dropped `dom`.
            });
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['department', 'product'],
            ids: { department: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'department',
            beforeRefresh() {
                if ($.fn.DataTable.isDataTable('#departmentProductsTable')) $('#departmentProductsTable').DataTable().destroy();
            },
            afterRefresh: initProductsTable
        });
    </script>
}
