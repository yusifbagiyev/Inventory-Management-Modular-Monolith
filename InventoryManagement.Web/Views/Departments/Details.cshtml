@model DepartmentViewModel
@{
    var canProducts = User.HasPermission("product.view");
    ViewData["Title"] = "Department Details";
    ViewData["Subtitle"] = Model.Name;   // Shown under the title in the phone app bar
    var canUpdate = User.HasPermission("department.update");
    var canDelete = User.HasPermission("department.delete");
    var canExport = User.HasPermission("department.export");
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4 catalog-details" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Departments"]</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
            <h1>@Model.Name</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (Model.IsActive)
                {
                    <span class="ip-badge ip-badge-success">@L["Active"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                }
                <span class="ip-num">@L.Plural(Model.ProductCount, "{0} product", "{0} products") · @L.Plural(Model.WorkerCount, "{0} worker", "{0} workers")</span>
            </div>
        </div>
    </div>

    @* Phones get these actions in the fixed bar at the end of the page *@
    @if (canDelete || canExport || canUpdate)
    {
        <div class="ip-page-actions mb-4 d-none d-md-flex">
            @if (canDelete)
            {
                <button type="button" class="ip-btn ip-btn-danger-ghost" data-catalog-delete="department" data-name="@Model.Name" data-products="@Model.ProductCount"
                        data-url="@Url.Action("Delete", new { id = Model.Id })" data-edit-url="@(canUpdate ? Url.Action("Edit", new { id = Model.Id }) : null)">
                    <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
                </button>
            }
            @if (canExport)
            {
                <a asp-action="ExportToWord" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">
                    <i class="fa-regular fa-file-word"></i><span>@L["Export to Word"]</span>
                </a>
            }
            @if (canUpdate)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-primary">
                    <span>@L["Edit"]</span><i class="fa-solid fa-pen"></i>
                </a>
            }
        </div>
    }

    <hr class="ip-rule" />

    @* The counts and the status are in the head, so the facts list only what it lacks *@
    <div class="row pt-2 mb-4">
        <div class="col-md-6">
            <dl class="ip-dl">
                <div>
                    <dt>@L["Department Head"]</dt>
                    @if (!string.IsNullOrEmpty(Model.DepartmentHead))
                    {
                        <dd>@Model.DepartmentHead</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["Not assigned"]</dd>
                    }
                </div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd></div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div><dt>@L["Updated"]</dt><dd class="ip-num">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy")</dd></div>
                }
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="ip-dl">
                <div>
                    <dt>@L["Description"]</dt>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dd>@Model.Description</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["No description provided"]</dd>
                    }
                </div>
            </dl>
        </div>
    </div>

    <section class="ip-section">
        <h2 class="mb-2">@L["Department Inventory"]</h2>
        @if (products.Any())
        {
            <div class="ip-table-wrap">
                <table class="ip-table" id="departmentProductsTable" data-column-filters="client">
                    <thead>
                        <tr>
                            <th data-sort="code" data-filter="text">@L["Code"]</th>
                            <th data-sort="product" data-filter="text">@L["Product"]</th>
                            <th data-sort="category" data-filter="list">@L["Category"]</th>
                            <th data-sort="worker" data-filter="list">@L["Assigned To"]</th>
                            <th data-sort="state" data-filter="list">@L["State"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products.OrderBy(p => p.CategoryName).ThenBy(p => p.InventoryCode))
                        {
                            <tr data-href="@(canProducts ? Url.Action("Details", "Products", new { id = product.Id }) : null)">
                                <td class="code ip-mono" data-order="@product.InventoryCode">@product.InventoryCode</td>
                                <td class="title" data-filter-value="@($"{product.Model} {product.Vendor}".Trim())">
                                    <div class="cell-text">
                                        <span class="cell-title">@(product.Model ?? L["N/A"].Value)</span>
                                        <span class="cell-sub">@(product.Vendor ?? L["N/A"].Value)</span>
                                    </div>
                                </td>
                                <td class="meta">@(product.CategoryName ?? L["Uncategorized"].Value)</td>
                                <td class="meta">
                                    @if (!string.IsNullOrEmpty(product.Worker))
                                    {
                                        @product.Worker
                                    }
                                    else
                                    {
                                        <span class="ip-faint">@L["Not assigned"]</span>
                                    }
                                </td>
                                <td class="state" data-filter-value="@(product.IsWorking ? "working" : "not-working")">
                                    @if (product.IsWorking)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Working"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-danger">@L["Not working"]</span>
                                    }
                                </td>
                                <td class="actions" data-no-row-link>
                                    <div class="actions">
                                        @if (canProducts)
                                        {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-solid fa-box-open"></i></span>
                <div class="title">@L["No Products Yet"]</div>
                <div class="text">@L["This department doesn't have any products assigned."]</div>
            </div>
        }
    </section>
    @if (canDelete || canExport || canUpdate)
    {
        <div class="ip-form-foot d-md-none">
            @if (canDelete)
            {
                <button type="button" class="ip-btn ip-btn-danger-ghost" title="@L["Delete"]" aria-label="@L["Delete"]" data-catalog-delete="department" data-name="@Model.Name" data-products="@Model.ProductCount"
                        data-url="@Url.Action("Delete", new { id = Model.Id })" data-edit-url="@(canUpdate ? Url.Action("Edit", new { id = Model.Id }) : null)">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            }
            @if (canExport)
            {
                <a asp-action="ExportToWord" asp-route-id="@Model.Id" class="ip-btn ip-btn-ghost" title="@L["Export to Word"]" aria-label="@L["Export to Word"]"><i class="fa-regular fa-file-word"></i><span>@L["Export to Word"]</span></a>
            }
            @if (canUpdate)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-primary"><span>@L["Edit"]</span><i class="fa-solid fa-pen"></i></a>
            }
        </div>
    }
</div>

<form id="catalogDeleteForm" method="post" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="~/js/catalog-delete.js" asp-append-version="true"></script>
    <script>
        // Other users' changes refresh the page in place, and a deletion shows a notice; the table keeps its header sort and filters
        LiveUpdates.watch({
            entities: ['department', 'product'],
            ids: { department: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'department',
            // An open header filter belongs to the table it was opened on
            isEditing: () => !!document.querySelector('.ip-colfilter')
        });
    </script>
}
