@model DepartmentViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@L["Edit Department"]</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@L["Departments"]</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-xl-7 col-lg-9">
            <div class="card mb-4">
                <div class="card-header">@L["Edit Department Information"]</div>

                <form asp-action="Edit" method="post">
                    <div class="form-section">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-grid">
                            <div>
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div>
                                <label asp-for="DepartmentHead" class="form-label"></label>
                                <input asp-for="DepartmentHead" class="form-control" placeholder="@L["Enter department head name"]" />
                                <span asp-validation-for="DepartmentHead" class="text-danger"></span>
                                <div class="form-text">@L["This person will appear in exported documents"]</div>
                            </div>

                            <div class="full">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="full">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h2 class="section-title">@L["Department record"]</h2>
                        <div class="detail-grid">
                            <div class="detail-row">
                                <span class="d-label">@L["Products"]</span>
                                <span class="d-value mono">@Model.ProductCount</span>
                            </div>
                            <div class="detail-row">
                                <span class="d-label">@L["Assigned workers"]</span>
                                <span class="d-value mono">@Model.WorkerCount</span>
                            </div>
                            <div class="detail-row">
                                <span class="d-label">@L["Created"]</span>
                                <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="detail-row">
                                <span class="d-label">@L["Updated"]</span>
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <span class="d-value mono">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="d-value d-empty">@L["Never"]</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="page-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> @L["Back to List"]
                        </a>
                        <div class="actions-right">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-save"></i> @L["Save Changes"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('form').on('submit', function(e) {
                e.preventDefault();
                var form = this;
                var $btn = $(form).find('button[type="submit"]');
                var originalText = $btn.html();

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>' + t('Saving...'));

                $.ajax({
                    url: form.action,
                    type: form.method,
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        showToast(t('Department updated successfully!'), 'success');
                        setTimeout(() => window.location.href = '@Url.Action("Index")', 1500);
                    },
                    error: function(xhr) {
                        $btn.prop('disabled', false).html(originalText);
                        var error = t('Failed to update department');
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            error = xhr.responseJSON.message;
                        }
                        showToast(error, 'error');
                    }
                });
            });
        });


        // Someone else saving or deleting this department while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['department'],
            ids: { department: @Model.Id },
            label: 'department'
        });
    </script>
}
