@model DepartmentViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Departments"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L["Edit Department"]</h1>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="ip-form" id="departmentForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Basic information"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label asp-for="Name" class="ip-label"><span>@L["Department Name"]</span> <span class="req">*</span></label>
                    <input asp-for="Name" class="ip-input" />
                    <span asp-validation-for="Name" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="DepartmentHead" class="ip-label"></label>
                    <input asp-for="DepartmentHead" class="ip-input" placeholder="@L["Enter department head name"]" />
                    <span class="ip-hint">@L["This person will appear in exported documents"]</span>
                    <span asp-validation-for="DepartmentHead" class="ip-error"></span>
                </div>
                <div class="ip-field span-2">
                    <label asp-for="Description" class="ip-label"></label>
                    <textarea asp-for="Description" class="ip-textarea" rows="3"></textarea>
                    <span asp-validation-for="Description" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Status"]</h2>
            <div class="ip-switch-list">
                <label class="ip-switch-row">
                    <span class="fw-medium">@L["Active"]</span>
                    <input asp-for="IsActive" type="checkbox" role="switch" class="ip-switch" />
                </label>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Department record"]</h2>
            <dl class="ip-dl">
                <div><dt>@L["Products"]</dt><dd class="ip-num">@Model.ProductCount</dd></div>
                <div><dt>@L["Assigned workers"]</dt><dd class="ip-num">@Model.WorkerCount</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div>
                <div>
                    <dt>@L["Updated"]</dt>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dd class="ip-num">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                    else
                    {
                        <dd class="ip-muted">@L["Never"]</dd>
                    }
                </div>
            </dl>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/ajaxHandler.js" asp-append-version="true"></script>
    <script>
        // The shared handler marks the fields the server rejects (a taken name) and returns to the department, as Cancel does
        $(document).ready(function() {
            AjaxHandler.handleForm('#departmentForm', {
                successMessage: t('Department updated successfully!'),
                successRedirect: '@Url.Action("Details", new { id = Model.Id })',
                redirectDelay: 1500
            });
        });


        // If someone else changes this department while it is open, warn but leave the form alone
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['department'],
            ids: { department: @Model.Id },
            label: 'department'
        });
    </script>
}
