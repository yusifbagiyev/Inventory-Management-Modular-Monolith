@model CategoryViewModel
@{
    ViewData["Title"] = "Category Details";
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Categories"]</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
            <h1>@Model.Name</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                @if (Model.IsActive)
                {
                    <span class="ip-badge ip-badge-success">@L["Active"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                }
                <span class="ip-num">@L["{0} products", Model.ProductCount]</span>
            </div>
        </div>
    </div>

    @if (User.HasPermission("category.update"))
    {
        <div class="ip-page-actions mb-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ip-btn ip-btn-primary">
                <span>@L["Edit"]</span><i class="fa-solid fa-pen"></i>
            </a>
        </div>
    }

    <hr class="ip-rule" />

    <div class="row pt-2 mb-5">
        <div class="col-lg-8 col-xl-7">
            <dl class="ip-dl">
                <div><dt>@L["Name"]</dt><dd>@Model.Name</dd></div>
                <div>
                    <dt>@L["Description"]</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <dd class="ip-muted">@L["No description"]</dd>
                    }
                    else
                    {
                        <dd>@Model.Description</dd>
                    }
                </div>
                <div><dt>@L["Total Products"]</dt><dd class="ip-num">@Model.ProductCount</dd></div>
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd></div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div><dt>@L["Updated"]</dt><dd class="ip-num">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy")</dd></div>
                }
            </dl>
        </div>
    </div>

    <section class="ip-section">
        <h2 class="mb-2">@L["Products in this Category"]</h2>
        @if (products.Any())
        {
            <div class="ip-table-wrap">
                <table class="ip-table" id="categoryProductsTable">
                    <thead>
                        <tr>
                            <th>@L["Code"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["Department and worker"]</th>
                            <th>@L["State"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr data-href="@Url.Action("Details", "Products", new { id = product.Id })">
                                <td class="ip-mono" data-order="@product.InventoryCode">@product.InventoryCode</td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title">@(product.Model ?? L["N/A"].Value)</span>
                                        <span class="cell-sub">@product.Vendor</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-text">
                                        <span class="cell-title fw-normal">@product.DepartmentName</span>
                                        <span class="cell-sub">@(string.IsNullOrEmpty(product.Worker) ? L["Unassigned"].Value : product.Worker)</span>
                                    </div>
                                </td>
                                <td>
                                    @if (product.IsWorking)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Working"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-danger">@L["Not working"]</span>
                                    }
                                </td>
                                <td data-no-row-link>
                                    <div class="actions">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-solid fa-box-open"></i></span>
                <div class="title">@L["No products in this category"]</div>
                <div class="text">@L["Products assigned to this category will be listed here."]</div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        $(document).ready(initProductsTable);

        // Runs on load and again after live-updates.js swaps in a fresh table.
        function initProductsTable() {
            $('#categoryProductsTable').DataTable({
                pageLength: 10,
                responsive: true,
                columnDefs: [{ targets: -1, orderable: false, searchable: false }]
            });
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['category', 'product'],
            ids: { category: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'category',
            beforeRefresh() {
                if ($.fn.DataTable.isDataTable('#categoryProductsTable')) $('#categoryProductsTable').DataTable().destroy();
            },
            afterRefresh: initProductsTable
        });
    </script>
}
