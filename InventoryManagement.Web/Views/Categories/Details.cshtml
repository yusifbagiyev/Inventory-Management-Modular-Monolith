@model CategoryViewModel
@{
    ViewData["Title"] = "Category Details";
    var products = ViewBag.Products as List<ProductViewModel> ?? new List<ProductViewModel>();
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">@L["Category Details"]</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">@L["Dashboard"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@L["Categories"]</a></li>
                <li class="breadcrumb-item active">@L["Details"]</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> @L["Back to List"]
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-edit"></i> @L["Edit Category"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-tags me-1"></i>
                    @L["Category Information"]
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">@L["Name"]</span>
                            <span class="d-value">@Model.Name</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Description"]</span>
                            <span class="d-value">
                                @if (string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <span class="d-empty">@L["No description"]</span>
                                }
                                else
                                {
                                    @Model.Description
                                }
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Status"]</span>
                            <span class="d-value">
                                @if (Model.IsActive)
                                {
                                    <span class="state state-ok">@L["Active"]</span>
                                }
                                else
                                {
                                    <span class="state state-flat state-idle">@L["Inactive"]</span>
                                }
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Total Products"]</span>
                            <span class="d-value mono">@Model.ProductCount</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Created"]</span>
                            <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="detail-row">
                                <span class="d-label">@L["Updated"]</span>
                                <span class="d-value mono">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-boxes me-1"></i>
                    @L["Products in this Category"]
                </div>
                <div class="card-body">
                    @if (products.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="categoryProductsTable">
                                <thead>
                                    <tr>
                                        <th style="width: 96px;">@L["Code"]</th>
                                        <th>@L["Model"]</th>
                                        <th>@L["Vendor"]</th>
                                        <th>@L["Department"]</th>
                                        <th style="width: 130px;">@L["Status"]</th>
                                        <th style="width: 80px;">@L["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in products)
                                    {
                                        <tr>
                                            <td class="num">@product.InventoryCode</td>
                                            <td>@product.Model</td>
                                            <td>@product.Vendor</td>
                                            <td>@product.DepartmentName</td>
                                            <td>
                                                @if (product.IsWorking)
                                                {
                                                    <span class="state state-ok">@L["Working"]</span>
                                                }
                                                else
                                                {
                                                    <span class="state state-crit">@L["Not Working"]</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="@L["View"]">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-box-open"></i>
                            <h5>@L["No products in this category"]</h5>
                            <p class="text-muted mb-0">@L["Products assigned to this category will be listed here."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(initProductsTable);

        // Runs on load and again after live-updates.js swaps in a fresh table.
        function initProductsTable() {
            $('#categoryProductsTable').DataTable({
                pageLength: 10,
                responsive: true
            });
        }


        // Changes by other users refresh this page in place; a deletion shows a notice (live-updates.js).
        LiveUpdates.watch({
            entities: ['category', 'product'],
            ids: { category: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'category',
            beforeRefresh() {
                if ($.fn.DataTable.isDataTable('#categoryProductsTable')) $('#categoryProductsTable').DataTable().destroy();
            },
            afterRefresh: initProductsTable
        });
    </script>
}
