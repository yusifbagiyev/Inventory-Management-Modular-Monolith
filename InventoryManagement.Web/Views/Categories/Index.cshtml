@model PagedResultDto<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var hasSearch = !string.IsNullOrEmpty(currentSearch);
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Categories"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportCategoriesToPDF()">
                <i class="fas fa-file-pdf"></i> @L["Export PDF"]
            </button>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> @L["New Category"]
                </a>
            }
        </div>
    </div>

    @* Search is server-side (it reloads the page); status and sort narrow the rows
       already on screen, so both selects act the moment they change. *@
    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <form method="get" id="searchForm">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" id="searchInput" class="form-control"
                               placeholder="@L["Search categories..."]" value="@currentSearch">
                    </div>
                </form>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                <i class="fas fa-redo"></i> @L["Reset"]
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="statusFilter">@L["Status"]</label>
                <select id="statusFilter" class="form-select form-select-sm">
                    <option value="">@L["All Status"]</option>
                    <option value="active">@L["Active"]</option>
                    <option value="inactive">@L["Inactive"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="sortBy">@L["Sort"]</label>
                <select id="sortBy" class="form-select form-select-sm">
                    <option value="name">@L["Sort by Name"]</option>
                    <option value="products">@L["Sort by Products"]</option>
                    <option value="created">@L["Sort by Date"]</option>
                </select>
            </div>
        </div>

        @if (hasSearch)
        {
            <div class="filter-applied">
                <span class="achip">
                    @L["Search:"] <b>@currentSearch</b>
                    <button type="button" class="achip-x" onclick="resetFilters()">&times;</button>
                </span>
                <button type="button" class="filter-clear" onclick="resetFilters()">@L["Clear all"]</button>
            </div>
        }
    </div>

    <div class="result-bar" id="categoriesSummary">
        <span><b>@Model.TotalCount</b> @(hasSearch ? (Model.TotalCount == 1 ? L["category matched"] : L["categories matched"]) : (Model.TotalCount == 1 ? L["category"] : L["categories"]))</span>
        <span class="text-muted">
            <b>@(Model.ActiveItems ?? ViewBag.ActiveCategories)</b> @L["active"]
            &middot; <b>@(Model.InActiveItems ?? ViewBag.InActiveCategories)</b> @L["inactive"]
            &middot; <b>@(Model.ItemsInWithProducts ?? ViewBag.CategoriesInWithProducts)</b> @L["with products"]
        </span>
    </div>

    <div class="card mb-4" id="categoriesRegion">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 250px;">@L["Category"]</th>
                                <th style="width: 35%;">@L["Description"]</th>
                                <th class="text-center" style="width: 100px;">@L["Products"]</th>
                                <th style="width: 120px;">@L["Status"]</th>
                                <th style="width: 120px;">@L["Created"]</th>
                                <th class="text-center" style="width: 100px;">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesTable">
                            @foreach (var category in Model.Items)
                            {
                                <tr class="category-item"
                                    data-name="@category.Name.ToLower()"
                                    data-description="@category.Description?.ToLower()"
                                    data-status="@(category.IsActive ? "active" : "inactive")"
                                    data-products="@category.ProductCount"
                                    data-created="@category.CreatedAt.Ticks">
                                    <td>
                                        <div class="cell-item">
                                            <div class="cell-text">
                                                <span class="cell-title" title="@category.Name">@category.Name</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cell-text">
                                            @if (string.IsNullOrEmpty(category.Description))
                                            {
                                                <span class="cell-sub text-muted pdf-omit">@L["No description"]</span>
                                            }
                                            else
                                            {
                                                <span class="cell-sub" title="@category.Description">
                                                    @(category.Description.Length > 100 ? category.Description.Substring(0, 100) + "..." : category.Description)
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center num">@category.ProductCount</td>
                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="state state-ok">@L["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="state state-flat state-idle">@L["Inactive"]</span>
                                        }
                                    </td>
                                    <td class="num text-muted">@category.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-outline-secondary" title="@L["View Details"]">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-outline-secondary" title="@L["Edit"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="@L["Delete"]"
                                                    data-name="@category.Name" onclick="deleteCategory(@category.Id, this.dataset.name)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-tags"></i>
                    <h5>@L["No categories found"]</h5>
                    @if (hasSearch)
                    {
                        <p class="text-muted mb-3">@(L["Nothing matches \"{0}\".", currentSearch!])</p>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">@L["Clear search"]</button>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@L["Categories you create will be listed here."]</p>
                    }
                </div>
            }
        </div>
        <div class="card-footer">
            <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete this category?"] <strong id="categoryName"></strong></p>
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @L["This will permanently delete the category and affect associated products."]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>@L["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Snapshot of every rendered row, so narrowing by status can be undone
        // without a round-trip to the server.
        let allCategoryRows = [];

        $(document).ready(function() {
            allCategoryRows = Array.from(document.querySelectorAll('#categoriesTable tr.category-item'));

            // Filter change handlers
            $('#statusFilter, #sortBy').on('change', function() {
                filterCategories();
            });

            // Restore filter values from URL
            restoreFilterValues();
        });

        function filterCategories() {
            const statusFilter = $('#statusFilter').val();
            const sortBy = $('#sortBy').val();

            // Filter rows - every row carries its own state in data-status
            let visibleRows = allCategoryRows.filter(row => {
                const isActive = row.dataset.status === 'active';
                const matchesStatus = !statusFilter ||
                    (statusFilter === 'active' && isActive) ||
                    (statusFilter === 'inactive' && !isActive);

                return matchesStatus;
            });

            // Sort rows
            visibleRows.sort((a, b) => {
                switch(sortBy) {
                    case 'name':
                        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                    case 'products':
                        return (parseInt(b.dataset.products) || 0) - (parseInt(a.dataset.products) || 0);
                    case 'created':
                        return (Number(b.dataset.created) || 0) - (Number(a.dataset.created) || 0);
                    default:
                        return 0;
                }
            });

            // Update table (absent when the server returned no rows at all)
            const tbody = document.getElementById('categoriesTable');
            if (!tbody) {
                return;
            }
            tbody.innerHTML = '';
            visibleRows.forEach(row => tbody.appendChild(row));

            // Show/hide empty state
            if (visibleRows.length === 0) {
                if (!document.getElementById('noResults')) {
                    tbody.innerHTML = `
                        <tr id="noResults">
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-search"></i>
                                    <h5>${t('No categories match these filters')}</h5>
                                    <p class="text-muted mb-0">${t('Reset the status filter to see the full list.')}</p>
                                </div>
                            </td>
                        </tr>
                    `;
                }
            }
        }

        function restoreFilterValues() {
            const params = new URLSearchParams(window.location.search);
            const search = params.get('search');
            if (search) {
                $('#searchInput').val(search);
            }
        }

                // Add to your department/category view pages
        function applyFilters() {
            const searchTerm = $('#searchInput').val().trim();
            const params = new URLSearchParams();

            if (searchTerm) {
                params.append('search', searchTerm);
            }

            params.append('pageSize', '@Model.PageSize');
            params.append('pageNumber', '1');

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        function resetFilters() {
            // Clear all input fields
            $('#searchInput').val('');

            // Reload the page without parameters to refresh items
            window.location.href = window.location.pathname;
        }

        // Enable search on Enter key
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                applyFilters();
            }
        });

        function deleteCategory(id, name) {
            $('#categoryName').text(name);
            $('#deleteForm').attr('action', '/Categories/Delete/' + id);
            $('#deleteModal').modal('show');
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['category', 'product'],
            regions: ['#categoriesSummary', '#categoriesRegion'],
            afterRefresh() {
                allCategoryRows = Array.from(document.querySelectorAll('#categoriesTable tr.category-item'));
                filterCategories();
            }
        });
    </script>
}
