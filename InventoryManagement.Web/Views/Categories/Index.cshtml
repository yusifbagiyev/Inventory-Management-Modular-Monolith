@model PagedResultDto<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
    var currentSearch = ViewBag.CurrentSearch as string ?? null;
    var hasSearch = !string.IsNullOrEmpty(currentSearch);
    object activeCount = Model.ActiveItems ?? ViewBag.ActiveCategories ?? 0;
    object inactiveCount = Model.InActiveItems ?? ViewBag.InActiveCategories ?? 0;
    object withProductsCount = Model.ItemsInWithProducts ?? ViewBag.CategoriesInWithProducts ?? 0;
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Categories"]</h1>
            <div class="ip-sub ip-num" id="categoriesSummary">
                @L["{0} categories", Model.TotalCount] · @L["{0} active", activeCount] · @L["{0} inactive", inactiveCount] · @L["{0} with products", withProductsCount]
            </div>
        </div>
        <div class="ip-page-actions">
            <button type="button" class="ip-btn ip-btn-secondary" onclick="exportCategoriesToPDF()">
                <span>@L["Export PDF"]</span><i class="fa-regular fa-file-pdf"></i>
            </button>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="ip-btn ip-btn-primary">
                    <span>@L["New Category"]</span><i class="fa-solid fa-plus"></i>
                </a>
            }
        </div>
    </div>

    @* Search is server-side (Enter reloads the page); status and sort narrow the rows
       already on screen, so both selects act the moment they change. *@
    <div class="ip-filterbar">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" name="search" value="@currentSearch" autocomplete="off"
                   placeholder="@L["Search categories..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["Status"]</span>
            <select id="statusFilter">
                <option value="">@L["All"]</option>
                <option value="active">@L["Active"]</option>
                <option value="inactive">@L["Inactive"]</option>
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Sort"]</span>
            <select id="sortBy">
                <option value="name">@L["Sort by Name"]</option>
                <option value="products">@L["Sort by Products"]</option>
                <option value="created">@L["Sort by Date"]</option>
            </select>
        </label>
        <button type="button" class="ip-btn ip-btn-ghost @(hasSearch ? "" : "d-none")" id="resetFiltersBtn" onclick="resetFilters()">
            <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div id="categoriesRegion" data-list-region>
        <div class="ip-table-wrap">
            @if (Model.Items.Any())
            {
                <table class="ip-table">
                    <thead>
                        <tr>
                            <th>@L["Category"]</th>
                            <th>@L["Description"]</th>
                            <th>@L["Products"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Created"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody id="categoriesTable">
                        @foreach (var category in Model.Items)
                        {
                            <tr class="category-item" data-href="@Url.Action("Details", new { id = category.Id })"
                                data-name="@category.Name.ToLower()"
                                data-description="@category.Description?.ToLower()"
                                data-status="@(category.IsActive ? "active" : "inactive")"
                                data-products="@category.ProductCount"
                                data-created="@category.CreatedAt.Ticks">
                                <td>
                                    <div class="cell-text">
                                        <a class="cell-title text-reset" href="@Url.Action("Details", new { id = category.Id })" title="@category.Name">@category.Name</a>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-text">
                                        @if (string.IsNullOrEmpty(category.Description))
                                        {
                                            <span class="cell-sub pdf-omit">@L["No description"]</span>
                                        }
                                        else
                                        {
                                            <span class="cell-sub" title="@category.Description">
                                                @(category.Description.Length > 100 ? category.Description.Substring(0, 100) + "..." : category.Description)
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="ip-num">@category.ProductCount</td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="ip-badge ip-badge-success">@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                                    }
                                </td>
                                <td class="ip-num text-nowrap">@category.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td data-no-row-link>
                                    <div class="actions">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="ip-btn-icon" title="@L["View"]" aria-label="@L["View"]">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="ip-btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <button type="button" class="ip-btn-icon ip-btn-icon-danger" title="@L["Delete"]" aria-label="@L["Delete"]"
                                                data-id="@category.Id" data-name="@category.Name" onclick="deleteCategory(this.dataset.id, this.dataset.name)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="ip-empty">
                    <span class="icon"><i class="fa-solid fa-tags"></i></span>
                    <div class="title">@L["No categories found"]</div>
                    <div class="text">@(hasSearch ? L["Nothing matches \"{0}\".", currentSearch!] : L["Categories you create will be listed here."])</div>
                    @if (hasSearch)
                    {
                        <button type="button" class="ip-btn ip-btn-secondary" onclick="resetFilters()">
                            <span>@L["Clear search"]</span><i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            }
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalTitle">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete this category?"] <strong id="categoryName"></strong></p>
                <div class="ip-banner ip-banner-warning">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>@L["This will permanently delete the category and affect associated products."]</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ip-btn ip-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ip-btn ip-btn-danger">
                        <span>@L["Delete"]</span><i class="fa-solid fa-trash-can"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Snapshot of every rendered row, so narrowing by status can be undone
        // without a round-trip to the server.
        let allCategoryRows = [];
        const serverSearchActive = @(hasSearch ? "true" : "false");

        $(document).ready(function() {
            allCategoryRows = Array.from(document.querySelectorAll('#categoriesTable tr.category-item'));

            $('#statusFilter, #sortBy').on('change', function() {
                filterCategories();
            });

            restoreFilterValues();
        });

        function filterCategories() {
            const statusFilter = $('#statusFilter').val();
            const sortBy = $('#sortBy').val();

            $('#resetFiltersBtn').toggleClass('d-none', !serverSearchActive && !statusFilter);

            // Every row carries its own state in data-status
            let visibleRows = allCategoryRows.filter(row => {
                const isActive = row.dataset.status === 'active';
                return !statusFilter ||
                    (statusFilter === 'active' && isActive) ||
                    (statusFilter === 'inactive' && !isActive);
            });

            visibleRows.sort((a, b) => {
                switch(sortBy) {
                    case 'name':
                        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                    case 'products':
                        return (parseInt(b.dataset.products) || 0) - (parseInt(a.dataset.products) || 0);
                    case 'created':
                        return (Number(b.dataset.created) || 0) - (Number(a.dataset.created) || 0);
                    default:
                        return 0;
                }
            });

            // Absent when the server returned no rows at all
            const tbody = document.getElementById('categoriesTable');
            if (!tbody) {
                return;
            }
            tbody.innerHTML = '';
            visibleRows.forEach(row => tbody.appendChild(row));

            if (visibleRows.length === 0) {
                tbody.innerHTML = `
                    <tr id="noResults">
                        <td colspan="6">
                            <div class="ip-empty">
                                <span class="icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <div class="title">${t('No categories match these filters')}</div>
                                <div class="text">${t('Reset the status filter to see the full list.')}</div>
                            </div>
                        </td>
                    </tr>
                `;
            }
        }

        function restoreFilterValues() {
            const params = new URLSearchParams(window.location.search);
            const search = params.get('search');
            if (search) {
                $('#searchInput').val(search);
            }
        }

        function applyFilters() {
            const searchTerm = $('#searchInput').val().trim();
            const params = new URLSearchParams();

            if (searchTerm) {
                params.append('search', searchTerm);
            }

            params.append('pageSize', '@Model.PageSize');
            params.append('pageNumber', '1');

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        function resetFilters() {
            $('#searchInput').val('');
            window.location.href = window.location.pathname;
        }

        // Search on Enter
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                applyFilters();
            }
        });

        function deleteCategory(id, name) {
            $('#categoryName').text(name);
            $('#deleteForm').attr('action', '/Categories/Delete/' + id);
            $('#deleteModal').modal('show');
        }

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['category', 'product'],
            regions: ['#categoriesSummary', '#categoriesRegion'],
            afterRefresh() {
                allCategoryRows = Array.from(document.querySelectorAll('#categoriesTable tr.category-item'));
                filterCategories();
            }
        });
    </script>
}
