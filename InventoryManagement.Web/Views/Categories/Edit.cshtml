@model CategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Categories"]</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L["Edit Category"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> @L["Back to List"]
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-xl-7 col-lg-9">
            <form asp-action="Edit" method="post">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-edit me-1"></i>
                        @L["Edit Category Information"]
                    </div>

                    <div class="form-section">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-grid">
                            <div class="full">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="full">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="full">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">@L["Record"]</div>
                        <div class="detail-grid">
                            <div class="detail-row">
                                <span class="d-label">@L["Created"]</span>
                                <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="detail-row">
                                    <span class="d-label">@L["Updated"]</span>
                                    <span class="d-value mono">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="page-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@L["Cancel"]</a>
                        <div class="actions-right">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-save"></i> @L["Save Changes"]
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('form').on('submit', function(e) {
                e.preventDefault();
                var form = this;
                var $btn = $(form).find('button[type="submit"]');
                var originalText = $btn.html();

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>' + t('Saving...'));

                $.ajax({
                    url: form.action,
                    type: form.method,
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        showToast(t('Category updated successfully!'), 'success');
                        setTimeout(() => window.location.href = '@Url.Action("Index")', 1500);
                    },
                    error: function(xhr) {
                        $btn.prop('disabled', false).html(originalText);
                        var error = t('Failed to update category');
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            error = xhr.responseJSON.message;
                        }
                        showToast(error, 'error');
                    }
                });
            });
        });


        // Someone else saving or deleting this category while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['category'],
            ids: { category: @Model.Id },
            label: 'category'
        });
    </script>
}
