@model CategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">@L["Categories"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L["Edit Category"]</h1>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="ip-form" id="categoryForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Basic information"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field span-2">
                    <label asp-for="Name" class="ip-label"><span>@L["Category Name"]</span> <span class="req">*</span></label>
                    <input asp-for="Name" class="ip-input" />
                    <span asp-validation-for="Name" class="ip-error"></span>
                </div>
                <div class="ip-field span-2">
                    <label asp-for="Description" class="ip-label"></label>
                    <textarea asp-for="Description" class="ip-textarea" rows="3"></textarea>
                    <span asp-validation-for="Description" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Status"]</h2>
            <div class="ip-switch-list">
                <label class="ip-switch-row">
                    <span class="fw-medium">@L["Active"]</span>
                    <input asp-for="IsActive" type="checkbox" role="switch" class="ip-switch" />
                </label>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Record"]</h2>
            <dl class="ip-dl">
                <div><dt>@L["Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div><dt>@L["Updated"]</dt><dd class="ip-num">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd></div>
                }
            </dl>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#categoryForm').on('submit', function(e) {
                e.preventDefault();
                var form = this;
                var $btn = $(form).find('button[type="submit"]');
                var originalText = $btn.html();

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>' + t('Saving...'));

                $.ajax({
                    url: form.action,
                    type: form.method,
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        showToast(t('Category updated successfully!'), 'success');
                        setTimeout(() => window.location.href = '@Url.Action("Index")', 1500);
                    },
                    error: function(xhr) {
                        $btn.prop('disabled', false).html(originalText);
                        var error = t('Failed to update category');
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            error = xhr.responseJSON.message;
                        }
                        showToast(error, 'error');
                    }
                });
            });
        });


        // If someone else changes this category while it is open, warn but leave the form alone.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['category'],
            ids: { category: @Model.Id },
            label: 'category'
        });
    </script>
}
