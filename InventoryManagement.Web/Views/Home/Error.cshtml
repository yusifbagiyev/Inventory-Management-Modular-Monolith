@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <div class="ip-empty">
        <span class="icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
        <h1 class="title">@L["Something went wrong."]</h1>
        <p class="text mb-0">@L[Model?.Message ?? "An error occurred while processing your request."]</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="ip-faint mb-0">
                @if (Model.StatusCode > 0)
                {
                    <span class="ip-num">@Model.StatusCode</span><span> · </span>
                }
                @L["Request ID"]: <span class="ip-mono">@Model.RequestId</span>
            </p>
        }
        <a href="/Home/Dashboard" class="ip-btn ip-btn-secondary">
            <span>@L["Go to Dashboard"]</span><i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</div>
