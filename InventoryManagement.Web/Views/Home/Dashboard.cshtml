@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentPeriod = ViewBag.CurrentPeriod as string ?? "last7days";
    var allTime = currentPeriod == "all";
    var notWorking = (int)(ViewBag.NotWorking ?? 0);
    var openTransfers = (int)(ViewBag.OpenTransfers ?? 0);
    var pendingApprovals = ViewBag.PendingApprovals as int?;

    // Period caption under the completed-transfers figure
    var periodText = currentPeriod switch
    {
        "last30days" => L["in the last {0} days", 30].Value,
        "last90days" => L["in the last {0} days", 90].Value,
        "last6months" => L["in the last 6 months"].Value,
        "all" => L["over all time"].Value,
        _ => L["in the last {0} days", 7].Value
    };

    // Figures, chart bars and rows link to the lists filtered to this period
    string PeriodQuery() => Model.PeriodStart is null ? "" : $"&startDate={Model.PeriodStart}&endDate={Model.PeriodEnd}";
    var transfersUrl = "/Routes?routeType=Transfer" + PeriodQuery();
    var productsUrl = Model.PeriodStart is null ? "/Products" : $"/Products?startDate={Model.PeriodStart}&endDate={Model.PeriodEnd}";
    // Without the permission these return null and Razor drops the href
    var canProducts = User.HasPermission("product.view");
    var canRoutes = User.HasPermission("route.view");
    string? ProductLink(string url) => canProducts ? url : null;
    string? RouteLink(string url) => canRoutes ? url : null;
    var categoryTotal = Model.CategoryDistributions.Sum(c => c.Count);
    var maxDepartment = Math.Max(1, Model.DepartmentStats.Select(d => d.PeriodTransfers).DefaultIfEmpty(0).Max());
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Dashboard"]</h1>
        </div>
        <nav class="ip-tabs ink border-0" aria-label="@L["Period"]">
            <a class="ip-tab @(currentPeriod == "last7days" ? "active" : "")" href="/Home/Dashboard?period=last7days">@L["7 days"]</a>
            <a class="ip-tab @(currentPeriod == "last30days" ? "active" : "")" href="/Home/Dashboard?period=last30days">@L["30 days"]</a>
            <a class="ip-tab @(currentPeriod == "last90days" ? "active" : "")" href="/Home/Dashboard?period=last90days">@L["90 days"]</a>
            <a class="ip-tab @(allTime ? "active" : "")" href="/Home/Dashboard?period=all">@L["All"]</a>
        </nav>
    </div>

    <div class="ip-kpi-grid" id="dashboardStats">
        @* Only completed transfers follow the period, the other figures show the current state *@
        <a class="ip-kpi" href="@ProductLink("/Products")">
            <span class="label">@L["Total products"]</span>
            <span class="value">@Model.TotalProducts.ToString("N0")</span>
            <span class="trend">@L["{0} active · {1} inactive", Model.ActiveProducts.ToString("N0"), Model.InactiveProducts.ToString("N0")]</span>
        </a>
        <a class="ip-kpi" href="@ProductLink("/Products?status=false")">
            <span class="label">@L["Faulty"]</span>
            <span class="value">@Model.NotWorking.ToString("N0")</span>
            <span class="trend text-truncate">@(Model.NotWorkingNames.Count > 0 ? string.Join(", ", Model.NotWorkingNames) : L["None"].Value)</span>
        </a>
        <a class="ip-kpi" href="@RouteLink(transfersUrl + "&isCompleted=true")">
            <span class="label">@L["Completed transfers"]</span>
            <span class="value">@((Model.CompletedTransfers ?? 0).ToString("N0"))</span>
            <span class="trend">@periodText</span>
        </a>
        <a class="ip-kpi" href="@RouteLink("/Routes?routeType=Transfer&isCompleted=false")">
            <span class="label">@L["Pending transfers"]</span>
            <span class="value">@Model.PendingTransfers.ToString("N0")</span>
            <span class="trend">@(Model.OldestPendingDays switch
            {
                null => L["None waiting"].Value,
                0 => L["the oldest is from today"].Value,
                int days => L.Plural(days, "the oldest has waited {0} day", "the oldest has waited {0} days").Value
            })</span>
        </a>
    </div>

    <div class="row g-5 mt-0" id="dashboardCharts">
        <div class="col-xl-8">
            <section class="ip-section">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <h2>@L["Transfer Activity"]</h2>
                    <div class="ip-legend">
                        <span><i style="background: var(--ip-chart-1)"></i>@L["Completed"]</span>
                        <span><i style="background: var(--ip-chart-pending)"></i>@L["Pending"]</span>
                    </div>
                </div>
                @if (Model.TransferActivityData.Labels.Any())
                {
                    <div class="ip-chart">
                        <canvas id="transferChart" role="img" aria-label="@L["Transfer Activity"]"
                                data-chart="@Json.Serialize(Model.TransferActivityData).ToString()" data-link="@RouteLink("/Routes?routeType=Transfer")"></canvas>
                    </div>
                    <p class="ip-hint mt-2 mb-0">@L["Click a bar to open those transfers."]</p>
                }
                else
                {
                    <p class="ip-muted py-4 mb-0">@L["No transfer activity for this period"]</p>
                }
            </section>
        </div>

        @* On phones CSS order moves this block above the chart *@
        <div class="col-xl-4 ip-dash-attention">
            <section class="ip-section">
                <h2 class="mb-3">@L["Needs attention"]</h2>
                @if (pendingApprovals is int approvals)
                {
                    <a class="ip-list-link" href="/Approvals">
                        <span>@L["Requests awaiting approval"]</span>
                        <b class="ip-num @(approvals > 0 ? "ip-status-text warning fs-6" : "")">@approvals</b>
                    </a>
                }
                <a class="ip-list-link" href="@RouteLink("/Routes?isCompleted=false")">
                    <span>@L["Unfinished transfers"]</span>
                    <b class="ip-num @(openTransfers > 0 ? "ip-status-text warning fs-6" : "")">@openTransfers</b>
                </a>
                <a class="ip-list-link" href="@ProductLink("/Products?status=false")">
                    <span>@L["Broken devices"]</span>
                    <b class="ip-num @(notWorking > 0 ? "text-danger" : "")">@notWorking</b>
                </a>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="ip-section">
                <h2 class="mb-3">@L["Categories in Transfers"]</h2>
                @if (Model.CategoryDistributions.Any())
                {
                    <div class="d-flex gap-4 align-items-center flex-wrap">
                        <div style="position: relative; width: 168px; height: 168px;">
                            <canvas id="categoryChart" role="img" aria-label="@L["Categories in Transfers"]"
                                    data-chart="@Json.Serialize(Model.CategoryDistributions).ToString()" data-link="@RouteLink(transfersUrl)"></canvas>
                        </div>
                        <div class="flex-grow-1" style="min-width: 200px">
                            @for (var i = 0; i < Model.CategoryDistributions.Count; i++)
                            {
                                var category = Model.CategoryDistributions[i];
                                <a class="ip-list-link" href="@RouteLink(transfersUrl + "&categoryName=" + Uri.EscapeDataString(category.CategoryName))">
                                    <span class="d-flex align-items-center gap-2" style="min-width: 0">
                                        <i class="ip-swatch" style="background: var(--ip-cat-@(i % 8 + 1))"></i>
                                        <span class="text-truncate">@category.CategoryName</span>
                                    </span>
                                    <span class="ip-num ip-muted text-nowrap">@(categoryTotal == 0 ? 0 : Math.Round(category.Count * 100.0 / categoryTotal))% · @category.Count</span>
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="ip-muted py-4 mb-0">@L["No transfers for this period"]</p>
                }
            </section>
        </div>

        <div class="col-xl-7" id="dashboardRecent">
            <section class="ip-section">
                <h2 class="mb-3">@L["Top Departments by Transfer Activity"]</h2>
                @if (Model.DepartmentStats.Any())
                {
                    @foreach (var dept in Model.DepartmentStats)
                    {
                        <a class="ip-list-link" href="@RouteLink(transfersUrl + "&departmentName=" + Uri.EscapeDataString(dept.DepartmentName))">
                            <span class="text-truncate" style="width: 30%">@dept.DepartmentName</span>
                            <span class="ip-bar" aria-hidden="true"><i style="width: @(dept.PeriodTransfers * 100 / maxDepartment)%"></i></span>
                            <span class="ip-num ip-muted text-nowrap" title="@L["Unique Products"]: @dept.ProductCount · @L["Active Workers"]: @dept.ActiveWorkers">
                                @L.Plural(dept.PeriodTransfers, "{0} transfer", "{0} transfers")
                            </span>
                        </a>
                    }
                }
                else
                {
                    <p class="ip-muted py-4 mb-0">@L["No department activity for this period"]</p>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let transferChart, categoryChart;

        // Colours are read from the tokens so the charts follow the theme
        const v = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

        function initializeCharts() {
            Chart.defaults.font.family = v('--ip-font-sans');
            Chart.defaults.color = v('--ip-text-3');
            initializeTransferChart();
            initializeCategoryChart();
        }

        function destroyCharts() {
            transferChart?.destroy();
            categoryChart?.destroy();
            transferChart = categoryChart = undefined;
        }

        window.addEventListener('themechange', function () { destroyCharts(); initializeCharts(); });
        $(initializeCharts);

        LiveUpdates.watch({
            entities: ['product', 'route', 'category', 'department', 'approval'],
            regions: ['#dashboardStats', '#dashboardCharts'],
            beforeRefresh: destroyCharts,
            afterRefresh: initializeCharts
        });

        // Charts only have data-link when the user may open the routes list
        function pointerOnHover(event, elements) {
            event.native.target.style.cursor = elements.length && event.native.target.dataset.link ? 'pointer' : 'default';
        }

        function tooltip() {
            return { backgroundColor: v('--ip-text-1'), titleColor: v('--ip-surface'), bodyColor: v('--ip-surface'), padding: 10, cornerRadius: 8, displayColors: true, boxPadding: 4 };
        }

        // Clicking a bar opens that bucket's transfers, and a single segment also filters by status
        function initializeTransferChart() {
            const ctx = document.getElementById('transferChart');
            if (!ctx) return;
            const data = JSON.parse(ctx.dataset.chart || 'null');
            if (!data || !data.labels || !data.labels.length) return;

            transferChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [
                        { label: t('Completed'), data: data.completedData, backgroundColor: v('--ip-chart-1'), borderRadius: 4, maxBarThickness: 64 },
                        { label: t('Pending'), data: data.pendingData, backgroundColor: v('--ip-chart-pending'), borderRadius: 4, maxBarThickness: 64 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { display: false }, tooltip: tooltip() },
                    scales: {
                        x: {
                            stacked: true, grid: { display: false }, border: { color: v('--ip-border-strong') },
                            // Phones show only the day numbers so the labels fit
                            ticks: {
                                callback: function (value) {
                                    const label = this.getLabelForValue(value);
                                    if (window.innerWidth >= 768 || typeof label !== 'string') return label;
                                    const range = /^(\d{2})[–-](\d{2})\.\d{2}$/.exec(label);
                                    if (range) return (+range[1]) + '–' + (+range[2]);
                                    const day = /(\d{2})\.\d{2}$/.exec(label);
                                    return day ? String(+day[1]) : label;
                                }
                            }
                        },
                        y: { stacked: true, beginAtZero: true, grid: { color: v('--ip-border') }, border: { display: false }, ticks: { precision: 0 } }
                    },
                    onHover: pointerOnHover,
                    onClick: function (event, elements) {
                        if (!elements.length || !ctx.dataset.link) return;
                        const i = elements[0].index;
                        const status = elements.length === 1 ? (elements[0].datasetIndex === 0 ? '&isCompleted=true' : '&isCompleted=false') : '';
                        window.location.href = ctx.dataset.link + '&startDate=' + data.bucketStarts[i] + '&endDate=' + data.bucketEnds[i] + status;
                    }
                }
            });
        }

        // The legend is plain HTML beside the chart, and clicking a slice opens that category's transfers
        function initializeCategoryChart() {
            const ctx = document.getElementById('categoryChart');
            if (!ctx) return;
            const data = JSON.parse(ctx.dataset.chart || 'null');
            if (!data || !data.length) return;

            categoryChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.map(c => c.categoryName),
                    datasets: [{
                        data: data.map(c => c.count),
                        backgroundColor: data.map((c, i) => v('--ip-cat-' + (i % 8 + 1))),
                        borderColor: v('--ip-surface'),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: { legend: { display: false }, tooltip: tooltip() },
                    onHover: pointerOnHover,
                    onClick: function (event, elements) {
                        if (!elements.length || !ctx.dataset.link) return;
                        window.location.href = ctx.dataset.link + '&categoryName=' + encodeURIComponent(data[elements[0].index].categoryName);
                    }
                }
            });
        }
    </script>
}
