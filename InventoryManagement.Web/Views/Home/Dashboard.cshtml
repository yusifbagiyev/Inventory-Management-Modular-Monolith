@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentPeriod = ViewBag.CurrentPeriod as string ?? "last7days";
    var totalDepartments = ViewBag.TotalDepartments ?? 0;
    var totalCategories = ViewBag.TotalCategories ?? 0;
    var activeDepartmentsInPeriod = ViewBag.ActiveDepartmentsInPeriod ?? 0;
    var activeCategoriesInPeriod = ViewBag.ActiveCategoriesInPeriod ?? 0;
    var startDate = ViewBag.PeriodStartDate as DateTime?;
    var endDate = ViewBag.PeriodEndDate as DateTime?;

    // Pending transfers are the only tile figure that can signal a problem, so it is the only one that gets colour
    var pendingState = Model.PendingTransfers > 0 ? "state-warn" : "state-idle";

    // Determine period display name
    var periodName = currentPeriod switch
    {
        "last7days" => "Last 7 Days",
        "last30days" => "Last 30 Days",
        "last6months" => "Last 6 Months",
        "all" => "All Time",
        _ => "Last 7 Days"
    };
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Dashboard</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item active">Overview</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="form-label mb-0">Period</span>
            <button type="button" class="qchip @(currentPeriod == "last7days" ? "active" : "")"
                    onclick="changePeriod('last7days')">
                Last 7 Days
            </button>
            <button type="button" class="qchip @(currentPeriod == "last30days" ? "active" : "")"
                    onclick="changePeriod('last30days')">
                Last 30 Days
            </button>
            <button type="button" class="qchip @(currentPeriod == "last6months" ? "active" : "")"
                    onclick="changePeriod('last6months')">
                Last 6 Months
            </button>
            <button type="button" class="qchip @(currentPeriod == "all" ? "active" : "")"
                    onclick="changePeriod('all')">
                All Time
            </button>
        </div>
    </div>

    <!-- Period Info Banner -->
    @if (startDate.HasValue && endDate.HasValue)
    {
        <div class="alert alert-info mt-3 mb-3">
            <i class="fas fa-calendar-alt me-2"></i>
            <strong>Viewing:</strong> @periodName
            <span class="mx-2">|</span>
            <strong>Date Range:</strong> @startDate.Value.ToString("MMM dd, yyyy") - @endDate.Value.ToString("MMM dd, yyyy")
            @if (currentPeriod != "all")
            {
                <span class="ms-3"><em>(Showing transfer activity and new products for this period)</em></span>
            }
        </div>
    }

    <!-- Key Metrics -->
    <div class="row g-3 mt-1 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-boxes me-1"></i>
                        @if (currentPeriod == "all")
                        {
                            <text>Total Products</text>
                        }
                        else
                        {
                            <text>New Products Added</text>
                        }
                    </div>
                    <div class="display-6 mb-2">@Model.TotalProducts.ToString("N0")</div>
                    <span class="state state-flat state-ok">
                        <i class="fas fa-check-circle"></i> @Model.ActiveProducts active
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-exchange-alt me-1"></i>
                        Total Transfers
                    </div>
                    <div class="display-6 mb-2">@Model.TotalRoutes.ToString("N0")</div>
                    <span class="state state-flat @pendingState">
                        <i class="fas fa-hourglass-half"></i> @Model.PendingTransfers pending
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-building me-1"></i>
                        Departments
                    </div>
                    <div class="display-6 mb-2">@totalDepartments</div>
                    <span class="state state-flat state-info">
                        <i class="fas fa-chart-line"></i> @activeDepartmentsInPeriod active in period
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-tags me-1"></i>
                        Categories
                    </div>
                    <div class="display-6 mb-2">@totalCategories</div>
                    <span class="state state-flat state-idle">
                        <i class="fas fa-chart-line"></i> @activeCategoriesInPeriod active in period
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-3">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Transfer Activity (@periodName)</h5>
                        <small class="text-muted">Completed vs Pending</small>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.TransferActivityData.Labels.Any())
                    {
                        @* Chart.js needs an explicitly sized box when maintainAspectRatio is off. *@
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="transferChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-line"></i>
                            <h5>No transfer activity for this period</h5>
                            <p class="text-muted mb-0">Pick a wider period to see movement over time.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">Categories in Transfers</h5>
                    <small class="text-muted">Products transferred by category</small>
                </div>
                <div class="card-body">
                    @if (Model.CategoryDistributions.Any())
                    {
                        <div class="chart-container" style="position: relative; height: 250px;">
                            <canvas id="categoryChart"></canvas>
                        </div>
                        <!-- Legend -->
                        <div class="detail-grid mt-3">
                            @foreach (var category in Model.CategoryDistributions)
                            {
                                <div class="detail-row">
                                    <span class="d-label">
                                        <span class="d-inline-block align-middle me-2"
                                              style="width: 10px; height: 10px; border-radius: 2px; background-color: @category.Color;"></span>@category.CategoryName
                                    </span>
                                    <span class="d-value"><span class="mono">@category.Count</span> transfers</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-pie"></i>
                            <h5>No transfers for this period</h5>
                            <p class="text-muted mb-0">The category split appears once products move.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Department Performance -->
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Top Departments by Transfer Activity</h5>
                    <small class="text-muted">Departments with the most transfer activity during @periodName.ToLower()</small>
                </div>
                <div class="card-body p-0">
                    @if (Model.DepartmentStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Department</th>
                                        <th class="text-center">
                                            <i class="fas fa-exchange-alt me-1"></i>
                                            Total Transfers
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-box me-1"></i>
                                            Unique Products
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-users me-1"></i>
                                            Active Workers
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dept in Model.DepartmentStats)
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-building text-muted me-2"></i>
                                                <strong>@dept.DepartmentName</strong>
                                            </td>
                                            <td class="text-center num">@dept.PeriodTransfers</td>
                                            <td class="text-center num">@dept.ProductCount</td>
                                            <td class="text-center num">@dept.ActiveWorkers</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="page-actions">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                <strong>Note:</strong> "Active" means the department participated in at least one transfer during this period.
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-building"></i>
                            <h5>No department activity for this period</h5>
                            <p class="text-muted mb-0">Departments show up here once they send or receive a transfer.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let transferChart, categoryChart;
        const currentPeriod = '@currentPeriod';

        // Chart palette - mirrors the design tokens in modern-ui.css
        const chartColors = {
            accent: '#0E9BC4',
            ok: '#17924E',
            warn: '#C2740A',
            crit: '#CE3B33',
            neutral: '#7C8F9B',
            ink: 'rgba(20, 35, 43, 0.92)',
            grid: 'rgba(20, 35, 43, 0.06)',
            okFill: 'rgba(23, 146, 78, 0.12)',
            warnFill: 'rgba(194, 116, 10, 0.12)'
        };

        $(document).ready(function() {
            initializeCharts();
            initializeTooltips();
        });

        function initializeTooltips() {
            $('[data-bs-toggle="tooltip"]').tooltip();
        }

        function changePeriod(period) {
            if (period === currentPeriod) return;

            showLoadingOverlay();
            window.location.href = '/Home/Dashboard?period=' + period;
        }

        function showLoadingOverlay() {
            const overlay = `
                <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                     style="background: rgba(255,255,255,0.95); z-index: 9999;">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5>Loading dashboard data...</h5>
                        <p class="text-muted">Please wait</p>
                    </div>
                </div>
            `;
            $('body').append(overlay);
        }

        function initializeCharts() {
            initializeCategoryChart();
            initializeTransferChart();
        }

        function initializeCategoryChart() {
            const ctx = document.getElementById('categoryChart');
            if (!ctx) return;

            const categoryData = @Html.Raw(Json.Serialize(Model.CategoryDistributions));
            if (!categoryData || categoryData.length === 0) return;

            categoryChart = new Chart(ctx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: categoryData.map(c => c.categoryName),
                    datasets: [{
                        data: categoryData.map(c => c.count),
                        backgroundColor: categoryData.map(c => c.color),
                        borderWidth: 3,
                        borderColor: '#fff',
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: chartColors.ink,
                            padding: 12,
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 },
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return `${label}: ${value} transfers (${percentage}%)`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        }

        function initializeTransferChart() {
            const ctx = document.getElementById('transferChart');
            if (!ctx) return;

            const transferData = @Html.Raw(Json.Serialize(Model.TransferActivityData));
            if (!transferData || !transferData.labels || transferData.labels.length === 0) return;

            transferChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: transferData.labels,
                    datasets: [
                        {
                            label: 'Completed',
                            data: transferData.completedData,
                            borderColor: chartColors.ok,
                            backgroundColor: chartColors.okFill,
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: chartColors.ok,
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        },
                        {
                            label: 'Pending',
                            data: transferData.pendingData,
                            borderColor: chartColors.warn,
                            backgroundColor: chartColors.warnFill,
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: chartColors.warn,
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                color: chartColors.neutral,
                                font: { size: 12, weight: 'bold' }
                            }
                        },
                        tooltip: {
                            backgroundColor: chartColors.ink,
                            padding: 12,
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                precision: 0,
                                color: chartColors.neutral,
                                font: { size: 11 }
                            },
                            grid: {
                                color: chartColors.grid,
                                drawBorder: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: chartColors.neutral,
                                font: { size: 11 }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
