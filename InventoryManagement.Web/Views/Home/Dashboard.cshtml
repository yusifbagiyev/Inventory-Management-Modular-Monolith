@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentPeriod = ViewBag.CurrentPeriod as string ?? "last7days";
    var totalDepartments = ViewBag.TotalDepartments ?? 0;
    var totalCategories = ViewBag.TotalCategories ?? 0;
    var activeDepartmentsInPeriod = ViewBag.ActiveDepartmentsInPeriod ?? 0;
    var activeCategoriesInPeriod = ViewBag.ActiveCategoriesInPeriod ?? 0;
    var startDate = ViewBag.PeriodStartDate as DateTime?;
    var endDate = ViewBag.PeriodEndDate as DateTime?;

    // Pending transfers are the only tile figure that can signal a problem, so it is the only one that gets colour
    var pendingState = Model.PendingTransfers > 0 ? "state-warn" : "state-idle";

    // Determine period display name
    var periodName = currentPeriod switch
    {
        "last7days" => L["Last 7 Days"].Value,
        "last30days" => L["Last 30 Days"].Value,
        "last6months" => L["Last 6 Months"].Value,
        "all" => L["All Time"].Value,
        _ => L["Last 7 Days"].Value
    };

    // Links into the filtered lists for this period (tiles, chart points, table rows).
    string PeriodQuery() => Model.PeriodStart is null ? "" : $"&startDate={Model.PeriodStart}&endDate={Model.PeriodEnd}";
    var transfersUrl = "/Routes?routeType=Transfer" + PeriodQuery();
    var productsUrl = Model.PeriodStart is null ? "/Products" : $"/Products?startDate={Model.PeriodStart}&endDate={Model.PeriodEnd}";
}

@functions {
    /// <summary>Change against the previous period: arrow, colour and "+12%" (or "+3" when it was zero).</summary>
    private (string Icon, string Css, string Text)? TrendOf(int current, int? previous, bool upIsBad = false)
    {
        if (previous is not { } prev)
            return null;
        if (current == prev)
            return ("fa-minus", "trend-flat", "0%");

        var up = current > prev;
        var text = prev == 0
            ? $"+{current}"
            : $"{(up ? "+" : "−")}{Math.Abs(Math.Round((current - prev) * 100.0 / prev)):0}%";
        return (up ? "fa-arrow-trend-up" : "fa-arrow-trend-down", up == upIsBad ? "trend-bad" : "trend-good", text);
    }
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Dashboard"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="form-label mb-0">@L["Period"]</span>
            <button type="button" class="qchip @(currentPeriod == "last7days" ? "active" : "")"
                    onclick="changePeriod('last7days')">
                @L["Last 7 Days"]
            </button>
            <button type="button" class="qchip @(currentPeriod == "last30days" ? "active" : "")"
                    onclick="changePeriod('last30days')">
                @L["Last 30 Days"]
            </button>
            <button type="button" class="qchip @(currentPeriod == "last6months" ? "active" : "")"
                    onclick="changePeriod('last6months')">
                @L["Last 6 Months"]
            </button>
            <button type="button" class="qchip @(currentPeriod == "all" ? "active" : "")"
                    onclick="changePeriod('all')">
                @L["All Time"]
            </button>
        </div>
    </div>

    <!-- Period Info Banner -->
    @if (startDate.HasValue && endDate.HasValue)
    {
        <div class="alert alert-info mt-3 mb-3">
            <i class="fas fa-calendar-alt me-2"></i>
            <strong>@L["Viewing:"]</strong> @periodName
            <span class="mx-2">|</span>
            <strong>@L["Date Range:"]</strong> @startDate.Value.ToString("dd.MM.yyyy") - @endDate.Value.ToString("dd.MM.yyyy")
            @if (currentPeriod != "all")
            {
                <span class="ms-3"><em>@L["(Showing transfer activity and new products for this period)"]</em></span>
            }
        </div>
    }

    <!-- Key Metrics -->
    <div class="row g-3 mt-1 mb-3" id="dashboardStats">
        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-boxes me-1"></i>
                        @if (currentPeriod == "all")
                        {
                            <text>@L["Total Products"]</text>
                        }
                        else
                        {
                            <text>@L["New Products Added"]</text>
                        }
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <a class="display-6 metric-link" href="@productsUrl">@Model.TotalProducts.ToString("N0")</a>
                        @if (TrendOf(Model.TotalProducts, Model.PreviousTotalProducts) is { } productTrend)
                        {
                            <span class="trend @productTrend.Css" title="@L["Previous period: {0}", Model.PreviousTotalProducts!]">
                                <i class="fas @productTrend.Icon"></i> @productTrend.Text
                            </span>
                        }
                    </div>
                    <span class="state state-flat state-ok">
                        <i class="fas fa-check-circle"></i> @L["{0} active", Model.ActiveProducts]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-exchange-alt me-1"></i>
                        @L["Total Transfers"]
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <a class="display-6 metric-link" href="@transfersUrl">@Model.TotalRoutes.ToString("N0")</a>
                        @if (TrendOf(Model.TotalRoutes, Model.PreviousTotalRoutes) is { } transferTrend)
                        {
                            <span class="trend @transferTrend.Css" title="@L["Previous period: {0}", Model.PreviousTotalRoutes!]">
                                <i class="fas @transferTrend.Icon"></i> @transferTrend.Text
                            </span>
                        }
                    </div>
                    <a class="state state-flat @pendingState metric-chip" href="@(transfersUrl)&isCompleted=false">
                        <i class="fas fa-hourglass-half"></i> @L["{0} pending", Model.PendingTransfers ?? 0]
                        @if (TrendOf(Model.PendingTransfers ?? 0, Model.PreviousPendingTransfers, upIsBad: true) is { } pendingTrend && pendingTrend.Css != "trend-flat")
                        {
                            <span class="trend @pendingTrend.Css ms-1" title="@L["Previous period: {0}", Model.PreviousPendingTransfers!]"><i class="fas @pendingTrend.Icon"></i> @pendingTrend.Text</span>
                        }
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-building me-1"></i>
                        @L["Departments"]
                    </div>
                    <a class="display-6 mb-2 d-block metric-link" href="/Departments">@totalDepartments</a>
                    <span class="state state-flat state-info">
                        <i class="fas fa-chart-line"></i> @L["{0} active in period", (object)activeDepartmentsInPeriod]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-title">
                        <i class="fas fa-tags me-1"></i>
                        @L["Categories"]
                    </div>
                    <a class="display-6 mb-2 d-block metric-link" href="/Categories">@totalCategories</a>
                    <span class="state state-flat state-idle">
                        <i class="fas fa-chart-line"></i> @L["{0} active in period", (object)activeCategoriesInPeriod]
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-3" id="dashboardCharts">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@L["Transfer Activity"] (@periodName)</h5>
                        <small class="text-muted">@L["Completed vs Pending"] · @L["click a point to open those transfers"]</small>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.TransferActivityData.Labels.Any())
                    {
                        @* Chart.js needs an explicitly sized box when maintainAspectRatio is off. *@
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="transferChart" data-chart="@Json.Serialize(Model.TransferActivityData).ToString()" data-link="/Routes?routeType=Transfer"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-line"></i>
                            <h5>@L["No transfer activity for this period"]</h5>
                            <p class="text-muted mb-0">@L["Pick a wider period to see movement over time."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">@L["Categories in Transfers"]</h5>
                    <small class="text-muted">@L["Products transferred by category"]</small>
                </div>
                <div class="card-body">
                    @if (Model.CategoryDistributions.Any())
                    {
                        <div class="chart-container" style="position: relative; height: 250px;">
                            <canvas id="categoryChart" data-chart="@Json.Serialize(Model.CategoryDistributions).ToString()" data-link="@transfersUrl"></canvas>
                        </div>
                        <!-- Legend -->
                        <div class="detail-grid mt-3">
                            @foreach (var category in Model.CategoryDistributions)
                            {
                                <a class="detail-row row-link" href="@(transfersUrl)&categoryName=@Uri.EscapeDataString(category.CategoryName)">
                                    <span class="d-label">
                                        <span class="d-inline-block align-middle me-2"
                                              style="width: 10px; height: 10px; border-radius: 2px; background-color: @category.Color;"></span>@category.CategoryName
                                    </span>
                                    <span class="d-value"><span class="mono">@category.Count</span> @L["transfers"]</span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-pie"></i>
                            <h5>@L["No transfers for this period"]</h5>
                            <p class="text-muted mb-0">@L["The category split appears once products move."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Department Performance -->
    <div class="row" id="dashboardRecent">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">@L["Top Departments by Transfer Activity"]</h5>
                    <small class="text-muted">@L["Departments with the most transfer activity during {0}", periodName.ToLower()]</small>
                </div>
                <div class="card-body p-0">
                    @if (Model.DepartmentStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>@L["Department"]</th>
                                        <th class="text-center">
                                            <i class="fas fa-exchange-alt me-1"></i>
                                            @L["Total Transfers"]
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-box me-1"></i>
                                            @L["Unique Products"]
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-users me-1"></i>
                                            @L["Active Workers"]
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dept in Model.DepartmentStats)
                                    {
                                        <tr class="row-link" data-href="@(transfersUrl)&departmentId=@dept.DepartmentId">
                                            <td>
                                                <i class="fas fa-building text-muted me-2"></i>
                                                <a class="fw-semibold text-reset text-decoration-none" href="@(transfersUrl)&departmentId=@dept.DepartmentId">@dept.DepartmentName</a>
                                            </td>
                                            <td class="text-center num">@dept.PeriodTransfers</td>
                                            <td class="text-center num">@dept.ProductCount</td>
                                            <td class="text-center num">@dept.ActiveWorkers</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="page-actions">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                <strong>@L["Note:"]</strong> @(L["\"Active\" means the department participated in at least one transfer during this period."])
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-building"></i>
                            <h5>@L["No department activity for this period"]</h5>
                            <p class="text-muted mb-0">@L["Departments show up here once they send or receive a transfer."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let transferChart, categoryChart;
        const currentPeriod = '@currentPeriod';

        // Chart palette, read from the design tokens (modern-ui.css) so it follows the theme.
        let chartColors = readChartColors();

        function readChartColors() {
            const css = getComputedStyle(document.documentElement);
            const token = name => css.getPropertyValue(name).trim();
            const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            return {
                accent: token('--accent'),
                ok: token('--ok'),
                warn: token('--warn'),
                crit: token('--crit'),
                neutral: token('--ink-3'),
                surface: token('--surface'),
                ink: dark ? 'rgba(8, 16, 21, 0.94)' : 'rgba(20, 35, 43, 0.92)',   // tooltip background
                grid: dark ? 'rgba(227, 237, 242, 0.08)' : 'rgba(20, 35, 43, 0.06)',
                okFill: withAlpha(token('--ok'), 0.14),
                warnFill: withAlpha(token('--warn'), 0.14)
            };
        }

        // '#RRGGBB' -> 'rgba(r, g, b, a)' (a canvas fill cannot rely on CSS color-mix()).
        function withAlpha(hex, alpha) {
            const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex);
            return m ? `rgba(${parseInt(m[1], 16)}, ${parseInt(m[2], 16)}, ${parseInt(m[3], 16)}, ${alpha})` : hex;
        }

        // Toggling the theme redraws the charts in the new palette.
        window.addEventListener('themechange', function () {
            transferChart?.destroy();
            categoryChart?.destroy();
            transferChart = categoryChart = undefined;
            chartColors = readChartColors();
            initializeCharts();
        });

        $(document).ready(function() {
            initializeCharts();
            initializeTooltips();
        });

        // Any product, route, category, department or approval change updates the figures.
        LiveUpdates.watch({
            entities: ['product', 'route', 'category', 'department', 'approval'],
            regions: ['#dashboardStats', '#dashboardCharts', '#dashboardRecent'],
            beforeRefresh() {
                transferChart?.destroy();
                categoryChart?.destroy();
                transferChart = categoryChart = undefined;
                $('[data-bs-toggle="tooltip"]').tooltip('dispose');
            },
            afterRefresh() {
                initializeCharts();
                initializeTooltips();
            }
        });

        function initializeTooltips() {
            $('[data-bs-toggle="tooltip"]').tooltip();
        }

        // Department rows open that department's transfers (delegated: survives live refreshes).
        $(document).on('click', 'tr.row-link[data-href]', function (e) {
            if (e.target.closest('a')) return;
            window.location.href = this.dataset.href;
        });

        // Chart clicks: pointer over clickable parts, then navigate.
        function pointerOnHover(event, elements) {
            event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
        }

        function changePeriod(period) {
            if (period === currentPeriod) return;

            showLoadingOverlay();
            window.location.href = '/Home/Dashboard?period=' + period;
        }

        function showLoadingOverlay() {
            const overlay = `
                <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
                     style="background: color-mix(in srgb, var(--surface) 95%, transparent); z-index: 9999;">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">${t('Loading...')}</span>
                        </div>
                        <h5>${t('Loading dashboard data...')}</h5>
                        <p class="text-muted">${t('Please wait')}</p>
                    </div>
                </div>
            `;
            $('body').append(overlay);
        }

        function initializeCharts() {
            initializeCategoryChart();
            initializeTransferChart();
        }

        function initializeCategoryChart() {
            const ctx = document.getElementById('categoryChart');
            if (!ctx) return;

            // Data rides on the canvas (data-chart, HTML-encoded by Razor) so a live refresh brings the new figures.
            const categoryData = JSON.parse(ctx.dataset.chart || 'null');
            if (!categoryData || categoryData.length === 0) return;

            categoryChart = new Chart(ctx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: categoryData.map(c => c.categoryName),
                    datasets: [{
                        data: categoryData.map(c => c.count),
                        backgroundColor: categoryData.map(c => c.color),
                        borderWidth: 3,
                        borderColor: chartColors.surface,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: chartColors.ink,
                            padding: 12,
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 },
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return `${label}: ${t('{0} transfers ({1}%)', value, percentage)}`;
                                }
                            }
                        }
                    },
                    cutout: '65%',
                    onHover: pointerOnHover,
                    onClick: function (event, elements) {
                        if (!elements.length) return;
                        const category = categoryData[elements[0].index];
                        window.location.href = ctx.dataset.link + '&categoryName=' + encodeURIComponent(category.categoryName);
                    }
                }
            });
        }

        function initializeTransferChart() {
            const ctx = document.getElementById('transferChart');
            if (!ctx) return;

            const transferData = JSON.parse(ctx.dataset.chart || 'null');
            if (!transferData || !transferData.labels || transferData.labels.length === 0) return;

            transferChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: transferData.labels,
                    datasets: [
                        {
                            label: t('Completed'),
                            data: transferData.completedData,
                            borderColor: chartColors.ok,
                            backgroundColor: chartColors.okFill,
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: chartColors.ok,
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        },
                        {
                            label: t('Pending'),
                            data: transferData.pendingData,
                            borderColor: chartColors.warn,
                            backgroundColor: chartColors.warnFill,
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: chartColors.warn,
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    onHover: pointerOnHover,
                    // A point opens the transfers of that day/week/month; the nearest series picks completed or pending.
                    onClick: function (event, elements, chart) {
                        if (!elements.length) return;
                        const index = elements[0].index;
                        const nearest = chart.getElementsAtEventForMode(event, 'nearest', { intersect: false }, false)[0];
                        const status = nearest ? (nearest.datasetIndex === 0 ? '&isCompleted=true' : '&isCompleted=false') : '';
                        window.location.href = ctx.dataset.link
                            + '&startDate=' + transferData.bucketStarts[index]
                            + '&endDate=' + transferData.bucketEnds[index] + status;
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                color: chartColors.neutral,
                                font: { size: 12, weight: 'bold' }
                            }
                        },
                        tooltip: {
                            backgroundColor: chartColors.ink,
                            padding: 12,
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                precision: 0,
                                color: chartColors.neutral,
                                font: { size: 11 }
                            },
                            grid: {
                                color: chartColors.grid,
                                drawBorder: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: chartColors.neutral,
                                font: { size: 11 }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
