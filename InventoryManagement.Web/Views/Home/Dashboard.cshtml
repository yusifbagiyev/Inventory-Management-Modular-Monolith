@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentPeriod = ViewBag.CurrentPeriod as string ?? "last7days";
    var allTime = currentPeriod == "all";
    var notWorking = (int)(ViewBag.NotWorking ?? 0);
    var openTransfers = (int)(ViewBag.OpenTransfers ?? 0);
    var pendingApprovals = ViewBag.PendingApprovals as int?;
    // Without the approvals row the block would only repeat two figures from the tiles above
    var showAttention = pendingApprovals is not null;
    var hasTransfers = Model.TransferActivityData.Labels.Any();

    // Period caption under the completed-transfers figure
    var periodText = currentPeriod switch
    {
        "last30days" => L["in the last {0} days", 30].Value,
        "last90days" => L["in the last {0} days", 90].Value,
        "all" => L["over all time"].Value,
        _ => L["in the last {0} days", 7].Value
    };

    // Figures, chart bars and rows link to the lists filtered to this period
    string PeriodQuery() => Model.PeriodStart is null ? "" : $"&startDate={Model.PeriodStart}&endDate={Model.PeriodEnd}";
    var transfersUrl = "/Routes?routeType=Transfer" + PeriodQuery();
    // Without the permission these return null and Razor drops the href
    var canProducts = User.HasPermission("product.view");
    var canRoutes = User.HasPermission("route.view");
    string? ProductLink(string url) => canProducts ? url : null;
    string? RouteLink(string url) => canRoutes ? url : null;
    var maxDepartment = Math.Max(1, Model.DepartmentStats.Select(d => d.PeriodTransfers).DefaultIfEmpty(0).Max());
    string CategoryLabel(CategoryDistribution c) => c.IsOther ? L["Other ({0} categories)", c.OtherCategories].Value : c.CategoryName;
    // A share of every transfer in the period, so the rows add up to the whole
    long Percent(int count) => Model.TotalTransfers == 0 ? 0 : (long)Math.Round(count * 100.0 / Model.TotalTransfers);
    var categoryChart = Model.CategoryDistributions.Select(c => new { categoryName = CategoryLabel(c), count = c.Count, isOther = c.IsOther });
    var faultyNames = string.Join(", ", Model.NotWorkingNames);
    var faultyMore = Model.NotWorking - Model.NotWorkingNames.Count;
    var activity = Model.TransferActivityData;
    // yyyy-MM-dd to dd.MM.yyyy without going through a culture
    string Day(string iso) => string.Join(".", iso.Split('-').Reverse());
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Dashboard"]</h1>
        </div>
        <nav class="ip-tabs ink border-0" aria-label="@L["Period"]">
            <a class="ip-tab @(currentPeriod == "last7days" ? "active" : "")" aria-current="@(currentPeriod == "last7days" ? "page" : null)" href="/Home/Dashboard?period=last7days">@L["7 days"]</a>
            <a class="ip-tab @(currentPeriod == "last30days" ? "active" : "")" aria-current="@(currentPeriod == "last30days" ? "page" : null)" href="/Home/Dashboard?period=last30days">@L["30 days"]</a>
            <a class="ip-tab @(currentPeriod == "last90days" ? "active" : "")" aria-current="@(currentPeriod == "last90days" ? "page" : null)" href="/Home/Dashboard?period=last90days">@L["90 days"]</a>
            <a class="ip-tab @(allTime ? "active" : "")" aria-current="@(allTime ? "page" : null)" href="/Home/Dashboard?period=all">@L["All"]</a>
        </nav>
    </div>

    <div class="ip-kpi-grid" id="dashboardStats">
        @* Only completed transfers follow the period, the other figures show the current state *@
        <a class="ip-kpi" href="@ProductLink("/Products")">
            <span class="label">@L["Total products"]</span>
            <span class="value">@Model.TotalProducts.ToString("N0")</span>
            <span class="trend">@L["{0} active · {1} inactive", Model.ActiveProducts.ToString("N0"), Model.InactiveProducts.ToString("N0")]</span>
        </a>
        <a class="ip-kpi" href="@ProductLink("/Products?status=false")">
            <span class="label">@L["Broken devices"]</span>
            <span class="value">@Model.NotWorking.ToString("N0")</span>
            @if (Model.NotWorkingNames.Count > 0)
            {
                @* The names are a sample, so the rest is counted after them *@
                <span class="trend ip-kpi-names">
                    <span class="text-truncate" title="@faultyNames">@faultyNames</span>
                    @if (faultyMore > 0)
                    {
                        <span class="text-nowrap">+@faultyMore</span>
                    }
                </span>
            }
            else
            {
                <span class="trend">@L["None"]</span>
            }
        </a>
        <a class="ip-kpi" href="@RouteLink(transfersUrl + "&isCompleted=true")">
            <span class="label">@L["Completed transfers"]</span>
            <span class="value">@((Model.CompletedTransfers ?? 0).ToString("N0"))</span>
            <span class="trend">@periodText</span>
        </a>
        <a class="ip-kpi" href="@RouteLink("/Routes?routeType=Transfer&isCompleted=false")">
            <span class="label">@L["Pending transfers"]</span>
            <span class="value">@Model.PendingTransfers.ToString("N0")</span>
            <span class="trend">@(Model.OldestPendingDays switch
            {
                null => L["None waiting"].Value,
                0 => L["the oldest is from today"].Value,
                int days => L.Plural(days, "the oldest has waited {0} day", "the oldest has waited {0} days").Value
            })</span>
        </a>
    </div>

    <div class="row g-5 mt-0" id="dashboardCharts">
        @* The chart, categories and departments all count the period's transfers, so an empty period shows one empty state for them *@
        <div class="@(showAttention ? "col-lg-8" : "col-12")">
            @if (hasTransfers)
            {
                <section class="ip-section">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                        <h2>@L["Transfer Activity"]</h2>
                        <div class="ip-legend" aria-hidden="true">
                            <span><i style="background: var(--ip-chart-1)"></i>@L["Completed"]</span>
                            <span><i style="background: var(--ip-chart-pending)"></i>@L["Pending"]</span>
                        </div>
                    </div>
                    <div class="ip-chart">
                        <canvas id="transferChart" role="img" aria-label="@L["Transfer Activity"]"
                                data-chart="@Json.Serialize(Model.TransferActivityData).ToString()" data-link="@RouteLink("/Routes?routeType=Transfer")"></canvas>
                    </div>
                    <p class="ip-hint mt-2 mb-0">@L["Click a bar to open those transfers."]</p>
                    @* The chart's figures as text and links for screen readers and the keyboard *@
                    <ul class="visually-hidden-focusable ip-chart-links">
                        @for (var i = 0; i < activity.Labels.Count; i++)
                        {
                            if (activity.CompletedData[i] + activity.PendingData[i] == 0) continue;
                            var start = activity.BucketStarts[i];
                            var end = activity.BucketEnds[i];
                            var when = start == end ? activity.Labels[i] : $"{Day(start)} – {Day(end)}";
                            <li>
                                <a href="@RouteLink($"/Routes?routeType=Transfer&startDate={start}&endDate={end}")">@when: @L["Completed"] @activity.CompletedData[i], @L["Pending"] @activity.PendingData[i]</a>
                            </li>
                        }
                    </ul>
                </section>
            }
            else
            {
                <div class="ip-empty">
                    <span class="icon"><i class="fa-solid fa-right-left"></i></span>
                    <div class="title">@L["No transfers for this period"]</div>
                    <div class="text">@L["Transfer activity, categories and departments appear here once transfers are made in the period."]</div>
                    @if (!allTime)
                    {
                        <a href="/Home/Dashboard?period=all" class="ip-btn ip-btn-secondary">
                            <span>@L["View all time"]</span><i class="fa-solid fa-arrow-right"></i>
                        </a>
                    }
                </div>
            }
        </div>

        @if (showAttention)
        {
            @* In one column CSS order moves this block above the chart *@
            <div class="col-lg-4 ip-dash-attention">
                <section class="ip-section">
                    <h2 class="mb-3">@L["Needs attention"]</h2>
                    <a class="ip-list-link" href="/Approvals">
                        <span>@L["Requests awaiting approval"]</span>
                        <span class="ip-dash-count">
                            <b class="ip-num fs-6 @(pendingApprovals > 0 ? "ip-status-text warning" : "")">@pendingApprovals</b>
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </span>
                    </a>
                    <a class="ip-list-link" href="@RouteLink("/Routes?isCompleted=false")">
                        <span>@L["Pending transfers"]</span>
                        <span class="ip-dash-count">
                            <b class="ip-num fs-6 @(openTransfers > 0 ? "ip-status-text warning" : "")">@openTransfers</b>
                            @if (canRoutes)
                            {
                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                            }
                        </span>
                    </a>
                    <a class="ip-list-link" href="@ProductLink("/Products?status=false")">
                        <span>@L["Broken devices"]</span>
                        <span class="ip-dash-count">
                            <b class="ip-num fs-6 @(notWorking > 0 ? "ip-status-text danger" : "")">@notWorking</b>
                            @if (canProducts)
                            {
                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                            }
                        </span>
                    </a>
                </section>
            </div>
        }

        @if (hasTransfers)
        {
            <div class="col-lg-6">
                <section class="ip-section">
                    <h2 class="mb-3">@L["Categories in Transfers"]</h2>
                    @if (Model.CategoryDistributions.Any())
                    {
                        <div class="d-flex gap-4 align-items-center flex-wrap">
                            <div class="ip-dash-doughnut">
                                <canvas id="categoryChart" role="img" aria-label="@L["Categories in Transfers"]"
                                        data-chart="@Json.Serialize(categoryChart).ToString()" data-link="@RouteLink(transfersUrl)"></canvas>
                            </div>
                            <div class="flex-grow-1" style="min-width: 200px">
                                @for (var i = 0; i < Model.CategoryDistributions.Count; i++)
                                {
                                    var category = Model.CategoryDistributions[i];
                                    var label = CategoryLabel(category);
                                    <a class="ip-list-link" href="@RouteLink(category.IsOther ? transfersUrl : transfersUrl + "&categoryName=" + Uri.EscapeDataString(category.CategoryName))">
                                        <span class="d-flex align-items-center gap-2" style="min-width: 0">
                                            <i class="ip-swatch" style="background: var(--ip-cat-@(category.IsOther ? 8 : i % 8 + 1))"></i>
                                            <span class="text-truncate" title="@label">@label</span>
                                        </span>
                                        <span class="ip-num ip-muted text-nowrap">@L.Plural(category.Count, "{0} transfer", "{0} transfers") · @Percent(category.Count)%</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </section>
            </div>

            <div class="col-lg-6" id="dashboardRecent">
                <section class="ip-section">
                    <h2 class="mb-3">@L["Transfers by department"]</h2>
                    @if (Model.DepartmentStats.Any())
                    {
                        @foreach (var dept in Model.DepartmentStats)
                        {
                            <a class="ip-list-link" href="@RouteLink(transfersUrl + "&departmentName=" + Uri.EscapeDataString(dept.DepartmentName))">
                                <span class="text-truncate" title="@dept.DepartmentName">@dept.DepartmentName</span>
                                <span class="ip-bar" aria-hidden="true"><i style="width: @(dept.PeriodTransfers * 100 / maxDepartment)%"></i></span>
                                <span class="ip-num ip-muted text-nowrap" title="@L["Unique Products"]: @dept.ProductCount · @L["Active Workers"]: @dept.ActiveWorkers">@dept.PeriodTransfers.ToString("N0")</span>
                            </a>
                        }
                    }
                </section>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        let transferChart, categoryChart;

        // Colours are read from the tokens so the charts follow the theme
        const v = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

        function initializeCharts() {
            Chart.defaults.font.family = v('--ip-font-sans');
            Chart.defaults.color = v('--ip-text-3');
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) Chart.defaults.animation = false;
            initializeTransferChart();
            initializeCategoryChart();
        }

        function destroyCharts() {
            transferChart?.destroy();
            categoryChart?.destroy();
            transferChart = categoryChart = undefined;
        }

        window.addEventListener('themechange', function () { destroyCharts(); initializeCharts(); });
        $(initializeCharts);

        LiveUpdates.watch({
            entities: ['product', 'route', 'category', 'department', 'approval'],
            regions: ['#dashboardStats', '#dashboardCharts'],
            beforeRefresh: destroyCharts,
            afterRefresh: initializeCharts
        });

        // Charts only have data-link when the user may open the routes list
        function pointerOnHover(event, elements) {
            event.native.target.style.cursor = elements.length && event.native.target.dataset.link ? 'pointer' : 'default';
        }

        // The tooltip covers the whole column, but a click opens only the segment under the pointer
        function hitSegment(chart, event) {
            return chart.getElementsAtEventForMode(event.native, 'nearest', { intersect: true }, false)[0];
        }

        const isoDay = iso => iso.split('-').reverse().join('.');

        function tooltip() {
            return { backgroundColor: v('--ip-text-1'), titleColor: v('--ip-surface'), bodyColor: v('--ip-surface'), padding: 10, cornerRadius: 8, displayColors: true, boxPadding: 4 };
        }

        // Clicking a segment opens that bucket's transfers with that status
        function initializeTransferChart() {
            const ctx = document.getElementById('transferChart');
            if (!ctx) return;
            const data = JSON.parse(ctx.dataset.chart || 'null');
            if (!data || !data.labels || !data.labels.length) return;

            transferChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [
                        { label: t('Completed'), data: data.completedData, backgroundColor: v('--ip-chart-1'), borderRadius: 4, maxBarThickness: 64 },
                        { label: t('Pending'), data: data.pendingData, backgroundColor: v('--ip-chart-pending'), borderRadius: 4, maxBarThickness: 64 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: Object.assign(tooltip(), {
                            callbacks: {
                                // A bucket longer than a day is named by its first and last day
                                title: items => {
                                    const i = items[0].dataIndex;
                                    return data.bucketStarts[i] === data.bucketEnds[i] ? data.labels[i] : isoDay(data.bucketStarts[i]) + ' – ' + isoDay(data.bucketEnds[i]);
                                }
                            }
                        })
                    },
                    scales: {
                        x: {
                            stacked: true, grid: { display: false }, border: { color: v('--ip-border-strong') },
                            // Phones show the day number of a day and the first day of a week so the labels fit unrotated
                            ticks: {
                                autoSkip: true, maxRotation: 0,
                                callback: function (value, i) {
                                    if (window.innerWidth >= 768) return this.getLabelForValue(value);
                                    const start = data.bucketStarts[i], end = data.bucketEnds[i];
                                    const days = (new Date(end) - new Date(start)) / 864e5;
                                    if (days === 0) return String(+start.slice(8));
                                    if (days < 28) return isoDay(start).slice(0, 5);
                                    return this.getLabelForValue(value);
                                }
                            }
                        },
                        y: { stacked: true, beginAtZero: true, grid: { color: v('--ip-border') }, border: { display: false }, ticks: { precision: 0 } }
                    },
                    onHover: (event, elements, chart) => pointerOnHover(event, hitSegment(chart, event) ? [1] : []),
                    onClick: function (event, elements, chart) {
                        const hit = hitSegment(chart, event);
                        if (!hit || !ctx.dataset.link) return;
                        const i = hit.index;
                        const status = hit.datasetIndex === 0 ? '&isCompleted=true' : '&isCompleted=false';
                        window.location.href = ctx.dataset.link + '&startDate=' + data.bucketStarts[i] + '&endDate=' + data.bucketEnds[i] + status;
                    }
                }
            });
        }

        // The legend is plain HTML beside the chart, and clicking a slice opens that category's transfers
        function initializeCategoryChart() {
            const ctx = document.getElementById('categoryChart');
            if (!ctx) return;
            const data = JSON.parse(ctx.dataset.chart || 'null');
            if (!data || !data.length) return;

            categoryChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.map(c => c.categoryName),
                    datasets: [{
                        data: data.map(c => c.count),
                        backgroundColor: data.map((c, i) => v('--ip-cat-' + (c.isOther ? 8 : i % 8 + 1))),
                        borderColor: v('--ip-surface'),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: { legend: { display: false }, tooltip: tooltip() },
                    onHover: pointerOnHover,
                    onClick: function (event, elements) {
                        if (!elements.length || !ctx.dataset.link) return;
                        const category = data[elements[0].index];
                        // The joined row has no single category, so it opens all the period's transfers
                        window.location.href = ctx.dataset.link + (category.isOther ? '' : '&categoryName=' + encodeURIComponent(category.categoryName));
                    }
                }
            });
        }
    </script>
}
