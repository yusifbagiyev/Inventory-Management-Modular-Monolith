@model ApprovalDashboardViewModel
@{
    ViewData["Title"] = "Approvals";
    var pendingTab = Model.Tab == "pending";
}

<div class="container-fluid px-4">
    @* Header figures, tabs and the list are refreshed in place by live-updates.js (see Scripts). *@
    <div class="ip-page-head" id="approvalsStats">
        <div>
            <h1>@L["Approvals"]</h1>
        </div>
        <div class="ip-stats">
            <div>
                <div class="ip-faint">@L["Pending"]</div>
                <div class="ip-stat-value ip-status-text warning">@Model.TotalPending</div>
            </div>
            <div>
                <div class="ip-faint">@L["Approved today"]</div>
                <div class="ip-stat-value">@Model.TotalApproved</div>
            </div>
            <div>
                <div class="ip-faint">@L["Rejected today"]</div>
                <div class="ip-stat-value">@Model.TotalRejected</div>
            </div>
        </div>
    </div>

    <nav class="ip-tabs strong" aria-label="@L["Status"]" id="approvalsTabs">
        <a asp-action="Index" class="ip-tab @(pendingTab ? "active" : "")">@L["Pending"] <span class="count warning">@Model.TotalPending</span></a>
        <a asp-action="Index" asp-route-status="approved" class="ip-tab @(Model.Tab == "approved" ? "active" : "")">@L["Approved"] <span class="count">@Model.ApprovedCount</span></a>
        <a asp-action="Index" asp-route-status="rejected" class="ip-tab @(Model.Tab == "rejected" ? "active" : "")">@L["Rejected"] <span class="count">@Model.RejectedCount</span></a>
    </nav>

    <div id="approvalsRegion">
        @if (Model.Requests.Any())
        {
            <div class="ip-table-wrap">
                <table class="ip-table" id="approvalsTable">
                    <thead>
                        <tr>
                            <th>@L["Request"]</th>
                            <th>@L["What changes"]</th>
                            <th>@L["Requested By"]</th>
                            <th>@L["Date"]</th>
                            <th>@L["Status"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.Requests)
                        {
                            var view = ApprovalView.From(request.RequestType, request.ActionData);
                            var fields = view.FieldNames.Select(f => L[f].Value).ToList();
                            <tr data-request-id="@request.Id" class="ip-clickable" onclick="viewDetails(@request.Id)">
                                <td class="ip-mono ip-muted">#@request.Id</td>
                                <td>
                                    <div class="cell-text">
                                        <span class="fw-semibold">@L[view.Kind]@(string.IsNullOrEmpty(view.Subject) ? "" : ": " + view.Subject)</span>
                                        @if (fields.Count > 0)
                                        {
                                            <span class="sub">@string.Join(", ", fields) · @L["{0} fields", fields.Count]</span>
                                        }
                                    </div>
                                </td>
                                <td>@request.RequestedByName</td>
                                <td class="ip-num text-nowrap">
                                    @request.CreatedAt.ToString("dd.MM.yyyy")
                                    <div class="sub">@request.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @switch (request.Status)
                                    {
                                        case "Pending":
                                            <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                                            break;
                                        case "Rejected":
                                            <span class="ip-badge ip-badge-danger">@L["Rejected"]</span>
                                            break;
                                        case "Failed":
                                            <span class="ip-badge ip-badge-danger">@L["Failed"]</span>
                                            break;
                                        default:
                                            <span class="ip-badge ip-badge-success">@L["Approved"]</span>
                                            break;
                                    }
                                    @if (!pendingTab && !string.IsNullOrEmpty(request.ApprovedByName))
                                    {
                                        <div class="sub">@request.ApprovedByName</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="ip-btn ip-btn-secondary ip-btn-sm" onclick="event.stopPropagation(); viewDetails(@request.Id)">
                                        @(pendingTab ? L["Review and decide"] : L["View"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-solid fa-inbox"></i></span>
                <div class="title">@(pendingTab ? L["Nothing waiting for approval"] : L["Nothing here yet"])</div>
                <div class="text">@(pendingTab ? L["New requests appear here as soon as a user submits one."] : L["Decided requests are listed here, newest first."])</div>
            </div>
        }
        @if (!pendingTab && Model.Requests.Count >= 50)
        {
            <p class="ip-faint mt-3">@L["The latest {0} are shown.", Model.Requests.Count]</p>
        }
    </div>
</div>

@* Decision dialog (design: 08 Approvals). The header and body come from _ApprovalDetails. *@
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="flex-grow-1" style="min-width: 0" data-dialog-head></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body" data-dialog-body></div>
            <div class="modal-footer flex-column align-items-stretch">
                <div id="rejectBox" class="ip-field w-100 mb-2 d-none">
                    <label for="rejectionReason" class="ip-label"><span>@L["Rejection Reason"]</span> <span class="req">*</span></label>
                    <textarea id="rejectionReason" class="ip-textarea" rows="3"
                              placeholder="@L["The requester sees this reason on their My Requests page."]"></textarea>
                    <span class="ip-error d-none" id="rejectionError">@L["Rejection reason is required."]</span>
                </div>
                <div class="d-flex justify-content-end gap-2 flex-wrap d-none" id="decisionButtons">
                    <button type="button" class="ip-btn ip-btn-danger-ghost" id="modalRejectBtn">
                        <i class="fa-solid fa-xmark"></i><span>@L["Reject"]</span>
                    </button>
                    <button type="button" class="ip-btn ip-btn-primary" id="modalApproveBtn">
                        <span>@L["Approve"]</span><i class="fa-solid fa-check"></i>
                    </button>
                </div>
                <div class="d-flex justify-content-end gap-2 flex-wrap d-none" id="rejectButtons">
                    <button type="button" class="ip-btn ip-btn-secondary" id="rejectBackBtn">@L["Back"]</button>
                    <button type="button" class="ip-btn ip-btn-danger" id="confirmRejectBtn">
                        <span>@L["Confirm rejection"]</span><i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRequestId = null;
        const modalEl = document.getElementById('detailsModal');

        function setMode(mode) {   // 'view' (decided), 'decide' (pending) or 'reject'
            // d-none, not [hidden]: these are flex containers, and display:flex beats [hidden].
            $('#decisionButtons').toggleClass('d-none', mode !== 'decide');
            $('#rejectButtons').toggleClass('d-none', mode !== 'reject');
            $('#rejectBox').toggleClass('d-none', mode !== 'reject');
            if (mode === 'reject') setTimeout(() => $('#rejectionReason').trigger('focus'), 50);
        }

        function viewDetails(requestId) {
            currentRequestId = requestId;
            $('#rejectionReason').val('').removeClass('is-invalid');
            $('#rejectionError').addClass('d-none');
            setMode('view');
            loadApprovalDetails(`/Approvals/Details/${requestId}`, modalEl).then(function (head) {
                setMode(head && head.dataset.status === 'Pending' ? 'decide' : 'view');
            });
        }

        $('#modalRejectBtn').on('click', () => setMode('reject'));
        $('#rejectBackBtn').on('click', () => setMode('decide'));
        $('#rejectionReason').on('input', function () {
            if (this.value.trim()) { $(this).removeClass('is-invalid'); $('#rejectionError').addClass('d-none'); }
        });

        function busy($button, on) {
            if (on) {
                $button.data('html', $button.html()).prop('disabled', true)
                    .html(`<span class="spinner-border spinner-border-sm"></span><span>${escapeHtml(t('Processing...'))}</span>`);
            } else {
                $button.prop('disabled', false).html($button.data('html'));
            }
        }

        function decided(message, type) {
            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            showToast(message, type);
            setTimeout(() => location.reload(), 900);
        }

        $('#modalApproveBtn').on('click', function () {
            const $button = $(this);
            busy($button, true);
            $.ajax({ url: `/Approvals/Approve/${currentRequestId}`, type: 'POST', headers: AppConfig.antiforgeryHeaders() })
                .done(function (response) {
                    if (response.success) decided(t('Request approved successfully'), 'success');
                    else { busy($button, false); showToast(t('Failed to approve request: {0}', response.message), 'error'); }
                })
                .fail(function (xhr) {
                    busy($button, false);
                    showToast(t('Failed to approve request: {0}', xhr.responseJSON?.message || t('Unknown error')), 'error');
                });
        });

        $('#confirmRejectBtn').on('click', function () {
            const reason = $('#rejectionReason').val().trim();
            if (!reason) {
                $('#rejectionReason').addClass('is-invalid').trigger('focus');
                $('#rejectionError').removeClass('d-none');
                return;
            }
            const $button = $(this);
            busy($button, true);
            $.ajax({ url: `/Approvals/Reject/${currentRequestId}`, type: 'POST', data: { reason: reason }, headers: AppConfig.antiforgeryHeaders() })
                .done(function (response) {
                    if (response.success) decided(t('Request rejected'), 'info');
                    else { busy($button, false); showToast(t('Failed to reject request: {0}', response.message), 'error'); }
                })
                .fail(function (xhr) {
                    busy($button, false);
                    showToast(t('Failed to reject request: {0}', xhr.responseJSON?.message || t('Unknown error')), 'error');
                });
        });

        // Opened from a product or a notification (?open=5): show that request straight away.
        const openId = parseInt(new URLSearchParams(location.search).get('open'), 10);
        if (openId > 0) viewDetails(openId);

        // New, approved and rejected requests from other admins update the figures, tabs and list.
        LiveUpdates.watch({
            entities: ['approval'],
            regions: ['#approvalsStats', '#approvalsTabs', '#approvalsRegion']
        });
    </script>
}
