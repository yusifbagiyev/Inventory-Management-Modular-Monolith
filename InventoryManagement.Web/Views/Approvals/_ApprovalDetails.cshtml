@model ApprovalRequestDto
@* The decision dialog's content (design: 08 Approvals), used by Approvals and My Requests.
   [data-approval-head] is moved into the modal header by loadApprovalDetails() (site.js); the
   rest is the body: what changes as a Field / Current / -> / Proposed table. *@
@{
    var view = ApprovalView.From(Model.RequestType, Model.ActionData);
    var images = view.ImageData;
    var (addedImages, removedImages) = view.ImageCounts();

    string Value(string? value, bool localize) => string.IsNullOrWhiteSpace(value) ? "" : localize ? L[value].Value : value;

    var newImageNames = new List<string>();
    if (images != null)
    {
        foreach (var key in new[] { "images", "replaceImages" })
        {
            if (images.GetValue(key, StringComparison.OrdinalIgnoreCase) is Newtonsoft.Json.Linq.JArray list)
                newImageNames.AddRange(list.Select(i => i.Value<string>("imageFileName") ?? L["Image"].Value));
        }
    }
    var removedUrls = (images?.GetValue("removeImageUrls", StringComparison.OrdinalIgnoreCase) as Newtonsoft.Json.Linq.JArray)?
        .Select(u => u.ToString()).Where(u => u.StartsWith("/images/")).ToList() ?? new List<string>();
    var cover = images?.GetValue("coverImageUrl", StringComparison.OrdinalIgnoreCase)?.ToString();
    string? newCoverName = cover != null && cover.StartsWith("new:") && int.TryParse(cover[4..], out var coverIndex) && coverIndex < newImageNames.Count
        ? newImageNames[coverIndex] : null;
}

<div data-approval-head data-status="@Model.Status" data-request-id="@Model.Id">
    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
        <span class="ip-mono ip-faint">@L["Request"] #@Model.Id</span>
        @switch (Model.Status)
        {
            case "Pending":
                <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                break;
            case "Executed":
            case "Approved":
                <span class="ip-badge ip-badge-success">@L["Approved"]</span>
                break;
            case "Rejected":
                <span class="ip-badge ip-badge-danger">@L["Rejected"]</span>
                break;
            default:
                <span class="ip-badge ip-badge-danger">@L[Model.Status]</span>
                break;
        }
    </div>
    <div class="modal-title" id="detailsTitle">@L[view.Kind]@(string.IsNullOrEmpty(view.Subject) ? "" : ": " + view.Subject)</div>
    <div class="ip-faint">@Model.RequestedByName · <span class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span></div>
</div>

@if (Model.Status == "Rejected" && !string.IsNullOrWhiteSpace(Model.RejectionReason))
{
    <div class="ip-banner ip-banner-danger mb-3">
        <i class="fa-solid fa-circle-xmark"></i>
        <span><b>@L["Rejection Reason"]:</b> @JsonStringLocalizer.TranslateMessage(Model.RejectionReason)</span>
    </div>
}
else if (Model.Status == "Failed")
{
    <div class="ip-banner ip-banner-danger mb-3">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>@L["Approved, but the change could not be carried out."] @JsonStringLocalizer.TranslateMessage(Model.RejectionReason)</span>
    </div>
}
@if (Model.Status != "Pending" && !string.IsNullOrEmpty(Model.ApprovedByName))
{
    <p class="ip-faint mb-3">@L["Decided by {0}", Model.ApprovedByName]@(Model.ProcessedAt.HasValue ? " · " + Model.ProcessedAt.Value.ToString("dd.MM.yyyy HH:mm") : "")</p>
}

@if (view.IsDeletion)
{
    <div class="ip-banner ip-banner-warning mb-3">
        <i class="fa-solid fa-trash-can"></i>
        <span>@L["Approving this deletes the record below."]</span>
    </div>
    <dl class="ip-dl">
        @foreach (var change in view.Changes)
        {
            <div><dt>@L[change.Field]</dt><dd>@Value(change.Current, change.Localize)</dd></div>
        }
    </dl>
}
else if (view.Changes.Count > 0)
{
    <div class="ip-faint mb-1">@L["Changed fields"] · @view.Changes.Count</div>
    <div class="ip-table-wrap">
        <table class="ip-table ip-diff">
            <thead>
                <tr>
                    <th>@L["Field"]</th>
                    <th>@L["Current value"]</th>
                    <th style="width: 24px"></th>
                    <th>@L["Proposed"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var change in view.Changes)
                {
                    <tr>
                        <td class="text-nowrap">@L[change.Field]</td>
                        @if (change.Field == "Images")
                        {
                            <td class="old">@(view.Kind == "Product update" ? L["Current images"].Value : "—")</td>
                            <td class="ip-muted" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></td>
                            <td>
                                <span class="new">
                                    @L["{0} new", addedImages]@(removedImages > 0 ? ", " + L["{0} removed", removedImages].Value : "")
                                </span>
                            </td>
                        }
                        else
                        {
                            <td class="old">@(string.IsNullOrWhiteSpace(change.Current) ? "—" : Value(change.Current, change.Localize))</td>
                            <td class="ip-muted" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(change.Proposed))
                                {
                                    <span class="ip-muted">—</span>
                                }
                                else
                                {
                                    <span class="new">@Value(change.Proposed, change.Localize)</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="ip-muted mb-0">@L["View details for more information"]</p>
}

@if (newImageNames.Count > 0 || removedUrls.Count > 0 || cover != null)
{
    <div class="ip-section mt-3">
        @if (newImageNames.Count > 0)
        {
            <div class="mb-2"><span class="ip-faint">@L["New images"]:</span> @string.Join(", ", newImageNames)</div>
        }
        @if (newCoverName != null)
        {
            <div class="mb-2"><i class="fa-solid fa-star" style="color: var(--ip-brand)"></i> <span class="ip-faint">@L["New cover image"]:</span> @newCoverName</div>
        }
        @if (cover != null && cover.StartsWith("/images/"))
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="fa-solid fa-star" style="color: var(--ip-brand)"></i><span class="ip-faint">@L["New cover image"]:</span>
                <span class="ip-thumb"><img src="@cover" alt="" /></span>
            </div>
        }
        @if (removedUrls.Count > 0)
        {
            <div class="ip-faint mb-1">@L["Images to remove"]:</div>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var url in removedUrls)
                {
                    <span class="ip-thumb" style="opacity: .6"><img src="@url" alt="" /></span>
                }
            </div>
        }
    </div>
}
