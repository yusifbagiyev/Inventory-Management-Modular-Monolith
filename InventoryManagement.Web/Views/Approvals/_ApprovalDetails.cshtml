@model ApprovalRequestDto

<div class="approval-details">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="section-title">Request Information</div>
            <div class="detail-grid">
                <div class="detail-row">
                    <span class="d-label">Type</span>
                    <span class="d-value">
                        <span class="badge bg-info">@GetReadableRequestType(Model.RequestType)</span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Entity</span>
                    <span class="d-value">
                        @Model.EntityType
                        @if (Model.EntityId.HasValue)
                        {
                            <span class="mono text-muted">#@Model.EntityId</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Requested By</span>
                    <span class="d-value">@Model.RequestedByName</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Date</span>
                    <span class="d-value mono">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm")</span>
                </div>
                <div class="detail-row">
                    <span class="d-label">Status</span>
                    <span class="d-value">
                        @if (Model.Status == "Pending")
                        {
                            <span class="state state-warn">Pending</span>
                        }
                        else if (Model.Status == "Executed" || Model.Status == "Approved")
                        {
                            <span class="state state-ok">Approved</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="state state-crit">Rejected</span>
                        }
                        else
                        {
                            <span class="state state-idle">@Model.Status</span>
                        }
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="section-title">Request Details</div>
            @{
                var details = ParseActionData(Model.RequestType, Model.ActionData);
            }
            @Html.Raw(details)
        </div>
    </div>
</div>

@functions {
    // XSS guard: ActionData is user-supplied, so every dynamic value must be HTML-encoded
    // before it is concatenated into markup that is emitted with @Html.Raw above.
    string E(dynamic value) => System.Net.WebUtility.HtmlEncode(value?.ToString() ?? "");

    // A dynamic JSON value as text (null when missing). A null check on the dynamic value itself
    // is invisible to nullable analysis; on the returned string it is not.
    string? Text(object? value) => value?.ToString();

    // One label/value pair in the design-system detail-row shape. The value always goes
    // through E(); when it is missing the placeholder is rendered muted instead.
    // Callers cast the dynamic JSON value to object so this stays a compile-time bound call.
    string Row(string label, object? value, string placeholder, bool mono)
    {
        var text = value?.ToString();
        var body = string.IsNullOrWhiteSpace(text)
            ? $"<span class='d-empty'>{E(placeholder)}</span>"
            : E(text);
        var valueClass = mono ? "d-value mono" : "d-value";
        return $"<div class='detail-row'><span class='d-label'>{E(label)}</span><span class='{valueClass}'>{body}</span></div>";
    }

    // Same row shape for values that are markup we build ourselves (state chips, badges).
    // Anything user-supplied inside valueHtml must already have been passed through E().
    string RowHtml(string label, string valueHtml)
        => $"<div class='detail-row'><span class='d-label'>{E(label)}</span><span class='d-value'>{valueHtml}</span></div>";

    string Section(string title) => $"<div class='section-title'>{E(title)}</div>";

    // department + worker stacked inside a single value cell
    string Place(object department, object worker)
    {
        var dept = department?.ToString();
        var who = worker?.ToString();
        var deptHtml = string.IsNullOrWhiteSpace(dept) ? "<span class='d-empty'>Unknown</span>" : E(dept);
        var workerHtml = string.IsNullOrWhiteSpace(who) ? "Not assigned" : E(who);
        return $"{deptHtml}<br/><small class='text-muted'>Worker: {workerHtml}</small>";
    }

    string GetReadableRequestType(string requestType)
    {
        return requestType switch
        {
            "product.create" => "Creating Product",
            "product.update" => "Updating Product",
            "product.delete" => "Deleting Product",
            "product.transfer" => "Transferring Product",
            "route.update" => "Updating Route",
            "route.delete" => "Deleting Route",
            _ => requestType
        };
    }

    string ParseActionData(string requestType, string actionData)
    {
        try
        {
            var data = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(actionData);

            switch (requestType)
            {
                case "product.create":
                    return ParseProductCreateData(data);

                case "product.update":
                    return ParseProductUpdateData(data);

                case "product.delete":
                    return ParseProductDeleteData(data);

                case "product.transfer":
                    return ParseProductTransferData(data);

                case "route.update":
                    return ParseRouteUpdateData(data);

                case "route.delete":
                    return ParseRouteDeleteData(data);

                default:
                    // For unknown types, format the JSON nicely
                    return $"<pre class='mb-0' style='max-height: 340px; overflow: auto;'>{E(FormatJson(data))}</pre>";
            }
        }
        catch (Exception ex)
        {
            // If parsing fails, try to format the raw JSON
            try
            {
                var parsed = Newtonsoft.Json.Linq.JToken.Parse(actionData);
                return $"<pre class='mb-0' style='max-height: 340px; overflow: auto;'>{E(parsed.ToString(Newtonsoft.Json.Formatting.Indented))}</pre>";
            }
            catch
            {
                return $"<div class='alert alert-danger mb-0'>Error parsing data: {E(ex.Message)}</div>";
            }
        }
    }

    string ParseProductCreateData(dynamic data)
    {
        var productData = data.ProductData ?? data;
        var html = new System.Text.StringBuilder();

        // Basic Information
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Product Information"));
        html.AppendLine(Row("Inventory Code", (object)(productData.inventoryCode ?? productData.InventoryCode), "N/A", true));
        html.AppendLine(Row("Model", (object)(productData.model ?? productData.Model), "N/A", false));
        html.AppendLine(Row("Vendor", (object)(productData.vendor ?? productData.Vendor), "N/A", false));
        html.AppendLine(Row("Worker", (object)(productData.worker ?? productData.Worker), "Not assigned", false));
        html.AppendLine("</div>");

        // Category & Department
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Location"));
        var categoryName = productData.categoryName ?? productData.CategoryName ?? $"Category #{productData.categoryId ?? productData.CategoryId}";
        var departmentName = productData.departmentName ?? productData.DepartmentName ?? $"Department #{productData.departmentId ?? productData.DepartmentId}";
        html.AppendLine(Row("Category", (object)categoryName, "N/A", false));
        html.AppendLine(Row("Department", (object)departmentName, "N/A", false));
        html.AppendLine("</div>");

        // Status Information
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Status"));
        bool isWorking = GetBoolValue(productData, "isWorking", "IsWorking", true);
        bool isActive = GetBoolValue(productData, "isActive", "IsActive", true);
        bool isNewItem = GetBoolValue(productData, "isNewItem", "IsNewItem", true);

        html.AppendLine(RowHtml("Working Status", isWorking
            ? "<span class='state state-ok'>Working</span>"
            : "<span class='state state-crit'>Not Working</span>"));
        html.AppendLine(RowHtml("Active", isActive
            ? "<span class='state state-ok'>Active</span>"
            : "<span class='state state-flat state-idle'>Inactive</span>"));
        html.AppendLine(RowHtml("Item Condition", isNewItem
            ? "<span class='state state-flat state-new'>New</span>"
            : "<span class='state state-warn'>Used</span>"));
        html.AppendLine("</div>");

        // Description & Notes
        var description = productData.description ?? productData.Description;
        if (!string.IsNullOrEmpty(description?.ToString()))
        {
            html.AppendLine("<div class='mb-3'>");
            html.AppendLine(Section("Description"));
            html.AppendLine($"<p class='mb-0'>{E(description)}</p>");
            html.AppendLine("</div>");
        }

        // Image Information
        if (productData.imageData != null || productData.imageFileName != null)
        {
            html.AppendLine("<div class='alert alert-info mb-0'>");
            html.AppendLine($"<i class='fas fa-image'></i> Image attached: {E(productData.imageFileName ?? "product_image.jpg")}");
            html.AppendLine("</div>");
        }

        return html.ToString();
    }

    string ParseProductUpdateData(dynamic data)
    {
        var html = new System.Text.StringBuilder();
        var inventoryCode = data.InventoryCode ?? data.inventoryCode;

        html.AppendLine(Section("Product"));
        html.AppendLine(Row("Inventory Code", (object)inventoryCode, "N/A", true));

        // Show changes summary if available
        var changes = data.Changes;
        if (changes != null)
        {
            html.AppendLine("<div class='mt-3'>");
            html.AppendLine(Section("Summary of Changes"));
            html.AppendLine("<ul class='mb-0'>");
            foreach (var change in changes)
            {
                html.AppendLine($"<li>{E(change)}</li>");
            }
            html.AppendLine("</ul>");
            html.AppendLine("</div>");
        }

        return html.ToString();
    }

    string ParseProductDeleteData(dynamic data)
    {
        var html = new System.Text.StringBuilder();
        html.AppendLine("<div class='alert alert-warning'>");
        html.AppendLine("<i class='fas fa-exclamation-triangle'></i> <strong>Product to be Deleted</strong>");
        html.AppendLine("</div>");

        html.AppendLine(Row("Inventory Code", (object)(data.InventoryCode ?? data.inventoryCode), "N/A", true));
        html.AppendLine(Row("Model", (object)(data.Model ?? data.model), "N/A", false));
        html.AppendLine(Row("Vendor", (object)(data.Vendor ?? data.vendor), "N/A", false));
        html.AppendLine(Row("Department", (object)(data.DepartmentName ?? data.departmentName), "N/A", false));

        if (data.DeleteReason != null)
        {
            html.AppendLine(Row("Reason", (object)data.DeleteReason, "N/A", false));
        }

        return html.ToString();
    }

    string ParseProductTransferData(dynamic data)
    {
        var html = new System.Text.StringBuilder();

        // Product Information
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Product Information"));
        html.AppendLine(Row("Inventory Code", (object)(data.inventoryCode ?? data.InventoryCode), "N/A", true));
        html.AppendLine(Row("Model", (object)(data.productModel ?? data.ProductModel), "N/A", false));
        html.AppendLine(Row("Vendor", (object)(data.productVendor ?? data.ProductVendor), "N/A", false));
        html.AppendLine("</div>");

        // Transfer Details
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Transfer Details"));
        html.AppendLine(RowHtml("From", Place(
            (object)(data.fromDepartmentName ?? data.FromDepartmentName),
            (object)(data.fromWorker ?? data.FromWorker))));
        html.AppendLine(RowHtml("To", Place(
            (object)(data.toDepartmentName ?? data.ToDepartmentName),
            (object)(data.toWorker ?? data.ToWorker))));
        html.AppendLine("</div>");

        // Notes
        var notes = Text((object?)(data.notes ?? data.Notes));
        if (notes != null && notes != "{}" && !string.IsNullOrWhiteSpace(notes))
        {
            html.AppendLine("<div class='mb-3'>");
            html.AppendLine(Section("Notes"));
            html.AppendLine($"<p class='mb-0'>{E(notes)}</p>");
            html.AppendLine("</div>");
        }

        // Image
        if (data.imageData != null || data.imageFileName != null)
        {
            html.AppendLine("<div class='alert alert-info mb-0'>");
            html.AppendLine("<i class='fas fa-image'></i> Transfer image attached");
            html.AppendLine("</div>");
        }

        return html.ToString();
    }

    bool GetBoolValue(dynamic obj, string camelCase, string pascalCase, bool defaultValue)
    {
        try
        {
            // Try camelCase first
            if (obj[camelCase] != null)
            {
                return (bool)obj[camelCase];
            }
        }
        catch { }

        try
        {
            // Try PascalCase
            if (obj[pascalCase] != null)
            {
                return (bool)obj[pascalCase];
            }
        }
        catch { }

        return defaultValue;
    }

    string FormatJson(dynamic data)
    {
        return Newtonsoft.Json.JsonConvert.SerializeObject(data, Newtonsoft.Json.Formatting.Indented);
    }

    string ParseRouteUpdateData(dynamic data)
    {
        var html = new System.Text.StringBuilder();

        // Route Information
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Route Information"));

        string? routeId = (data.RouteId ?? data.routeId)?.ToString();
        var inventoryCode = data.InventoryCode ?? data.inventoryCode ?? "N/A";
        var model = data.Model ?? data.model ?? "N/A";

        html.AppendLine(Row("Route ID", string.IsNullOrWhiteSpace(routeId) ? null : "#" + routeId, "Unknown", true));
        html.AppendLine(Row("Product", (object)$"{inventoryCode} - {model}", "N/A", false));

        // Show transfer route if available
        var fromDept = data.FromDepartmentName ?? data.fromDepartmentName;
        var toDept = data.ToDepartmentName ?? data.toDepartmentName;
        if (fromDept != null && toDept != null)
        {
            html.AppendLine(RowHtml("Route", $"{E(fromDept)} &rarr; {E(toDept)}"));
        }

        html.AppendLine("</div>");

        // Update Details
        var updateData = data.UpdateData ?? data.updateData;
        if (updateData != null)
        {
            html.AppendLine("<div class='mb-3'>");
            html.AppendLine(Section("Updates to Apply"));

            // Check for notes update
            var notes = Text((object?)(updateData.notes ?? updateData.Notes));
            if (notes != null && notes != "{}")
            {
                html.AppendLine(Row("Notes", notes, "N/A", false));
            }

            // Check for image update
            if (updateData.imageData != null || updateData.imageFileName != null)
            {
                var fileName = updateData.imageFileName ?? updateData.ImageFileName ?? "route_image.jpg";
                html.AppendLine("<div class='alert alert-info mt-2'>");
                html.AppendLine($"<i class='fas fa-image'></i> New route image will be uploaded: {E(fileName)}");
                html.AppendLine("</div>");
            }

            // Show changes summary if available
            var changesSummary = Text((object?)(updateData.changesSummary ?? updateData.ChangesSummary));
            if (!string.IsNullOrEmpty(changesSummary))
            {
                html.AppendLine(Row("Summary", changesSummary, "N/A", false));
            }

            html.AppendLine("</div>");
        }

        // Show the Changes field if it exists (from the approval request)
        var changes = Text((object?)(data.Changes ?? data.changes));
        if (!string.IsNullOrEmpty(changes))
        {
            html.AppendLine("<div class='alert alert-warning mb-0'>");
            html.AppendLine($"<strong>Changes:</strong> {E(changes)}");
            html.AppendLine("</div>");
        }

        return html.ToString();
    }

    string ParseRouteDeleteData(dynamic data)
    {
        var html = new System.Text.StringBuilder();

        // Warning message
        html.AppendLine("<div class='alert alert-danger'>");
        html.AppendLine("<i class='fas fa-exclamation-triangle'></i> <strong>Route to be Deleted</strong>");
        html.AppendLine("</div>");

        // Route details
        html.AppendLine("<div class='mb-3'>");
        html.AppendLine(Section("Route Information"));

        string? routeId = (data.RouteId ?? data.routeId)?.ToString();
        var routeType = data.RouteType ?? data.routeType ?? "Transfer";
        var productInfo = data.ProductInfo ?? data.productInfo;
        var fromLocation = data.FromLocation ?? data.fromLocation;
        var toLocation = data.ToLocation ?? data.toLocation;
        var createdDate = data.CreatedDate ?? data.createdDate;
        bool isCompleted = GetBoolValue(data, "isCompleted", "IsCompleted", false);

        html.AppendLine(Row("Route ID", string.IsNullOrWhiteSpace(routeId) ? null : "#" + routeId, "Unknown", true));
        html.AppendLine(RowHtml("Type", $"<span class='badge bg-info'>{E(routeType)}</span>"));
        html.AppendLine(Row("Product", (object)productInfo, "Unknown Product", false));
        html.AppendLine(Row("From", (object)fromLocation, "N/A", false));
        html.AppendLine(Row("To", (object)toLocation, "N/A", false));

        if (createdDate != null)
        {
            try
            {
                DateTime date = DateTime.Parse(createdDate.ToString());
                html.AppendLine(Row("Created", date.ToString("MM/dd/yyyy HH:mm"), "N/A", true));
            }
            catch
            {
                html.AppendLine(Row("Created", (object)createdDate, "N/A", true));
            }
        }

        html.AppendLine(RowHtml("Status", isCompleted
            ? "<span class='state state-ok'>Completed</span>"
            : "<span class='state state-warn'>Pending</span>"));
        html.AppendLine("</div>");

        // Deletion reason if provided
        var deleteReason = Text((object?)(data.DeleteReason ?? data.deleteReason ?? data.Reason ?? data.reason));
        if (!string.IsNullOrEmpty(deleteReason))
        {
            html.AppendLine("<div class='mb-3'>");
            html.AppendLine(Section("Deletion Reason"));
            html.AppendLine($"<p class='mb-0'>{E(deleteReason)}</p>");
            html.AppendLine("</div>");
        }

        // Warning for completed routes
        if (isCompleted)
        {
            html.AppendLine("<div class='alert alert-warning mb-0'>");
            html.AppendLine("<i class='fas fa-info-circle'></i> <strong>Note:</strong> This is a completed route. Deleting completed routes is generally not recommended as they form part of the audit trail.");
            html.AppendLine("</div>");
        }

        return html.ToString();
    }
}
