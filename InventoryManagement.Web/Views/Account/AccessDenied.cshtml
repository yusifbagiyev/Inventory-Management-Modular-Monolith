@{
    ViewData["Title"] = "Access Denied";
}

<div class="container-fluid px-4">
    <div class="ip-empty">
        <span class="icon"><i class="fa-solid fa-lock"></i></span>
        <h1 class="title">@L["Access Denied"]</h1>
        <p class="text mb-0">@L["You do not have permission to open this page. Ask your administrator if you need access."]</p>
        <a href="/Home/Dashboard" class="ip-btn ip-btn-secondary">
            <span>@L["Go to Dashboard"]</span><i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</div>
