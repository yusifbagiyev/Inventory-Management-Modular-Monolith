@model LoginViewModel
@using System.Reflection
@{
    Layout = null;
    var returnUrl = Model.ReturnUrl;
    // The version followed by the first 7 characters of the commit hash
    var info = typeof(Program).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
    var plus = info.IndexOf('+');
    var version = plus < 0 ? info : info[..plus] + " · " + info[(plus + 1)..].Substring(0, Math.Min(7, info.Length - plus - 1));
}
@* Recent accounts on this browser only need a password, another account also asks for the username *@
<!DOCTYPE html>
<html lang="@JsonStringLocalizer.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sign in"] - @L["166 Inventory"]</title>
    @* The .ico is for older browsers and the PNG for iOS home screens *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    @* Names the rail and toolbar only during a view transition, inline since it must run before first render *@
    <script>
        (function () {
            var root = document.documentElement;
            if (!('onpagereveal' in window)) { root.classList.add('no-vt'); return; }
            function name(on) {
                var rail = document.querySelector('.ip-rail'), bar = document.querySelector('.ip-toolbar');
                if (rail) rail.style.viewTransitionName = on ? 'ip-rail' : '';
                if (bar) bar.style.viewTransitionName = on ? 'ip-toolbar' : '';
            }
            window.addEventListener('pageswap', function (e) { if (e.viewTransition) name(true); });
            window.addEventListener('pagereveal', function (e) {
                if (!e.viewTransition) return;
                name(true);
                e.viewTransition.finished.finally(function () { name(false); });
            });
            // A page restored from the back/forward cache still has the names from its swap
            window.addEventListener('pageshow', function (e) { if (e.persisted) name(false); });
        })();
    </script>

    @* Sets the theme before first paint so dark pages don't flash light, same storage key as Theme in site.js *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ip-components.css" asp-append-version="true">
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--ip-bg); }
        [data-bs-theme="dark"] { color-scheme: dark; }
        .ip-login-head form { margin: 0; }
        .ip-account-wrap { position: relative; }
        .ip-account-wrap .ip-account { width: 100%; padding-right: 48px; }
        /* The remove button shows on hover or focus, and always on touch screens */
        .ip-account-forget { position: absolute; top: 50%; right: 8px; transform: translateY(-50%); margin: 0; }
        .ip-account-forget button { width: 32px; height: 32px; border: 0; border-radius: var(--ip-radius-md); background: transparent; color: var(--ip-text-3); cursor: pointer; opacity: 0; }
        .ip-account-wrap:hover .ip-account-forget button, .ip-account-forget button:focus-visible { opacity: 1; }
        .ip-account-forget button:hover { background: var(--ip-surface-active); color: var(--ip-text-1); }
        @@media (hover: none) { .ip-account-forget button { opacity: 1; } }
        .ip-account-wrap:hover .ip-account > i { visibility: hidden; }
    </style>
</head>
<body>
    <div class="ip-login">
        <header class="ip-login-head">
            <div class="d-flex align-items-center gap-2" style="display: flex; align-items: center; gap: 8px;">
                <span class="ip-logo brand" aria-hidden="true"><partial name="_BrandMark" /></span>
                <strong class="ip-rail-name">@L["166 Inventory"]<small>@L["IT department"]</small></strong>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <partial name="_LanguageSwitch" />
                <button type="button" class="ip-btn-icon lg" id="themeToggle" aria-label="@L["Toggle dark mode"]" title="@L["Dark mode"]">
                    <i class="fa-solid fa-moon"></i>
                </button>
            </div>
        </header>

        <main class="ip-login-main">
            @if (Model.ShowPicker)
            {
                <div class="ip-account-pick">
                    <div>
                        <h1>@L["Select an account"]</h1>
                        <div class="ip-muted">@L["Recent sign-ins on this computer"]</div>
                    </div>
                    <div class="ip-account-grid">
                        @foreach (var a in Model.Recent)
                        {
                            <div class="ip-account-wrap">
                                <a class="ip-account" href="@Url.Action("Login", new { user = a.Login, returnUrl })">
                                    <span class="ip-avatar" aria-hidden="true">@a.Initials</span>
                                    <span class="who"><b>@a.Name</b><small>@a.RoleLabel · @a.LastAtText</small></span>
                                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                </a>
                                <form class="ip-account-forget" method="post" asp-action="ForgetAccount">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="login" value="@a.Login" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" title="@L["Remove from this list"]" aria-label="@L["Remove {0} from this list", a.Name]">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                    <a class="ip-account-other" href="@Url.Action("Login", new { other = 1, returnUrl })">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>@L["Use another account"]
                    </a>
                </div>
            }
            else
            {
                <form class="ip-login-form" method="post" asp-action="Login" novalidate>
                    @if (Model.Recent.Any())
                    {
                        <a class="back" href="@Url.Action("Login", new { returnUrl })"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>@L["Change account"]</a>
                    }
                    @if (Model.AskUsername)
                    {
                        <div>
                            <h1>@L["Sign in"]</h1>
                            <div class="ip-muted">@L["Use the username and password of your work account"]</div>
                        </div>
                    }
                    else
                    {
                        <div class="identity">
                            <span class="ip-avatar" aria-hidden="true">@Model.Initials</span>
                            <div>
                                <div class="name">@Model.DisplayName</div>
                                <div class="login">@Model.LoginHint</div>
                            </div>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="ip-banner ip-banner-danger" role="alert">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <div>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                                {
                                    <div>@error</div>
                                }
                            </div>
                        </div>
                    }

                    <input type="hidden" asp-for="Mode" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    @if (Model.AskUsername)
                    {
                        <div class="ip-field">
                            <label asp-for="Username" class="ip-label">@L["Username"]</label>
                            <input asp-for="Username" class="ip-input" autocomplete="username" autofocus>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="Username" />
                    }
                    <div class="ip-field">
                        <label asp-for="Password" class="ip-label">@L["Password"]</label>
                        <div class="ip-pw-wrap">
                            <input asp-for="Password" class="ip-input" type="password" autocomplete="current-password" autofocus="@(!Model.AskUsername)">
                            <button type="button" class="ip-btn-icon" id="togglePassword" aria-pressed="false"
                                    aria-label="@L["Show password"]" title="@L["Show password"]"
                                    data-label-show="@L["Show password"]" data-label-hide="@L["Hide password"]">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="ip-btn ip-btn-primary">@L["Sign in"]</button>
                    <div class="ip-faint">@L["If you have forgotten your password, please contact the IT department."]</div>
                </form>
            }
        </main>

        <footer class="ip-login-foot">
            <span>@L["Internal system"]</span>
            @if (version.Length > 0)
            {
                <span class="ip-num">v@(version)</span>
            }
        </footer>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('togglePassword');
            if (toggle) toggle.addEventListener('click', function () {
                var field = document.getElementById('Password');
                var show = field.type === 'password';
                field.type = show ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                var label = show ? toggle.dataset.labelHide : toggle.dataset.labelShow;
                toggle.setAttribute('aria-label', label);
                toggle.title = label;
                toggle.querySelector('i').className = show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            });

            // The theme toggle uses the same storage key as site.js
            var root = document.documentElement;
            var themeButton = document.getElementById('themeToggle');
            function syncTheme() {
                themeButton.querySelector('i').className = root.getAttribute('data-bs-theme') === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
            themeButton.addEventListener('click', function () {
                var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-bs-theme', next);
                try { localStorage.setItem('theme', next); } catch (e) { }
                syncTheme();
            });
            syncTheme();
        });
    </script>
</body>
</html>
