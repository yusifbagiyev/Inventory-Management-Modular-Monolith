@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@(JsonStringLocalizer.IsAzerbaijani ? "az" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sign in"] - Inventory Pro</title>
    @* Tab icon: the rail logo (favicon.svg); .ico for older browsers, PNG for iOS home screens. *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />

    @* Theme before first paint (no light flash on dark pages): the saved choice, else the OS setting.
       site.js (Theme) owns the toggle on the other pages; keep the storage key in sync with it. *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ip-components.css" asp-append-version="true">
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--ip-surface); }
        [data-bs-theme="dark"] { color-scheme: dark; }
        .ip-login-side .brand { display: flex; align-items: center; gap: 12px; font-size: var(--ip-fs-md); font-weight: 600; }
        .ip-login-side .brand .ip-logo { width: 36px; height: 36px; font-size: 16px; }
        .ip-login-side .note { margin-top: 16px; max-width: 440px; color: var(--ip-text-2); }
        .ip-login-main .top { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }
        .ip-login-main .top form { margin: 0; }
        .ip-login-form h1 { margin-bottom: 4px; }
        .pw-wrap { position: relative; }
        .pw-wrap .ip-input { padding-right: 48px; }
        .pw-wrap .ip-btn-icon { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); }
        .remember { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .ip-login-form .ip-btn-primary { width: 100%; }
        .ip-login-form .mobile-brand { display: none; align-items: center; gap: 10px; font-weight: 600; }
        @@media (max-width: 900px) {
            .ip-login-main { padding: 20px 24px; }
            .ip-login-form .mobile-brand { display: flex; }
        }
    </style>
</head>
<body>
    <div class="ip-login">
        @* Left panel (design: 01 Login): dark in both themes. *@
        <aside class="ip-login-side" data-bs-theme="dark">
            <div class="brand">
                <span class="ip-logo" aria-hidden="true"><i class="fa-solid fa-box-archive"></i></span>
                <span>Inventory Pro</span>
            </div>
            <div>
                <div class="claim">@L["Equipment records, transfers and approvals in one place."]</div>
                <p class="note">@L["For internal use. No account yet? Ask the IT department."]</p>
            </div>
            <div class="ip-faint">© @DateTime.Today.Year</div>
        </aside>

        <main class="ip-login-main">
            <div class="top">
                <form method="post" asp-controller="Language" asp-action="Set" class="ip-seg" role="group" aria-label="@L["Switch language"]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    @if (JsonStringLocalizer.IsAzerbaijani)
                    {
                        <button type="button" class="active" aria-pressed="true">AZ</button>
                        <button type="submit" name="culture" value="en-US" aria-pressed="false">EN</button>
                    }
                    else
                    {
                        <button type="submit" name="culture" value="az-Latn-AZ" aria-pressed="false">AZ</button>
                        <button type="button" class="active" aria-pressed="true">EN</button>
                    }
                </form>
                <button type="button" class="ip-btn-icon lg" id="themeToggle" aria-label="@L["Toggle dark mode"]" title="@L["Dark mode"]">
                    <i class="fa-solid fa-moon"></i>
                </button>
            </div>

            <div class="ip-login-form">
                <div class="mobile-brand">
                    <span class="ip-logo" aria-hidden="true"><i class="fa-solid fa-box-archive"></i></span>
                    <span>Inventory Pro</span>
                </div>
                <div>
                    <h1>@L["Please sign in"]</h1>
                    <div class="ip-muted">@L["With the username and password of your work account"]</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="ip-banner ip-banner-danger" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post" style="display: flex; flex-direction: column; gap: 20px;">
                    <div class="ip-field">
                        <label asp-for="Username" class="ip-label">@L["Username"]</label>
                        <input asp-for="Username" class="ip-input" autocomplete="username" autofocus>
                        <span asp-validation-for="Username" class="ip-error"></span>
                    </div>

                    <div class="ip-field">
                        <label asp-for="Password" class="ip-label">@L["Password"]</label>
                        <div class="pw-wrap">
                            <input asp-for="Password" class="ip-input" type="password" autocomplete="current-password">
                            <button type="button" class="ip-btn-icon" id="togglePassword" aria-pressed="false"
                                    aria-label="@L["Show password"]" title="@L["Show password"]"
                                    data-label-show="@L["Show password"]" data-label-hide="@L["Hide password"]">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="ip-error"></span>
                    </div>

                    <label class="remember">
                        <input asp-for="RememberMe" class="ip-check" type="checkbox">
                        <span>@L["Remember me"]</span>
                    </label>

                    <button type="submit" class="ip-btn ip-btn-primary ip-btn-lg">
                        <span>@L["Sign in"]</span><i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                <div class="ip-hint">@L["Trouble signing in? Contact your system administrator."]</div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var remembered = getCookie('username');
            if (remembered) {
                var user = document.getElementById('Username');
                var remember = document.getElementById('RememberMe');
                var pass = document.getElementById('Password');
                if (user) user.value = remembered;
                if (remember) remember.checked = true;
                if (pass) pass.focus();
            }

            // Show / hide the password.
            var toggle = document.getElementById('togglePassword');
            toggle.addEventListener('click', function () {
                var field = document.getElementById('Password');
                var show = field.type === 'password';
                field.type = show ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                var label = show ? toggle.dataset.labelHide : toggle.dataset.labelShow;
                toggle.setAttribute('aria-label', label);
                toggle.title = label;
                toggle.querySelector('i').className = show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            });

            // Theme toggle (same storage key as site.js).
            var root = document.documentElement;
            var themeButton = document.getElementById('themeToggle');
            function syncTheme() {
                themeButton.querySelector('i').className = root.getAttribute('data-bs-theme') === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
            themeButton.addEventListener('click', function () {
                var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-bs-theme', next);
                try { localStorage.setItem('theme', next); } catch (e) { }
                syncTheme();
            });
            syncTheme();
        });

        function getCookie(name) {
            var value = '; ' + document.cookie;
            var parts = value.split('; ' + name + '=');
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return null;
        }
    </script>
</body>
</html>
