@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@(JsonStringLocalizer.IsAzerbaijani ? "az" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sign in"] - Inventory Pro</title>

    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">

    @* Theme before first paint (no light flash on dark pages): the saved choice, else the OS setting.
       site.js (Theme) owns the toggle; keep the storage key in sync with it. *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <style>
        :root {
            --ground: #F6F9FC;
            --surface: #FFFFFF;
            --surface-2: #F0F5F9;
            --ink: #16262E;
            --ink-2: #4C616D;
            --ink-3: #7C8F9B;
            --line: #E3EDF3;
            --line-2: #CFDEE8;
            --accent: #0E9BC4;
            --accent-2: #0B7FA3;
            --accent-weak: #E4F5FB;
            --crit: #CE3B33;
            --crit-weak: #FDECEA;
            --font-mono: ui-monospace, "Cascadia Mono", "SF Mono", Consolas, monospace;
        }

        [data-bs-theme="dark"] {
            --ground: #0F1A21;
            --surface: #16232C;
            --surface-2: #1E2F3A;
            --ink: #E3EDF2;
            --ink-2: #A9BCC7;
            --ink-3: #7F95A2;
            --line: #26394A;
            --line-2: #33495A;
            --accent: #22B0D8;
            --accent-2: #4CC6EA;
            --accent-weak: rgba(34, 176, 216, .14);
            --crit: #F0655C;
            --crit-weak: rgba(240, 101, 92, .15);
            color-scheme: dark;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: var(--ground);
            color: var(--ink);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 14.5px;
            -webkit-font-smoothing: antialiased;
        }

        .login-card {
            width: 100%;
            max-width: 380px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 10px;
            box-shadow: 0 1px 3px rgba(22, 38, 46, .06);
            padding: 30px 28px 26px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 7px;
            background: var(--accent);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 15px;
            flex: none;
        }

        .brand-name {
            font-size: 16px;
            font-weight: 660;
            letter-spacing: -.01em;
            line-height: 1.2;
        }

        .brand-sub {
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--ink-3);
        }

        h1 {
            font-size: 19px;
            font-weight: 640;
            letter-spacing: -.015em;
            margin: 0 0 3px;
        }

        .lead {
            margin: 0 0 20px;
            color: var(--ink-3);
            font-size: 13.5px;
        }

        .form-group { margin-bottom: 14px; }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--ink-2);
            margin-bottom: 5px;
        }

        .input-wrapper { position: relative; }

        .input-icon {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-3);
            font-size: 13px;
            pointer-events: none;
        }

        .form-input {
            width: 100%;
            padding: 9px 12px 9px 33px;
            border: 1px solid var(--line-2);
            border-radius: 6px;
            background: var(--surface);
            color: var(--ink);
            font: inherit;
            font-size: 14px;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .form-input::placeholder { color: var(--ink-3); }

        .form-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-weak);
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 16px 0 20px;
        }

        .form-check-input {
            width: 15px;
            height: 15px;
            accent-color: var(--accent);
            margin: 0;
            cursor: pointer;
        }

        .form-check-label {
            font-size: 13px;
            color: var(--ink-2);
            cursor: pointer;
        }

        .login-btn {
            width: 100%;
            padding: 10px 14px;
            border: 0;
            border-radius: 6px;
            background: var(--accent);
            color: #fff;
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s ease;
        }

        .login-btn:hover { background: var(--accent-2); }

        .login-btn:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            background: var(--crit-weak);
            color: var(--crit);
            border-radius: 6px;
            padding: 9px 11px;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .text-danger {
            display: block;
            color: var(--crit);
            font-size: 12.5px;
            margin-top: 4px;
        }

        .foot {
            margin-top: 20px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            font-size: 12px;
            color: var(--ink-3);
            text-align: center;
        }

        .brand .lang-switch { margin-left: auto; }
        .brand .lang-switch button {
            border: 1px solid var(--line-2);
            background: none;
            color: var(--ink-2);
            border-radius: 6px;
            padding: 3px 9px;
            font: 600 11px/1.4 var(--font-mono);
            letter-spacing: .06em;
            cursor: pointer;
        }
        .brand .lang-switch button:hover { color: var(--accent-2); border-color: var(--accent); }

        @@media (prefers-reduced-motion: reduce) {
            * { transition: none !important; }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <div class="brand-mark"><i class="fas fa-boxes-stacked"></i></div>
            <div>
                <div class="brand-name">Inventory Pro</div>
                <div class="brand-sub">166</div>
            </div>
            <form method="post" asp-controller="Language" asp-action="Set" class="lang-switch">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="@(JsonStringLocalizer.IsAzerbaijani ? "en-US" : "az-Latn-AZ")" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" title="@L["Switch language"]">@(JsonStringLocalizer.IsAzerbaijani ? "EN" : "AZ")</button>
            </form>
        </div>

        <h1>@L["Sign in"]</h1>
        <p class="lead">@L["Use your work account to continue."]</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert">
                <i class="fas fa-circle-exclamation" style="margin-top:2px"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Username" class="form-label">@L["Username"]</label>
                <div class="input-wrapper">
                    <i class="fas fa-user input-icon"></i>
                    <input asp-for="Username" class="form-input" placeholder="@L["Your username"]" autocomplete="username" autofocus>
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">@L["Password"]</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Password" class="form-input" type="password" placeholder="@L["Your password"]" autocomplete="current-password">
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                <label asp-for="RememberMe" class="form-check-label">@L["Keep me signed in for 30 days"]</label>
            </div>

            <button type="submit" class="login-btn">@L["Sign in"]</button>
        </form>

        <div class="foot">@L["Trouble signing in? Contact your system administrator."]</div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var remembered = getCookie('username');
            if (remembered) {
                var user = document.getElementById('Username');
                var remember = document.getElementById('RememberMe');
                var pass = document.getElementById('Password');
                if (user) user.value = remembered;
                if (remember) remember.checked = true;
                if (pass) pass.focus();
            }
        });

        function getCookie(name) {
            var value = '; ' + document.cookie;
            var parts = value.split('; ' + name + '=');
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return null;
        }
    </script>
</body>
</html>
