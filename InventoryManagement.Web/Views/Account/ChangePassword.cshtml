@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Profile")">@L["Profile"]</a></li>
                <li class="breadcrumb-item active">@L["Change Password"]</li>
            </ol>
            <h1>@L["Change Password"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Profile")" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> @L["Back to Profile"]
            </a>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-lg-6 col-xl-5">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-key me-2"></i>@L["Update your password"]
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                             style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">@L["Current password"]</label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">@L["New password"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text">@L["At least 6 characters. Choose something you do not use elsewhere."]</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">@L["Confirm new password"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-1"></i> @L["Change password"]
                            </button>
                            <a href="@Url.Action("Profile")" class="btn btn-outline-secondary">@L["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@* Validation is server-side (ModelState), matching the rest of this project - it has no
   _ValidationScriptsPartial and wires no unobtrusive client validation. *@
