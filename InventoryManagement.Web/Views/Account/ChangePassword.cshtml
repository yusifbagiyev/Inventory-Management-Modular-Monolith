@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Profile")">@L["Profile"]</a></li>
                <li class="breadcrumb-item active">@L["Change Password"]</li>
            </ol>
            <h1>@L["Change Password"]</h1>
        </div>
    </div>

    <form asp-action="ChangePassword" method="post" autocomplete="off" class="ip-form">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Update your password"]</h2>
            <div class="d-flex flex-column gap-4 col-lg-7 col-xl-5">
                <div class="ip-field">
                    <label asp-for="CurrentPassword" class="ip-label"><span>@L["Current password"]</span> <span class="req">*</span></label>
                    <input asp-for="CurrentPassword" class="ip-input" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="NewPassword" class="ip-label"><span>@L["New password"]</span> <span class="req">*</span></label>
                    <input asp-for="NewPassword" class="ip-input" autocomplete="new-password" />
                    <span class="ip-hint">@L["At least {0} characters, with an uppercase letter, a lowercase letter and a digit. Choose a password you do not use for other services.", SharedServices.Identity.PasswordRules.MinLength]</span>
                    <span asp-validation-for="NewPassword" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="ConfirmPassword" class="ip-label"><span>@L["Confirm new password"]</span> <span class="req">*</span></label>
                    <input asp-for="ConfirmPassword" class="ip-input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="ip-error"></span>
                </div>
            </div>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a href="@Url.Action("Profile")" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Change password"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>
@* Validation is server-side (ModelState), matching the rest of this project - it has no
   _ValidationScriptsPartial and wires no unobtrusive client validation. *@
