@model UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var initials = $"{Model.FirstName.FirstOrDefault()}{Model.LastName.FirstOrDefault()}".Trim();
    var permissionsByCategory = Model.Permissions
        .GroupBy(p => p.Category)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div class="d-flex align-items-center gap-3">
            <span class="ip-avatar" aria-hidden="true">@(string.IsNullOrEmpty(initials) ? "?" : initials)</span>
            <div>
                <h1>@L["My Profile"]</h1>
                <div class="ip-sub">@Model.FullName · <span class="ip-mono">@@@Model.Username</span></div>
            </div>
        </div>
        <div class="ip-page-actions">
            <form asp-action="Logout" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="ip-btn ip-btn-danger-ghost">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i><span>@L["Sign Out"]</span>
                </button>
            </form>
            @* Self-service change (verifies the current password). Previously this pointed at the
               Admin-only ResetPassword action, so a non-admin got Access Denied. *@
            <a href="@Url.Action("ChangePassword")" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-key"></i><span>@L["Change Password"]</span>
            </a>
        </div>
    </div>

    <hr class="ip-rule" />

    <div class="row g-5 pt-4">
        <div class="col-lg-5">
            <h2 class="mb-3">@L["Personal Information"]</h2>
            <dl class="ip-dl">
                <div><dt>@L["First Name"]</dt><dd>@Model.FirstName</dd></div>
                <div><dt>@L["Last Name"]</dt><dd>@Model.LastName</dd></div>
                <div><dt>@L["Username"]</dt><dd class="ip-mono">@Model.Username</dd></div>
                <div><dt>@L["Email Address"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd></div>
                <div>
                    <dt>@L["Status"]</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="ip-badge ip-badge-success">@L["Active"]</span>
                        }
                        else
                        {
                            <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@L["Roles"]</dt>
                    <dd>
                        @if (Model.Roles.Any())
                        {
                            @(string.Join(", ", Model.Roles.Select(r => L[r].Value)))
                        }
                        else
                        {
                            <span class="ip-muted">@L["No roles"]</span>
                        }
                    </dd>
                </div>
                <div><dt>@L["Account Created"]</dt><dd class="ip-num">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd></div>
                <div>
                    <dt>@L["Last Login"]</dt>
                    <dd class="ip-num">
                        @if (Model.LastLoginAt.HasValue)
                        {
                            @Model.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm")
                        }
                        else
                        {
                            <span class="ip-muted">@L["Never"]</span>
                        }
                    </dd>
                </div>
            </dl>
            <p class="ip-hint mt-3 mb-0">@L["To update your profile information, please contact your system administrator."]</p>
        </div>

        <div class="col-lg-7">
            <h2 class="mb-3">@L["My Permissions"] <span class="ip-faint ip-num fw-normal ms-1">@Model.Permissions.Count</span></h2>

            @if (permissionsByCategory.Any())
            {
                <div class="ip-filterbar">
                    <label class="ip-filter search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" id="permissionSearch" autocomplete="off"
                               placeholder="@L["Search permissions..."]" aria-label="@L["Search permissions..."]" />
                    </label>
                </div>

                @foreach (var category in permissionsByCategory)
                {
                    <section class="permission-category pt-4">
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fw-semibold">@L[category.Key]</span>
                            <span class="ip-faint ip-num">@category.Count()</span>
                        </div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var permission in category.OrderBy(p => p.Name))
                            {
                                var description = string.IsNullOrEmpty(permission.Description) ? "" : L[permission.Description].Value;
                                <li class="permission-item py-2 border-top"
                                    data-permission-name="@($"{permission.Name} {description}".ToLowerInvariant())">
                                    <div class="ip-mono">@permission.Name</div>
                                    @if (!string.IsNullOrEmpty(description))
                                    {
                                        <div class="ip-faint">@description</div>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }

                <p class="ip-muted pt-4 mb-0 d-none" id="permissionSearchEmpty">@L["No matching permissions."]</p>
            }
            else
            {
                <div class="ip-empty pt-0">
                    <span class="icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <div class="title">@L["No permissions assigned"]</div>
                    <div class="text">@L["Ask your administrator to grant the access you need."]</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Permission search: hides non-matching permissions and the categories left empty.
        $('#permissionSearch').on('input', function () {
            const term = $(this).val().trim().toLowerCase();

            $('.permission-item').each(function () {
                $(this).toggleClass('d-none', term !== '' && !String($(this).data('permission-name')).includes(term));
            });
            $('.permission-category').each(function () {
                $(this).toggleClass('d-none', $(this).find('.permission-item:not(.d-none)').length === 0);
            });
            $('#permissionSearchEmpty').toggleClass('d-none', $('.permission-category:not(.d-none)').length > 0);
        });
    </script>
}
