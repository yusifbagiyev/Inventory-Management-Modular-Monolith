@model UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["My Profile"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @* Self-service change (verifies the current password). Previously this pointed at the
               Admin-only ResetPassword action, so a non-admin got Access Denied. *@
            <a href="@Url.Action("ChangePassword")" class="btn btn-sm btn-primary">
                <i class="fas fa-key me-1"></i> @L["Change Password"]
            </a>
            <form asp-action="Logout" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-sign-out-alt me-1"></i> @L["Sign Out"]
                </button>
            </form>
        </div>
    </div>

    <div class="row mt-3">
        <!-- Left Column - Account summary -->
        <div class="col-lg-4 mb-3">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-id-badge me-2"></i>@L["Account"]
                </div>
                <div class="card-body">
                    <div class="cell-item mb-3">
                        <div class="user-avatar">
                            <span>@Model.FirstName[0]@Model.LastName[0]</span>
                        </div>
                        <div class="cell-text">
                            <span class="cell-title">@Model.FullName</span>
                            <span class="cell-sub">@@@Model.Username</span>
                        </div>
                    </div>

                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">@L["Status"]</span>
                            <span class="d-value">
                                @if (Model.IsActive)
                                {
                                    <span class="state state-ok">@L["Active Account"]</span>
                                }
                                else
                                {
                                    <span class="state state-idle">@L["Inactive"]</span>
                                }
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Roles"] (@Model.Roles.Count)</span>
                            <span class="d-value">
                                @if (Model.Roles.Any())
                                {
                                    <span class="state-stack">
                                        @foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary">@role</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="d-empty">@L["No roles"]</span>
                                }
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Permissions"]</span>
                            <span class="d-value mono">@Model.Permissions.Count</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Details -->
        <div class="col-lg-8">
            <!-- Personal Information -->
            <div class="card mb-3">
                <div class="card-header">
                    <i class="fas fa-circle-info me-2"></i>@L["Personal Information"]
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">@L["First Name"]</span>
                            <span class="d-value">@Model.FirstName</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Last Name"]</span>
                            <span class="d-value">@Model.LastName</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Username"]</span>
                            <span class="d-value">@Model.Username</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Email Address"]</span>
                            <span class="d-value">@Model.Email</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Account Created"]</span>
                            <span class="d-value mono">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">@L["Last Login"]</span>
                            <span class="d-value">
                                @if (Model.LastLoginAt.HasValue)
                                {
                                    <span class="mono">@Model.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="d-empty">@L["Never"]</span>
                                }
                            </span>
                        </div>
                    </div>

                    <p class="form-text mb-0 mt-3">
                        @L["To update your profile information, please contact your system administrator."]
                    </p>
                </div>
            </div>

            <!-- Permissions -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <span><i class="fas fa-shield-halved me-2"></i>@L["My Permissions"] (@Model.Permissions.Count)</span>
                    <div class="filter-search">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-magnifying-glass"></i>
                            </span>
                            <input type="text"
                                   id="permissionSearch"
                                   class="form-control"
                                   placeholder="@L["Search permissions..."]">
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Permissions.Any())
                    {
                        var permissionsByCategory = Model.Permissions
                            .GroupBy(p => p.Category)
                            .OrderBy(g => g.Key);

                        <div class="accordion accordion-flush" id="permissionsAccordion">
                            @foreach (var category in permissionsByCategory)
                            {
                                var categoryId = category.Key.Replace(" ", "");
                                var isFirst = category.Key == permissionsByCategory.First().Key;

                                <div class="accordion-item permission-category">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(isFirst ? "" : "collapsed")"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@categoryId">
                                            <span class="fw-semibold">@L[category.Key]</span>
                                            <span class="badge bg-primary ms-2">@category.Count()</span>
                                        </button>
                                    </h2>
                                    <div id="@categoryId"
                                         class="accordion-collapse collapse @(isFirst ? "show" : "")"
                                         data-bs-parent="#permissionsAccordion">
                                        <div class="accordion-body">
                                            <div class="list-group list-group-flush side-panel">
                                                @foreach (var permission in category.OrderBy(p => p.Name))
                                                {
                                                    <div class="list-group-item permission-item"
                                                         data-permission-name="@permission.Name.ToLower()">
                                                        <div class="d-flex align-items-start gap-2">
                                                            <i class="fas fa-circle-check text-success"></i>
                                                            <div>
                                                                <div class="mono">@permission.Name</div>
                                                                @if (!string.IsNullOrEmpty(permission.Description))
                                                                {
                                                                    <div class="form-text">@L[permission.Description]</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-triangle-exclamation"></i>
                            <h5>@L["No permissions assigned"]</h5>
                            <p class="mb-0">@L["Ask your administrator to grant the access you need."]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Permission search functionality
        $(document).ready(function() {
            $('#permissionSearch').on('keyup', function() {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm === '') {
                    // Show all
                    $('.permission-item').show();
                    $('.permission-category').show();
                } else {
                    // Filter permissions
                    $('.permission-item').each(function() {
                        const permissionName = $(this).data('permission-name');
                        if (permissionName.includes(searchTerm)) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });

                    // Hide categories with no visible items
                    $('.permission-category').each(function() {
                        const visibleItems = $(this).find('.permission-item:visible').length;
                        if (visibleItems > 0) {
                            $(this).show();
                            // Expand the accordion
                            $(this).find('.accordion-collapse').addClass('show');
                            $(this).find('.accordion-button').removeClass('collapsed');
                        } else {
                            $(this).hide();
                        }
                    });
                }
            });
        });

        function logoutAllDevices() {
            // Nothing is wired up behind this yet, so asking for confirmation first would be
            // misleading - say plainly that it is not available instead.
            showToast(t('Signing out other devices is not available yet.'), 'info');
        }
    </script>
}
