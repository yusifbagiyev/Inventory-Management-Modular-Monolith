@model MyRequestsViewModel
@{
    ViewData["Title"] = "My Requests";
    var pendingCount = Model.Requests.Count(r => r.Status == "Pending");
}
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["My Approval Requests"]</h1>
            <div class="ip-sub ip-num" id="myRequestsSummary">@L["{0} requests, {1} pending", Model.Requests.Count, pendingCount]</div>
        </div>
    </div>

    @* These tabs filter rows in the browser through .filter-btn and data-filter *@
    <nav class="ip-tabs strong" aria-label="@L["Status"]" id="myRequestsTabs">
        <button type="button" class="ip-tab filter-btn active" data-filter="all">
            @L["All"] <span class="count">@Model.Requests.Count</span>
        </button>
        <button type="button" class="ip-tab filter-btn" data-filter="pending">
            @L["Pending"] <span class="count warning">@pendingCount</span>
        </button>
        <button type="button" class="ip-tab filter-btn" data-filter="approved">
            @L["Approved"] <span class="count">@Model.Requests.Count(r => r.Status == "Approved" || r.Status == "Executed")</span>
        </button>
        <button type="button" class="ip-tab filter-btn" data-filter="rejected">
            @L["Rejected"] <span class="count">@Model.Requests.Count(r => r.Status == "Rejected")</span>
        </button>
        <button type="button" class="ip-tab filter-btn" data-filter="failed">
            @L["Failed"] <span class="count">@Model.Requests.Count(r => r.Status == "Failed")</span>
        </button>
    </nav>

    <div id="myRequestsRegion">
        @if (Model.Requests.Any())
        {
            <div class="ip-table-wrap">
                @* Every request is in the page, so the column headers sort and filter these rows in the browser *@
                <table class="ip-table" id="myRequestsTable" data-columns="client">
                    <thead>
                        <tr>
                            <th data-sort="id" data-sort-first="desc" data-filter="text">@L["Request"]</th>
                            <th data-sort="what" data-filter="text">@L["What changes"]</th>
                            <th data-sort="date" data-sort-first="desc" data-filter="date">@L["Date"]</th>
                            <th data-sort="status" data-filter="list">@L["Status"]</th>
                            <th class="actions-column"><span class="visually-hidden">@L["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.Requests)
                        {
                            var view = ApprovalView.From(request.RequestType, request.ActionData);
                            var fields = view.FieldNames.Select(f => L[f].Value).ToList();
                            var statusLabel = L[StatusLabel(request.Status)].Value;
                            <tr data-status="@GetStatusFilter(request.Status)" data-request-id="@request.Id" class="ip-clickable" onclick="viewDetails(@request.Id)">
                                <td class="code ip-mono ip-muted" data-filter-value="@request.Id">#@request.Id</td>
                                <td class="title">
                                    <div class="cell-text">
                                        <span class="fw-semibold">@L[view.Kind]@(string.IsNullOrEmpty(view.Subject) ? "" : ": " + view.Subject)</span>
                                        @if (fields.Count > 0)
                                        {
                                            <span class="sub">@string.Join(", ", fields) · @L["{0} fields", fields.Count]</span>
                                        }
                                    </div>
                                </td>
                                <td class="date ip-num text-nowrap" data-order="@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")">
                                    @request.CreatedAt.ToString("dd.MM.yyyy")
                                    <div class="sub">@request.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                @* The reason and decider under the badge are left out of the status filter *@
                                <td class="state" data-filter-value="@statusLabel" data-filter-label="@statusLabel">
                                    @switch (request.Status)
                                    {
                                        case "Pending":
                                            <span class="ip-badge ip-badge-warning">@L["Pending"]</span>
                                            break;
                                        case "Approved":
                                        case "Executed":
                                            <span class="ip-badge ip-badge-success">@L["Approved"]</span>
                                            break;
                                        case "Rejected":
                                            <span class="ip-badge ip-badge-danger">@L["Rejected"]</span>
                                            @if (!string.IsNullOrEmpty(request.RejectionReason))
                                            {
                                                <div class="sub">@request.RejectionReason</div>
                                            }
                                            break;
                                        case "Failed":
                                            <span class="ip-badge ip-badge-danger">@L["Failed"]</span>
                                            @if (!string.IsNullOrEmpty(request.RejectionReason))
                                            {
                                                <div class="sub">@L["Reason"]: @JsonStringLocalizer.TranslateMessage(request.RejectionReason)</div>
                                            }
                                            break;
                                        default:
                                            <span class="ip-badge ip-badge-neutral">@L[request.Status]</span>
                                            break;
                                    }
                                    @if (!string.IsNullOrEmpty(request.ApprovedByName))
                                    {
                                        <div class="sub">
                                            <span>@L["Decided by {0}", request.ApprovedByName]</span>
                                            @if (request.ProcessedAt.HasValue)
                                            {
                                                <span class="ip-num">· @request.ProcessedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="actions text-end">
                                    <div class="actions">
                                        <button type="button" class="ip-btn-icon" title="@L["View details"]" aria-label="@L["View details"]"
                                                onclick="event.stopPropagation(); viewDetails(@request.Id)">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                        @if (request.Status == "Pending")
                                        {
                                            <button type="button" class="ip-btn ip-btn-danger-ghost ip-btn-sm" data-cancel-id="@request.Id"
                                                    onclick="event.stopPropagation(); cancelRequest(@request.Id)">
                                                <i class="fa-solid fa-xmark"></i><span>@L["Cancel request"]</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ip-empty d-none" id="myRequestsFilterEmpty">
                <span class="icon"><i class="fa-solid fa-filter"></i></span>
                <div class="title">@L["No requests with this status"]</div>
            </div>
        }
        else
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-solid fa-inbox"></i></span>
                <div class="title">@L["You have not submitted any requests"]</div>
                <div class="text">@L["Actions that require approval are listed here with their status."]</div>
            </div>
        }
    </div>
</div>

@* Read-only dialog whose header and body come from Approvals/_ApprovalDetails *@
<div class="modal fade ip-modal" id="detailsModal" tabindex="-1" aria-labelledby="detailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="flex-grow-1" style="min-width: 0" data-dialog-head></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body" data-dialog-body></div>
            <div class="modal-footer">
                <button type="button" class="ip-btn ip-btn-secondary" data-bs-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script>
        // Delegated because live updates replace the tabs
        $(document).on('click', '.filter-btn', function () {
            $('.filter-btn').removeClass('active');
            $(this).addClass('active');
            applyStatusFilter();
        });

        function applyStatusFilter() {
            const filter = $('.filter-btn.active').data('filter') || 'all';
            $('#myRequestsTable tr[data-status]').each(function () {
                $(this).toggleClass('d-none', filter !== 'all' && this.dataset.status !== filter);
            });
            updateFilterEmpty();
        }

        // The tabs hide rows with d-none and the column headers with hidden, and the headers stay in view either way
        function updateFilterEmpty() {
            const rows = Array.from(document.querySelectorAll('#myRequestsTable tr[data-status]'));
            const none = rows.length > 0 && !rows.some(row => !row.classList.contains('d-none') && !row.hidden);
            // The column filters show their own empty row when they alone match nothing
            const headerEmpty = !!document.querySelector('#myRequestsTable .ip-colfilter-empty');
            $('#myRequestsFilterEmpty').toggleClass('d-none', !none || headerEmpty);
        }

        // Column filters change the rows without an event, so the empty note follows the table itself
        function watchRequestRows() {
            const body = document.querySelector('#myRequestsTable tbody');
            if (body) new MutationObserver(updateFilterEmpty).observe(body, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
        }
        watchRequestRows();

        // A decision on one of these requests refreshes its status and the counts but keeps the active tab
        let activeFilter = 'all';
        LiveUpdates.watch({
            entities: ['approval'],
            regions: ['#myRequestsSummary', '#myRequestsTabs', '#myRequestsRegion'],
            beforeRefresh() {
                activeFilter = $('.filter-btn.active').data('filter') || 'all';
            },
            afterRefresh() {
                $('.filter-btn').removeClass('active').filter(`[data-filter="${activeFilter}"]`).addClass('active');
                watchRequestRows();
                applyStatusFilter();
            }
        });

        function viewDetails(requestId) {
            loadApprovalDetails(`/MyRequests/Details/${requestId}`, document.getElementById('detailsModal'));
        }

        // Products and notifications link here with ?open=id to open that request straight away
        $(function () {
            const openId = parseInt(new URLSearchParams(location.search).get('open'), 10);
            if (openId > 0) viewDetails(openId);
        });

        function cancelRequest(requestId) {
            confirmAction({
                title: t('Cancel request'),
                message: t('Cancel this request? It will be withdrawn from the approval queue.'),
                okText: t('Cancel request'),
                danger: true
            }, function () {
                const token = $('input[name="__RequestVerificationToken"]').val();

                const $cancelButton = $(`[data-cancel-id="${requestId}"]`);
                const originalButtonText = $cancelButton.html();
                $cancelButton.prop('disabled', true)
                            .html(`<span class="spinner-border spinner-border-sm"></span><span>${escapeHtml(t('Cancelling...'))}</span>`);

                $.ajax({
                    url: `/MyRequests/Cancel/${requestId}`,
                    type: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    data: {
                        __RequestVerificationToken: token
                    },
                    success: function(response) {
                        let isSuccess = false;
                        let message = t('Request cancelled successfully');

                        // Accept every success shape the server may answer with
                        if (typeof response === 'object' && response !== null) {
                            isSuccess = response.success === true ||
                                       response.isSuccess === true ||
                                       response.Success === true;

                            if (response.message) message = response.message;
                            else if (response.Message) message = response.Message;
                        } else if (typeof response === 'string') {
                            isSuccess = true;
                            message = response;
                        } else {
                            isSuccess = true;
                        }

                        if (isSuccess) {
                            showToast(message, 'success');
                            ListNav.reload();
                        } else {
                            showToast(message || t('Failed to cancel request'), 'error');
                            $cancelButton.prop('disabled', false).html(originalButtonText);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Cancel request failed:', {
                            status: xhr.status,
                            responseText: xhr.responseText,
                            error: error
                        });

                        let errorMessage = t('Failed to cancel request');

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || response.error || errorMessage;
                            } catch (e) {
                                // Only a short plain-text body is shown, never an HTML error page
                                if (xhr.responseText.length < 200 && !xhr.responseText.includes('<')) {
                                    errorMessage = xhr.responseText;
                                }
                            }
                        }

                        showToast(errorMessage, 'error');
                        $cancelButton.prop('disabled', false).html(originalButtonText);
                    }
                });
            });
        }
    </script>
}

@functions {
    // An English text key, translated through L
    string StatusLabel(string status) => status switch
    {
        "Executed" => "Approved",
        _ => status
    };

    string GetStatusFilter(string status)
    {
        return status switch
        {
            "Pending" => "pending",
            "Approved" => "approved",
            "Executed" => "approved",
            "Rejected" => "rejected",
            "Failed" => "failed",
            _ => "all"
        };
    }
}
