@model MyRequestsViewModel
    @Html.AntiForgeryToken()
@{
    ViewData["Title"] = "My Requests";
}
<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["My Approval Requests"]</h1>
        </div>
    </div>

    @* Status filter chips - the click handler keys off .filter-btn + data-filter *@
    <div class="filter-panel mt-3">
        <div class="filter-quick pt-2">
            <span class="qlabel">@L["Status"]</span>
            <button type="button" class="qchip filter-btn active" data-filter="all">
                @L["All"] <span class="mono">@Model.Requests.Count</span>
            </button>
            <button type="button" class="qchip filter-btn" data-filter="pending">
                @L["Pending"] <span class="mono">@Model.Requests.Count(r => r.Status == "Pending")</span>
            </button>
            <button type="button" class="qchip filter-btn" data-filter="approved">
                @L["Approved"] <span class="mono">@Model.Requests.Count(r => r.Status == "Approved" || r.Status == "Executed")</span>
            </button>
            <button type="button" class="qchip filter-btn" data-filter="rejected">
                @L["Rejected"] <span class="mono">@Model.Requests.Count(r => r.Status == "Rejected")</span>
            </button>
            <button type="button" class="qchip filter-btn" data-filter="failed">
                @L["Failed"] <span class="mono">@Model.Requests.Count(r => r.Status == "Failed")</span>
            </button>
        </div>
    </div>

    <div class="card mb-4" id="myRequestsRegion">
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
            <span><i class="fas fa-list-check me-1"></i> @L["Your Approval Requests"]</span>
            <span class="text-muted mono">@Model.Requests.Count</span>
        </div>
        <div class="card-body">
            @if (Model.Requests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="myRequestsTable">
                        <thead>
                            <tr>
                                <th>@L["Date"]</th>
                                <th>@L["Type"]</th>
                                <th>@L["Entity"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Processed By"]</th>
                                <th>@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.Requests)
                            {
                                <tr data-status="@GetStatusFilter(request.Status)">
                                    <td class="num text-muted" data-order="@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")">@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @L[GetRequestTypeDisplay(request.RequestType)]
                                        </span>
                                    </td>
                                    <td>
                                        <div class="cell-text">
                                            <span class="cell-title">@L[request.EntityType]</span>
                                            @if (request.EntityId.HasValue)
                                            {
                                                <span class="cell-sub mono">#@request.EntityId</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @switch (request.Status)
                                        {
                                            case "Pending":
                                                <span class="state state-warn">@L["Pending"]</span>
                                                break;
                                            case "Approved":
                                            case "Executed":
                                                <span class="state state-ok">@L["Approved"]</span>
                                                break;
                                            case "Rejected":
                                                <span class="state state-crit">@L["Rejected"]</span>
                                                @if (!string.IsNullOrEmpty(request.RejectionReason))
                                                {
                                                    <br />

                                                    <small class="text-muted">@request.RejectionReason</small>
                                                }
                                                break;
                                            case "Failed":
                                                <span class="state state-crit">@L["Failed"]</span>
                                                @if (!string.IsNullOrEmpty(request.RejectionReason))
                                                {
                                                    <br />

                                                    <small class="text-muted">@L["Reason"]: @JsonStringLocalizer.TranslateMessage(request.RejectionReason)</small>
                                                }
                                                break;
                                            default:
                                                <span class="state state-idle">@L[request.Status]</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(request.ApprovedByName))
                                        {
                                            @request.ApprovedByName
                                            @if (request.ProcessedAt.HasValue)
                                            {
                                                <br />
                                                <small class="text-muted mono">@request.ProcessedAt.Value.ToString("dd.MM HH:mm")</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="d-empty">@L["Not processed"]</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="viewDetails(@request.Id)" title="@L["View details"]">
                                                <i class="fas fa-eye"></i> @L["Details"]
                                            </button>
                                            @if (request.Status == "Pending")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="cancelRequest(@request.Id)" title="@L["Cancel request"]">
                                                    <i class="fas fa-times"></i> @L["Cancel"]
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h5>@L["You have not submitted any requests"]</h5>
                    <p class="text-muted mb-0">@L["Actions that need an administrator's approval show up here with their status."]</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Request Details"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsContent">
                <partial name="_Skeleton" model="5" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            initRequestsTable();

            $('.filter-btn').click(function() {
                $('.filter-btn').removeClass('active');
                $(this).addClass('active');
                applyStatusFilter();
            });
        });

        // Runs on load and again after live-updates.js swaps in a fresh table.
        function initRequestsTable() {
            // the table is only rendered when the user has at least one request
            if ($('#myRequestsTable').length) {
                $('#myRequestsTable').DataTable({
                    order: [[0, 'desc']],
                    pageLength: 25
                });
            }
        }

        function applyStatusFilter() {
            const filter = $('.filter-btn.active').data('filter') || 'all';

            if (filter === 'all') {
                $('tr[data-status]').show();
            } else {
                $('tr[data-status]').hide();
                $(`tr[data-status="${filter}"]`).show();
            }

            if ($.fn.DataTable.isDataTable('#myRequestsTable')) $('#myRequestsTable').DataTable().draw();
        }

        // An admin approving or rejecting one of your requests updates its status here.
        LiveUpdates.watch({
            entities: ['approval'],
            regions: ['#myRequestsRegion'],
            beforeRefresh() {
                if ($.fn.DataTable.isDataTable('#myRequestsTable')) $('#myRequestsTable').DataTable().destroy();
            },
            afterRefresh() {
                initRequestsTable();
                applyStatusFilter();
            }
        });

        function viewDetails(requestId) {
            $('#detailsContent').html(skeletonHtml(5));
            $('#detailsModal').modal('show');

            $.get(`/MyRequests/Details/${requestId}`, function(data) {
                $('#detailsContent').html(data);
            }).fail(function() {
                $('#detailsContent').html(`<div class="alert alert-danger">${escapeHtml(t('Failed to load details'))}</div>`);
            });
        }

         function cancelRequest(requestId) {
            confirmAction({
                title: t('Cancel request'),
                message: t('Cancel this request? It will be withdrawn from the approval queue.'),
                okText: t('Cancel request'),
                danger: true
            }, function () {
                // Get the anti-forgery token from the page
                const token = $('input[name="__RequestVerificationToken"]').val();

                // Show loading state
                const $cancelButton = $(`button[onclick="cancelRequest(${requestId})"]`);
                const originalButtonText = $cancelButton.html();
                $cancelButton.prop('disabled', true)
                            .html(`<span class="spinner-border spinner-border-sm me-2"></span>${escapeHtml(t('Cancelling...'))}`);

                $.ajax({
                    url: `/MyRequests/Cancel/${requestId}`,
                    type: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    data: {
                        __RequestVerificationToken: token
                    },
                    success: function(response) {
                        // Be very explicit about what constitutes success
                        let isSuccess = false;
                        let message = t('Request cancelled successfully');

                        // Handle different response formats your server might return
                        if (typeof response === 'object' && response !== null) {
                            // Check for explicit success indicators
                            isSuccess = response.success === true ||
                                       response.isSuccess === true ||
                                       response.Success === true;

                            // Extract the message if available
                            if (response.message) message = response.message;
                            else if (response.Message) message = response.Message;
                        } else if (typeof response === 'string') {
                            // Sometimes servers return plain text success messages
                            isSuccess = true;
                            message = response;
                        } else {
                            // If we get here and the AJAX call reached 'success', assume it worked
                            isSuccess = true;
                        }

                        if (isSuccess) {
                            // Explicitly show success toast
                            showToast(message, 'success');

                            // Refresh the page after a brief delay to show the success message
                            setTimeout(function() {
                                window.location.reload();
                            }, 1500);
                        } else {
                            // Handle case where server returned success HTTP status but indicates failure in response
                            showToast(message || t('Failed to cancel request'), 'error');
                            $cancelButton.prop('disabled', false).html(originalButtonText);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Cancel request failed:', {
                            status: xhr.status,
                            responseText: xhr.responseText,
                            error: error
                        });

                        // Extract meaningful error message
                        let errorMessage = t('Failed to cancel request');

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || response.error || errorMessage;
                            } catch (e) {
                                if (xhr.responseText.length < 200 && !xhr.responseText.includes('<')) {
                                    errorMessage = xhr.responseText;
                                }
                            }
                        }

                        showToast(errorMessage, 'error');
                        $cancelButton.prop('disabled', false).html(originalButtonText);
                    }
                });
            });
        }
    </script>
}

@functions {
    string GetStatusFilter(string status)
    {
        return status switch
        {
            "Pending" => "pending",
            "Approved" => "approved",
            "Executed" => "approved",
            "Rejected" => "rejected",
            "Failed" => "failed",
            _ => "all"
        };
    }

    string GetRequestTypeDisplay(string requestType)
    {
        return requestType switch
        {
            "product.create" => "Create Product",
            "product.update" => "Update Product",
            "product.delete" => "Delete Product",
            "product.transfer" => "Transfer Product",
            "route.update" => "Update Route",
            "route.delete" => "Delete Route",
            _ => requestType
        };
    }
}
