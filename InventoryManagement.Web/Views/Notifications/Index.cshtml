@model NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
    const int Shown = 200;
    var items = Model.Notifications.OrderByDescending(n => n.CreatedAt).Take(Shown).ToList();
    var unread = items.Count(n => !n.IsRead);
    var types = items.Select(n => n.Type).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t).ToList();
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Notifications"]</h1>
            <div class="ip-sub ip-num" id="unreadSummary">@L["{0} unread", unread]</div>
        </div>
        <div class="ip-page-actions">
            <button type="button" class="ip-btn ip-btn-secondary" onclick="markAllAsRead()">
                <i class="fa-solid fa-check-double"></i><span>@L["Mark all as read"]</span>
            </button>
        </div>
    </div>

    <nav class="ip-tabs strong align-items-center" aria-label="@L["Notifications"]">
        <button type="button" class="ip-tab active" data-filter="all">@L["All"] <span class="count">@items.Count</span></button>
        <button type="button" class="ip-tab" data-filter="unread">@L["Unread"] <span class="count" id="unreadCount">@unread</span></button>
        @if (types.Count > 1)
        {
            <label class="ip-filter ms-auto">
                <span>@L["Type"]</span>
                <select id="typeFilter">
                    <option value="">@L["All"]</option>
                    @foreach (var type in types)
                    {
                        <option value="@type">@L[TypeLabel(type)]</option>
                    }
                </select>
            </label>
        }
    </nav>

    <div id="notificationsList">
        @if (items.Count == 0)
        {
            <div class="ip-empty">
                <span class="icon"><i class="fa-regular fa-bell-slash"></i></span>
                <div class="title">@L["No notifications found"]</div>
                <div class="text">@L["Approval requests, product and route updates will show up here."]</div>
            </div>
        }
        else
        {
            @foreach (var day in items.GroupBy(n => n.CreatedAt.Date))
            {
                <section class="ip-notif-day" data-day>
                    <div class="ip-day-head">@DayLabel(day.Key)</div>
                    @foreach (var notification in day)
                    {
                        var link = Link(notification);
                        <div class="ip-notif-item @(notification.IsRead ? "" : "unread")" role="button" tabindex="0"
                             data-id="@notification.Id" data-type="@notification.Type" data-read="@(notification.IsRead ? "read" : "unread")">
                            <span class="unread-dot" aria-hidden="true"></span>
                            <span class="ip-notif-icon" aria-hidden="true"><i class="fa-solid @TypeIcon(notification.Type)"></i></span>
                            <div class="flex-grow-1" style="min-width: 0">
                                <div class="d-flex justify-content-between align-items-baseline gap-3">
                                    <span class="title">@notification.Title</span>
                                    <span class="time ip-num" title="@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")">@notification.CreatedAt.ToString("HH:mm")</span>
                                </div>
                                <div class="text">@notification.Message</div>
                                @if (link != null)
                                {
                                    <a class="ip-notif-link" href="@link.Value.Url">@link.Value.Label</a>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
            <div class="ip-empty d-none" id="noMatch">
                <span class="icon"><i class="fa-regular fa-bell-slash"></i></span>
                <div class="title">@L["Nothing found"]</div>
                <div class="text">@L["No notifications match this filter."]</div>
            </div>
            @if (Model.Notifications.Count > Shown)
            {
                <p class="ip-faint mt-3">@L["The latest {0} are shown.", Shown]</p>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tabs (All / Unread) and the type select filter the list in place; a day heading hides
        // when none of its notifications is left. Clicking a notification marks it read (_Layout).
        let filter = 'all';

        function applyFilter() {
            const type = $('#typeFilter').val() || '';
            let shown = 0;
            document.querySelectorAll('#notificationsList [data-day]').forEach(function (day) {
                let any = false;
                day.querySelectorAll('.ip-notif-item').forEach(function (item) {
                    const visible = (filter !== 'unread' || item.classList.contains('unread'))
                        && (!type || item.dataset.type === type);
                    item.classList.toggle('d-none', !visible);
                    any = any || visible;
                    if (visible) shown++;
                });
                day.classList.toggle('d-none', !any);
            });
            $('#noMatch').toggleClass('d-none', shown > 0 || !document.querySelector('#notificationsList [data-day]'));
        }

        function updateUnread() {
            const count = document.querySelectorAll('#notificationsList .ip-notif-item.unread').length;
            $('#unreadCount').text(count);
            $('#unreadSummary').text(t('{0} unread', count));
        }

        $('.ip-tabs [data-filter]').on('click', function () {
            $('.ip-tabs [data-filter]').removeClass('active');
            $(this).addClass('active');
            filter = this.dataset.filter;
            applyFilter();
        });
        $('#typeFilter').on('change', applyFilter);

        // The layout's handler marks a clicked item read (removes .unread): keep the counts in step.
        new MutationObserver(updateUnread).observe(document.getElementById('notificationsList'),
            { subtree: true, attributes: true, attributeFilter: ['class'] });

        // Keyboard: Enter on a focused notification works like a click.
        $(document).on('keydown', '#notificationsList .ip-notif-item', function (e) {
            if (e.key === 'Enter' && e.target === this) this.click();
        });

        function markAllAsRead() {
            $.ajax({
                url: '/Notifications/MarkAllAsRead',
                type: 'POST',
                headers: AppConfig.antiforgeryHeaders(),
                success: function () {
                    $('#notificationsList .ip-notif-item').removeClass('unread').attr('data-read', 'read');
                    if (window.loadNotificationCount) loadNotificationCount();
                    applyFilter();
                    showToast(t('All notifications marked as read'), 'success');
                },
                error: function () {
                    showToast(t('Failed to mark all as read'), 'error');
                }
            });
        }
    </script>
}

@functions {
    string DayLabel(DateTime day)
    {
        var today = DateTime.Today;
        if (day == today) return L["Today"].Value;
        if (day == today.AddDays(-1)) return L["Yesterday"].Value;
        return day.ToString("dd.MM.yyyy");
    }

    // Where the notification points (its stored Data: approvalRequestId, routeId, productId).
    (string Url, string Label)? Link(NotificationDto notification)
    {
        if (string.IsNullOrWhiteSpace(notification.Data)) return null;
        try
        {
            var data = Newtonsoft.Json.Linq.JObject.Parse(notification.Data);
            int? Id(string name) => data.GetValue(name, StringComparison.OrdinalIgnoreCase)
                is Newtonsoft.Json.Linq.JValue { Type: Newtonsoft.Json.Linq.JTokenType.Integer } value ? (int)value : null;

            if (Id("approvalRequestId") is int requestId)
                return (((User.HasPermission("approval.view") || User.HasPermission("approval.decide")) && notification.Type == "ApprovalRequest" ? "/Approvals" : "/MyRequests") + "?open=" + requestId,
                        L["View request #{0}", requestId].Value);
            if (Id("routeId") is int routeId && User.HasPermission("route.view"))
                return ($"/Routes/Details/{routeId}", L["View route"].Value);
            // A deleted product is kept on the Deleted products page (else its audit trail).
            if (notification.Title == "Product Deleted" || notification.Title == L["Product Deleted"].Value)   // stored English, shown translated
            {
                if (Id("productId") is not int deletedId) return null;
                if (User.HasPermission("product.deleted.view"))
                    return ($"/Products/Deleted/{deletedId}", L["View deleted product"].Value);
                return User.HasPermission("audit.view")
                    ? ($"/Audit?entityType=Product&entityId={deletedId}", L["View in audit log"].Value)
                    : null;
            }
            if (Id("productId") is int productId && User.HasPermission("product.view"))
                return ($"/Products/Details/{productId}", L["View product"].Value);
        }
        catch (Newtonsoft.Json.JsonException) { }
        return null;
    }

    string TypeIcon(string type) => type switch
    {
        "ApprovalRequest" => "fa-clipboard-check",
        "ApprovalResponse" => "fa-circle-check",
        "RouteCompleted" => "fa-check-double",
        "TransferCompleted" => "fa-arrow-right-arrow-left",
        "ProductUpdate" => "fa-box",
        "RouteUpdate" => "fa-route",
        "System" => "fa-circle-info",
        _ => "fa-bell"
    };

    string TypeLabel(string type) => type switch
    {
        "ApprovalRequest" => "Approval Request",
        "ApprovalResponse" => "Approval Response",
        "RouteCompleted" => "Route Completed",
        "TransferCompleted" => "Transfer Completed",
        "ProductUpdate" => "Product Update",
        "RouteUpdate" => "Route Update",
        "System" => "System",
        _ => string.IsNullOrWhiteSpace(type) ? "Notification" : type
    };
}
