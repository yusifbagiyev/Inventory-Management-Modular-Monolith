@model NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
    var status = ViewBag.StatusFilter as string;
    var type = ViewBag.TypeFilter as string;
    var unreadTab = status == "unread";
    var items = Model.Notifications;
    // Tab links keep the type filter and go back to page 1
    string TabUrl(string? s) => Url.Action("Index", new { status = s, type = string.IsNullOrEmpty(type) ? null : type })!;
}

@* Paged on the server at 30 a page, and tabs, type and paging swap the list in place via ListNav *@
<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Notifications"]</h1>
            <div class="ip-sub ip-num" id="unreadSummary" data-unread="@Model.TotalUnreadCount">@L["{0} unread", Model.TotalUnreadCount]</div>
        </div>
        <div class="ip-page-actions ip-notif-head-actions">
            <button type="button" class="ip-btn ip-btn-secondary" onclick="markAllAsRead()">
                <i class="fa-solid fa-check-double"></i><span>@L["Mark all as read"]</span>
            </button>
        </div>
    </div>

    @* The type filter sits beside the tabs, not in them, so on phones it drops below their rule *@
    <div class="ip-notif-bar">
        <nav class="ip-tabs strong" aria-label="@L["Notifications"]" data-list-tabs>
            <a class="ip-tab @(unreadTab ? "" : "active")" href="@TabUrl(null)">@L["All"] <span class="count">@Model.AllCount</span></a>
            <a class="ip-tab @(unreadTab ? "active" : "")" href="@TabUrl("unread")">@L["Unread"] <span class="count" id="unreadCount">@Model.UnreadCount</span></a>
        </nav>
        @if (Model.Types.Count > 1)
        {
            <label class="ip-filter">
                <span>@L["Type"]</span>
                <select id="typeFilter">
                    <option value="">@L["All"]</option>
                    @foreach (var t in Model.Types)
                    {
                        <option value="@t" selected="@(t == type)">@L[TypeLabel(t)]</option>
                    }
                </select>
            </label>
        }
        <button type="button" class="ip-btn-icon lg ip-notif-markall" onclick="markAllAsRead()" aria-label="@L["Mark all as read"]" title="@L["Mark all as read"]">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i>
        </button>
    </div>

    <div id="notificationsList" data-list-region>
        @if (items.Count == 0)
        {
            <div class="ip-empty">
                @if (unreadTab && string.IsNullOrEmpty(type) && Model.AllCount > 0)
                {
                    @* Nothing unread gets its own message rather than the empty filter one *@
                    <span class="icon ok"><i class="fa-solid fa-check-double"></i></span>
                    <div class="title">@L["All notifications have been read"]</div>
                    <div class="text">@L["There are no unread notifications."]</div>
                }
                else if (unreadTab || !string.IsNullOrEmpty(type))
                {
                    <span class="icon"><i class="fa-regular fa-bell-slash"></i></span>
                    <div class="title">@L["Nothing found"]</div>
                    <div class="text">@L["No notifications match this filter."]</div>
                    <a class="ip-btn ip-btn-secondary" href="@Url.Action("Index")"><span>@L["Clear filters"]</span><i class="fa-solid fa-xmark"></i></a>
                }
                else
                {
                    <span class="icon"><i class="fa-regular fa-bell-slash"></i></span>
                    <div class="title">@L["No notifications found"]</div>
                    <div class="text">@L["Approval requests, product and route updates will show up here."]</div>
                }
            </div>
        }
        else
        {
            @foreach (var day in items.GroupBy(n => n.CreatedAt.Date))
            {
                <section class="ip-notif-day" data-day>
                    <div class="ip-day-head">@DayLabel(day.Key)</div>
                    @foreach (var notification in day)
                    {
                        var link = Link(notification);
                        @* A click anywhere marks the row as read; the dot is the keyboard's way to do it and goes once it is read *@
                        <div class="ip-notif-item @(notification.IsRead ? "" : "unread")"
                             data-id="@notification.Id" data-type="@notification.Type" data-read="@(notification.IsRead ? "read" : "unread")">
                            @if (notification.IsRead)
                            {
                                <span class="unread-dot" aria-hidden="true"></span>
                            }
                            else
                            {
                                <button type="button" class="unread-dot" aria-label="@L["Mark Read"]" title="@L["Mark Read"]"></button>
                            }
                            @{ var (icon, tone) = Icon(notification); }
                            <span class="ip-notif-icon @tone" aria-hidden="true"><i class="fa-solid @icon"></i></span>
                            <div class="flex-grow-1" style="min-width: 0">
                                <div class="d-flex justify-content-between align-items-baseline gap-3">
                                    <span class="title">@if (!notification.IsRead) {<span class="visually-hidden ip-notif-unread">@L["Unread notification"]: </span>}@notification.Title</span>
                                    <span class="time ip-num" title="@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")">@notification.CreatedAt.ToString("HH:mm")</span>
                                </div>
                                <div class="text">@notification.Message</div>
                                @if (link != null)
                                {
                                    <a class="ip-notif-link" href="@link.Value.Url">@link.Value.Label</a>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
            <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        }
    </div>
</div>

@section Scripts {
    <script>
        // Changing the type keeps the tab and goes back to page 1
        $(document).on('change', '#typeFilter', function () {
            const params = new URLSearchParams(window.location.search);
            if (this.value) params.set('type', this.value); else params.delete('type');
            params.delete('pageNumber');
            ListNav.go(window.location.pathname + '?' + params.toString());
        });

        // _Layout removes .unread when a notification is clicked, so count the unread numbers down here (the tab counts only the chosen type)
        function countDown(read) {
            const total = Math.max(0, (parseInt($('#unreadSummary').attr('data-unread'), 10) || 0) - read);
            $('#unreadSummary').attr('data-unread', total).text(t('{0} unread', total));
            $('#unreadCount').text(Math.max(0, (parseInt($('#unreadCount').text(), 10) || 0) - read));
        }
        new MutationObserver(function (mutations) {
            const read = mutations.filter(m => m.target.classList && m.target.classList.contains('ip-notif-item')
                && (m.oldValue || '').split(' ').includes('unread') && !m.target.classList.contains('unread')).length;
            if (read) countDown(read);
        }).observe(document.getElementById('notificationsList'),
            { subtree: true, attributes: true, attributeFilter: ['class'], attributeOldValue: true });

        // The dot hides once the row is read, so keyboard focus moves on to the row's link
        $(document).on('click', '#notificationsList button.unread-dot', function () {
            $(this).closest('.ip-notif-item').find('.ip-notif-link').trigger('focus');
        });

        // The filter is not swapped with the list, so it follows the URL after Clear filters and Back
        document.addEventListener('listnav:loaded', function () {
            const select = document.getElementById('typeFilter');
            if (select) select.value = new URLSearchParams(window.location.search).get('type') || '';
        });

        function markAllAsRead() {
            $.ajax({
                url: '/Notifications/MarkAllAsRead',
                type: 'POST',
                headers: AppConfig.antiforgeryHeaders(),
                success: function () {
                    if (window.loadNotificationCount) loadNotificationCount();
                    ListNav.reload();   // Refetches counts, tabs and the list
                    showToast(t('All notifications marked as read'), 'success');
                },
                error: function () {
                    showToast(t('Failed to mark all as read'), 'error');
                }
            });
        }
    </script>
}

@functions {
    string DayLabel(DateTime day)
    {
        var today = DateTime.Today;
        if (day == today) return L["Today"].Value;
        if (day == today.AddDays(-1)) return L["Yesterday"].Value;
        return day.ToString("dd.MM.yyyy");
    }

    // Builds the link from the ids stored in the notification's Data
    (string Url, string Label)? Link(NotificationDto notification)
    {
        if (string.IsNullOrWhiteSpace(notification.Data)) return null;
        try
        {
            var data = Newtonsoft.Json.Linq.JObject.Parse(notification.Data);
            int? Id(string name) => data.GetValue(name, StringComparison.OrdinalIgnoreCase)
                is Newtonsoft.Json.Linq.JValue { Type: Newtonsoft.Json.Linq.JTokenType.Integer } value ? (int)value : null;

            if (Id("approvalRequestId") is int requestId)
                return (((User.HasPermission("approval.view") || User.HasPermission("approval.decide")) && notification.Type == "ApprovalRequest" ? "/Approvals" : "/MyRequests") + "?open=" + requestId,
                        L["View request #{0}", requestId].Value);
            if (Id("routeId") is int routeId && User.HasPermission("route.view"))
                return ($"/Routes/Details/{routeId}", L["View route"].Value);
            // A deleted product links to the Deleted products page, or to the audit log without that permission
            if (notification.Title == "Product Deleted" || notification.Title == L["Product Deleted"].Value)   // Stored in English, shown translated
            {
                if (Id("productId") is not int deletedId) return null;
                if (User.HasPermission("product.deleted.view"))
                    return ($"/Products/Deleted/{deletedId}", L["View deleted product"].Value);
                return User.HasPermission("audit.view")
                    ? ($"/Audit?entityType=Product&entityId={deletedId}", L["View in audit log"].Value)
                    : null;
            }
            if (Id("productId") is int productId && User.HasPermission("product.view"))
                return ($"/Products/Details/{productId}", L["View product"].Value);
        }
        catch (Newtonsoft.Json.JsonException) { }
        return null;
    }

    // Same mapping as createNotificationItem in _Layout, where only approval answers use status colours
    (string Icon, string Tone) Icon(NotificationDto notification)
    {
        string? status = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(notification.Data))
                status = Newtonsoft.Json.Linq.JObject.Parse(notification.Data)
                    .GetValue("status", StringComparison.OrdinalIgnoreCase)?.ToString();
        }
        catch (Newtonsoft.Json.JsonException) { }

        return notification.Type switch
        {
            "ApprovalRequest" => ("fa-clipboard-list", ""),
            "ApprovalResponse" => status switch
            {
                "Approved" => ("fa-circle-check", "ok"),
                "Rejected" => ("fa-circle-xmark", "bad"),
                "Failed" => ("fa-triangle-exclamation", "bad"),
                _ => ("fa-reply", "")
            },
            "RouteUpdate" or "RouteCompleted" or "TransferCompleted" => ("fa-right-left", ""),
            "ProductUpdate" when notification.Title == "Product Deleted" || notification.Title == L["Product Deleted"].Value => ("fa-trash-can", ""),
            "ProductUpdate" => ("fa-box", ""),
            _ => ("fa-bell", "")
        };
    }

    string TypeLabel(string type) => type switch
    {
        "ApprovalRequest" => "Approval Request",
        "ApprovalResponse" => "Approval Response",
        "RouteCompleted" => "Route Completed",
        "TransferCompleted" => "Transfer Completed",
        "ProductUpdate" => "Product Update",
        "RouteUpdate" => "Route Update",
        "System" => "System",
        _ => string.IsNullOrWhiteSpace(type) ? "Notification" : type
    };
}
