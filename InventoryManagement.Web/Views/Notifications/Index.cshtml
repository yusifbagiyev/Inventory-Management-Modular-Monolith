@model NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Notifications"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary btn-sm" onclick="markAllAsRead()">
                <i class="fas fa-check-double"></i> @L["Mark All Read"]
            </button>
        </div>
    </div>

    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="searchFilter" placeholder="@L["Search in notifications..."]">
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="applyFilters()">
                <i class="fas fa-filter"></i> @L["Apply Filters"]
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                <i class="fas fa-redo"></i> @L["Reset Filters"]
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="statusFilter">@L["Status"]</label>
                <select class="form-select form-select-sm" id="statusFilter" onchange="applyFilters()">
                    <option value="">@L["All Notifications"]</option>
                    <option value="unread">@L["Unread Only"]</option>
                    <option value="read">@L["Read Only"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="typeFilter">@L["Type"]</label>
                <select class="form-select form-select-sm" id="typeFilter" onchange="applyFilters()">
                    <option value="">@L["All Types"]</option>
                    <option value="ApprovalRequest">@L["Approval Requests"]</option>
                    <option value="ApprovalResponse">@L["Approval Responses"]</option>
                    <option value="ProductUpdate">@L["Product Updates"]</option>
                    <option value="RouteUpdate">@L["Route Updates"]</option>
                    <option value="System">@L["System Messages"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="dateRangeFilter">@L["Date Range"]</label>
                <input type="text" class="form-control form-control-sm" id="dateRangeFilter" placeholder="@L["Select date range"]">
            </div>
        </div>
    </div>

    <div class="result-bar">
        <span>@L["Notifications shown"]: <b><span id="visibleCount">0</span></b> / <b><span id="totalCount">@Model.Notifications.Count</span></b></span>
        @if (Model.Notifications.Any())
        {
            <span class="text-muted">@L["Scroll the list to load more"]</span>
        }
    </div>

    <div class="card mb-4">
        <div class="card-body p-0">
            @if (Model.Notifications.Any())
            {
                @* Fixed-height scroller: the infinite-scroll handler binds to this element's scroll event. *@
                <div id="notificationsList" style="height: 600px; overflow-y: auto;">
                    <div id="notificationsContent">
                        @foreach (var notification in Model.Notifications.Take(50)) // Initial load of 50 items
                        {
                            <div class="notification-item @(notification.IsRead ? "" : "unread")"
                                 data-id="@notification.Id"
                                 data-type="@notification.Type"
                                 data-date="@notification.CreatedAt.ToString("yyyy-MM-dd")"
                                 data-read="@(notification.IsRead ? "read" : "unread")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                            <span class="state state-flat @TypeState(notification.Type)">
                                                <i class="fas @TypeIcon(notification.Type)"></i> @L[TypeLabel(notification.Type)]
                                            </span>
                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-primary">@L["New"]</span>
                                            }
                                        </div>
                                        <div class="fw-semibold">@notification.Title</div>
                                        <div class="text-muted">@notification.Message</div>
                                        <small class="mono text-muted">
                                            <i class="fas fa-clock me-1"></i>@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div class="flex-shrink-0">
                                        @if (!notification.IsRead)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" onclick="markAsRead(@notification.Id)">
                                                <i class="fas fa-check"></i> @L["Mark Read"]
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div id="loadMoreTrigger" class="text-center py-3 d-none">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">@L["Loading more..."]</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-bell-slash"></i>
                    <h5>@L["No notifications found"]</h5>
                    <p class="text-muted mb-0">@L["Approval requests, product and route updates will show up here."]</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>

    <script>
        let currentPage = 1;
        let itemsPerPage = 50;
        let isLoading = false;
        let allNotifications = [];
        // null = no filter active. An empty array is a filter that matched nothing - the old code
        // used [] for both, so a no-match filter fell back to "everything" and Clear emptied the list.
        let filteredNotifications = null;

        // Only this page's list: the header bell's dropdown uses the same .notification-item class.
        const PAGE_ITEMS = '#notificationsContent .notification-item';

        function currentItems() {
            return filteredNotifications === null ? allNotifications : filteredNotifications;
        }

        $(document).ready(function() {
            // Date range filter (client-side, like the others)
            DateRange.attach('#dateRangeFilter', { onApply: applyFilters, onClear: applyFilters });

            // Store all notifications for client-side filtering
            allNotifications = $(PAGE_ITEMS).toArray();
            updateCounts();

            // Implement infinite scrolling
            $('#notificationsList').on('scroll', function() {
                if ($(this).scrollTop() + $(this).innerHeight() >= $(this)[0].scrollHeight - 100) {
                    loadMoreNotifications();
                }
            });

            // Real-time search
            $('#searchFilter').on('input', function() {
                applyFilters();
            });
        });

        function applyFilters() {
            const status = $('#statusFilter').val();
            const type = $('#typeFilter').val();
            const dateRange = $('#dateRangeFilter').val();
            const searchTerm = $('#searchFilter').val().toLowerCase();

            if (!status && !type && !DateRange.parse(dateRange) && !searchTerm) {
                filteredNotifications = null;
                displayFilteredNotifications();
                return;
            }

            filteredNotifications = allNotifications.filter(function(item) {
                const $item = $(item);
                let show = true;

                // Status filter
                if (status && $item.data('read') !== status) {
                    show = false;
                }

                // Type filter
                if (type && $item.data('type') !== type) {
                    show = false;
                }

                // Date range filter
                // data-date is yyyy-MM-dd; both ends of the range are inclusive.
                const range = DateRange.parse(dateRange);
                if (range) {
                    const itemDate = DateRange.fromIso(String($item.data('date')));
                    if (!itemDate || itemDate < range.start || itemDate > range.end) {
                        show = false;
                    }
                }

                // Search filter
                if (searchTerm && !$item.text().toLowerCase().includes(searchTerm)) {
                    show = false;
                }

                return show;
            });

            displayFilteredNotifications();
        }

        function displayFilteredNotifications() {
            $('#notificationsContent').empty();

            const itemsToShow = currentItems().slice(0, itemsPerPage);
            itemsToShow.forEach(item => {
                $('#notificationsContent').append(item);
            });

            updateCounts();
            currentPage = 1;
        }

        function loadMoreNotifications() {
            if (isLoading) return;

            const totalItems = currentItems().length;
            const startIndex = currentPage * itemsPerPage;

            if (startIndex >= totalItems) return;

            isLoading = true;
            $('#loadMoreTrigger').removeClass('d-none');

            setTimeout(() => {
                const items = currentItems();
                const endIndex = Math.min(startIndex + itemsPerPage, items.length);

                for (let i = startIndex; i < endIndex; i++) {
                    $('#notificationsContent').append(items[i]);
                }

                currentPage++;
                isLoading = false;
                $('#loadMoreTrigger').addClass('d-none');
                updateCounts();
            }, 500);
        }

        function updateCounts() {
            const visibleCount = $(PAGE_ITEMS).length;
            const totalCount = currentItems().length;

            $('#visibleCount').text(visibleCount);
            $('#totalCount').text(totalCount);
        }

        function markAsRead(notificationId) {
            $.ajax({
                url: '/Notifications/MarkAsRead',
                type: 'POST',
                data: JSON.stringify(notificationId),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function() {
                    const $item = $(`.notification-item[data-id="${notificationId}"]`);
                    $item.removeClass('unread').attr('data-read', 'read');
                    $item.find('.btn-outline-primary').remove();
                    $item.find('.badge.bg-primary').remove();
                    showToast(t('Notification marked as read'), 'success');
                },
                error: function() {
                    showToast(t('Failed to mark notification as read'), 'error');
                }
            });
        }

        function markAllAsRead() {
            confirmAction({
                title: t('Mark all as read'),
                message: t('Mark every notification as read?'),
                okText: t('Mark all read')
            }, function () {
                $.ajax({
                    url: '/Notifications/MarkAllAsRead',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    success: function() {
                        $('.notification-item').removeClass('unread').attr('data-read', 'read');
                        $('.notification-item .btn-outline-primary').remove();
                        $('.notification-item .badge.bg-primary').remove();
                        showToast(t('All notifications marked as read'), 'success');
                    },
                    error: function() {
                        showToast(t('Failed to mark all as read'), 'error');
                    }
                });
            });
        }

        function clearFilters() {
            $('#statusFilter').val('');
            $('#typeFilter').val('');
            DateRange.clear('#dateRangeFilter');
            $('#searchFilter').val('');
            filteredNotifications = null;
            displayFilteredNotifications();
        }
    </script>
}

@functions {
    string TypeState(string type)
    {
        return type switch
        {
            "ApprovalRequest" => "state-warn",
            "ApprovalResponse" => "state-ok",
            "RouteCompleted" => "state-ok",
            "TransferCompleted" => "state-ok",
            "ProductUpdate" => "state-info",
            "RouteUpdate" => "state-new",
            "System" => "state-idle",
            _ => "state-idle"
        };
    }

    string TypeIcon(string type)
    {
        return type switch
        {
            "ApprovalRequest" => "fa-clock",
            "ApprovalResponse" => "fa-check-circle",
            "RouteCompleted" => "fa-check-double",
            "TransferCompleted" => "fa-exchange-alt",
            "ProductUpdate" => "fa-box",
            "RouteUpdate" => "fa-route",
            "System" => "fa-info-circle",
            _ => "fa-bell"
        };
    }

    string TypeLabel(string type)
    {
        return type switch
        {
            "ApprovalRequest" => "Approval Request",
            "ApprovalResponse" => "Approval Response",
            "RouteCompleted" => "Route Completed",
            "TransferCompleted" => "Transfer Completed",
            "ProductUpdate" => "Product Update",
            "RouteUpdate" => "Route Update",
            "System" => "System",
            _ => string.IsNullOrWhiteSpace(type) ? "Notification" : type
        };
    }
}
