@using AuditService.Queries
@model AuditLogPage
@{
    ViewData["Title"] = "Audit log";
    var facets = ViewBag.Facets as AuditFacets ?? new AuditFacets(Array.Empty<AuditUserOption>(), Array.Empty<string>());
    var query = Context.Request.Query;
    string? Q(string key) => string.IsNullOrWhiteSpace(query[key]) ? null : query[key].ToString();
    // Any query value besides paging is a filter or sort the reset button undoes
    var hasFilters = query.Keys.Any(k => k is not ("pageNumber" or "pageSize"));
    // The bar shows a single choice, so several from a header leave it on All
    string? Single(string key) => query[key].Count == 1 ? Q(key) : null;

    // These return English text keys that are translated through L
    string TypeLabel(string type) => type switch
    {
        "InventoryRoute" => "Route",
        "ApprovalRequest" => "Approval request",
        "UserPermission" => "User permission",
        "IdentityUserRole" => "User role",
        "RolePermission" => "Role permission",
        _ => type
    };
    string OperationLabel(string op) => op switch
    {
        "SignedIn" => "Signed in",
        "SignInFailed" => "Sign-in failed",
        "SignedOut" => "Signed out",
        _ => op
    };
    var CanViewRequests = User.HasPermission("approval.view") || User.HasPermission("approval.decide");
    // Links to the record's page, and for a deletion only to a product's kept page since other records are gone
    string? RecordUrl(AuditEntryDto e)
    {
        if (!int.TryParse(e.EntityId, out var id)) return null;
        if (e.Operation == "Deleted")
        {
            var kept = e.EntityType == "Product" && e.Changes.Any(c => c.Field == "IsDeleted" && c.New == "true");
            return kept && User.HasPermission("product.deleted.view") ? $"/Products/Deleted?id={id}" : null;
        }
        return e.EntityType switch
        {
            "Product" when User.HasPermission("product.view") => $"/Products/Details/{id}",
            "InventoryRoute" when User.HasPermission("route.view") => $"/Routes/Details/{id}",
            "Category" when User.HasPermission("category.view") => $"/Categories/Details/{id}",
            "Department" when User.HasPermission("department.view") => $"/Departments/Details/{id}",
            "User" when User.HasPermission("user.view") => $"/UserManagement/Details/{id}",
            "ApprovalRequest" when CanViewRequests => $"/Approvals?open={id}",
            _ => null
        };
    }
    string OperationBadge(string op) => op switch
    {
        "Created" or "SignedIn" => "ip-badge-success",
        "Deleted" or "SignInFailed" => "ip-badge-danger",
        "Updated" => "ip-badge-info",
        _ => "ip-badge-neutral"
    };
    // Turns request types, booleans and status words into translated text
    string Shown(string field, string? value)
    {
        if (value == null || value.StartsWith("01.01.0001")) return "—";   // Older rows stored unset dates as 01.01.0001
        if (AuditLabels.IsRequestType(value)) return L[AuditLabels.RequestType(value)].Value;
        if (value is "true" or "false") return L[value == "true" ? "Yes" : "No"].Value;
        // Lists are stored as JSON, specifications are joined with semicolons and other lists with commas
        if (ListItems(value, out var cut) is { } items)
        {
            if (items.Count == 0) return "—";
            var text = string.Join(items.All(i => i is Newtonsoft.Json.Linq.JObject) ? "; " : ", ", items.Select(i => i is Newtonsoft.Json.Linq.JObject o
                ? $"{o.GetValue("Name", StringComparison.OrdinalIgnoreCase)}: {o.GetValue("Value", StringComparison.OrdinalIgnoreCase)}".TrimEnd(' ', ':')
                : i.ToString()));
            return cut ? text + " …" : text;
        }
        if (field == "EntityType") return L[TypeLabel(value)].Value;
        if (value == "(changed)") return L["(changed)"].Value;
        // Notes and the words modules store for a missing value are English in the database
        if (field.EndsWith("Notes")) return JsonStringLocalizer.TranslateMessage(value);
        if (field.EndsWith("Model") || field.EndsWith("Vendor")) return StoredPlaceholders.Name(value);
        if (field.EndsWith("Worker")) return StoredPlaceholders.Worker(value);
        if (field.EndsWith("DepartmentName") && value == StoredPlaceholders.Removed) return JsonStringLocalizer.TranslateMessage(value);
        return field.EndsWith("Status") || field.EndsWith("RouteType") || field == "Reason" ? L[value].Value : value;
    }
    // Older rows hold long lists cut off mid-item with an ellipsis, so only their complete items are read
    static Newtonsoft.Json.Linq.JArray? ListItems(string value, out bool cut)
    {
        cut = false;
        if (!value.StartsWith('[')) return null;
        if (value.EndsWith(']'))
        {
            try { return Newtonsoft.Json.Linq.JArray.Parse(value); }
            catch (Newtonsoft.Json.JsonException) { return null; }
        }
        if (!value.EndsWith('…') || !(value.StartsWith("[\"") || value.StartsWith("[{"))) return null;
        // The list is closed after each comma from the end until what is left is whole
        for (var end = value.LastIndexOf(','); end > 0; end = value.LastIndexOf(',', end - 1))
        {
            try
            {
                var items = Newtonsoft.Json.Linq.JArray.Parse(value[..end] + "]");
                cut = true;
                return items;
            }
            catch (Newtonsoft.Json.JsonException) { }
        }
        return null;
    }
    var userOptions = Json.Serialize(facets.Users.Where(u => u.UserId.HasValue).Select(u => new { value = u.UserId.ToString(), label = u.UserName })).ToString();
    var typeOptions = Json.Serialize(facets.EntityTypes.Select(t => new { value = t, label = L[TypeLabel(t)].Value })).ToString();
    var departmentNames = ViewBag.DepartmentNames as Dictionary<int, string> ?? new();
    var categoryNames = ViewBag.CategoryNames as Dictionary<int, string> ?? new();
    string? IdName(string field, string? value)
    {
        if (!int.TryParse(value, out var id)) return null;
        if (field.EndsWith("DepartmentId")) return departmentNames.TryGetValue(id, out var d) ? d : null;
        if (field.EndsWith("CategoryId")) return categoryNames.TryGetValue(id, out var c) ? c : null;
        return null;
    }
    static bool IsEmpty(string? value) => string.IsNullOrWhiteSpace(value) || value == "[]" || value.StartsWith("01.01.0001");
    static bool IsImageField(string field) => field.EndsWith("ImageUrl") || field.EndsWith("ImageUrls");
    // Null when the value is neither one address nor a readable list, so it is shown as text
    static List<string>? ImageUrls(string? value, out bool cut)
    {
        cut = false;
        if (string.IsNullOrWhiteSpace(value)) return new List<string>();
        if (!value.StartsWith('[')) return new List<string> { value };
        return ListItems(value, out cut)?.Select(v => v.ToString()).Where(v => v.Length > 0).ToList();
    }

    // Permission codes read as the permission editor names them, with the level for two-level actions
    var permissionNames = new Dictionary<string, string>();
    foreach (var item in PermissionCatalog.Areas.SelectMany(a => a.Items))
    {
        permissionNames[item.Permission] = item.Direct == null ? L[item.Label].Value : $"{L[item.Label]} ({L["With approval"]})";
        if (item.Direct != null) permissionNames[item.Direct] = $"{L[item.Label]} ({L["Direct"]})";
    }
    string LabelText(AuditEntryDto entry) => string.Join(" · ", entry.Label!.Split(" · ").Select(p =>
        entry.EntityType is "UserPermission" or "RolePermission" && permissionNames.TryGetValue(p, out var name) ? name
        : AuditLabels.IsRequestType(p) ? L[AuditLabels.RequestType(p)].Value : p));

    // Splits the last part of a field path into words, which also serves as the text key
    string FieldLabel(string field)
    {
        var name = field.Contains('.') ? field[(field.LastIndexOf('.') + 1)..] : field;
        // Department and category ids are shown by name, so drop the Id suffix
        if (name.EndsWith("DepartmentId") || name.EndsWith("CategoryId")) name = name[..^2];
        return System.Text.RegularExpressions.Regex.Replace(name, "(?<=[a-z])(?=[A-Z])", " ");
    }
}

@{
    // Images render as thumbnails and department or category ids as names
    void RenderValue(string field, string? value, string? entityId)
    {
        if (IsImageField(field) && value != null && !value.StartsWith("01.01.0001") && ImageUrls(value, out var cut) is { } urls)
        {
            if (urls.Count == 0) { <text>—</text> return; }
            <span class="ip-audit-thumbs">
                @foreach (var url in urls)
                {
                    <a href="@url" target="_blank" rel="noopener" title="@url"><img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(url)" alt="" loading="lazy" data-fallback /></a>
                }
                @if (cut)
                {
                    <span class="ip-faint align-self-center">…</span>
                }
            </span>
            return;
        }
        // The stored request is machine data with photos, so it links to the request
        if (field.EndsWith("ActionData") && int.TryParse(entityId, out var requestId))
        {
            <a href="/Approvals?open=@requestId">@L["View request #{0}", requestId]</a>
            return;
        }
        var name = IdName(field, value);
        if (name != null) { <span title="#@value">@name</span> return; }
        <text>@Shown(field, value)</text>
    }
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Audit log"]</h1>
            <div class="ip-sub ip-num">@L.Plural(Model.TotalCount, "{0} action", "{0} actions")</div>
        </div>
    </div>

    @* The same filters as the column headers, for phones where the headers are hidden; each change keeps the others *@
    <div class="ip-filterbar" id="auditFilters">
        <label class="ip-filter search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" value="@Q("search")" autocomplete="off"
                   placeholder="@L["Search record, user, value..."]" aria-label="@L["Search"]" />
        </label>
        <label class="ip-filter">
            <span>@L["User"]</span>
            <select id="userFilter">
                <option value="">@L["All"]</option>
                @foreach (var user in facets.Users.Where(u => u.UserId.HasValue))
                {
                    <option value="@user.UserId" selected="@(Single("userId") == user.UserId.ToString())">@user.UserName</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Record"]</span>
            <select id="typeFilter">
                <option value="">@L["All"]</option>
                @foreach (var type in facets.EntityTypes)
                {
                    <option value="@type" selected="@(Single("entityType") == type)">@L[TypeLabel(type)]</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <span>@L["Operation"]</span>
            <select id="operationFilter">
                <option value="">@L["All"]</option>
                @foreach (var op in new[] { "Created", "Updated", "Deleted", "SignedIn", "SignInFailed", "SignedOut" })
                {
                    <option value="@op" selected="@(Single("operation") == op)">@L[OperationLabel(op)]</option>
                }
            </select>
        </label>
        <label class="ip-filter">
            <i class="fa-regular fa-calendar"></i>
            <input type="text" id="dateRange" class="date-range-input" placeholder="@L["Any date"]" size="12" aria-label="@L["Date"]" />
        </label>
        @if (hasFilters)
        {
            <a href="@Url.Action("Index")" class="ip-btn ip-btn-ghost">
                <span>@L["Reset"]</span><i class="fa-solid fa-xmark"></i>
            </a>
        }
    </div>

    <div data-list-region>
        <div class="ip-table-wrap">
                <table class="ip-table ip-audit-table">
                    <thead>
                        <tr>
                            <th class="when" data-sort="when" data-sort-first="desc" data-filter="date" data-param-from="startDate" data-param-to="endDate">@L["When"]</th>
                            <th class="who" data-sort="user" data-filter="list" data-param="userId" data-options="@userOptions">@L["User"]</th>
                            <th data-sort="action" data-filter="list" data-param="entityType" data-options="@typeOptions">@L["What"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var action in Model.Items)
                        {
                            <tr>
                                <td class="ip-num text-nowrap">
                                    @action.At.ToString("dd.MM.yyyy")
                                    <div class="sub">@action.At.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    <div class="cell-title">@(action.UserName ?? L["System"].Value)</div>
                                    @if (!string.IsNullOrEmpty(action.IpAddress))
                                    {
                                        <div class="cell-sub ip-mono">@action.IpAddress</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold mb-1" title="@action.Action">@L[AuditLabels.Action(action.Action)]</div>
                                    @foreach (var entry in action.Entries)
                                    {
                                        <div class="ip-audit-entry">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <span class="ip-badge @OperationBadge(entry.Operation)">@L[OperationLabel(entry.Operation)]</span>
                                                <span class="fw-medium">@L[TypeLabel(entry.EntityType)]</span>
                                                @if (!string.IsNullOrEmpty(entry.Label))
                                                {
                                                    var url = RecordUrl(entry);
                                                    if (url != null)
                                                    {
                                                        <a href="@url">@LabelText(entry)</a>
                                                    }
                                                    else
                                                    {
                                                        <span>@LabelText(entry)</span>
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(entry.EntityId) && entry.EntityType != "Session")
                                                {
                                                    <span class="ip-faint ip-mono">#@entry.EntityId</span>
                                                }
                                            </div>
                                            @{
                                                // Hide fields that repeat another one, like ImageUrl next to ImageUrls or an id next to its name
                                                var shownChanges = entry.Changes.Where(c => !(c.Field.EndsWith("ImageUrl") && entry.Changes.Any(o => o.Field == c.Field + "s"))
                                                    && !((c.Field.EndsWith("ById") || c.Field.EndsWith("DepartmentId") || c.Field.EndsWith("CategoryId")) && entry.Changes.Any(o => o.Field == c.Field[..^2] + "Name"))
                                                    // A request's stored data is opened on the Approvals page instead
                                                    && !(c.Field.EndsWith("ActionData") && (!CanViewRequests || !int.TryParse(entry.EntityId, out _)))).ToList();
                                            }
                                            @if (shownChanges.Count > 0)
                                            {
                                                <details class="ip-audit-changes" open="@(entry.Operation is "Updated" or "SignInFailed" && shownChanges.Count <= 6)">
                                                    <summary class="ip-faint">@L["{0} fields", shownChanges.Count]</summary>
                                                    <dl>
                                                        @foreach (var change in shownChanges)
                                                        {
                                                            <div>
                                                                <dt title="@change.Field">@L[FieldLabel(change.Field)]</dt>
                                                                <dd>
                                                                    @if (entry.Operation == "Updated")
                                                                    {
                                                                        @* Empty values are spelled out instead of shown as a dash *@
                                                                        if (IsEmpty(change.Old))
                                                                        {
                                                                            <span class="ip-empty-value">@L["Not set"]</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="old">@{ RenderValue(change.Field, change.Old, entry.EntityId); }</span>
                                                                        }
                                                                        <i class="fa-solid fa-arrow-right ip-faint mx-1" aria-hidden="true"></i>
                                                                        if (IsEmpty(change.New))
                                                                        {
                                                                            <span class="ip-removed-value">@L["Removed"]</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="new">@{ RenderValue(change.Field, change.New, entry.EntityId); }</span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>@{ RenderValue(change.Field, change.New ?? change.Old, entry.EntityId); }</span>
                                                                    }
                                                                </dd>
                                                            </div>
                                                        }
                                                    </dl>
                                                </details>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        @* The headers stay when nothing matches, so their filters can be changed *@
                        @if (!Model.Items.Any())
                        {
                            <tr class="ip-empty-row">
                                @* The phone layout makes this row a flex box, so the cell is told to take the full width *@
                                <td class="empty" colspan="3" style="flex: 1 1 100%">
                                    <div class="ip-empty">
                                        <span class="icon"><i class="fa-solid fa-clipboard-list"></i></span>
                                        <div class="title">@L["Nothing found"]</div>
                                        @if (hasFilters)
                                        {
                                            <div class="text">@L["No actions match these filters"]</div>
                                            <a href="@Url.Action("Index")" class="ip-btn ip-btn-secondary">
                                                <span>@L["Reset filters"]</span><i class="fa-solid fa-xmark"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/air-datepicker/air-datepicker.css" asp-append-version="true" />
    <script src="~/lib/air-datepicker/air-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script>
        (function () {
            // The selects write the same query values as the column headers and keep every other filter
            TableColumns.bindBar({ fields: { '#userFilter': 'userId', '#typeFilter': 'entityType', '#operationFilter': 'operation' } });

            function go(changes) {
                const url = new URL(window.location.href);
                Object.entries(changes).forEach(function ([key, value]) {
                    if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
                });
                url.searchParams.delete('pageNumber');
                ListNav.go(url.pathname + url.search);
            }

            DateRange.attach('#dateRange', {
                position: 'bottom right',
                onApply: function (from, to) { go({ startDate: DateRange.iso(from), endDate: DateRange.iso(to) }); },
                onClear: function () {
                    if (new URLSearchParams(window.location.search).get('startDate')) go({ startDate: '', endDate: '' });
                }
            });

            // The bar is not swapped with the list, so it follows the URL after header filters and Back
            function sync() {
                const p = new URLSearchParams(window.location.search);
                const search = document.getElementById('searchInput');
                if (document.activeElement !== search) search.value = p.get('search') || '';
                if (p.get('startDate') && p.get('endDate'))
                    DateRange.set('#dateRange', DateRange.fromIso(p.get('startDate')), DateRange.fromIso(p.get('endDate')));
                else
                    DateRange.clear('#dateRange');
            }
            document.addEventListener('listnav:loaded', sync);
            window.addEventListener('popstate', sync);
            sync();
        })();
    </script>
}
