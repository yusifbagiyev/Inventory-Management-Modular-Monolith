@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L["Users"]</a></li>
                <li class="breadcrumb-item active">@L["New User"]</li>
            </ol>
            <h1>@L["Create New User"]</h1>
        </div>
    </div>

    <form asp-action="Create" method="post" class="ip-form" id="createUserForm">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Account"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label asp-for="FirstName" class="ip-label"><span>@L["First Name"]</span> <span class="req">*</span></label>
                    <input asp-for="FirstName" class="ip-input" placeholder="@L["Enter first name"]" />
                    <span asp-validation-for="FirstName" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="LastName" class="ip-label"><span>@L["Last Name"]</span> <span class="req">*</span></label>
                    <input asp-for="LastName" class="ip-input" placeholder="@L["Enter last name"]" />
                    <span asp-validation-for="LastName" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="Username" class="ip-label"><span>@L["Username"]</span> <span class="req">*</span></label>
                    <input asp-for="Username" class="ip-input" placeholder="@L["Enter username"]" autocomplete="off" />
                    <span asp-validation-for="Username" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="Email" class="ip-label"><span>@L["Email"]</span> <span class="req">*</span></label>
                    <input asp-for="Email" class="ip-input" placeholder="@L["Enter email address"]" />
                    <span asp-validation-for="Email" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Password"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label asp-for="Password" class="ip-label"><span>@L["Password"]</span> <span class="req">*</span></label>
                    <div class="position-relative">
                        <input asp-for="Password" class="ip-input pe-5" type="password" placeholder="@L["Enter password"]" autocomplete="new-password" />
                        <button type="button" class="ip-btn-icon position-absolute top-50 end-0 translate-middle-y me-1"
                                onclick="togglePassword('Password')" title="@L["Show password"]" aria-label="@L["Show password"]">
                            <i class="fa-regular fa-eye" id="Password-icon"></i>
                        </button>
                    </div>
                    <span class="ip-hint">@L[SharedServices.Identity.PasswordRules.LengthMessage]</span>
                    <span asp-validation-for="Password" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="ConfirmPassword" class="ip-label"><span>@L["Confirm Password"]</span> <span class="req">*</span></label>
                    <div class="position-relative">
                        <input asp-for="ConfirmPassword" class="ip-input pe-5" type="password" placeholder="@L["Confirm password"]" autocomplete="new-password" />
                        <button type="button" class="ip-btn-icon position-absolute top-50 end-0 translate-middle-y me-1"
                                onclick="togglePassword('ConfirmPassword')" title="@L["Show password"]" aria-label="@L["Show password"]">
                            <i class="fa-regular fa-eye" id="ConfirmPassword-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Access"]</h2>
            <div class="ip-form-grid">
                @* Only Admins pick the role, anyone else creates a User *@
                @if (User.IsInRole("Admin"))
                {
                <div class="ip-field">
                    <label asp-for="SelectedRole" class="ip-label"><span>@L["Role"]</span> <span class="req">*</span></label>
                    <select asp-for="SelectedRole" class="ip-select">
                        <option value="User" selected>@L["User"]</option>
                        <option value="Admin">@L["Admin"]</option>
                    </select>
                    <span class="ip-hint">@L["A User sees only what you grant on the Edit page after creating the account."]</span>
                    <span asp-validation-for="SelectedRole" class="ip-error"></span>
                </div>
                }
                else
                {
                    <input type="hidden" asp-for="SelectedRole" value="User" />
                }
            </div>
            <div class="ip-switch-list mt-3">
                <label class="ip-switch-row">
                    <span><span class="d-block fw-medium">@L["Active User"]</span><span class="ip-hint">@L["Inactive users cannot login to the system."]</span></span>
                    <input asp-for="IsActive" type="checkbox" role="switch" class="ip-switch" />
                </label>
            </div>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a href="@Url.Action("Index")" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Create User"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function togglePassword(fieldId) {
            const passwordField = document.getElementById(fieldId);
            const icon = document.getElementById(fieldId + '-icon');
            const button = icon.closest('button');
            const show = passwordField.type === 'password';

            passwordField.type = show ? 'text' : 'password';
            icon.classList.toggle('fa-eye', !show);
            icon.classList.toggle('fa-eye-slash', show);
            const label = show ? t('Hide password') : t('Show password');
            button.title = label;
            button.setAttribute('aria-label', label);
        }

        // Suggest a username from the first and last name until the admin types one of their own
        document.getElementById('FirstName').addEventListener('input', generateUsername);
        document.getElementById('LastName').addEventListener('input', generateUsername);
        let suggestedUsername = '';

        // Usernames take only Latin letters and digits here, so ə, ı and accented letters become their plain form
        function usernamePart(name) {
            return name
                .replace(/[əƏ]/g, 'e')
                .replace(/ı/g, 'i')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[^a-z0-9]/g, '');
        }

        function generateUsername() {
            const usernameField = document.getElementById('Username');
            if (usernameField.value && usernameField.value !== suggestedUsername) return;

            const firstName = usernamePart(document.getElementById('FirstName').value);
            const lastName = usernamePart(document.getElementById('LastName').value);
            // Nothing is better than a suggestion the server would refuse, as for a name in another alphabet
            suggestedUsername = firstName && lastName ? (firstName + '.' + lastName).slice(0, usernameField.maxLength > 0 ? usernameField.maxLength : 50) : '';
            usernameField.value = suggestedUsername;
        }

        // Looked up by id because the toolbar search is the first form on the page
        document.getElementById('createUserForm').addEventListener('submit', function(e) {
            const password = document.getElementById('Password').value;
            const confirmPassword = document.getElementById('ConfirmPassword').value;

            if (password !== confirmPassword) {
                e.preventDefault();
                // Keeps site.js from switching the button to its spinner
                e.stopImmediatePropagation();
                showToast(t('Passwords do not match!'), 'error');
                return false;
            }
        });
    </script>
}
