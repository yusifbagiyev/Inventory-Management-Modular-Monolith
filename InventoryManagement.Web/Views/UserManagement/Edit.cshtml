@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    var isAdminViewer = User.IsInRole("Admin");
    var userRole = Model.CurrentRoles.Contains("Admin") ? "Admin" : "User";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L["Users"]</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = Model.Id })">@Model.Username</a></li>
                <li class="breadcrumb-item active">@L["Edit"]</li>
            </ol>
            <h1>@L["Edit User"]</h1>
        </div>
        <div class="ip-page-actions">
            <a href="@Url.Action("ResetPassword", new { id = Model.Id })" class="ip-btn ip-btn-secondary">
                <i class="fa-solid fa-key"></i><span>@L["Reset Password"]</span>
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="ip-form" id="editUserForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Username" type="hidden" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <section class="ip-form-section">
            <h2>@L["Account"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label for="UsernameDisplay" class="ip-label">@L["Username"]</label>
                    <input id="UsernameDisplay" value="@Model.Username" class="ip-input" readonly disabled />
                    <span class="ip-hint">@L["Username cannot be changed."]</span>
                </div>
                <div class="ip-field">
                    <label asp-for="Email" class="ip-label"><span>@L["Email"]</span> <span class="req">*</span></label>
                    <input asp-for="Email" class="ip-input" placeholder="@L["Enter email address"]" />
                    <span asp-validation-for="Email" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="FirstName" class="ip-label"><span>@L["First Name"]</span> <span class="req">*</span></label>
                    <input asp-for="FirstName" class="ip-input" placeholder="@L["Enter first name"]" />
                    <span asp-validation-for="FirstName" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="LastName" class="ip-label"><span>@L["Last Name"]</span> <span class="req">*</span></label>
                    <input asp-for="LastName" class="ip-input" placeholder="@L["Enter last name"]" />
                    <span asp-validation-for="LastName" class="ip-error"></span>
                </div>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Status"]</h2>
            <div class="ip-switch-list">
                <label class="ip-switch-row">
                    <span><span class="d-block fw-medium">@L["Active User"]</span><span class="ip-hint">@L["Inactive users cannot login to the system."]</span></span>
                    <input asp-for="IsActive" type="checkbox" role="switch" class="ip-switch" />
                </label>
            </div>
        </section>

        @* One role: Admin (every permission) or User (only the permissions granted below).
           Only Admins see and change it. *@
        @if (isAdminViewer)
        {
            <section class="ip-form-section">
                <h2>@L["Role"]</h2>
                <div class="d-flex flex-column">
                    @foreach (var (role, hint) in new[] { ("User", "The role's permissions, plus those granted below."), ("Admin", "All pages and actions; no permissions need to be granted.") })
                    {
                        <label class="d-flex align-items-center gap-3 py-2 border-bottom" for="role_@role">
                            <input type="radio" class="ip-check" name="SelectedRoles" value="@role" id="role_@role"
                                   @(userRole == role ? "checked" : "") />
                            <span><span class="d-block fw-medium">@L[role]</span><span class="ip-hint">@L[hint]</span></span>
                        </label>
                    }
                </div>
            </section>
        }

        <div class="ip-form-foot">
            <span class="note"></span>
            <a href="@Url.Action("Index")" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Save"]</span><i class="fa-solid fa-check"></i>
            </button>
        </div>
    </form>

    @* Direct permissions are granted and revoked one by one (AJAX, applied at once), so they
       live outside the form and its Save button. *@
    @if (isAdminViewer && userRole == "Admin")
    {
        <section class="ip-section ip-form mt-5">
            <h2 class="mb-1">@L["User Permissions"]</h2>
            <p class="ip-hint mb-0">@L["Administrators hold every permission."]</p>
        </section>
    }
    else if (isAdminViewer && ViewBag.PermissionEditor is PermissionEditorModel editor)
    {
        @* Own permissions on top of the role's (shown locked); each change saves at once. *@
        <section class="ip-section mt-5" id="permissionsSection">
            <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="mb-1">@L["User Permissions"]</h2>
                    <p class="ip-hint mb-0">@L["Permission changes apply immediately (within 5 minutes for a signed-in user)."]</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <label class="ip-filter search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" id="permissionSearch" autocomplete="off"
                               placeholder="@L["Search permissions..."]" aria-label="@L["Search permissions..."]" />
                    </label>
                    <a href="@Url.Action("RolePermissions", new { role = "User" })" class="ip-btn ip-btn-secondary">
                        <i class="fa-solid fa-user-shield"></i><span>@L["Role permissions"]</span>
                    </a>
                </div>
            </div>
            <partial name="_PermissionEditor" model="editor" />
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/permission-editor.js" asp-append-version="true"></script>
    <script>
        // Someone else saving or deleting this user while it is open: warn, never touch the form.
        LiveUpdates.watch({
            mode: 'warn',
            entities: ['user'],
            ids: { user: @Model.Id },
            label: 'user'
        });
    </script>
}
