@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Edit User</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">User Management</a></li>
                <li class="breadcrumb-item active">Edit User</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to Users
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-person-gear me-1"></i> User Information
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="Username" type="hidden" />

                    <div class="form-section">
                        <div class="section-title">Account</div>
                        <div class="form-grid">
                            <div>
                                <label class="form-label">Username</label>
                                <input value="@Model.Username" class="form-control" readonly disabled />
                                <div class="form-text">Username cannot be changed.</div>
                            </div>
                            <div>
                                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div>
                                <label class="form-label">Status</label>
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Active User
                                    </label>
                                </div>
                                <div class="form-text">Inactive users cannot login to the system.</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title">Roles</div>
                        @* Always send role data, even when every box is cleared. *@
                        <input type="hidden" name="RoleUpdateFlag" value="true" />
                        <div class="role-selection form-grid">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input role-checkbox"
                                           name="SelectedRoles"
                                           value="@role.Value"
                                           id="role_@role.Value"
                                           @(Model.CurrentRoles.Contains(role.Value) ? "checked" : "") />
                                    <label class="form-check-label" for="role_@role.Value">
                                        @role.Text
                                        @if (Model.CurrentRoles.Contains(role.Value))
                                        {
                                            <small class="text-muted">(Current)</small>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                        @if (!Model.AvailableRoles.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-person-badge"></i>
                                <h5>No roles available</h5>
                            </div>
                        }
                        @* Hidden fields to track original roles *@
                        @foreach (var role in Model.CurrentRoles)
                        {
                            <input type="hidden" name="CurrentRoles" value="@role" />
                        }
                        <div class="form-text">
                            Select one or more roles for this user. Changes will be applied immediately upon save.
                        </div>
                    </div>

                    <div class="page-actions">
                        <div class="actions-right">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-save"></i> Update User
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-shield-lock me-1"></i> User Permissions
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <input type="text" id="permissionSearch" class="form-control form-control-sm"
                               placeholder="Search permissions...">
                    </div>

                    @* Fixed-height scroll region: the permission list can run to hundreds of rows. *@
                    <div id="permissionsContainer" style="max-height: 500px; overflow-y: auto;">
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card side-panel mb-4">
                <div class="card-header">
                    <i class="bi bi-lock me-1"></i> Password Management
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("ResetPassword", new { id = Model.Id })" class="list-group-item list-group-item-action">
                        <i class="bi bi-key me-2"></i>Reset Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allPermissions = [];
        let originalPermissions = {};

        $(document).ready(function() {
            loadUserPermissions();

                    $('#permissionSearch').on('keyup', function() {
                const searchTerm = $(this).val().toLowerCase();
                let visible = 0;
                $('.permission-item').each(function() {
                    const text = $(this).text().toLowerCase();
                    const match = text.includes(searchTerm);
                    $(this).toggle(match);
                    if (match) visible++;
                });
                $('#permissionsNoResults').toggle(visible === 0);
            });
        });

                async function loadUserPermissions() {
            try {
                // Call the MVC controller action directly (no API gateway needed)
                const url = '/UserManagement/GetUserPermissions?id=@Model.Id';

                $.ajax({
                    url: url,
                    type: 'GET',
                    // For MVC controller actions, we don't need the Bearer token
                    // The cookie authentication handles it automatically
                    success: function(data) {
                        console.log('Permissions loaded successfully:', data);

                        if (data.error) {
                            $('#permissionsContainer').html(
                                '<p class="text-danger">Failed to load permissions</p>'
                            );
                            return;
                        }
                        renderPermissions(data);
                    },
                    error: function(xhr, status, error) {
                        console.error('Failed to load permissions:', xhr.status, error);

                        let errorMessage = 'Error loading permissions';
                        if (xhr.status === 401) {
                            errorMessage = 'Session expired. Please refresh the page.';
                        } else if (xhr.status === 403) {
                            errorMessage = 'You do not have permission to view user permissions.';
                        }

                        $('#permissionsContainer').html(
                            `<p class="text-danger">${errorMessage}</p>`
                        );
                    }
                });
            } catch (error) {
                console.error('Error loading permissions:', error);
                $('#permissionsContainer').html(
                    '<p class="text-danger">Error loading permissions. Please refresh the page.</p>'
                );
            }
        }

        function renderPermissions(permissions) {
            // Nothing came back at all - show the standard empty block instead of a blank panel.
            if (!permissions || permissions.length === 0) {
                $('#permissionsContainer').html(`
                    <div class="empty-state">
                        <i class="bi bi-shield-slash"></i>
                        <h5>No permissions defined</h5>
                    </div>
                `);
                return;
            }

            // Group permissions by category
            const grouped = {};
            permissions.forEach(p => {
                const category = p.category || 'General';
                if (!grouped[category]) {
                    grouped[category] = [];
                }
                grouped[category].push(p);
            });

            let html = '<div class="permissions-list">';

            // Show assigned permissions first
            const assignedPerms = permissions.filter(p => p.isAssigned);
            if (assignedPerms.length > 0) {
                html += `
                    <div class="mb-4">
                        <div class="section-title">Current Permissions (${assignedPerms.length})</div>
                        <div class="assigned-permissions">
                `;

                assignedPerms.forEach(perm => {
                    html += createPermissionItem(perm, true);
                });

                html += '</div></div>';
            }

            // Show available permissions by category
            html += '<div class="section-title">Available Permissions</div>';

            for (const [category, perms] of Object.entries(grouped)) {
                const availableInCategory = perms.filter(p => !p.isAssigned);
                if (availableInCategory.length === 0) continue;

                html += `
                    <div class="category-section mb-3">
                        <div class="category-header form-label mb-2">${category}</div>
                        <div class="category-permissions">
                `;

                availableInCategory.forEach(perm => {
                    html += createPermissionItem(perm, false);
                });

                html += '</div></div>';
            }

            // Search filters the rendered rows, so it needs its own no-match block.
            html += `
                <div id="permissionsNoResults" class="empty-state" style="display: none;">
                    <i class="bi bi-search"></i>
                    <h5>No permissions match</h5>
                </div>
            `;

            html += '</div>';
            $('#permissionsContainer').html(html);
        }

        function createPermissionItem(permission, isAssigned) {
            const action = isAssigned ? 'remove' : 'add';
            // Removing a granted permission is the destructive side of this control.
            const buttonClass = isAssigned ? 'btn-outline-danger' : 'btn-outline-secondary';
            const buttonIcon = isAssigned ? 'fa-times' : 'fa-plus';
            const buttonText = isAssigned ? 'Remove' : 'Add';

            // The wrapper stays a plain block: jQuery .toggle() writes an inline display,
            // which a Bootstrap d-* display utility would override with !important.
            return `
                <div class="permission-item ${isAssigned ? 'assigned' : 'available'}" data-name="${permission.name}">
                    <div class="d-flex justify-content-between align-items-start gap-2 py-2 border-bottom">
                        <div class="permission-info">
                            <div class="fw-semibold">${permission.name}</div>
                            <small class="text-muted">${permission.description || 'No description'}</small>
                        </div>
                        <button class="btn btn-sm ${buttonClass}"
                                onclick="togglePermission('${permission.name}', ${!isAssigned})"
                                title="${buttonText} permission">
                            <i class="fas ${buttonIcon}"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        async function togglePermission(permissionName, isGranting) {
            // Promise wrapper so the shared dialog fits this async flow: resolves only if confirmed.
            const confirmed = await new Promise(resolve => {
                confirmAction({
                    title: isGranting ? 'Grant permission' : 'Remove permission',
                    message: isGranting
                        ? `Grant the "${permissionName}" permission to this user?`
                        : `Remove the "${permissionName}" permission from this user?`,
                    okText: isGranting ? 'Grant' : 'Remove',
                    danger: !isGranting
                }, () => resolve(true));
                document.getElementById('globalConfirmModal')
                    ?.addEventListener('hidden.bs.modal', () => resolve(false), { once: true });
            });

            if (!confirmed) {
                return; // User cancelled the action
            }

            $.ajax({
                url: '@Url.Action("TogglePermission", new { id = Model.Id })',
                type: 'POST',
                data: JSON.stringify({ permissionName: permissionName, isGranting: isGranting }),
                contentType: 'application/json',
                headers: AppConfig.antiforgeryHeaders(),
                success: function(response) {
                    if (response && response.success) {
                        showToast(isGranting ? 'Permission granted' : 'Permission removed', 'success');
                    } else {
                        showToast(response?.message || 'Permission change failed', 'error');
                    }
                    loadUserPermissions();
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.message ||
                                   xhr.responseJSON?.error ||
                                   'Permission change failed';
                    showToast(errorMsg, 'error');
                }
            });
        }
    </script>
}
