@model EditUserViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">User Details</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">User Management</a></li>
                <li class="breadcrumb-item active">User Details</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to Users
            </a>
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary btn-sm">
                <i class="fas fa-edit"></i> Edit User
            </a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-person me-1"></i> User Information
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">Username</span>
                            <span class="d-value mono">@Model.Username</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Email</span>
                            @if (string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.Email</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">First Name</span>
                            @if (string.IsNullOrWhiteSpace(Model.FirstName))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.FirstName</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Last Name</span>
                            @if (string.IsNullOrWhiteSpace(Model.LastName))
                            {
                                <span class="d-value d-empty">Not set</span>
                            }
                            else
                            {
                                <span class="d-value">@Model.LastName</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Status</span>
                            <span class="d-value">
                                @if (Model.IsActive)
                                {
                                    <span class="state state-ok">Active</span>
                                }
                                else
                                {
                                    <span class="state state-idle">Inactive</span>
                                }
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Roles</span>
                            <span class="d-value">
                                @if (Model.CurrentRoles.Any())
                                {
                                    foreach (var role in Model.CurrentRoles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="d-empty">No roles assigned</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-bar-chart me-1"></i> Activity Summary
                </div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-row">
                            <span class="d-label">Total Logins</span>
                            <span class="d-value mono">15</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Last Login</span>
                            <span class="d-value mono">2 days ago</span>
                        </div>
                        <div class="detail-row">
                            <span class="d-label">Account Age</span>
                            <span class="d-value mono">30 days</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card side-panel mb-4">
                <div class="card-header">
                    <i class="bi bi-lightning-charge me-1"></i> Quick Actions
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="list-group-item list-group-item-action">
                        <i class="bi bi-pencil-square me-2"></i>Edit User
                    </a>
                    <a href="@Url.Action("ResetPassword", new { id = Model.Id })" class="list-group-item list-group-item-action">
                        <i class="bi bi-key me-2"></i>Reset Password
                    </a>
                    <button type="button" class="list-group-item list-group-item-action text-start w-100"
                            onclick="toggleUserStatus(@Model.Id, @Model.IsActive.ToString().ToLower())">
                        @if (Model.IsActive)
                        {
                            <span><i class="bi bi-person-dash me-2"></i>Deactivate User</span>
                        }
                        else
                        {
                            <span><i class="bi bi-person-check me-2"></i>Activate User</span>
                        }
                    </button>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-1"></i> Account Information
                </div>
                <div class="card-body">
                    <div class="detail-row">
                        <span class="d-label">User ID</span>
                        <span class="d-value mono">#@Model.Id</span>
                    </div>
                    <div class="detail-row">
                        <span class="d-label">Created</span>
                        <span class="d-value mono">Jan 15, 2024</span>
                    </div>
                    <div class="detail-row">
                        <span class="d-label">Last Modified</span>
                        <span class="d-value mono">Jan 20, 2024</span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-exclamation-triangle me-1"></i> Danger Zone
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Once you delete a user, there is no going back. Please be certain.</p>
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteUser(@Model.Id, '@Model.Username')">
                        <i class="fas fa-trash"></i> Delete User
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete User Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUsername"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUserStatus(userId, isActive) {
            const action = isActive ? 'deactivate' : 'activate';
            if (confirm(`Are you sure you want to ${action} this user?`)) {
                fetch('@Url.Action("QuickToggleStatus")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: userId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error updating user status: ' + (data.message || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error updating user status');
                });
            }
        }

        function deleteUser(userId, username) {
            document.getElementById('deleteUsername').textContent = username;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + userId;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
