@model EditUserViewModel
@{
    ViewData["Title"] = "User Details";
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    var isOwnAccount = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.Id.ToString();
    string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

<div class="container-fluid px-4" id="detailsRegion">
    <div class="ip-page-head mb-3">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L["Users"]</a></li>
                <li class="breadcrumb-item active">@Model.Username</li>
            </ol>
            <h1>@Or(fullName, Model.Username)</h1>
            <div class="ip-sub d-flex flex-wrap align-items-center gap-2 mt-2">
                <span>@Model.Username</span>
                @if (Model.IsActive)
                {
                    <span class="ip-badge ip-badge-success">@L["Active"]</span>
                }
                else
                {
                    <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                }
                @if (Model.CurrentRoles.Any())
                {
                    <span class="ip-tag-plain">@string.Join(", ", Model.CurrentRoles.Select(r => L[r].Value))</span>
                }
            </div>
        </div>
    </div>

    @* Admin accounts are changed by Admins only *@
    @if (User.HasPermission("user.manage") && (User.IsInRole("Admin") || !Model.CurrentRoles.Contains("Admin")))
    {
    <div class="ip-page-actions mb-4">
        @* Nobody deletes or deactivates the account they are signed in with *@
        @if (!isOwnAccount)
        {
        <button type="button" class="ip-btn ip-btn-danger-ghost" data-name="@Model.Username" onclick="deleteUser(@Model.Id, this.dataset.name)">
            <i class="fa-solid fa-trash-can"></i><span>@L["Delete"]</span>
        </button>
        <button type="button" class="ip-btn ip-btn-secondary" onclick="toggleUserStatus(@Model.Id, @Model.IsActive.ToString().ToLower())">
            @if (Model.IsActive)
            {
                <i class="fa-solid fa-user-slash"></i><span>@L["Deactivate User"]</span>
            }
            else
            {
                <i class="fa-solid fa-user-check"></i><span>@L["Activate User"]</span>
            }
        </button>
        }
        <a href="@Url.Action("ResetPassword", new { id = Model.Id })" class="ip-btn ip-btn-secondary">
            <i class="fa-solid fa-key"></i><span>@L["Reset Password"]</span>
        </a>
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="ip-btn ip-btn-primary">
            <span>@L["Edit"]</span><i class="fa-solid fa-pen"></i>
        </a>
    </div>
    }

    <hr class="ip-rule" />

    <div class="row pt-2">
        <div class="col-xl-8">
            <dl class="ip-dl">
                <div><dt>@L["Username"]</dt><dd>@Model.Username</dd></div>
                <div><dt>@L["First Name"]</dt><dd class="@(string.IsNullOrWhiteSpace(Model.FirstName) ? "ip-muted" : "")">@Or(Model.FirstName, L["Not set"].Value)</dd></div>
                <div><dt>@L["Last Name"]</dt><dd class="@(string.IsNullOrWhiteSpace(Model.LastName) ? "ip-muted" : "")">@Or(Model.LastName, L["Not set"].Value)</dd></div>
                <div><dt>@L["Email"]</dt><dd class="@(string.IsNullOrWhiteSpace(Model.Email) ? "ip-muted" : "")">@Or(Model.Email, L["Not set"].Value)</dd></div>
                <div>
                    <dt>@L["Roles"]</dt>
                    <dd class="@(Model.CurrentRoles.Any() ? "" : "ip-muted")">@(Model.CurrentRoles.Any() ? string.Join(", ", Model.CurrentRoles.Select(r => L[r].Value)) : L["No roles assigned"].Value)</dd>
                </div>
                <div>
                    <dt>@L["Status"]</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="ip-badge ip-badge-success">@L["Active"]</span>
                        }
                        else
                        {
                            <span class="ip-badge ip-badge-neutral">@L["Inactive"]</span>
                        }
                    </dd>
                </div>
                <div><dt>@L["User ID"]</dt><dd class="ip-mono">#@Model.Id</dd></div>
            </dl>
        </div>
    </div>
</div>

@* Posted after the shared confirm dialog, so the result comes back as the usual redirect and notice *@
<form id="deleteForm" method="post" hidden>
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function toggleUserStatus(userId, isActive) {
            const deactivating = !!isActive;
            confirmAction({
                title: deactivating ? t('Deactivate user') : t('Activate user'),
                message: deactivating
                    ? t('Deactivate this user? They will no longer be able to sign in.')
                    : t('Activate this user? They will be able to sign in again.'),
                okText: deactivating ? t('Deactivate') : t('Activate'),
                danger: deactivating
            }, function () {
                // The id goes in the route because the action does not bind it from a JSON body
                fetch(`@Url.Action("QuickToggleStatus")/${userId}`, {
                    method: 'POST',
                    headers: AppConfig.antiforgeryHeaders()
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        ListNav.reload();
                    } else {
                        showToast(t('Error updating user status: {0}', data.message || t('Unknown error')), 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast(t('Error updating user status'), 'error');
                });
            });
        }

        function deleteUser(userId, username) {
            confirmAction({
                title: t('Delete User'),
                message: t('Delete user {0}? This action cannot be undone.', username),
                okText: t('Delete'),
                danger: true
            }, function () {
                const form = document.getElementById('deleteForm');
                form.action = '@Url.Action("Delete")/' + userId;
                form.submit();
            });
        }

        // Other users' changes refresh the page in place, and a deletion shows a notice
        LiveUpdates.watch({
            entities: ['user'],
            ids: { user: @Model.Id },
            regions: ['#detailsRegion'],
            label: 'user'
        });
    </script>
}
