@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@L["Users"]</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = Model.UserId })">@Model.Username</a></li>
                <li class="breadcrumb-item active">@L["Reset Password"]</li>
            </ol>
            <h1>@L["Reset Password"]</h1>
            <div class="ip-sub">@L["Reset Password for {0}", Model.Username]</div>
        </div>
    </div>

    <form asp-action="ResetPassword" method="post" class="ip-form" id="resetPasswordForm">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Username" type="hidden" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="ip-banner ip-banner-danger mb-3" role="alert"></div>
        }

        <div class="ip-banner ip-banner-info mb-4">
            <i class="fa-solid fa-circle-info"></i>
            <span class="flex-grow-1">
                <strong>@L["Important:"]</strong> @L["The user will need to use this new password to login."]
                @L["Please send the new password to the user through a secure channel."]
            </span>
        </div>

        <section class="ip-form-section">
            <h2>@L["New Password"]</h2>
            <div class="ip-form-grid">
                <div class="ip-field">
                    <label asp-for="NewPassword" class="ip-label"><span>@L["New Password"]</span> <span class="req">*</span></label>
                    <div class="position-relative">
                        <input asp-for="NewPassword" class="ip-input pe-5" type="password" placeholder="@L["Enter new password"]" autocomplete="new-password" />
                        <button type="button" class="ip-btn-icon position-absolute top-50 end-0 translate-middle-y me-1"
                                onclick="togglePassword('NewPassword')" title="@L["Show password"]" aria-label="@L["Show password"]">
                            <i class="fa-regular fa-eye" id="NewPassword-icon"></i>
                        </button>
                    </div>
                    <span class="ip-hint">@L[SharedServices.Identity.PasswordRules.LengthMessage]</span>
                    <span asp-validation-for="NewPassword" class="ip-error"></span>
                </div>
                <div class="ip-field">
                    <label asp-for="ConfirmPassword" class="ip-label"><span>@L["Confirm New Password"]</span> <span class="req">*</span></label>
                    <div class="position-relative">
                        <input asp-for="ConfirmPassword" class="ip-input pe-5" type="password" placeholder="@L["Confirm new password"]" autocomplete="new-password" />
                        <button type="button" class="ip-btn-icon position-absolute top-50 end-0 translate-middle-y me-1"
                                onclick="togglePassword('ConfirmPassword')" title="@L["Show password"]" aria-label="@L["Show password"]">
                            <i class="fa-regular fa-eye" id="ConfirmPassword-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="ip-error"></span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap mt-4">
                <button type="button" class="ip-btn ip-btn-secondary" onclick="generatePassword()">
                    <span>@L["Generate Strong Password"]</span><i class="fa-solid fa-wand-magic-sparkles"></i>
                </button>
                <span class="ip-hint">@L["A generated password is filled into both fields and shown for 3 seconds."]</span>
            </div>
        </section>

        <section class="ip-form-section">
            <h2>@L["Password Requirements"]</h2>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 ip-muted">
                <li><i class="fa-solid fa-check me-2 ip-faint"></i>@L["At least {0} characters", SharedServices.Identity.PasswordRules.MinLength]</li>
                <li><i class="fa-solid fa-check me-2 ip-faint"></i>@L["Uppercase and lowercase letters"]</li>
                <li><i class="fa-solid fa-check me-2 ip-faint"></i>@L["At least one digit"]</li>
                <li><i class="fa-solid fa-check me-2 ip-faint"></i>@L["Special characters for extra security (recommended)"]</li>
            </ul>
        </section>

        <div class="ip-form-foot">
            <span class="note"></span>
            <a href="@Url.Action("Index")" class="ip-btn ip-btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="ip-btn ip-btn-primary">
                <span>@L["Reset Password"]</span><i class="fa-solid fa-key"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function togglePassword(fieldId) {
            const passwordField = document.getElementById(fieldId);
            const icon = document.getElementById(fieldId + '-icon');
            const button = icon.closest('button');
            const show = passwordField.type === 'password';

            passwordField.type = show ? 'text' : 'password';
            icon.classList.toggle('fa-eye', !show);
            icon.classList.toggle('fa-eye-slash', show);
            const label = show ? t('Hide password') : t('Show password');
            button.title = label;
            button.setAttribute('aria-label', label);
        }

        // Draws again instead of taking a remainder, which would favour the first characters of a set
        function randomIndex(count) {
            const limit = Math.floor(0x100000000 / count) * count;
            const draw = new Uint32Array(1);
            do {
                crypto.getRandomValues(draw);
            } while (draw[0] >= limit);
            return draw[0] % count;
        }

        function generatePassword() {
            const length = 12;
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const digits = '0123456789';
            const all = lower + upper + digits + '!@@#$%^&*';
            const pick = set => set.charAt(randomIndex(set.length));

            // One of each kind the rules ask for, so the server never refuses a generated password
            const chars = [pick(lower), pick(upper), pick(digits)];
            while (chars.length < length) {
                chars.push(pick(all));
            }
            for (let i = chars.length - 1; i > 0; i--) {
                const j = randomIndex(i + 1);
                [chars[i], chars[j]] = [chars[j], chars[i]];
            }
            const password = chars.join('');

            document.getElementById('NewPassword').value = password;
            document.getElementById('ConfirmPassword').value = password;

            // Show the generated password for a few seconds
            document.getElementById('NewPassword').type = 'text';
            document.getElementById('ConfirmPassword').type = 'text';

            setTimeout(() => {
                document.getElementById('NewPassword').type = 'password';
                document.getElementById('ConfirmPassword').type = 'password';
            }, 3000);
        }

        // Looked up by id because the toolbar search is the first form on the page
        document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
            const password = document.getElementById('NewPassword').value;
            const confirmPassword = document.getElementById('ConfirmPassword').value;

            if (password !== confirmPassword) {
                e.preventDefault();
                // Keeps site.js from switching the button to its spinner
                e.stopImmediatePropagation();
                showToast(t('Passwords do not match!'), 'error');
                return false;
            }

            // Plain a-z, A-Z and 0-9, because those are the characters the server counts
            if (password.length < @SharedServices.Identity.PasswordRules.MinLength
                || !/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/[0-9]/.test(password)) {
                e.preventDefault();
                e.stopImmediatePropagation();
                showToast(t('@SharedServices.Identity.PasswordRules.LengthMessage'), 'error');
                return false;
            }
        });
    </script>
}
