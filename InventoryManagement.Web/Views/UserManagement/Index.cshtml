@model List<UserListViewModel>
@{
    ViewData["Title"] = "Users";
    var allRoles = Model.SelectMany(u => u.Roles).Distinct().OrderBy(r => r).ToList();
}
<div class="container-fluid px-4">
    <div class="ip-page-head">
        <div>
            <h1>@L["Users"]</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportUsersToPDF()">
                <i class="fas fa-file-pdf"></i> @L["Export PDF"]
            </button>
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="fas fa-user-plus"></i> @L["New User"]
            </a>
        </div>
    </div>

    @* The whole user list is rendered at once, so every filter here narrows the rows
       instantly in the browser - there is no Apply step to wait for. *@
    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="@L["Search name, username, email..."]">
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetUserFilters()">
                <i class="fas fa-redo"></i> @L["Reset"]
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="roleFilter">@L["Role"]</label>
                <select id="roleFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">@L["All roles"]</option>
                    @foreach (var role in allRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="statusFilter">@L["Status"]</label>
                <select id="statusFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">@L["All"]</option>
                    <option value="active">@L["Active"]</option>
                    <option value="inactive">@L["Inactive"]</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="loginFilter">@L["Sign-in"]</label>
                <select id="loginFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">@L["All"]</option>
                    <option value="signed">@L["Has signed in"]</option>
                    <option value="never">@L["Never signed in"]</option>
                </select>
            </div>
        </div>
    </div>

    <div class="result-bar" id="usersSummary">
        <span><b id="userCount">@Model.Count</b> @L["of"] <b>@Model.Count</b> @L["users"]</span>
    </div>

    <div class="card mb-4" id="usersRegion">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>@L["User"]</th>
                            <th>@L["Email"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Roles"]</th>
                            <th>@L["Created"]</th>
                            <th>@L["Last Login"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="user-initial-badge me-3 pdf-omit">@user.Username.Substring(0, 1).ToUpper()</span>
                                        <div>
                                            <h6 class="mb-0">@user.FullName</h6>
                                            <small class="text-muted">@user.Username</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@L["Inactive"]</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    <small>@(user.CreatedAt == default(DateTime) ? L["Unknown"].Value : user.CreatedAt.ToString("dd.MM.yyyy"))</small>
                                </td>
                                <td>
                                    @if (user.LastLoginAt.HasValue && user.LastLoginAt.Value != default(DateTime))
                                    {
                                        <small>@user.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@L["Never"]</small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Details", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-secondary" title="@L["View Details"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-secondary" title="@L["Edit User"]">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-warning"
                                                onclick="toggleUserStatus(@user.Id, @user.IsActive.ToString().ToLower())"
                                                title="@L["Toggle Status"]">
                                            @if (user.IsActive)
                                            {
                                                <i class="fas fa-user-slash"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-user-check"></i>
                                            }
                                        </button>
                                        <a href="@Url.Action("ResetPassword", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-secondary" title="@L["Reset Password"]">
                                            <i class="fas fa-key"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-name="@user.Username" onclick="deleteUser(@user.Id, this.dataset.name)"
                                                title="@L["Delete User"]">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr class="no-results-row" id="noUserResults" style="display: none;">
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-user-slash"></i>
                                    <h5>@L["No users match these filters"]</h5>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetUserFilters()">@L["Clear filters"]</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Confirm Delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>@L["Are you sure you want to delete user"] <strong id="deleteUsername"></strong>?</p>
                <p class="text-danger">@L["This action cannot be undone."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">@L["Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Every filter narrows the already-rendered rows, so results update as you type/select.
        function applyUserFilters() {
            const term = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            const role = document.getElementById('roleFilter').value;
            const status = document.getElementById('statusFilter').value;
            const login = document.getElementById('loginFilter').value;
            const terms = term ? term.split(/\s+/) : [];

            let shown = 0;
            document.querySelectorAll('#usersTable tbody tr').forEach(row => {
                if (row.classList.contains('no-results-row')) return;

                const haystack = row.textContent.toLowerCase();
                const rowRoles = (row.dataset.roles || '').split('|').filter(Boolean);
                const isActive = row.dataset.active === 'true';
                const hasLoggedIn = row.dataset.everLoggedIn === 'true';

                const matches =
                    terms.every(t => haystack.includes(t)) &&
                    (!role || rowRoles.includes(role)) &&
                    (!status || (status === 'active') === isActive) &&
                    (!login || (login === 'signed') === hasLoggedIn);

                row.style.display = matches ? '' : 'none';
                if (matches) shown++;
            });

            document.getElementById('userCount').textContent = shown;
            const empty = document.getElementById('noUserResults');
            if (empty) empty.style.display = shown === 0 ? '' : 'none';
        }

        function resetUserFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('roleFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('loginFilter').value = '';
            applyUserFilters();
        }

        function exportUsersToPDF() {
            const table = document.getElementById('usersTable');
            if (!table || typeof collectTableData !== 'function') return;
            const data = collectTableData(table, [t('Actions')]);
            if (!data.rows.length) { showToast(t('Nothing to export'), 'warning'); return; }
            renderPrintDocument({ title: t('Users'), headers: data.headers, rows: data.rows });
        }

        document.getElementById('searchInput').addEventListener('keyup', applyUserFilters);

        // Toggle user status. Razor renders the flag unquoted, so it arrives as a real boolean -
        // the old `isActive === 'true'` string compare was always false and mislabelled the prompt.
            function toggleUserStatus(userId, isActive) {
            const deactivating = (isActive === true || isActive === 'true');
            const action = deactivating ? 'deactivate' : 'activate';
            confirmAction({
                title: deactivating ? t('Deactivate user') : t('Activate user'),
                message: deactivating
                    ? t('Deactivate this user? They will no longer be able to sign in.')
                    : t('Activate this user? They will be able to sign in again.'),
                okText: deactivating ? t('Deactivate') : t('Activate'),
                danger: deactivating
            }, function () {
                $.ajax({
                    url: '@Url.Action("QuickToggleStatus")',
                    type: 'POST',
                    data: { id: userId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(data) {
                        if (data.success) {
                            location.reload();
                        } else {
                            showToast(t('Error updating user status: {0}', data.message || t('Unknown error')), 'error');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        showToast(t('Error updating user status'), 'error');
                    }
                });
            });
        }

        // Delete user
        function deleteUser(userId, username) {
            document.getElementById('deleteUsername').textContent = username;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + userId;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Auto-hide alerts
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Other users' changes refresh the count and the table in place (live-updates.js).
        LiveUpdates.watch({
            entities: ['user'],
            regions: ['#usersSummary', '#usersRegion'],
            afterRefresh: applyUserFilters
        });
    </script>
}