@model List<UserListViewModel>
@{
    var allRoles = Model.SelectMany(u => u.Roles).Distinct().OrderBy(r => r).ToList();
}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-3 mb-1">
        <div>
            <h1 class="mb-1">Users</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Users</li>
            </ol>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm" onclick="exportUsersToPDF()">
                <i class="fas fa-file-pdf"></i> Export PDF
            </button>
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="fas fa-user-plus"></i> New User
            </a>
        </div>
    </div>

    @* The whole user list is rendered at once, so every filter here narrows the rows
       instantly in the browser - there is no Apply step to wait for. *@
    <div class="filter-panel mt-3">
        <div class="filter-top">
            <div class="filter-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="Search name, username, email...">
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetUserFilters()">
                <i class="fas fa-redo"></i> Reset
            </button>
        </div>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="roleFilter">Role</label>
                <select id="roleFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">All roles</option>
                    @foreach (var role in allRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="loginFilter">Sign-in</label>
                <select id="loginFilter" class="form-select form-select-sm" onchange="applyUserFilters()">
                    <option value="">All</option>
                    <option value="signed">Has signed in</option>
                    <option value="never">Never signed in</option>
                </select>
            </div>
        </div>
    </div>

    <div class="result-bar">
        <span><b id="userCount">@Model.Count</b> of <b>@Model.Count</b> users</span>
    </div>

    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Roles</th>
                            <th>Created</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="user-initial-badge me-3">@user.Username.Substring(0, 1).ToUpper()</span>
                                        <div>
                                            <h6 class="mb-0">@user.FullName</h6>
                                            <small class="text-muted">@user.Username</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    <small>@(user.CreatedAt == default(DateTime) ? "Unknown" : user.CreatedAt.ToString("MMM dd, yyyy"))</small>
                                </td>
                                <td>
                                    @if (user.LastLoginAt.HasValue && user.LastLoginAt.Value != default(DateTime))
                                    {
                                        <small>@user.LastLoginAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Never</small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Details", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-primary" title="Edit User">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-warning"
                                                onclick="toggleUserStatus(@user.Id, @user.IsActive.ToString().ToLower())"
                                                title="Toggle Status">
                                            @if (user.IsActive)
                                            {
                                                <i class="fas fa-user-slash"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-user-check"></i>
                                            }
                                        </button>
                                        <a href="@Url.Action("ResetPassword", new { id = user.Id })"
                                           class="btn btn-sm btn-outline-secondary" title="Reset Password">
                                            <i class="fas fa-key"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-name="@user.Username" onclick="deleteUser(@user.Id, this.dataset.name)"
                                                title="Delete User">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr class="no-results-row" id="noUserResults" style="display: none;">
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-user-slash"></i>
                                    <h5>No users match these filters</h5>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetUserFilters()">Clear filters</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUsername"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script>
        // Every filter narrows the already-rendered rows, so results update as you type/select.
        function applyUserFilters() {
            const term = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            const role = document.getElementById('roleFilter').value;
            const status = document.getElementById('statusFilter').value;
            const login = document.getElementById('loginFilter').value;
            const terms = term ? term.split(/\s+/) : [];

            let shown = 0;
            document.querySelectorAll('#usersTable tbody tr').forEach(row => {
                if (row.classList.contains('no-results-row')) return;

                const haystack = row.textContent.toLowerCase();
                const rowRoles = (row.dataset.roles || '').split('|').filter(Boolean);
                const isActive = row.dataset.active === 'true';
                const hasLoggedIn = row.dataset.everLoggedIn === 'true';

                const matches =
                    terms.every(t => haystack.includes(t)) &&
                    (!role || rowRoles.includes(role)) &&
                    (!status || (status === 'active') === isActive) &&
                    (!login || (login === 'signed') === hasLoggedIn);

                row.style.display = matches ? '' : 'none';
                if (matches) shown++;
            });

            document.getElementById('userCount').textContent = shown;
            const empty = document.getElementById('noUserResults');
            if (empty) empty.style.display = shown === 0 ? '' : 'none';
        }

        function resetUserFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('roleFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('loginFilter').value = '';
            applyUserFilters();
        }

        function exportUsersToPDF() {
            const table = document.getElementById('usersTable');
            if (!table || typeof collectTableData !== 'function') return;
            const data = collectTableData(table, ['Actions']);
            if (!data.rows.length) { showToast('Nothing to export', 'warning'); return; }
            renderPrintDocument({ title: 'Users', headers: data.headers, rows: data.rows });
        }

        document.getElementById('searchInput').addEventListener('keyup', applyUserFilters);

        // Toggle user status. Razor renders the flag unquoted, so it arrives as a real boolean -
        // the old `isActive === 'true'` string compare was always false and mislabelled the prompt.
            function toggleUserStatus(userId, isActive) {
            const deactivating = (isActive === true || isActive === 'true');
            const action = deactivating ? 'deactivate' : 'activate';
            confirmAction({
                title: deactivating ? 'Deactivate user' : 'Activate user',
                message: deactivating
                    ? 'Deactivate this user? They will no longer be able to sign in.'
                    : 'Activate this user? They will be able to sign in again.',
                okText: deactivating ? 'Deactivate' : 'Activate',
                danger: deactivating
            }, function () {
                $.ajax({
                    url: '@Url.Action("QuickToggleStatus")',
                    type: 'POST',
                    data: { id: userId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(data) {
                        if (data.success) {
                            location.reload();
                        } else {
                            showToast('Error updating user status: ' + (data.message || 'Unknown error'), 'error');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        showToast('Error updating user status', 'error');
                    }
                });
            });
        }

        // Delete user
        function deleteUser(userId, username) {
            document.getElementById('deleteUsername').textContent = username;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + userId;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Auto-hide alerts
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}