@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<aside class="modern-sidebar" id="sidebar-wrapper">
    <div class="sidebar-header">
        <img src="/inventory.png" alt="" height="30">
        <span class="brand-text">Inventory Pro</span>
    </div>

    <ul class="sidebar-content">
        <li class="nav-item">
            <a href="/Home/Dashboard" class="nav-link @(action == "Dashboard" ? "active" : "")">
                <span class="nav-icon"><i class="bi bi-grid-1x2"></i></span>
                <span class="nav-text">Dashboard</span>
            </a>
        </li>

        <li class="nav-section"><span>Main menu</span></li>

        <li class="nav-item">
            <a href="/Products" class="nav-link @(controller == "Products" ? "active" : "")">
                <span class="nav-icon"><i class="bi bi-box-seam"></i></span>
                <span class="nav-text">Products</span>
                <span class="badge bg-primary">@ViewBag.ProductCount</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="/Routes" class="nav-link @(controller == "Routes" ? "active" : "")">
                <span class="nav-icon"><i class="bi bi-arrow-left-right"></i></span>
                <span class="nav-text">Routes</span>
                <span class="badge bg-warning" id="pendingRoutesCount"></span>
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="nav-section"><span>Management</span></li>

            <li class="nav-item">
                <a href="/Categories" class="nav-link @(controller == "Categories" ? "active" : "")">
                    <span class="nav-icon"><i class="bi bi-tags"></i></span>
                    <span class="nav-text">Categories</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Departments" class="nav-link @(controller == "Departments" ? "active" : "")">
                    <span class="nav-icon"><i class="bi bi-diagram-3"></i></span>
                    <span class="nav-text">Departments</span>
                </a>
            </li>

            <li class="nav-section"><span>Administration</span></li>

            <li class="nav-item">
                <a href="/Approvals" class="nav-link @(controller == "Approvals" ? "active" : "")">
                    <span class="nav-icon"><i class="bi bi-check2-square"></i></span>
                    <span class="nav-text">Approvals</span>
                    <span class="badge bg-danger" id="sidebarPendingCount"></span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/UserManagement" class="nav-link @(controller == "UserManagement" ? "active" : "")">
                    <span class="nav-icon"><i class="bi bi-people"></i></span>
                    <span class="nav-text">Users</span>
                </a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a href="/MyRequests" class="nav-link @(controller == "MyRequests" ? "active" : "")">
                    <span class="nav-icon"><i class="bi bi-clock-history"></i></span>
                    <span class="nav-text">My Requests</span>
                </a>
            </li>
        }

        <li class="nav-item">
            <a href="/Notifications" class="nav-link @(controller == "Notifications" ? "active" : "")">
                <span class="nav-icon"><i class="bi bi-bell"></i></span>
                <span class="nav-text">Notifications</span>
                <span class="badge bg-info notification-badge" id="sidebarUnreadCount" style="display: none;"></span>
            </a>
        </li>
    </ul>
</aside>
