@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
@* Dark in both themes: data-bs-theme switches the tokens for everything inside. *@
<aside class="modern-sidebar" id="sidebar-wrapper" data-bs-theme="dark">
    <div class="sidebar-header">
        <img src="/inventory.png" alt="" height="30">
        <span class="brand-text">Inventory Pro</span>
    </div>

    <ul class="sidebar-content">
        <li class="nav-item">
            <a href="/Home/Dashboard" class="nav-link @(action == "Dashboard" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-table-cells-large"></i></span>
                <span class="nav-text">@L["Dashboard"]</span>
            </a>
        </li>

        <li class="nav-section"><span>@L["Main menu"]</span></li>

        <li class="nav-item">
            <a href="/Products" class="nav-link @(controller == "Products" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-box"></i></span>
                <span class="nav-text">@L["Products"]</span>
                <span class="badge bg-primary">@ViewBag.ProductCount</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="/Routes" class="nav-link @(controller == "Routes" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-arrow-right-arrow-left"></i></span>
                <span class="nav-text">@L["Routes"]</span>
                <span class="badge bg-warning" id="pendingRoutesCount"></span>
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="nav-section"><span>@L["Management"]</span></li>

            <li class="nav-item">
                <a href="/Categories" class="nav-link @(controller == "Categories" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-tags"></i></span>
                    <span class="nav-text">@L["Categories"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Departments" class="nav-link @(controller == "Departments" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-sitemap"></i></span>
                    <span class="nav-text">@L["Departments"]</span>
                </a>
            </li>

            <li class="nav-section"><span>@L["Administration"]</span></li>

            <li class="nav-item">
                <a href="/Approvals" class="nav-link @(controller == "Approvals" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-square-check"></i></span>
                    <span class="nav-text">@L["Approvals"]</span>
                    <span class="badge bg-danger" id="sidebarPendingCount"></span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/UserManagement" class="nav-link @(controller == "UserManagement" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-users"></i></span>
                    <span class="nav-text">@L["Users"]</span>
                </a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a href="/MyRequests" class="nav-link @(controller == "MyRequests" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-clock-rotate-left"></i></span>
                    <span class="nav-text">@L["My Requests"]</span>
                </a>
            </li>
        }

        <li class="nav-item">
            <a href="/Notifications" class="nav-link @(controller == "Notifications" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-bell"></i></span>
                <span class="nav-text">@L["Notifications"]</span>
                <span class="badge bg-info notification-badge" id="sidebarUnreadCount" style="display: none;"></span>
            </a>
        </li>
    </ul>
</aside>
