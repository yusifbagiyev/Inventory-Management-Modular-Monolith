@* The logo chevrons from favicon.svg, the big one in the text colour so it works in both themes and on the dark sign-in panel *@
@{
    // Each copy on a page gets its own mask id: a copy that is hidden (the sign-in hero on phones) would otherwise take the others' gap with it
    var n = (Context.Items["ip-brand-mark"] as int? ?? 0) + 1;
    Context.Items["ip-brand-mark"] = n;
    var maskId = n == 1 ? "ip-brand-gap" : "ip-brand-gap-" + n;
}
<svg viewBox="254 150 300 300" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
    <defs>
        <mask id="@maskId" maskUnits="userSpaceOnUse" x="254" y="150" width="300" height="300">
            <rect x="254" y="150" width="300" height="300" fill="#fff" />
            <polygon points="349,233 416,300 349,367 335.5,353.5 389,300 335.5,246.5" fill="#000" stroke="#000" stroke-width="22" />
        </mask>
    </defs>
    <polygon points="352,156 497,300 352,444 310,402 412,300 310,198" fill="currentColor" mask="url(#@maskId)" />
    <polygon points="349,233 416,300 349,367 335.5,353.5 389,300 335.5,246.5" class="ip-brand-fill" />
</svg>
