@model ErrorViewModel
@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center mt-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <span class="state state-warn state-flat mono">404</span>
                    <h1 class="mt-2 mb-2">@L["Page Not Found"]</h1>
                    <p class="mb-3">
                        @L["The page you're looking for doesn't exist or may have been removed."]
                    </p>

                    <div class="section-title">@L["This might have happened because"]</div>
                    <ul class="text-muted mb-0">
                        <li>@L["The item was deleted"]</li>
                        <li>@L["The URL was typed incorrectly"]</li>
                        <li>@L["You don't have permission to view this resource"]</li>
                        <li>@L["The link you followed is outdated"]</li>
                    </ul>

                    <div class="section-title mt-4">@L["Looking for something specific?"]</div>
                    <div class="side-panel">
                        <div class="list-group list-group-flush">
                            <a href="/Products" class="list-group-item list-group-item-action">
                                <i class="fas fa-box me-2"></i>@L["Browse Products"]
                            </a>
                            <a href="/Routes" class="list-group-item list-group-item-action">
                                <i class="fas fa-signs-post me-2"></i>@L["View Routes"]
                            </a>
                            <a href="/Departments" class="list-group-item list-group-item-action">
                                <i class="fas fa-sitemap me-2"></i>@L["View Departments"]
                            </a>
                        </div>
                    </div>
                </div>
                <div class="page-actions">
                    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> @L["Go Back"]
                    </a>
                    <div class="actions-right">
                        <a href="/Home/Dashboard" class="btn btn-sm btn-primary">
                            <i class="fas fa-home me-1"></i> @L["Go to Dashboard"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
