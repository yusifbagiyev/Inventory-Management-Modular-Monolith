@model ErrorViewModel
@{
    ViewData["Title"] = "Page Not Found";
    var signedIn = User.Identity?.IsAuthenticated ?? false;
}

<div class="container-fluid px-4">
    <div class="ip-empty">
        <span class="icon"><i class="fa-solid fa-magnifying-glass"></i></span>
        <h1 class="title">@L["Page Not Found"]</h1>
        <p class="text mb-0">@L["The page you're looking for doesn't exist or may have been removed."]</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <button type="button" class="ip-btn ip-btn-ghost" data-history-back>
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>@L["Back"]</span>
            </button>
            @if (signedIn)
            {
                <a href="/" class="ip-btn ip-btn-secondary"><span>@L["Go to Dashboard"]</span></a>
            }
            else
            {
                <a href="/Account/Login" class="ip-btn ip-btn-secondary"><span>@L["Sign in"]</span></a>
            }
        </div>
    </div>
</div>
