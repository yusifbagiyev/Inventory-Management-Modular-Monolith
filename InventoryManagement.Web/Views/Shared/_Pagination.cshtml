@model PaginationViewModel
@* Page links keep the current filters, and list-filters.js also reads #pageSizeFilter *@
@{
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Math.Max(1, Model.PageSize)));
    var current = Math.Clamp(Model.PageNumber, 1, totalPages);

    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
            .Append(new KeyValuePair<string, string?>("pageNumber", page.ToString()));
        return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query).ToString();
    }

    // First, last and two pages either side of the current one, with an ellipsis for the gaps
    var pages = new SortedSet<int> { 1, totalPages };
    for (var p = current - 2; p <= current + 2; p++)
        if (p >= 1 && p <= totalPages) pages.Add(p);
    var pageStatus = $"{current} / {totalPages}";
}
<div class="ip-table-foot">
    @* Phones hide .range and .page-size and keep only previous, the page status and next *@
    <span class="ip-num range">@L["{0}–{1} of {2}", Model.FirstItem, Model.LastItem, Model.TotalCount]</span>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <label class="ip-filter page-size">
            <span>@L["Rows"]</span>
            <select id="pageSizeFilter" onchange="changePageSize(this.value)">
                @foreach (var size in new[] { 15, 30, 50, 100 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
        </label>
        @if (totalPages > 1)
        {
            <nav aria-label="@L["Pages"]">
                <ul class="ip-pagination">
                    @* At either end the arrow has no address, so the keyboard does not stop on it *@
                    <li class="prev @(current == 1 ? "disabled" : "")">
                        @if (current == 1)
                        {
                            <a role="link" aria-disabled="true" aria-label="@L["Previous"]"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <a href="@PageUrl(current - 1)" aria-label="@L["Previous"]"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                        }
                    </li>
                    @* Phones show this in place of the page numbers, which do not fit beside the fixed button *@
                    <li class="ip-page-status @(pageStatus.Length > 7 ? "long" : "")">
                        <span aria-current="page"><span class="visually-hidden">@L["Page {0} of {1}", current, totalPages]</span><span aria-hidden="true">@pageStatus</span></span>
                    </li>
                    @{ var previous = 0; }
                    @foreach (var p in pages)
                    {
                        if (p - previous > 1)
                        {
                            <li class="disabled"><span>…</span></li>
                        }
                        <li class="@(p == current ? "active" : "")">
                            @if (p == current)
                            {
                                <span aria-current="page">@p</span>
                            }
                            else
                            {
                                <a href="@PageUrl(p)">@p</a>
                            }
                        </li>
                        previous = p;
                    }
                    <li class="next @(current == totalPages ? "disabled" : "")">
                        @if (current == totalPages)
                        {
                            <a role="link" aria-disabled="true" aria-label="@L["Next"]"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <a href="@PageUrl(current + 1)" aria-label="@L["Next"]"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
