@inject InventoryManagement.Web.Services.RailCounts RailCounts
<!DOCTYPE html>
<html lang="@JsonStringLocalizer.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string pageTitle ? L[pageTitle] + " - " + L["166 Inventory"] : L["166 Inventory"])</title>
    @* The .ico is for older browsers and the PNG for iOS home screens *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    @* Prefetches a page when its link is hovered, so leave out anything with a side effect or a download *@
    <script type="speculationrules">
        {
            "prefetch": [{
                "where": { "and": [
                    { "href_matches": "/*" },
                    { "not": { "href_matches": ["/Account/*", "/Language/*", "/*/ExportToWord*", "/images/*", "/thumbs/*", "/api/*", "/notificationHub*"] } },
                    { "not": { "selector_matches": "[download], [target=_blank], [data-no-prefetch]" } }
                ] },
                "eagerness": "moderate"
            }]
        }
    </script>
    @* Names the rail and toolbar only during a view transition, inline since it must run before first render *@
    <script>
        (function () {
            var root = document.documentElement;
            if (!('onpagereveal' in window)) { root.classList.add('no-vt'); return; }
            function name(on) {
                var rail = document.querySelector('.ip-rail'), bar = document.querySelector('.ip-toolbar');
                if (rail) rail.style.viewTransitionName = on ? 'ip-rail' : '';
                if (bar) bar.style.viewTransitionName = on ? 'ip-toolbar' : '';
            }
            window.addEventListener('pageswap', function (e) { if (e.viewTransition) name(true); });
            window.addEventListener('pagereveal', function (e) {
                if (!e.viewTransition) return;
                name(true);
                e.viewTransition.finished.finally(function () { name(false); });
            });
            // A page restored from the back/forward cache still has the names from its swap
            window.addEventListener('pageshow', function (e) { if (e.persisted) name(false); });
        })();
    </script>
    @* Sets the theme before first paint so dark pages don't flash light, same storage key as Theme in site.js *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>

    <!-- tokens.css has to load before every stylesheet that reads its variables -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ip-components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    @{ var signedIn = User.Identity?.IsAuthenticated ?? false; }
    <a class="ip-skip" href="#page-body">@L["Skip to content"]</a>
    <div class="ip-app" id="wrapper">
        @if (signedIn)
        {
            @* Phone app bar below 768px, where site.js turns the menu button into a back arrow on breadcrumb pages *@
            <header class="ip-appbar">
                <button type="button" class="ip-btn-icon" data-rail-open aria-controls="ipRail" aria-expanded="false" aria-label="@L["Main menu"]"><i class="fa-solid fa-bars"></i></button>
                <a class="ip-btn-icon ip-appbar-back" href="/" hidden aria-label="@L["Back"]"><i class="fa-solid fa-arrow-left"></i></a>
                <div class="title">
                    @(ViewData["Title"] is string appBarTitle ? L[appBarTitle] : L["166 Inventory"])
                    @if (ViewData["Subtitle"] is string subtitle && subtitle.Length > 0)
                    {
                        <small>@subtitle</small>
                    }
                </div>
                <a class="ip-btn-icon position-relative" href="/Notifications" aria-label="@L["Notifications"]">
                    <i class="fa-regular fa-bell"></i><span class="ip-dot" data-unread-dot style="display:none"></span>
                </a>
            </header>
            <partial name="_Sidebar" />
        }

        <main class="ip-main page-content@(signedIn ? "" : " ip-guest")" id="page-content-wrapper">
            @if (!signedIn)
            {
                @* Error pages reached while signed out get the sign-in page's header instead of the toolbar *@
                <header class="ip-login-head">
                    <a class="ip-guest-brand" href="/Account/Login">
                        <span class="ip-logo brand" aria-hidden="true"><partial name="_BrandMark" /></span>
                        <strong class="ip-rail-name">@L["166 Inventory"]<small>@L["IT department"]</small></strong>
                    </a>
                    <div class="ip-guest-tools">
                        <partial name="_LanguageSwitch" />
                        <button type="button" class="ip-btn-icon lg" data-theme-toggle title="@L["Dark mode"]" aria-label="@L["Toggle dark mode"]">
                            <i class="fas fa-moon"></i>
                        </button>
                    </div>
                </header>
            }
            else
            {
            <header class="ip-toolbar">
                @if (signedIn)
                {
                    @* An exact code opens the product and anything else the filtered list, while CodeFinder suggests codes *@
                    @if (User.HasPermission("product.view"))
                    {
                    <form class="ip-toolbar-search" method="get" action="/Products/Find" role="search" data-no-ajax data-code-finder>
                        <button type="submit" class="ip-finder-go" title="@L["Search"]" aria-label="@L["Search"]">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                        <input type="search" name="code" autocomplete="off" inputmode="search"
                               role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="codeFinderList"
                               placeholder="@L["Find by code, e.g. 1042"]" aria-label="@L["Find by code"]" />
                        <div class="ip-finder-menu" id="codeFinderList" role="listbox" hidden></div>
                    </form>
                    }
                }

                <partial name="_LanguageSwitch" />

                @if (signedIn)
                {
                    <button type="button" class="ip-btn-icon lg" data-theme-toggle
                            title="@L["Dark mode"]" aria-label="@L["Toggle dark mode"]">
                        <i class="fas fa-moon"></i>
                    </button>

                    <div class="dropdown">
                        <button type="button" class="ip-btn-icon lg position-relative" id="notificationIcon"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                title="@L["Notifications"]" aria-label="@L["Notifications"]">
                            <i class="fa-regular fa-bell"></i>
                            <span id="notificationBadge" class="ip-dot" style="display:none"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end ip-dropdown ip-notif-menu">
                            <div class="head">
                                <span>@L["Notifications"]</span>
                                <button type="button" id="markAllAsRead" class="ip-btn ip-btn-ghost ip-btn-sm">@L["Mark all as read"]</button>
                            </div>
                            <div id="notificationList" class="ip-notif-list">
                                <div class="px-3 py-2"><partial name="_Skeleton" model="3" /></div>
                            </div>
                            <a href="/Notifications" class="ip-notif-foot">
                                <span>@L["All notifications"]</span><i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </header>
            }

            @* Target of the skip link, so the next Tab goes into the page instead of through the rail and toolbar *@
            <div id="page-body" class="ip-skip-target" tabindex="-1"></div>
            @RenderBody()
        </main>
    </div>

    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-4">
    </div>

    <div class="modal fade ip-modal" id="globalImageModal" tabindex="-1" aria-labelledby="globalImageTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: 900px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="globalImageTitle">@L["Image Preview"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body text-center p-0" style="max-height: 70vh; overflow: auto;">
                    <img id="globalModalImage" class="img-fluid" alt="@L["Preview"]"
                         style="max-width: 100%; max-height: 65vh; width: auto; height: auto;">
                </div>
            </div>
        </div>
    </div>

    @* Used through confirmAction() instead of the browser's confirm(), which cannot be styled *@
    <div class="modal fade ip-modal" id="globalConfirmModal" tabindex="-1" aria-labelledby="globalConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm-plus">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="globalConfirmTitle">@L["Please confirm"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p id="globalConfirmMessage" class="mb-0">@L["Are you sure?"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="ip-btn ip-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="ip-btn ip-btn-primary" id="globalConfirmOk">@L["Confirm"]</button>
                </div>
            </div>
        </div>
    </div>

    @* Self-hosted because the app must work without internet, with versions pinned in libman.json *@
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js" asp-append-version="true"></script>
    <script src="~/lib/chart.js/dist/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>

    @* Translation table for t() in site.js, with the language in the URL because the script is cached for good *@
    @if (JsonStringLocalizer.Language != "en")
    {
        <script src="/Language/Strings?lang=@JsonStringLocalizer.Language&amp;v=@JsonStringLocalizer.Version"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app-config.js" asp-append-version="true"></script>
    <script src="~/js/notification-manager.js" asp-append-version="true"></script>
    <script src="~/js/live-updates.js" asp-append-version="true"></script>
    <script src="~/js/image-manager.js" asp-append-version="true"></script>
    <script src="~/js/table-columns.js" asp-append-version="true"></script>

    @if (User.HasPermission("approval.view") || User.HasPermission("approval.decide"))
    {
        <script src="~/js/admin-approvals.js" asp-append-version="true"></script>
    }
    @{
        var canSeeApprovals = User.HasPermission("approval.view") || User.HasPermission("approval.decide");
        // Read with the page, so loading it does not send two more requests for the badges
        int? unreadCount = signedIn ? await RailCounts.UnreadAsync() : null;
        int? pendingCount = signedIn && canSeeApprovals ? await RailCounts.PendingApprovalsAsync() : null;
    }
    @* The bell, the counts and the live connection exist only for a signed-in user *@
    @if (signedIn)
    {
    <script>
        $(document).ready(function() {
                // Whoever may see the approvals page also follows the pending-approvals count
                NotificationManager.initialize(@(canSeeApprovals ? "true" : "false"));

                setupNotificationUIHandlers();

                // The list itself loads when the bell is opened
                @if (unreadCount.HasValue) { <text>updateNotificationBadge(@unreadCount);</text> } else { <text>loadNotificationCount();</text> }
                @if (canSeeApprovals)
                {
                    if (pendingCount.HasValue) { <text>updatePendingApprovalsCount(@pendingCount);</text> } else { <text>loadPendingApprovalsCount();</text> }
                }
        });

        // A reconnect or a new notification refreshes the count, and the list only while the bell is open
        window.refreshNotifications = function () {
            if ($('#notificationList').closest('.dropdown-menu').hasClass('show')) loadRecentNotifications();
            else loadNotificationCount();
        };

        function setupNotificationUIHandlers() {
            // Loaded on each opening, not when the bell closes
            $('#notificationIcon').closest('.dropdown').on('show.bs.dropdown', function() {
                loadRecentNotifications();
            });

            $('#markAllAsRead').on('click', function(e) {
                e.preventDefault();
                markAllNotificationsAsRead();
            });

            $(document).on('click', '.ip-notif-item', function() {
                const notificationId = $(this).data('id');
                if (notificationId) {
                    markNotificationAsRead(notificationId);
                }
            });
            // The items act as buttons, so Enter and Space work like a click
            $(document).on('keydown', '#notificationList .ip-notif-item', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    $(this).trigger('click');
                }
            });
        }

        // Global because notification-manager.js calls these
        window.loadNotificationCount = function() {
            $.ajax({
                url: '/Notifications/GetUnreadCount',
                type: 'GET',
                success: function(count) {
                    updateNotificationBadge(count);
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load notification count:', error);
                }
            });
        };



         window.loadRecentNotifications = function() {
            $('#notificationList').html(`<div class="px-3 py-2">${skeletonHtml(3)}</div>`);

            $.ajax({
                url: '/Notifications/GetRecentNotifications',
                type: 'GET',
                success: function(notifications) {
                    renderNotifications(notifications);

                    loadNotificationCount();
                },
                error: function(xhr, status, error) {
                    console.error('Failed to load notifications:', error);
                    $('#notificationList').html(`<div class="ip-notif-empty">${escapeHtml(t('Failed to load notifications'))}</div>`);
                }
            });
        };



         window.incrementNotificationCount = function() {
            $.ajax({
                url: '/Notifications/GetUnreadCount',
                type: 'GET',
                success: function(count) {
                    updateNotificationBadge(count);
                },
                error: function(xhr, status, error) {
                    console.error('Failed to get current count:', error);
                    // Without the server count, add one to the number already shown
                    const $badge = $('#notificationBadge');
                    const currentText = $badge.text().trim();

                    if (currentText && currentText !== '99+') {
                        const current = parseInt(currentText) || 0;
                        updateNotificationBadge(current + 1);
                    } else {
                        updateNotificationBadge(1);
                    }
                }
            });
        };

        window.playNotificationSound = function() {
            try {
                const audio = new Audio('/sounds/notify.mp3');
                audio.volume = 0.5;

                const playPromise = audio.play();
                if (playPromise !== undefined) {
                    // Browsers block autoplay until the page has been interacted with, which is not an error
                    playPromise.catch(() => { });
                }
            } catch (error) {
                console.error('Error playing notification sound:', error);
            }
        };

        window.getNotificationType = function(type) {
            const types = {
                'ApprovalRequest': 'warning',
                'ApprovalResponse': 'success',
                'ProductUpdate': 'info',
                'RouteUpdate': 'info',
                'RouteCompleted': 'success',
                'TransferCompleted': 'success',
                'System': 'secondary'
            };
            return types[type] || 'info';
        };

        function renderNotifications(notifications) {
            let html = '';

            if (!notifications || notifications.length === 0) {
                html = `<div class="ip-notif-empty">${escapeHtml(t('No new notifications'))}</div>`;
            } else {
                // Only the latest four, the rest are on the Notifications page
                notifications.slice(0, 4).forEach(function(notification) {
                    html += createNotificationItem(notification);
                });
            }

            $('#notificationList').html(html);
        }

        // Same mapping as Icon() on the Notifications page
        function notificationIcon(notification) {
            let status = null;
            try { status = JSON.parse(notification.data || '{}').status ?? null; } catch (e) { }
            switch (notification.type) {
                case 'ApprovalRequest': return ['fa-clipboard-list', ''];
                case 'ApprovalResponse':
                    return status === 'Approved' ? ['fa-circle-check', 'ok']
                         : status === 'Rejected' ? ['fa-circle-xmark', 'bad']
                         : status === 'Failed' ? ['fa-triangle-exclamation', 'bad'] : ['fa-reply', ''];
                case 'RouteUpdate': case 'RouteCompleted': case 'TransferCompleted': return ['fa-right-left', ''];
                case 'ProductUpdate':
                    return notification.title === t('Product Deleted') || notification.title === 'Product Deleted' ? ['fa-trash-can', ''] : ['fa-box', ''];
                default: return ['fa-bell', ''];
            }
        }

        function createNotificationItem(notification) {
            const unreadClass = notification.isRead ? '' : 'unread';
            const [icon, tone] = notificationIcon(notification);
            return `
                <div class="ip-notif-item ${unreadClass}" data-id="${escapeHtml(String(notification.id))}" role="button" tabindex="0">
                    <span class="unread-dot" aria-hidden="true"></span>
                    <span class="ip-notif-icon ${tone}" aria-hidden="true"><i class="fa-solid ${icon}"></i></span>
                    <div class="flex-grow-1" style="min-width: 0">
                        <div class="d-flex justify-content-between align-items-baseline gap-2">
                            <span class="title">${escapeHtml(notification.title)}</span>
                            <span class="time">${escapeHtml(formatTimeAgo(notification.createdAt))}</span>
                        </div>
                        <div class="text">${escapeHtml(notification.message)}</div>
                    </div>
                </div>
            `;
        }

        function markNotificationAsRead(notificationId) {
            $.ajax({
                url: '/Notifications/MarkAsRead',
                type: 'POST',
                data: JSON.stringify(notificationId),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function(response) {
                    $(`.ip-notif-item[data-id="${notificationId}"]`).removeClass('unread');
                    loadNotificationCount();
                },
                error: function(xhr, status, error) {
                    console.error('Failed to mark notification as read:', error);
                }
            });
        }

        function markAllNotificationsAsRead() {
            const token = $('input[name="__RequestVerificationToken"]').first().val();

            $.ajax({
                url: '/Notifications/MarkAllAsRead',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    $('.ip-notif-item').removeClass('unread');
                    updateNotificationBadge(0);

                    setTimeout(function() {
                        loadRecentNotifications();
                        loadNotificationCount();
                    }, 300);

                    showToast(t('All notifications marked as read'), 'success');
                },
                error: function(xhr, status, error) {
                    console.error('Failed to mark all as read:', error);
                    showToast(t('Failed to mark notifications as read'), 'error');
                }
            });
        }

        function updateNotificationBadge(count) {
            count = parseInt(count) || 0;

            // Toolbar bell, rail count and the phone app bar dot
            const badgeSelectors = ['#notificationBadge', '#sidebarUnreadCount', '[data-unread-dot]'];

            badgeSelectors.forEach(selector => {
                const $element = $(selector);
                if ($element.length) {
                    if (count > 0) {
                        const displayCount = count > 99 ? '99+' : count;
                        $element.text(displayCount).show();
                    } else {
                        $element.hide().text('');
                    }
                }
            });
        }


        function formatTimeAgo(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffMs = now - date;
            const diffSecs = Math.floor(diffMs / 1000);
            const diffMins = Math.floor(diffSecs / 60);
            const diffHours = Math.floor(diffMins / 60);
            const diffDays = Math.floor(diffHours / 24);

            if (diffSecs < 60) return t('just now');
            if (diffMins < 60) return t('{0}m ago', diffMins);
            if (diffHours < 24) return t('{0}h ago', diffHours);
            if (diffDays < 30) return t('{0}d ago', diffDays);

            return date.toLocaleDateString(uiLocale(), {
                month: 'short',
                day: 'numeric',
                year: date.getFullYear() !== now.getFullYear() ? 'numeric' : undefined
            });
        }

    </script>
    }

    @* Shows TempData messages from redirect-based actions as toasts *@
    @{
        var tdSuccess = JsonStringLocalizer.TranslateMessage(TempData["Success"] as string);
        var tdError = JsonStringLocalizer.TranslateMessage((TempData["Error"] ?? TempData["ErrorMessage"]) as string);
    }
    @if (!string.IsNullOrEmpty(tdSuccess) || !string.IsNullOrEmpty(tdError))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (!window.showToast) return;
                @if (!string.IsNullOrEmpty(tdSuccess))
                {
                    <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(tdSuccess)), 'success');</text>
                }
                @if (!string.IsNullOrEmpty(tdError))
                {
                    <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(tdError)), 'error');</text>
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>