@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid px-4">
    <div class="ip-empty">
        <span class="icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
        <h1 class="title">@L["An error has occurred."]</h1>
        <p class="text mb-0">@L["An error occurred while processing your request."]</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="ip-faint mb-0">@L["Request ID"]: <span class="ip-mono">@Model.RequestId</span></p>
        }
        <a href="/" class="ip-btn ip-btn-secondary">
            <span>@L["Go to Dashboard"]</span>
        </a>
    </div>
</div>
