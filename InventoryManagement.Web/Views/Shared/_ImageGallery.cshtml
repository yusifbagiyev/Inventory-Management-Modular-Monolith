@model ImageGalleryModel
@* image-manager.js switches the images, and clicking the large one opens the preview modal *@
@if (Model.Images.Count == 0)
{
    <div class="ip-gallery" role="img" aria-label="@L[Model.EmptyText]">
        <div class="text-center">
            <i class="fa-regular fa-image fa-2x d-block mb-2"></i>
            <span class="ip-faint">@L[Model.EmptyText]</span>
        </div>
    </div>
}
else
{
    <div data-image-gallery>
        <div class="ip-gallery">
            <img src="@Model.Images[0]" alt="@Model.Title" data-ig-main style="cursor: zoom-in"
                 onclick="showImageModal(this.getAttribute('src'), this.alt)" />
            <span class="chip" data-ig-cover><i class="fa-solid fa-star"></i>@L["Cover image"]</span>
            @if (Model.Images.Count > 1)
            {
                <button type="button" class="nav prev" data-ig-step="-1" aria-label="@L["Previous"]"><i class="fa-solid fa-chevron-left"></i></button>
                <button type="button" class="nav next" data-ig-step="1" aria-label="@L["Next"]"><i class="fa-solid fa-chevron-right"></i></button>
                <span class="counter" data-ig-counter>1 / @Model.Images.Count</span>
                @* Phones show dots instead of arrows and thumbnails and swipe between images *@
                <div class="ip-gallery-dots" aria-hidden="true">
                    @for (var i = 0; i < Model.Images.Count; i++)
                    {
                        <i class="@(i == 0 ? "active" : "")"></i>
                    }
                </div>
            }
        </div>
        @if (Model.Images.Count > 1)
        {
            <div class="ip-gallery-thumbs">
                @for (var i = 0; i < Model.Images.Count; i++)
                {
                    <button type="button" class="@(i == 0 ? "active" : "")" data-ig-thumb="@Model.Images[i]" data-ig-index="@(i + 1)"
                            aria-label="@L["Image {0}", i + 1]">
                        <img src="@InventoryManagement.Web.Services.ImageThumbnails.Url(Model.Images[i])" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>
}
