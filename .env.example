# Copy to .env and fill in, and never commit .env

# Volume name prefix, pinned so renaming the folder cannot start the stack on an empty database
COMPOSE_PROJECT_NAME=inventory166

# PostgreSQL superuser for the compose database server
DB_USER=
DB_PASSWORD=
# Database the app uses, with one schema per module
DB_NAME=inventory

# Signing key of at least 32 characters for JWTs issued to external /api clients
JWT_SECRET_KEY=
JWT_ISSUER=166Logistics
JWT_AUDIENCE=InventorySystemUsers

# X-Api-Key for the ServiceDesk integration, which stays off while this is empty
SERVICEDESK_API_KEY=

SEQ_ADMIN_PASSWORD=

WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=

# Set both to run the Cloudflare Tunnel, or leave them empty to keep the app on the LAN only
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

TZ=Asia/Baku
ENVIRONMENT=Production

# Image the app runs, written by deploy.sh and left empty on a manual setup
APP_IMAGE=
