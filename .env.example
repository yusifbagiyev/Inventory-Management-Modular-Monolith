# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.

# Prefix of the volume names, i.e. which PostgreSQL data the stack uses. Defaults to the folder
# name; pinned so moving or renaming the folder cannot start the stack on an empty database.
COMPOSE_PROJECT_NAME=inventory166

# PostgreSQL superuser for the compose database server.
DB_USER=
DB_PASSWORD=
# Database the app uses (one schema per module). Default: inventory
DB_NAME=inventory

# Signing key for JWTs issued to external /api clients (min. 32 chars).
JWT_SECRET_KEY=
JWT_ISSUER=166Logistics
JWT_AUDIENCE=InventorySystemUsers

# X-Api-Key for the ServiceDesk integration (product.view). Empty disables it.
SERVICEDESK_API_KEY=

SEQ_ADMIN_PASSWORD=

WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=

TZ=Asia/Baku
ENVIRONMENT=Production

# Written by deploy/deploy.sh (CD): the ghcr.io image the app runs. Leave empty on a manual setup.
APP_IMAGE=
