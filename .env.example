# Copy to .env and fill in. Never commit .env.

# Prefix of the volume names. Pinned so renaming the folder cannot start the stack on an empty database.
COMPOSE_PROJECT_NAME=inventory166

# PostgreSQL superuser for the compose database server.
DB_USER=
DB_PASSWORD=
# Database the app uses, with one schema per module.
DB_NAME=inventory

# Signing key for JWTs issued to external /api clients. At least 32 characters.
JWT_SECRET_KEY=
JWT_ISSUER=166Logistics
JWT_AUDIENCE=InventorySystemUsers

# X-Api-Key for the ServiceDesk integration. Empty disables it.
SERVICEDESK_API_KEY=

SEQ_ADMIN_PASSWORD=

WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=

# Set both to run the Cloudflare Tunnel. Leave them empty to keep the app on the LAN only.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

TZ=Asia/Baku
ENVIRONMENT=Production

# The image the app runs, written by deploy.sh. Leave empty on a manual setup.
APP_IMAGE=
